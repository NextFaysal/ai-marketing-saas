// Milestone 1 foundation schema.
// Money is always integer minor units or Decimal - never Float.
// Every tenant-owned model carries organizationId and is indexed on it.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  OWNER
  ADMIN
  MARKETING_MANAGER
  ADVERTISER
  SUPPORT_AGENT
  ANALYST
  VIEWER
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum SubscriptionPlan {
  FREE
  STARTER
  GROWTH
  AGENCY
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  referralCode String?  @unique
  name         String
  passwordHash String
  isSuperAdmin Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  memberships  Membership[]
  auditLogs    AuditLog[]
  // GB6 (GC16): login history + server-side session registry.
  loginEvents  LoginEvent[]
  sessions     UserSession[]
  notificationPreferences NotificationPreference[]
  status              String    @default("ACTIVE") // ACTIVE | SUSPENDED | DELETED
  adminTier           String? // SUPER | SUPPORT | FINANCE (null = not an admin even if flag legacy)
  lastLoginAt         DateTime?
  tokenVersion        Int       @default(0)
  totpSecretEncrypted String?
  totpEnabled         Boolean   @default(false)
  // GB9 (GC21): registration verification. Null = not verified.
  // Existing users are grandfathered by the enforcement gate
  // (it applies only to accounts created after enforcement was
  // switched on); the columns simply record the truth.
  emailVerifiedAt     DateTime?
  phoneVerifiedAt     DateTime?
  phone               String?
  verificationTokens  VerificationToken[]
  // AB8 (AX26): Google SSO state + handoff tokens (hashed at rest).
  ssoLoginStates      SsoLoginState[]
}

/// GB9 (GC21): email verification tokens + phone OTP codes.
/// tokenHash is always a SHA-256 hash — the raw token/code is
/// never stored. kind "email" rows carry a random token (24h);
/// kind "phone" rows carry a 6-digit OTP (5 min, attempt-capped,
/// mirroring the EC25 shop-account OTP discipline).
model VerificationToken {
  id        String    @id @default(uuid())
  userId    String
  kind      String // email | phone
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
}

model Organization {
  id             String          @id @default(uuid())
  name           String
  slug           String          @unique
  country        String          @default("BD")
  creditMinor    BigInt          @default(0)
  attributionWindowDays Int       @default(30)
  timezone       String          @default("Asia/Dhaka")
  currency       String          @default("BDT")
  // Milestone 59 (Agency White-Label v1): per-org branding.
  // All additive + nullable; absence means the platform defaults.
  brandName       String?
  logoUrl         String?
  logoContentType String?
  primaryColor    String?
  // MX7: brand-kit completion for the email builder — the font
  // is a key of the BRAND_FONT_STACKS allowlist in
  // messaging/email-blocks.ts (never free-text CSS) and the
  // secondary color is a #RRGGBB hex like primaryColor. Both
  // live HERE, on the Organization row's Org Settings branding
  // (M59) — there is deliberately no second brand store.
  brandFont           String?
  brandSecondaryColor String?
  // NF8 (FB3): the org's OWN Google review link, pasted by the
  // org in Settings (branding surface). Null = not configured —
  // a happy customer's post-submit screen then offers nothing.
  // The link is only ever OFFERED (never auto-redirected) and
  // only after a 4–5 star review the customer already submitted.
  googleReviewUrl String?
  customDomain    String?
  // GB9 (GC21): merchant verification workflow —
  // unverified | pending | verified | rejected. The admin's
  // note is visible to the merchant (it explains a rejection).
  verificationStatus      String    @default("unverified")
  verificationNote        String?
  verificationSubmittedAt DateTime?
  // AB8 (AX24): white-label — when true, the org's customer-facing
  // surfaces drop every platform mark that exists (shop favicon /
  // PWA icon fallbacks become a neutral generated initial icon;
  // org-scoped transactional email carries the org's own brand as
  // the sender display name). Set by a platform admin; plan tiers
  // carry numeric limits only, so there is no plan boolean to gate
  // it on (documented in the AB8 acceptance).
  whiteLabel              Boolean   @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  memberships    Membership[]
  businessProfile BusinessProfile?
  subscriptions  Subscription[]
  usageRecords   UsageRecord[]
  auditLogs      AuditLog[]
  products       Product[]
  policies       BusinessPolicy[]
  importJobs     ImportJob[]
  knowledgeDocs  KnowledgeDocument[]
  knowledgeEmbeddings KnowledgeEmbedding[]
  aiStoredAnswers AiStoredAnswer[]
  learnedItems   LearnedItem[]
  learningStates LearningState[]
  performanceSnapshots PerformanceSnapshot[]
  brandVoiceProfile    AiBrandVoiceProfile?
  customerMemories     CustomerMemory[]
  stores         Store[]
  integrations   Integration[]
  tenantAppConfigs TenantAppConfig[]
  orgLlmConfig   OrgLlmConfig?
  orgStockConfig OrgStockConfig?
  socialCoachDigests SocialCoachDigest[]
  tenantPaymentGateways TenantPaymentGateway[]
  tenantPaymentTransactions TenantPaymentTransaction[]
  platformPaymentEnablements PlatformPaymentEnablement[]
  walletAccount  WalletAccount?
  walletTransactions WalletTransaction[]
  payoutRequests PayoutRequest[]
  paymentRefunds PaymentRefund[]
  settlementImports SettlementImport[]
  payoutDestinations PayoutDestination[]
  payoutSchedule PayoutSchedule?
  payoutExecutions PayoutExecution[]
  paymentLinks   PaymentLink[]
  storeListings  StoreListing[]
  syncOutbox     SyncOutbox[]
  syncConflicts  SyncConflict[]
  // GB6: CRM segments (GC15) + per-org custom roles (GC16).
  crmSegments    CrmSegment[]
  customRoles    CustomRole[]
  // GB9 (GC23): outgoing merchant webhooks + public API usage.
  webhookSubscriptions WebhookSubscription[]
  apiUsageDaily        ApiUsageDaily[]
  // AB8 (AX21/AX24/AX25): merchant developer API keys, the
  // white-label flag, self-serve data exports + backup preference.
  merchantApiKeys      MerchantApiKey[]
  dataExports          DataExport[]
  dataImports          DataImport[]
  backupPreference     OrgBackupPreference?
  notificationPreferences NotificationPreference[]
  categories     Category[]
  productTags    ProductTag[]
  taxonomyMaps   StoreTaxonomyMap[]
  storeLocations StoreLocation[]
  bundleItems    BundleItem[]
  fulfillments   Fulfillment[]
  fulfillmentSetting FulfillmentSetting?
  pickWaves      PickWave[]
  deliveryAttempts DeliveryAttempt[]
  returnRequests ReturnRequest[]
  customerStoreIdentities CustomerStoreIdentity[]
  storeDiscounts          StoreDiscount[]
  promotions              Promotion[]
  productFeeds            ProductFeed[]
  suppliers               Supplier[]
  purchaseOrders          PurchaseOrder[]
  supplierPortalLinks     SupplierPortalLink[]
  // NF12 (FB4): dropship — the ONLY cross-org relations in the
  // schema. An agreement names both orgs explicitly; every read
  // is scoped by one side of the pair (see DropshipAgreement).
  dropshipAgreementsAsSupplier DropshipAgreement[] @relation("DropshipSupplierOrg")
  dropshipAgreementsAsSeller    DropshipAgreement[] @relation("DropshipSellerOrg")
  dropshipOffers          DropshipOffer[]
  dropshipListings        DropshipListing[]
  dropshipOrderLinks      DropshipOrderLink[]
  dropshipLedgerEntries   DropshipLedgerEntry[]
  warehouses              Warehouse[]
  binLocations            BinLocation[]
  productBinAssignments   ProductBinAssignment[]
  stockCountSessions      StockCountSession[]
  stockBalances           StockBalance[]
  stockAllocations        StockAllocation[]
  stockTransfers          StockTransfer[]
  courierRules            CourierRule[]
  riders                  Rider[]
  deliveryAssignments     DeliveryAssignment[]
  riderShareLinks         RiderShareLink[]
  riderLocationPings      RiderLocationPing[]
  riderLocationLatests    RiderLocationLatest[]
  taxSetting              TaxSetting?
  invoiceCounters         InvoiceCounter[]
  customerSubscriptions   CustomerSubscription[]
  abandonedStoreCheckouts AbandonedStoreCheckout[]
  abandonedCouponSetting AbandonedCouponSetting?
  loyaltySetting  LoyaltySetting?
  referralRewardSetting ReferralRewardSetting?
  loyaltyLedger   LoyaltyLedger[]
  giftCardSetting GiftCardSetting?
  giftCards       GiftCard[]
  giftCardLedger  GiftCardLedger[]
  giftCardIssuances GiftCardIssuance[]
  storefrontSetting StorefrontSetting?
  shopPages         ShopPage[]
  blogPosts         BlogPost[]
  searchSynonyms    SearchSynonym[]
  searchQueryLogs   SearchQueryLog[]
  storePopup        StorePopup?
  productReviewInsights ProductReviewInsight[]
  shopPushSetting   ShopPushSetting?
  webPushSubscriptions WebPushSubscription[]
  webPushCampaigns  WebPushCampaign[]
  socialProofSetting SocialProofSetting?
  shopContactMessages ShopContactMessage[]
  brands            Brand[]
  stockReservations StockReservation[]
  shippingZones     ShippingZone[]
  shippingRateRules ShippingRateRule[]
  pickupPoints      PickupPoint[]
  installmentPlans  InstallmentPlan[]
  affiliatePartners AffiliatePartner[]
  commissionEntries CommissionEntry[]
  affiliatePayouts  AffiliatePayout[]
  storeCarts        StoreCart[]
  customers      Customer[]
  orders         Order[]
  visitors       Visitor[]
  trackingEvents TrackingEvent[]
  touchpoints    Touchpoint[]
  adAccounts     AdAccount[]
  socialAccounts SocialAccount[]
  liveSessions   LiveSession[]
  videoProjects  VideoProject[]
  serviceOfferings ServiceOffering[]
  serviceStaff     ServiceStaff[]
  staffAvailabilities StaffAvailability[]
  serviceBookings  ServiceBooking[]
  contentTranslations ContentTranslation[]
  displayCurrencyRates DisplayCurrencyRate[]
  promoCampaigns PromoCampaign[]
  promoPlays PromoPlay[]
  promoGroupBuyJoins PromoGroupBuyJoin[]
  tierDefinitions TierDefinition[]
  customerTiers CustomerTier[]
  storeCreditEntries StoreCreditEntry[]
  chartAccounts ChartAccount[]
  journalEntries JournalEntry[]
  hrSetting HrSetting?
  staffSalaryProfiles StaffSalaryProfile[]
  attendanceRecords AttendanceRecord[]
  staffShiftPatterns StaffShiftPattern[]
  leaveRequests LeaveRequest[]
  payrollRuns PayrollRun[]
  fraudNetworkSetting FraudNetworkSetting?
  fraudNetworkContributions FraudNetworkContribution[]
  agencyCommissionEntriesAsAgency AgencyCommissionEntry[] @relation("AgencyCommissionAgency")
  agencyCommissionEntriesAsClient AgencyCommissionEntry[] @relation("AgencyCommissionClient")
  socialAccountFollowerSnapshots SocialAccountFollowerSnapshot[]
  socialPosts    SocialPost[]
  socialPostShareLinks SocialPostShareLink[]
  socialPostClientReviews SocialPostClientReview[]
  socialPostNotes SocialPostNote[]
  socialPostVersions SocialPostVersion[]
  socialPostGroups SocialPostGroup[]
  socialPostingSlots SocialPostingSlot[]
  mediaFolders   MediaFolder[]
  socialContentPlans SocialContentPlan[]
  mediaAssets    MediaAsset[]
  storedFiles    StoredFile[]
  dailyAdMetrics DailyAdMetric[]
  dailyAggregates DailyMetricAggregate[]
  aiConversations AIConversation[]
  aiReports      AIReport[]
  aiActions      AIAction[]
  aiActionProposals AIActionProposal[]
  aiAutonomySettings AiAutonomySetting[]
  aiProactiveSetting AIProactiveSetting?
  assistantApiKeys   AssistantApiKey[]
  aiUsageRecords AIUsageRecord[]
  channelConversations ChannelConversation[]
  leads          Lead[]
  customFieldDefs CustomFieldDef[]
  competitors    Competitor[]
  competitorInsights CompetitorInsight[]
  campaignPlans  CampaignPlan[]
  leadForms      LeadForm[]
  messageTemplates MessageTemplate[]
  messageTemplateVersions MessageTemplateVersion[]
  messagingContentBlocks MessagingContentBlock[]
  broadcasts     Broadcast[]
  messagingSavedAudiences MessagingSavedAudience[]
  workflows      Workflow[]
  scheduledJobs  ScheduledJob[]
  automationRules AutomationRule[]
  automationRuns AutomationRun[]
  ruleSuggestions RuleSuggestion[]
  status                String @default("ACTIVE") // ACTIVE | SUSPENDED | DELETED
  // ORG3 (Organization Next OB1): tenant-side archive — set by
  // the OWNER to pause the workspace without touching the
  // platform status above. Non-null = archived at that moment;
  // TenantGuard blocks org APIs except the OWNER's restore /
  // export / lifecycle paths. Restore clears it back to null.
  archivedAt            DateTime?
  aiDailyLimitOverride  Int?
  broadcastCapOverride  Int?
  seatLimit             Int?
  // ORG11 (Organization Next OB4): org security policy. When
  // requireMfa is true, TenantGuard refuses org API access to
  // members whose account has no TOTP MFA enabled (the setup
  // endpoints themselves are not org-scoped, so nobody is ever
  // permanently locked out). sessionMaxAgeHours caps how old a
  // member's server-side session (UserSession.createdAt) may be
  // while working in THIS org; null = no org-level cap (the
  // global JWT lifetime still applies).
  requireMfa            Boolean @default(false)
  sessionMaxAgeHours    Int?
  // ORG13 (Organization Next OB4): platform-admin classification
  // labels (support/sales triage). Admin-only: never rendered in
  // tenant UI and stripped from the tenant-facing org read paths
  // (listMine / getOne / create / identity update).
  tags                  String[] @default([])
  // SP7: when true, social posts by non-OWNER/ADMIN members need
  // OWNER/ADMIN approval before they can be scheduled/published.
  socialRequireApproval Boolean @default(false)
  // SN2: when true, a post additionally needs CLIENT approval
  // through a SocialPostShareLink before it can be published —
  // an optional third step beside the internal approval above.
  // Default false = client approval never gates publishing.
  socialRequireClientApproval Boolean @default(false)
  // SU9: when true, approval gains a second step — a first
  // OWNER/ADMIN approval moves a post to "manager_approved" and
  // only a second OWNER/ADMIN approval makes it "approved".
  // Default false = the SP7 one-step flow exactly.
  socialApprovalTwoStep Boolean @default(false)
  // SU6: last-click association window (days) for social post
  // link clicks → orders. Association only, never attribution.
  socialLinkWindowDays Int       @default(7)
  socialAutoDraftConfig SocialAutoDraftConfig?
  socialSyndicationSeen SocialSyndicationSeen[]
  socialLinkClicks SocialLinkClick[]
  // CX12a: Practice Mode — while true, the org can rehearse the
  // full AI reply + order flow on practice conversations/orders;
  // nothing practice-flagged ever reaches a real customer (the
  // send guard lives at InboxService.deliverText + courier
  // booking). Default false = pre-CX12a behaviour.
  practiceMode          Boolean @default(false)
  voiceCallSetting      VoiceCallSetting?
  orderVoiceCalls       OrderVoiceCall[]
  voiceConversationTurns VoiceConversationTurn[]
}

model Membership {
  id             String           @id @default(uuid())
  userId         String
  organizationId String
  role           Role             @default(VIEWER)
  status         MembershipStatus @default(ACTIVE)
  // Milestone 72 (Team W3): per-member custom access on top of
  // the role — { grants: string[], denies: string[] } of
  // permission-area keys (see common/permission-catalog.ts).
  // Null = no overrides. Never applies to the OWNER.
  permissionOverrides Json?
  // CC17 (Connect Center Advanced): per-member CONNECTION
  // deny-list — a JSON array of connection target ids
  // (Integration / SocialAccount row ids) this member may not
  // USE (send/post through), managed by OWNER/ADMIN from the
  // Connect Center member matrix. Kept apart from
  // permissionOverrides because normalizeOverrides() there is
  // strictly permission-area keys. Null = no restriction.
  // Never applies to the OWNER (same M72 semantics).
  // CC27 (Connect Center Next): AdAccount row ids are deniable
  // targets too — the matrix lists them and the ads/campaigns
  // send-side paths enforce them (see B12 acceptance).
  deniedConnections Json?
  // GB6 (GC16): per-org custom role assigned to this member.
  // When set (and the member is not the OWNER), the role's
  // areas govern @PermissionArea endpoints; the member's
  // preset `role` keeps governing role-list-only endpoints.
  customRoleId   String?
  customRole     CustomRole?      @relation(fields: [customRoleId], references: [id], onDelete: SetNull)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  serviceStaff   ServiceStaff[]
  salaryProfile  StaffSalaryProfile?
  attendanceRecords AttendanceRecord[]
  shiftPatterns  StaffShiftPattern[]
  leaveRequests  LeaveRequest[]
  payrollLines   PayrollLine[]

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
}

model BusinessProfile {
  id              String       @id @default(uuid())
  organizationId  String       @unique
  description     String?
  industry        String?
  businessModel   String?
  websiteUrl      String?
  goals           String?
  targetCustomers Json?
  brandVoice      String?
  uniqueSellingPoints String?
  monthlyBudgetMinor BigInt?
  budgetCurrency  String       @default("BDT")
  contactEmail    String?
  contactPhone    String?
  // Milestone 75 (Business Command Center): the operational
  // layer the AI quotes daily — address, hours, delivery,
  // payments. Money is integer minor units (BigInt, matching
  // monthlyBudgetMinor). Null = not set; the AI must say it
  // does not know rather than invent a value.
  address         String?
  city            String?
  businessHours   Json?
  deliveryChargeInsideMinor  BigInt?
  deliveryChargeOutsideMinor BigInt?
  freeDeliveryAboveMinor     BigInt?
  deliveryDaysInside  Int?
  deliveryDaysOutside Int?
  codAvailable        Boolean?
  minOrderMinor       BigInt?
  // GB3 (GC8): COD trust rules — codMaxOrderMinor caps a COD
  // order's total (null = no cap); codBlockedDistricts is a Json
  // array of district names COD is refused for; a COD order
  // above codAdvanceRequiredAboveMinor must collect an advance.
  codMaxOrderMinor              BigInt?
  codBlockedDistricts           Json?
  codAdvanceRequiredAboveMinor  BigInt?
  // AB4 (AX5a): REAL deposit/advance collection config. When
  // depositMode is "percent" (depositPercent 1–90) or "fixed"
  // (depositFixedMinor paisa), a checkout whose payment kind is
  // covered by depositAppliesTo (cod | online | all) owes that
  // amount before/at delivery; null mode = deposits OFF (the
  // GB3 stamp-only advance rule above is untouched by this).
  depositMode       String? // null (off) | percent | fixed
  depositPercent    Int?
  depositFixedMinor BigInt?
  depositAppliesTo  String  @default("cod") // cod | online | all
  depositNote       String?
  bkashNumber         String?
  nagadNumber         String?
  paymentNote         String?
  advancePaymentPercent Int?
  returnWindowDays    Int?
  // Milestone 77 (Business Command Center): owner-set AI
  // behaviour. Instructions steer style/conduct only — they
  // can never override the verified-facts discipline.
  aiInstructions      String?
  // CX2 (AI Instructions Desk): the persistent DRAFT working copy.
  // Consumers keep reading aiInstructions (the published text) only;
  // the draft reaches customers solely through an explicit publish.
  aiInstructionsDraft String?
  aiReplyLanguage     String?
  // SA-B4 (Smart AI Phase 0, P5/P6): AI learning toggles. The
  // BusinessProfile is where this org's AI settings already live
  // (aiInstructions, aiReplyLanguage), so the learning switches
  // live here too and ride the existing business-profile API.
  // Conversation mining is OPT-IN (plan decision D4): default
  // FALSE — no org's conversations are mined until the owner
  // turns it on. Website learning defaults TRUE but only ever
  // fetches the org's OWN public websiteUrl (its already-
  // published content) and only when a URL is set.
  conversationLearningEnabled Boolean @default(false)
  websiteLearningEnabled      Boolean @default(true)
  // SA-B13 (Smart AI Phase 2, W4): the per-org Answer Store
  // switch deferred from SA-B3/SA-B6. Default TRUE (the store
  // has ridden the autopilot gates since SA-B3). OFF means the
  // store is inert: lookup always misses (nothing is served)
  // and the automatic captures store nothing new. Rows already
  // stored are untouched, and the management surface
  // (list / status / delete in the Learn Dashboard) stays
  // available so the owner can still clean up while off.
  answerStoreEnabled          Boolean @default(true)
  // Billing Package B5: who receives invoices/reminders
  // (up to 3 extra emails) + the buyer block on invoices.
  billingEmails       Json?
  billingAddress      String?
  billingBin          String?
  // GB9 (GC21): merchant verification business facts —
  // the trade licence number + the registered business
  // address submitted for platform verification.
  tradeLicenseNo      String?
  businessAddress     String?
  // SaaS Multi-Tenant Merchant Growth Settings
  metaPixelId         String?      // Merchant's Facebook Pixel ID
  metaCapiToken       String?      // Merchant's Conversions API Token
  tikTokPixelId       String?      // Merchant's TikTok Pixel ID
  // DEPRECATED (ORG7, Organization Next OB2, 2026-10-16): this
  // field is NOT the merchant's custom domain — the live path is
  // Organization.customDomain (M59 branding → TD9 storefront
  // flow). A repo-wide audit (API + web + scripts + seeds) found
  // NO code that reads or writes BusinessProfile.customDomain:
  // UpdateBusinessProfileDto has no such field, no businessProfile
  // create/update/upsert carries it, and no select returns it.
  // The column is kept (not dropped) until production data is
  // checked: a future cleanup migration may drop it ONLY after
  // verifying on the real database that every row is NULL
  // (SELECT count(*) FROM "BusinessProfile" WHERE "customDomain"
  // IS NOT NULL must be 0). Do not write new code against it.
  customDomain        String?      // @deprecated — see note above; use Organization.customDomain
  // Campaign Builder Advanced CA13 (CB3): the org's campaign
  // naming template (tokens {product} {audience} {objective}
  // {date} {platform}), set in Organization Settings and
  // applied at plan/ad set/ad creation + via the explicit
  // preview-and-confirm rename action. Null = no convention,
  // names stay exactly as typed.
  campaignNamingTemplate String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Subscription {
  id               String             @id @default(uuid())
  organizationId   String
  plan             SubscriptionPlan   @default(FREE)
  status           SubscriptionStatus @default(TRIALING)
  currentPeriodEnd DateTime?
  // Billing Package B2: a downgrade (or FREE = cancel)
  // scheduled for the period end; the sweep applies it.
  pendingPlan      String?
  pendingPlanAt    DateTime?
  // Billing Package B3: the cycle the current period was
  // bought on — drives renewal price + proration length.
  billingCycle     String             @default("monthly")
  // GB9 (GC22): merchant/admin subscription pause. Paused <=>
  // pausedAt is set; the status vocabulary is unchanged.
  // While paused, commerce writes are refused (PlanLimit
  // choke points) until resume clears the stamp.
  pausedAt         DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model UsageRecord {
  id             String       @id @default(uuid())
  organizationId String
  metric         String
  quantity       Int          @default(1)
  recordedAt     DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, metric, recordedAt])
}

model AuditLog {
  id             String        @id @default(uuid())
  organizationId String?
  userId         String?
  action         String
  entityType     String
  entityId       String?
  metadata       Json?
  ipAddress      String?
  createdAt      DateTime      @default(now())
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
}

// ---------- Milestone 2: Business data ----------

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ImportJobStatus {
  PENDING
  COMPLETED
  FAILED
}

model Product {
  id             String        @id @default(uuid())
  organizationId String
  name           String
  slug           String?
  description    String?
  // AB6 (AX13): optional English alternates for the shop's
  // primary name/description. The primary fields are the shop's
  // main language; the En fields render ONLY when the shop
  // locale is "en" (fallback: the primary text). Both ride the
  // AX11 search vector.
  nameEn         String?
  descriptionEn  String?
  // AB6 (AX11): PostgreSQL full-text search vector over name /
  // nameEn / description / descriptionEn / SKUs (product +
  // variants) / category name / brand name, weighted A/B/C.
  // Maintained ONLY by raw SQL (products/search-vector.ts) —
  // never written through the Prisma client (Unsupported type).
  // Config 'simple': honest Bengali+English token matching, no
  // stemming claims.
  searchVector   Unsupported("tsvector")?
  category       String?
  sku            String?
  status         ProductStatus @default(ACTIVE)
  // Selling price in integer minor units (e.g. poisha for BDT, cents for USD)
  priceMinor     BigInt
  compareAtMinor BigInt?
  currency       String        @default("BDT")
  stockQuantity  Int?
  // Sales & Data S1: per-product low-stock alert threshold.
  // Null = the platform default (5, see InventoryService).
  lowStockThreshold Int?
  imageUrl       String?
  source         String        @default("manual") // manual | csv | woocommerce | shopify
  externalId     String?
  // SaaS eCommerce Expansion: 1-Click Order Bump & Upsells
  bumpTitle      String?       // e.g. "লেদার কি-রিং ও স্পেশাল পলিশ যোগ করুন"
  bumpPriceMinor BigInt?       // e.g. 19000 (190 BDT)
  bumpImageUrl   String?
  // EC3: physical dimensions, barcode and SEO enrichment for
  // catalog write-back. All additive + nullable; the legacy
  // `category String?` display field above stays untouched —
  // `categoryId`/`categoryRef` is the structured taxonomy link.
  weightGrams    Int?
  lengthCm       Int?
  widthCm        Int?
  heightCm       Int?
  barcode        String?
  seoTitle       String?
  seoDescription String?
  categoryId     String?
  // EC23: per-product VAT rate override in basis points
  // (1500 = 15.00%; fractional BD rates like 7.5% need bps —
  // whole-percent Int fields elsewhere cannot express them).
  // Null = fall back to the org TaxSetting default.
  taxRateBps     Int?
  // EC24a: pre-order. When enabled, checkout accepts the item
  // even at zero stock; those lines are stamped isPreorder and
  // do NOT decrement stock at placement (stock may not exist
  // yet). preorderLimit caps total open pre-ordered units.
  preorderEnabled     Boolean   @default(false)
  preorderReleaseDate DateTime?
  preorderLimit       Int?
  // AB2 (AX3): gift-card product. A flagged product sells stored
  // value, not stock: it is never out of stock, reserves nothing,
  // and its lines bypass stock checks (mirroring the preorder
  // bypass). giftCardConfig = { presetAmountsMinor: number[],
  // allowCustomAmount: boolean, minAmountMinor?, maxAmountMinor? }
  // — validated at save by commerce/gift-cards.ts; the chosen
  // amount on a cart line IS the issued card's face value (the
  // line's unit price). A gift-card product cannot itself be
  // bought WITH a gift card (checkout refuses — value loops).
  isGiftCard         Boolean  @default(false)
  giftCardConfig     Json?
  // EC24b: digital product. digitalFileUrl is a MERCHANT-hosted
  // URL (no file hosting is built); it is revealed only on
  // order-bound surfaces after delivery, never on public pages.
  digital            Boolean  @default(false)
  digitalFileUrl     String?
  digitalAccessLimit Int?
  // RB6/RM9: the SAME digital file hosted in the platform's OWN
  // private R2 bucket (the presign/complete upload flow in
  // ProductsService). Holds the storage KEY, never a URL — buyers
  // receive a short-lived presigned GET at reveal time (storefront
  // digitalAccess), so the object is never public. When set it
  // takes precedence over the merchant-hosted digitalFileUrl,
  // which stays as the merchant-hosted alternative.
  digitalStorageKey  String?
  // AB5 (AX9): what a delivered digital line hands the buyer —
  // "file" (signed expiring download, the pre-AB5 behaviour and
  // the default, so existing products are byte-identical),
  // "license" (assigned license keys from the product's pool),
  // or "both". Validated at product save.
  digitalDeliveryType String  @default("file")
  // AB5 (AX9): signed-download token lifetime in hours for this
  // product; null = the platform default (72h).
  digitalLinkExpiryHours Int?
  // EC24c: subscription plan (COD/manual renewal ONLY — no
  // payment gateway auto-charge exists or is implied).
  subscriptionEnabled         Boolean @default(false)
  subscriptionIntervalDays    Int?
  subscriptionDiscountPercent Int?
  // EC24d: wholesale price tiers [{ minQty, priceMinor }] —
  // server-validated, ascending unique minQty.
  wholesaleTiers      Json?
  // Feature 6: Predictive Replenishment & Auto Re-order
  replenishmentDays         Int?      // Estimated consumption cycle in days (e.g. 30, 45, 60)
  replenishmentReminderText String?   // Personalized SMS/WhatsApp template or offer
  // GB1 (GC4): optional product video (YouTube/Vimeo/mp4/webm URL
  // + optional poster). Normalized server-side at public read;
  // unrecognizable URLs serialize as no video.
  videoUrl            String?
  videoPosterUrl      String?
  // GB2 (GC6): brand link (Brand delete nulls this — SetNull) and
  // the per-product free-shipping flag. The flag's delivery
  // semantics live in the ONE resolver (StorefrontService
  // .resolveDeliveryCharge): free-shipping lines are excluded
  // from the EC30 weight population, and a cart whose every
  // product line is free-shipping pays no zone/rule charge.
  brandId             String?
  freeShipping        Boolean   @default(false)
  // GB2 (GC7): out-of-stock staff-alert stamp. Set when the
  // >0 → 0 alert fires for this row; cleared back to null by any
  // stock write landing above zero (the re-arm). See
  // InventoryService.maybeOutOfStockAlert.
  lastOosNotifiedAt   DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  categoryRef    Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brand          Brand?        @relation(fields: [brandId], references: [id], onDelete: SetNull)
  variants       ProductVariant[]
  costs          ProductCost[]
  listings       StoreListing[]
  images         ProductImage[]
  tagAssignments ProductTagAssignment[]
  dropshipOffers DropshipOffer[]
  bundleItems    BundleItem[]  @relation("BundleParent")
  bundleComponentIn BundleItem[] @relation("BundleComponent")
  storeCartItems StoreCartItem[]
  purchaseOrderItems PurchaseOrderItem[]
  binAssignments     ProductBinAssignment[]
  stockCountLines    StockCountLine[]
  stockBalances      StockBalance[]
  customerSubscriptions CustomerSubscription[]
  liveSessionProducts LiveSessionProduct[]
  videoProjects VideoProject[]

  @@unique([organizationId, sku])
  @@index([organizationId, status])
  @@index([organizationId, category])
  @@index([organizationId, updatedAt(sort: Desc)])
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([brandId])
  // AB6 (AX11): GIN index backing the FTS shop search.
  @@index([searchVector], type: Gin)
}

model ProductVariant {
  id            String  @id @default(uuid())
  productId     String
  name          String // e.g. "Red / XL"
  sku           String?
  priceMinor    BigInt?
  stockQuantity Int?
  attributes    Json?
  // GB2 (GC7): out-of-stock alert stamp — see Product.lastOosNotifiedAt.
  lastOosNotifiedAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  product       Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  storeCartItems StoreCartItem[]

  @@unique([productId, sku])
  @@index([productId])
}

model ProductCost {
  id             String   @id @default(uuid())
  productId      String
  variantId      String?
  // Unit cost in integer minor units, same currency as the product price
  costMinor      BigInt
  currency       String   @default("BDT")
  effectiveFrom  DateTime @default(now())
  note           String?
  createdAt      DateTime @default(now())
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, effectiveFrom])
}

// EC3: additional product gallery images. The legacy single
// `Product.imageUrl` stays as the primary/cover image; rows here
// are the ordered extra gallery.
model ProductImage {
  id        String   @id @default(uuid())
  productId String
  url       String
  altText   String?
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
}

// EC3: structured product taxonomy (tree). Replaces free-text
// categorisation for write-back; Product.category stays as the
// legacy display string.
// GB2 (GC6): merchant brand registry. Products link via
// Product.brandId (SetNull on brand delete — the service also
// nulls explicitly so the count lands in the delete audit).
// slug is unique per org and powers the public shop brand page.
model Brand {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  slug           String
  logoUrl        String?
  description    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products       Product[]

  @@unique([organizationId, slug])
  @@index([organizationId])
}

model Category {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  slug           String
  parentId       String?
  description    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent         Category?    @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children       Category[]   @relation("CategoryTree")
  products       Product[]

  @@unique([organizationId, slug])
  @@index([organizationId, parentId])
}

// EC3: org-scoped product tags.
model ProductTag {
  id             String                 @id @default(uuid())
  organizationId String
  name           String
  slug           String
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignments    ProductTagAssignment[]

  @@unique([organizationId, slug])
}

// EC3: join row between Product and ProductTag.
model ProductTagAssignment {
  id        String     @id @default(uuid())
  productId String
  tagId     String
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag       ProductTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([productId, tagId])
  @@index([tagId])
}

// Feature 6: Predictive Replenishment & Auto Re-order Cycle
// Anticipates when a customer's consumable product is about to run out
// and triggers personalized reorder reminders before they buy from competitors.
model PredictiveReplenishment {
  id                String    @id @default(uuid())
  organizationId    String
  customerId        String?
  customerName      String
  customerPhone     String
  orderId           String    // Original purchase order
  productId         String?
  productName       String
  deliveredAt       DateTime
  replenishmentDays Int
  predictedDate     DateTime  // deliveredAt + replenishmentDays
  status            String    @default("PENDING") // PENDING | DUE | REMINDED | REORDERED | EXPIRED
  lastRemindedAt    DateTime?
  reorderOrderId    String?   // Order placed from this reminder
  discountCode      String?
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([organizationId, status])
  @@index([organizationId, predictedDate])
  @@index([organizationId, customerPhone])
}

model BusinessPolicy {
  id             String       @id @default(uuid())
  organizationId String
  // shipping | delivery | refund | return | cancellation | payment | custom
  type           String
  title          String
  content        String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, type])
}

model KnowledgeDocument {
  id             String       @id @default(uuid())
  organizationId String
  title          String
  content        String
  kind           String       @default("faq") // faq | note | claim | template | file_doc | website (SA-B4: the org's own site, learned by WebsiteLearningService)
  // SA-B1 (Smart AI Phase 0, P3): disclosure class for AI audiences —
  // public = may be quoted to a customer; internal = org team only,
  // never enters a customer-audience AI context (Master Plan law L3).
  // Schema default stays "public" (the behaviour existing rows had);
  // the note-kind default-to-internal rule lives in the service layer.
  visibility     String       @default("public") // public | internal
  source         String       @default("paste") // paste | file:<original filename> (CX9)
  // Owner CX9 variant: chunked file-ingestion tracking (his series)
  sourceFile     String?
  chunkIndex     Int?
  totalChunks    Int?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, kind])
}

// SA-B2 (Smart AI Phase 0, P2): pgvector embedding rows for hybrid
// (semantic + keyword) retrieval in OrgBrainService. One row per
// indexed chunk of a source document:
//   sourceType "knowledge_chunk" — sourceId = KnowledgeDocument.id,
//     chunkIndex = the sub-chunk of that document's content built
//     at index time (paste documents are not pre-chunked; uploaded
//     files arrive as per-chunk documents already).
//   sourceType "product" — sourceId = Product.id, chunkIndex 0,
//     content = name + description + category text (never price or
//     stock: those facts are always read live, law L4).
// The embedding column is UNTYPED vector on purpose: providers
// return different dimensions, so each row carries its own
// provider/model/dimension and search filters to the query's
// model + dimension. The column is Unsupported in Prisma (the
// Product.searchVector precedent): every vector read/write goes
// through raw SQL in PgVectorStore; the Prisma client is used
// only for the metadata columns. `visibility` is a SNAPSHOT of
// the source's disclosure class at index time — the audience
// filter runs on it in SQL, so an internal chunk can never be
// returned to a customer audience even by the vector path (L3);
// re-indexing refreshes the snapshot. organizationId is on every
// row and in every query (L1).
model KnowledgeEmbedding {
  id             String       @id @default(uuid())
  organizationId String
  sourceType     String // knowledge_chunk | product
  sourceId       String
  chunkIndex     Int          @default(0)
  content        String
  contentHash    String
  provider       String
  model          String
  dimension      Int
  embedding      Unsupported("vector")?
  visibility     String       @default("public") // public | internal (snapshot)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, sourceType, sourceId])
  @@index([organizationId, contentHash])
  @@index([organizationId, model])
}

// SA-B3 (Smart AI Phase 0, P4): the Answer Store — verified
// question -> answer pairs the Brain may serve WITHOUT an LLM
// call (Master Plan P4). An entry is stored only after a grounded
// autopilot answer passed the fact pack + the deterministic
// number guard (or a staff member edited and sent an autopilot
// draft); it is served only after its sources are re-checked
// against LIVE data (a stored answer never beats live data —
// law L4). INTERNAL and CUSTOMER-OWN/personal answers are never
// stored (law L3). The embedding column follows the
// KnowledgeEmbedding precedent exactly: untyped vector, each row
// records its own provider/model/dimension, the vector itself is
// written/read only via raw SQL in AnswerStoreService. Rows
// stored while embeddings were unavailable carry NULL
// provider/model/dimension/embedding and are reachable only by
// exact normalized-question match (recorded in the SA-B3
// acceptance doc).
model AiStoredAnswer {
  id                 String       @id @default(uuid())
  organizationId     String
  normalizedQuestion String
  questionText       String
  answerText         String
  channel            String       @default("inbox") // inbox (comment lands in Phase 1)
  language           String? // bn | en | mixed (detected at store time)
  // Grounded sources, normalized at store time:
  // { docIds: string[], products: { id, name }[],
  //   policyIds: string[], profileAreas: string[] }
  sourceRefs         Json?
  containsLiveFacts  Boolean      @default(false)
  status             String       @default("active") // active | invalidated | disabled
  invalidReason      String? // source_doc_changed | source_doc_removed | source_doc_reclassified | source_policy_changed | source_policy_removed | source_profile_changed | product_unavailable | product_changed | live_facts_changed | number_guard_failed
  origin             String // autopilot_grounded | staff_approved | staff_edited
  hitCount           Int          @default(0)
  lastHitAt          DateTime?
  // When the CURRENT answerText was grounded/stored. Hit writes
  // never touch it (updatedAt moves on every hit) — source
  // freshness is compared against this stamp.
  groundedAt         DateTime
  provider           String?
  model              String?
  dimension          Int?
  embedding          Unsupported("vector")?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, normalizedQuestion, channel])
  @@index([organizationId, status])
  @@index([organizationId, model])
}

// SA-B4 (Smart AI Phase 0, P5/P6): a piece of knowledge the Brain
// MINED from a source (conversation, unanswered-question cluster,
// product record, website) but has NOT been allowed to use yet.
// Law D3: self-learned = suggestion only — a row sits at status
// "suggested" until a human approves it, at which point the
// LearningService applies it (Answer Store or KnowledgeDocument)
// and records where it landed in appliedRef. PII is scrubbed
// BEFORE anything reaches this table (law L3); content never
// carries customer-personal data.
model LearnedItem {
  id             String    @id @default(uuid())
  organizationId String
  kind           String // faq_pair | fact | product_note
  title          String
  // faq_pair: { question, answer } · fact: { text } ·
  // product_note: { text, productId? }
  content        Json
  sourceType     String // conversation | unanswered | website | product | performance (SA-B5)
  // Ids of the source rows it was mined from (conversation ids,
  // AiUnansweredQuestion id, product id, page URL) — Json array.
  sourceRef      Json?
  status         String    @default("suggested") // suggested | approved | rejected
  reviewedById   String?
  reviewedAt     DateTime?
  // SA-B23: WHERE the review happened — "org" (the tenant's
  // own queue) or "admin_console" (a SUPER admin deciding from
  // the platform console). reviewedById alone cannot carry
  // this: the same person can be both org staff and platform
  // admin, so the via is stamped structurally at decision time.
  reviewedVia    String?
  // Where approval applied it: "answer:<AiStoredAnswer id>" or
  // "knowledge:<KnowledgeDocument id>"; null until approved.
  appliedRef     String?
  // sha256 over org + kind + normalized payload; the unique key
  // is the dedupe wall against re-mining the same suggestion.
  dedupeKey      String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, dedupeKey])
  @@index([organizationId, status])
  @@index([organizationId, sourceType])
}

// SA-B4: durable per-org learning-run state — the mining/refresh
// watermark and the last run's honest summary. One row per
// (organization, source): "conversation" | "website" |
// "performance" | "brand_voice" (SA-B5).
model LearningState {
  id             String    @id @default(uuid())
  organizationId String
  source         String // conversation | website
  // Conversation mining: only conversations resolved after this
  // stamp are considered on the next run. Website: last refresh.
  watermark      DateTime?
  lastRunAt      DateTime?
  lastStatus     String? // ok | skipped | failed (with lastDetail)
  lastDetail     Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, source])
}

// SA-B22 (Smart AI Phase 6, T1): platform-wide TEACHING written
// by SUPER admins in the Admin Training Console — general style /
// policy / how-to guidance that applies to EVERY org's Brain.
// It is PLATFORM scope: no organizationId, deliberately. The
// closed precedence decision (plan D8) is structural: teaching
// rides the Brain's GUIDANCE channel (the OrgBrainContext
// .platformGuidance block, rendered after every org section and
// labelled as yielding to the org's own facts/instructions) and
// NEVER the facts channel — it is not a source of facts about
// any shop, its numbers never enter a fact pack, and the Answer
// Store cannot ground on it. One text + language (the house
// i18n shape, cf. BusinessProfile.aiReplyLanguage).
model PlatformTeaching {
  id          String   @id @default(uuid())
  title       String
  content     String
  language    String   @default("bn") // bn | en | mixed
  kind        String   @default("guidance") // style | policy | guidance
  enabled     Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([enabled, sortOrder])
}

// SA-B5 (Smart AI Phase 0, P7): performance learning — a
// deterministic snapshot of what actually happened in one period
// (inbox outcomes, chat orders, best-sellers, returns, reviews,
// ad campaigns, broadcasts, social posts), computed from live
// rows by PerformanceLearningService. NO LLM ever writes here:
// every number is an aggregate of real rows, labelled with its
// period. INTERNAL class (plan law L3): snapshots are served
// only to the internal Brain audience — order counts, revenue
// and campaign performance never enter a customer context.
// One row per (organization, period); recomputation upserts the
// same key, so a re-run corrects rather than duplicates.
model PerformanceSnapshot {
  id             String   @id @default(uuid())
  organizationId String
  periodStart    DateTime
  periodEnd      DateTime
  // { windowDays, inbox{...}, sales{...}, ads{...},
  //   broadcasts{...}, social{...} } — money as minor-unit
  //   strings (BigInt-safe), rates as numbers or null.
  metrics        Json
  computedAt     DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, periodStart, periodEnd])
  @@index([organizationId, periodEnd])
}

// SA-B5 (Smart AI Phase 0, P8a): the org's LEARNED brand voice —
// style traits summarised by the org's own LLM from its STAFF's
// sent messages (PII-masked before any call), behind the same
// D4 conversation-learning opt-in as mining. Plan decision D3:
// the learned profile is a SUGGESTION — it shapes nothing until
// a human activates it. While a profile is "active", a newer
// learning run never overwrites the live traits: its proposal
// waits in pendingTraits/pendingExamples until a human promotes
// it (activation) or dismisses it. Style is BEHAVIOUR, never
// facts: consumers inject it as wording guidance only, and the
// owner's explicit BusinessProfile.brandVoice text takes
// precedence wherever the two conflict.
model AiBrandVoiceProfile {
  id               String   @id @default(uuid())
  organizationId   String   @unique
  // { formality, emojiUse, greetingStyle, languageMix,
  //   avgSentence, signaturePhrases[] } — closed vocabularies,
  //   validated again at write time (never trusted raw).
  traits           Json
  // Scrubbed staff-message excerpts the traits were derived
  // from — each one verified a verbatim substring of a masked
  // sample before it may be stored.
  exampleSnippets  Json     @default("[]")
  pendingTraits    Json?
  pendingExamples  Json?
  status           String   @default("suggested") // suggested | active
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// SA-B5 (Smart AI Phase 0, P8b): per-customer memory — the
// commerce facts the Brain may use when talking to THIS
// customer again: the language they write in, the products they
// asked about or bought, their order count. CUSTOMER-OWN class
// (plan law L3): a memory is served only inside that same
// customer's own conversation context (Brain audience
// "own_customer", or an internal context explicitly carrying
// their key) — never to another customer, never into a plain
// customer context. Facts only, written deterministically (no
// LLM): no inferred traits, nothing beyond commerce. The key is
// the conversation identity the org already holds —
// "<channel>:<externalContactId>" (WhatsApp wa_id / Messenger
// PSID); the limit is recorded: one human on two channels is
// two memories, because no cross-channel identity exists.
model CustomerMemory {
  id               String    @id @default(uuid())
  organizationId   String
  customerKey      String
  displayName      String?
  languagePref     String? // bn | en | mixed (observed, never guessed)
  // [{ productId, name, via: "asked" | "ordered" }]
  topics           Json      @default("[]")
  orderCount       Int       @default(0)
  lastOrderAt      DateTime?
  // [{ kind: "outcome" | "csat", text, conversationId, at }] —
  // system-generated commerce facts only, each carrying the
  // conversation it came from, PII-screened before storage.
  notes            Json      @default("[]")
  lastInteractionAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, customerKey])
  @@index([organizationId, lastInteractionAt])
}

model ImportJob {
  id             String          @id @default(uuid())
  organizationId String
  kind           String          @default("products") // products (orders in a later milestone)
  status         ImportJobStatus @default(PENDING)
  fileName       String?
  totalRows      Int             @default(0)
  successRows    Int             @default(0)
  failedRows     Int             @default(0)
  skippedRows    Int             @default(0)
  errors         Json?
  createdById    String?
  createdAt      DateTime        @default(now())
  completedAt    DateTime?
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

// ---------- Milestone 3: Stores, integrations, ecommerce ----------

enum StorePlatform {
  WOOCOMMERCE
  SHOPIFY
  CUSTOM
}

enum IntegrationStatus {
  CONNECTED
  DISCONNECTED
  ERROR
}

enum SyncJobStatus {
  RUNNING
  COMPLETED
  FAILED
}

model Store {
  id             String        @id @default(uuid())
  organizationId String
  platform       StorePlatform @default(WOOCOMMERCE)
  name           String
  url            String
  currency       String        @default("BDT")
  timezone       String        @default("Asia/Dhaka")
  isActive       Boolean       @default(true)
  trackingKey    String?       @unique // public key used by tracker.js, not a secret
  // EC1: how much control the SaaS has over this store.
  // mirror = inbound only (the pre-EC1 behaviour, default for every
  // existing store) | co-manage = order-side pushes | full-manage =
  // catalog/price/stock pushes too. Changing it is OWNER/ADMIN-only
  // and audit-logged (see CommerceService.updateSyncMode).
  syncMode       String        @default("mirror")
  // EC1: optional per-field source-of-truth overrides, e.g.
  // { "price": "saas", "stock": "saas", "description": "store" }.
  // Null = the sync mode's defaults. Read by EC3 conflict logic.
  fieldOwnership Json?
  // EC5: refund push to the store platform is a money-adjacent
  // capability — DEFAULT OFF (plan §9 owner decision). Only when an
  // OWNER turns this on does recording a refund locally enqueue a
  // platform refund. Default false is part of the safety contract.
  refundPushEnabled Boolean @default(false)
  // NF7 (FB3): refund-to-store-credit is a money instrument —
  // DEFAULT OFF, in the same per-store refund settings area as
  // refundPushEnabled above (owner decision 2026-10-13: refund
  // features stay opt-in). Only when an OWNER turns this on does
  // the refund flow offer store credit at all; the API refuses a
  // refund-to-credit attempt while it is off. For orders with no
  // linked Store (native shop orders), the gate reads "any store
  // of the org has it on" — see StoreCreditService.
  refundToCreditEnabled Boolean @default(false)
  // EC5: name of the meta_data key the store's shipment/tracking
  // plugin reads (e.g. an AST-style plugin). Null = only the generic
  // tracking_provider/tracking_number meta keys + customer note.
  courierTrackingMetaKey String?
  // CP: the store's own weight unit (g | kg | lb | oz), read
  // from the Woo settings endpoint (woocommerce_weight_unit)
  // when fetchable, else staff-set. Null = legacy kg assumption.
  // Product push converts Product.weightGrams into this unit.
  weightUnit     String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  integrations   Integration[]
  orders         Order[]
  listings       StoreListing[]
  locations      StoreLocation[]
  taxonomyMaps   StoreTaxonomyMap[]
  customerIdentities CustomerStoreIdentity[]
  discountSyncs      StoreDiscountSync[]
  abandonedCheckouts AbandonedStoreCheckout[]

  @@index([organizationId])
}

model Integration {
  id             String            @id @default(uuid())
  organizationId String
  storeId        String?
  provider       String // woocommerce | meta | google_ads | tiktok | whatsapp
  status         IntegrationStatus @default(DISCONNECTED)
  externalAccountId String?
  lastSyncAt     DateTime?
  productsCursor DateTime?
  ordersCursor   DateTime?
  lastError      String?
  // EC2: last webhook registration/subscription attempt, recorded
  // verbatim per topic ({ provider, topics: {topic: {status, error?}},
  // updatedAt }). This is a RECORD of an attempt — a topic counts as
  // registered only when its status says so; never inferred.
  webhookStatus  Json?
  // EC22: optional courier tracking URL template for THIS account,
  // e.g. "https://courier.example/track/{trackingId}". Not a secret
  // (shown to staff, used to build customer-facing links), so it
  // lives outside the encrypted credential blob. Null = fall back
  // to the built-in per-provider behaviour (today: no URL).
  trackingUrlTemplate String?
  // EC2: how this integration authenticated. Null = the pre-EC2
  // legacy token path (Woo keys / Shopify shpat_ token).
  // "client_credentials" = Shopify Dev Dashboard grant (token
  // expires; tokenExpiresAt drives the refresh in ShopifyService).
  authType       String?
  tokenExpiresAt DateTime?
  // CC2 (Connect Center): tenant-picked default connection within
  // its category group (e.g. the default WhatsApp number). Set via
  // PATCH organizations/:id/connections/:integrationId/default,
  // which clears the flag on sibling rows of the same org+category.
  isDefault      Boolean           @default(false)
  // CC3/CC4 (Connect Center): which app this connection was made
  // through — "platform" (the operator's app, the default for every
  // pre-CC3 row) or "own" (the tenant's own app, configured via
  // TenantAppConfig). Webhook verification and OAuth token refresh
  // resolve their app secret from the matching source.
  appSource      String            @default("platform")
  // CC14/CC15 (Connect Center Advanced): the provider's OWN health
  // report for this connection, fetched live from the provider
  // (WhatsApp phone-number quality/limit + WABA review status;
  // Meta Page asset completeness) and stored VERBATIM — a field
  // the provider did not return stays absent from the snapshot,
  // never 0 and never estimated. providerHealthAt moves ONLY on
  // a successful fetch; a failed fetch sets providerHealthError
  // and leaves the old snapshot + timestamp untouched, so stale
  // values can never masquerade as fresh.
  providerHealth    Json?
  providerHealthAt  DateTime?
  providerHealthError String?
  // CC17 (Connect Center Advanced): tenant-chosen display label
  // (AD6 semantics: free text, trimmed, ≤60 chars service-side;
  // null/empty = fall back to the provider name) and a free-text
  // group name (brand/branch grouping in the Connect Center —
  // deliberately NOT a separate Group entity; grouping is a
  // display concern over a string the tenant controls).
  label             String?
  groupName         String?
  // CC18: tenant-paused sync for THIS connection. The sync
  // entry points (manual triggers + scheduled store/channel
  // jobs) skip a paused integration and record the skip; ad
  // accounts keep their own AD5 syncDisabled flag instead.
  syncPaused        Boolean           @default(false)
  // CC21 (Connect Center Next): tenant opt-out for the
  // monitoring sweep's AUTO-HEALING (today: commerce webhook
  // re-registration through the CC16/EC2 registrars). Default
  // true = healing allowed; false = the sweep detects and
  // alerts exactly as before but never attempts a repair on
  // this connection. Detection itself is never disabled.
  autoHealEnabled   Boolean           @default(true)
  // CC30 (Connect Center Next): per-connection sync cadence for
  // SCHEDULED store syncs — the minimum minutes between two
  // scheduled syncs of the same kind for THIS connection. Null =
  // no cadence (today's behaviour: every scheduled job run
  // syncs). Manual sync triggers ignore the cadence entirely (a
  // human asking now means now); CC18's syncPaused still wins
  // over the cadence. Enforced in the scheduled path only — see
  // integrations/sync-cadence.ts.
  syncIntervalMinutes Int?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  store          Store?            @relation(fields: [storeId], references: [id], onDelete: SetNull)
  credential     IntegrationCredential?
  syncJobs       SyncJob[]
  webhookEvents  WebhookEvent[]

  @@index([organizationId, provider])
  @@index([storeId])
}

// Secrets are stored ONLY as AES-256-GCM ciphertext (see integrations/crypto.ts).
// Plaintext consumer keys/secrets never touch the database or API responses.
model IntegrationCredential {
  id            String      @id @default(uuid())
  integrationId String      @unique
  encryptedData String // JSON payload, encrypted
  keyVersion    Int         @default(1)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
}

// CC3 (Connect Center): the tenant's OWN developer app for a
// platform — one row per (org, platform). This is the "own app"
// half of the Connect Center's two app paths: connections made
// with appSource="own" resolve their app secret / OAuth client
// credentials from here instead of the operator's platform app.
//
// platform: "meta" (appId = Meta app id, secret = app secret) |
//           "tiktok" (appId = TikTok client key, secret = client
//           secret).
// status: "verified" — a REAL platform call confirmed the
//         credentials before saving (Meta: Graph API app lookup
//         with the app access token).
//         "configured" — saved WITHOUT a platform confirmation.
//         TikTok offers no credential-check endpoint usable
//         without a user authorization code (its OAuth token
//         endpoint requires a code or refresh token), so TikTok
//         configs are honestly "configured" — verification
//         happens at the first OAuth connect, when the token
//         exchange succeeds or fails with TikTok's own error.
// The secret is stored ONLY as AES-256-GCM ciphertext (the
// { appSecret } payload sealed via integrations/crypto.ts
// encryptJson, MessagingSenderConfig pattern) and is never
// returned by any API.
model TenantAppConfig {
  id              String       @id @default(uuid())
  organizationId  String
  platform        String // meta | tiktok | google | linkedin (CC28: google + linkedin own-app configs)
  appId           String // Meta app id | TikTok client key
  encryptedSecret String // sealed JSON: { appSecret }
  status          String       @default("configured") // verified | configured
  lastVerifiedAt  DateTime?
  lastError       String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, platform])
  @@index([organizationId])
}

// CC8 (Connect Center, Senders + AI keys): the tenant's OWN LLM
// configuration — one per organization. When present and enabled,
// AI calls that carry an organizationId resolve through THIS
// provider+key (tenant key wins over the platform LLM for that
// org); every other org keeps the platform-config resolution.
// Verify-before-save: the row is written only after a REAL minimal
// completion through the chosen provider succeeded (status
// "verified"); a failed check saves nothing. The API key is
// stored ONLY as AES-256-GCM ciphertext (the { apiKey } payload
// sealed via integrations/crypto.ts encryptJson, TenantAppConfig
// pattern) and is never returned by any API.
model OrgLlmConfig {
  id              String       @id @default(uuid())
  organizationId  String       @unique
  provider        String // openai | anthropic | gemini
  model           String?
  encryptedData   String // sealed JSON: { apiKey }
  status          String       @default("configured") // verified | configured
  isEnabled       Boolean      @default(true)
  lastVerifiedAt  DateTime?
  lastError       String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// CC9 (Connect Center, tenant's OWN payment gateway): the tenant's
// own online gateway credentials — money settles DIRECTLY to the
// tenant's merchant account; the platform never holds these funds
// (platform payment + wallet is CC10, a separate model family).
// One row per (org, provider). Verify semantics are per-provider
// and honest (see connections service): bKash rows exist only
// after a REAL grant-token call succeeded ("verified");
// SSLCommerz offers NO pre-transaction credential check (its
// validation API needs a val_id from a real transaction), so its
// rows are "configured"; Nagad likewise has no check wired in
// this codebase and saves as "configured". Credentials are
// stored ONLY as AES-256-GCM ciphertext (sealed JSON via
// integrations/crypto.ts encryptJson) and never returned by APIs.
model TenantPaymentGateway {
  id              String       @id @default(uuid())
  organizationId  String
  provider        String // sslcommerz | bkash | nagad (rocket is manual-number only — BusinessProfile path, never an API gateway here)
  // CC19: which credential set this row is — "live" (production;
  // the only set real checkout/IPN flows may resolve) or
  // "sandbox" (the gateway's test environment; used by the
  // Doctor's checks and the clearly-labelled test initiation,
  // whose transactions can NEVER pay a real order). Pre-CC19
  // rows are "live"; a row whose sealed creds carry sandbox=true
  // from the CC9 form keeps working as live-with-sandbox-creds
  // exactly as before (the creds-level flag still picks the
  // gateway host) — the column governs row SELECTION.
  environment     String       @default("live") // live | sandbox
  encryptedData   String // sealed JSON credentials (shape per provider)
  status          String       @default("configured") // verified | configured
  isEnabled       Boolean      @default(true)
  // GC12: the MERCHANT's own gateway-contract fee numbers (NOT
  // part of the sealed creds — plain columns so fee reporting
  // never has to decrypt). Both null = no fee rate configured;
  // fee reporting then leaves fee/net null, never invented.
  feeBps          Int?
  feeFixedMinor   BigInt?
  lastVerifiedAt  DateTime?
  lastError       String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transactions    TenantPaymentTransaction[]

  @@unique([organizationId, provider, environment])
  @@index([organizationId])
}

// CC9: one payment attempt through a tenant's OWN gateway for one
// order. A transaction becomes "verified_paid" ONLY on a
// server-side verified gateway confirmation (SSLCommerz
// validation API via the IPN's val_id / bKash execute+query) with
// exact amount + currency match — a browser return NEVER moves
// it. ipnPayload keeps the verified gateway payload as evidence.
model TenantPaymentTransaction {
  id              String       @id @default(uuid())
  organizationId  String
  gatewayId       String? // null for CC10 platform transactions (no tenant gateway row exists)
  orderId         String
  provider        String // sslcommerz | bkash | nagad
  // CC10: whose gateway carried this payment. "own" = the
  // tenant's own gateway (CC9; money settles directly to the
  // tenant). "platform" = the platform's gateway (CC10; money
  // lands in the platform account and the net amount is credited
  // to the tenant's Wallet — see WalletAccount).
  source          String       @default("own") // own | platform
  // CC19: the gateway environment that carried this transaction.
  // "sandbox" rows come only from the labelled test initiation
  // against a sandbox credential set; the verified-confirmation
  // paths refuse to transition any real order (or credit any
  // wallet) for a sandbox transaction.
  environment     String       @default("live") // live | sandbox
  amountMinor     BigInt
  currency        String       @default("BDT")
  status          String       @default("initiated") // initiated | verified_paid | failed | cancelled
  // AB4 (AX5a): what this attempt pays toward — "full" (the
  // whole order total; every pre-AB4 row), "deposit" (the
  // order's configured deposit slice) or "balance" (the
  // remaining amount after earlier verified payments).
  // Settlement is ALWAYS judged by Σ verified amounts vs the
  // order total; purpose only labels intent + drives the
  // deposit bookkeeping below.
  purpose         String       @default("full") // full | deposit | balance
  // AB4 (AX5a): exactly-once claim for the approved
  // PaymentVerification row a verified DEPOSIT writes into the
  // order's canonical paid sum (source "gateway_deposit"). Set
  // via a conditional updateMany (the failureNotifiedAt idiom)
  // before the row is created, so an IPN re-delivery can never
  // double-count a deposit. Null for non-deposit transactions.
  depositVerificationId String?
  // GB9 (GC23): staff payment-failure alert dedupe stamp —
  // set when the failure-conclusion alert has been claimed
  // for this attempt (exactly one alert opportunity).
  failureNotifiedAt DateTime?
  providerTxnId   String? // SSLCommerz tran_id (ours) | bKash paymentID
  valId           String? // SSLCommerz validation id, kept as evidence
  ipnPayload      Json? // the verified gateway payload (evidence)
  // CC23 (Connect Center Next): append-only record of REJECTED
  // gateway notifications against this transaction —
  // [{ kind: "signature_invalid" | "amount_mismatch", at, detail }]
  // — written by the IPN/callback paths when a notification
  // fails the signature check or the gateway-confirmed amount
  // does not match this transaction. Verified payloads keep
  // living in ipnPayload; this list exists so the CC23 anomaly
  // counter has real recorded events to count (before CC23 a
  // rejected IPN left no trace at all). Capped at the last 50
  // entries by the writer; never contains credential material.
  ipnEvents       Json?
  // GC12: payment-ops bookkeeping — failureReason is written
  // failure-isolated alongside a failed/cancelled recording
  // (never breaks the payment path); feeMinor/netMinor are
  // stamped ONLY at verified_paid (own path: from the gateway
  // row's feeBps/feeFixedMinor when either is set; platform
  // path: from the wallet credit's fee). Both stay null when
  // no fee rate is known — never invented.
  failureReason   String?
  feeMinor        BigInt?
  netMinor        BigInt?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  gateway         TenantPaymentGateway? @relation(fields: [gatewayId], references: [id], onDelete: Cascade)
  refunds         PaymentRefund[]

  @@index([organizationId, orderId])
  @@index([providerTxnId])
}

// CC10 (Connect Center, Platform Payment + Wallet): the tenant's
// choice to accept PLATFORM-gateway payments, per provider. The
// platform's own credentials live ONLY in the admin platform
// config (sslcommerzConfig / bkashConfig) — this row stores NO
// secret, just the tenant's enablement. A provider can only be
// enabled when the platform actually has that gateway configured;
// the service refuses otherwise (no fake checkout).
model PlatformPaymentEnablement {
  id             String       @id @default(uuid())
  organizationId String
  provider       String // sslcommerz | bkash (the providers the platform checkout wires)
  isEnabled      Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider])
  @@index([organizationId])
}

// CC10: one tenant's platform-payment wallet. balanceMinor is a
// cached projection of the WalletTransaction ledger — every
// change to it happens in the SAME database transaction as the
// ledger row(s) that justify it, and it can never go negative
// (enforced in the wallet service; there is no endpoint by which
// a tenant can create a credit).
model WalletAccount {
  id             String       @id @default(uuid())
  organizationId String       @unique
  currency       String       @default("BDT")
  balanceMinor   BigInt       @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transactions   WalletTransaction[]
  payoutRequests PayoutRequest[]

  @@index([organizationId])
}

// CC10: append-only wallet ledger. amountMinor is SIGNED
// (credits positive, debits negative); balanceAfterMinor is the
// wallet balance immediately after this row — the pair (signed
// amounts, running balance) makes every balance auditable.
// Rows are never updated or deleted by any service path.
model WalletTransaction {
  id                String       @id @default(uuid())
  organizationId    String
  walletId          String
  type              String // payment_credit | fee_debit | payout_debit | refund_debit | adjustment
  amountMinor       BigInt // signed
  balanceAfterMinor BigInt
  refType           String? // e.g. tenant_payment_transaction | payout_request
  refId             String?
  note              String?
  createdById       String? // set for admin adjustments (the acting admin's user id)
  createdAt         DateTime     @default(now())
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  wallet            WalletAccount @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([walletId, createdAt])
  @@index([refType, refId])
}

// CC10: a tenant's request to withdraw wallet balance. While a
// request is pending (or approved-but-unpaid) its amount is HELD:
// available balance = wallet balance − Σ(held amounts), so two
// requests can never jointly exceed the balance. Money leaves
// the wallet ONLY at admin mark-paid, which appends the
// payout_debit ledger row and decrements the balance exactly
// once, inside one transaction. destination holds the tenant's
// payout details (bKash number / bank account) — sensitive,
// tenant-scoped, never exposed to other tenants.
model PayoutRequest {
  id             String       @id @default(uuid())
  organizationId String
  walletId       String
  amountMinor    BigInt
  method         String // bkash | bank
  destination    Json // tenant-entered payout details (sensitive)
  status         String       @default("pending") // pending | approved | paid | rejected | cancelled
  adminNote      String?
  payoutRef      String? // reference the admin records when actually paying out
  requestedById  String
  decidedById    String? // admin who approved/rejected/marked paid
  // CC23 (Connect Center Next): the admin who APPROVED this
  // request, recorded at approve time (decidedById is
  // overwritten by later decisions, so four-eyes needs its own
  // column). Null on rows never approved — including every
  // pre-CC23 row, for which four-eyes cannot apply (no approver
  // was ever recorded).
  approvedById   String?
  // CC26 (Connect Center Next): when the request was made
  // against a saved PayoutDestination, its id; the destination
  // DETAILS are still snapshotted into `destination` at request
  // time (editing the destination later never rewrites an
  // existing request). Null on free-form requests — including
  // every pre-CC26 row.
  destinationId  String?
  // CC26: true when the wallet_payout_sweep job created this
  // request from the org's PayoutSchedule. System requests are
  // ordinary pending requests — a human admin still approves
  // and marks them paid; the sweep never moves money.
  createdBySystem Boolean     @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  wallet         WalletAccount @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([status, createdAt])
}

// CC24 (Connect Center Next): one refund against ONE verified
// gateway payment (TenantPaymentTransaction), through the SAME
// gateway that carried the payment — the tenant's own (source
// "own", money returns from the tenant's merchant account) or
// the platform's (source "platform", money returns from the
// platform account and the tenant's Wallet is debited back).
// Money discipline mirrors CC9: INITIATION IS NEVER PROOF. The
// row is created "initiated"; a gateway acceptance moves it to
// "processing" with the gateway's refund reference; ONLY a
// gateway status query confirming success moves it to
// "refunded" (verifiedAt stamped, exactly once) — and only then
// do the order's refundedMinor and (for platform source) the
// Wallet refund_debit move, in the same database transaction.
// gatewayStatusRaw keeps the gateway's latest raw answer
// verbatim as evidence. The cumulative of verified + in-flight
// (initiated|processing) refunds for one transaction may never
// exceed the transaction's paid amount (enforced in the service
// inside a transaction).
model PaymentRefund {
  id                       String    @id @default(uuid())
  organizationId           String
  tenantPaymentTransactionId String
  orderId                  String
  provider                 String // sslcommerz | bkash (nagad has no wired refund API — initiation refuses)
  source                   String    @default("own") // own | platform
  environment              String    @default("live") // live only in v1 — sandbox test payments are never refunded
  amountMinor              BigInt
  currency                 String    @default("BDT")
  status                   String    @default("initiated") // initiated | processing | refunded | failed
  gatewayRefundRef         String? // SSLCommerz refund_ref_id | bKash refundTrxID
  gatewayStatusRaw         Json? // the gateway's latest raw response, verbatim
  reason                   String?
  requestedById            String
  verifiedAt               DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  organization             Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transaction              TenantPaymentTransaction @relation(fields: [tenantPaymentTransactionId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([tenantPaymentTransactionId, status])
  @@index([organizationId, orderId])
}

// CC25 (Connect Center Next): one settlement-file import used to
// reconcile gateway money against the system's verified payment
// records. v1 source of truth is a CSV the merchant downloads
// from the gateway (neither gateway exposes a wired bulk
// settlement API in this codebase — nothing is fetched or
// fabricated). Matching happens once, at import time, against
// TenantPaymentTransaction rows in status verified_paid.
model SettlementImport {
  id             String    @id @default(uuid())
  organizationId String
  provider       String // sslcommerz | bkash
  source         String    @default("own") // own | platform
  periodLabel    String // tenant-entered period description (e.g. "October 2026")
  periodFrom     DateTime? // optional machine range for the missing-in-report comparison
  periodTo       DateTime?
  fileName       String
  rowCount       Int       @default(0) // data rows stored (parsed)
  skippedCount   Int       @default(0) // data rows that could not be parsed into ref + amount
  matchedCount   Int       @default(0) // rows whose matchState is "matched"
  createdById    String
  createdAt      DateTime  @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rows           SettlementRow[]

  @@index([organizationId, createdAt])
}

// CC25: one parsed settlement-file row and its match verdict
// against the system's records. matchState: matched (ref found,
// amount equal) | amount_mismatch (ref found, amount differs) |
// missing_in_system (ref unknown to the system) | duplicate
// (the same ref appeared earlier in the SAME file).
// matchedTransactionId is the TenantPaymentTransaction the ref
// resolved to (set for matched + amount_mismatch).
model SettlementRow {
  id                   String   @id @default(uuid())
  importId             String
  externalRef          String // tran_id (sslcommerz) | trxID/paymentID (bkash), as written in the file
  amountMinor          BigInt
  currency             String   @default("BDT")
  rawStatus            String? // the file's own status text, verbatim
  matchState           String // matched | amount_mismatch | missing_in_system | duplicate
  matchedTransactionId String?
  createdAt            DateTime @default(now())
  import               SettlementImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([importId, matchState])
  @@index([externalRef])
}

// OU11 (One-Umbrella, OB6): THE LEGAL GATE for payout
// AUTOMATION. The platform wallet holds tenant money; the
// Connect Center program carries an OPEN item — a legal review
// of holding tenant funds — and the approved rule is that payout
// automation must NOT be able to go live until that review
// exists. This singleton row (scope = "platform") is where a
// SUPER admin RECORDS that the review happened: who confirmed
// it, when, and the reference (reviewer / law firm / memo).
// Recording is an operator act in the Admin Console; the code
// records the confirmation, it does not replace the review.
// `automationEnabled` is a SEPARATE explicit switch (default
// false): a recorded confirmation alone never enables anything.
// Payout automation (any disbursement execution path) is allowed
// only when a confirmation is present AND the switch is on —
// enforced in the SERVICE layer (connections/payout-legal-gate),
// never only in UI. The existing MANUAL admin mark-paid process
// is NOT gated by this row and behaves exactly as before.
model PayoutLegalGate {
  id                     String    @id @default(uuid())
  scope                  String    @unique @default("platform")
  legalConfirmedById     String? // SUPER admin who recorded the legal-review confirmation
  legalConfirmedAt       DateTime?
  legalReference         String? // reviewer / law firm name or memo reference
  legalNote              String?
  automationEnabled      Boolean   @default(false)
  automationEnabledById  String?
  automationEnabledAt    DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
}

// OU11: ONE disbursement execution, on the v1 bank-instruction
// rail (no bKash disbursement API is evidenced anywhere in this
// codebase — the bKash clients wire tokenized CHECKOUT only —
// so no automated provider disbursement exists). An execution
// is created ONLY from an APPROVED payout (wallet PayoutRequest
// in status approved, or affiliate commissions whose approved
// outstanding covers the amount) and ONLY while the legal gate
// above is open. Issuing creates a bank instruction (destination
// snapshot + amount + instructionRef) the operator carries out
// at the bank BY HAND; confirming records the bank's reference
// and completes the payout through the EXISTING bookkeeping
// (WalletService.adminMarkPaid for wallet payouts — the one and
// only ledger debit — or the EC32 AffiliatePayout create + FIFO
// flip for affiliates). There is no parallel ledger.
// Status: instruction_issued | confirmed | failed. A failed
// execution records its reason and leaves the underlying payout
// untouched and retryable (a re-issue reuses this row); a
// confirmed execution can never execute again (exactly-once).
model PayoutExecution {
  id                String    @id @default(uuid())
  organizationId    String
  subjectType       String // wallet_payout | affiliate_payout
  // Wallet subject: the PayoutRequest being executed (unique —
  // one execution row per request, re-issued in place after a
  // failure). Null on affiliate executions.
  payoutRequestId   String?   @unique
  // Affiliate subject: the partner being paid + the
  // AffiliatePayout row the confirmation created (null until
  // confirmed). Null on wallet executions.
  partnerId         String?
  affiliatePayoutId String?
  amountMinor       BigInt
  method            String // bkash | bank (wallet) / bkash | nagad | bank | cash | other (affiliate)
  destination       Json // snapshot of the payee details the instruction pays to
  currency          String    @default("BDT")
  rail              String    @default("bank_instruction")
  status            String    @default("instruction_issued") // instruction_issued | confirmed | failed
  instructionRef    String    @unique // OUR reference, quoted on the bank instruction
  bankReference     String? // the BANK's reference, recorded by the operator at confirmation
  failureReason     String?
  issuedById        String
  confirmedById     String?
  failedById        String?
  issuedAt          DateTime  @default(now())
  confirmedAt       DateTime?
  failedAt          DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([organizationId, partnerId, status])
}

// CC26 (Connect Center Next): a saved payout destination for a
// tenant's wallet. `details` holds the tenant-entered payout
// identifiers (bKash number / bank account fields) — tenant
// business data, stored as entered; list views mask account
// identifiers beyond the last 4 characters. Exactly one
// destination per org may be isDefault (enforced in the
// service); payout requests snapshot the details at request
// time, so editing a destination never rewrites history.
model PayoutDestination {
  id             String   @id @default(uuid())
  organizationId String
  label          String
  method         String // bkash | bank
  details        Json
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, isDefault])
}

// CC26: the org's automatic payout-request schedule. The
// wallet_payout_sweep job reads this row at its slot; when the
// available wallet balance is at or above thresholdMinor it
// creates ONE pending PayoutRequest (createdBySystem) for the
// org's chosen (or default) destination. The sweep NEVER
// approves or pays — money still leaves only through the human
// admin approve + mark-paid chain (CC10). One schedule per org.
model PayoutSchedule {
  id             String   @id @default(uuid())
  organizationId String   @unique
  enabled        Boolean  @default(false)
  cadence        String   @default("weekly") // weekly | monthly
  dayOfWeek      Int? // 0=Sunday .. 6=Saturday (Asia/Dhaka day), for weekly
  dayOfMonth     Int? // 1..28, for monthly
  thresholdMinor BigInt   @default(0)
  destinationId  String? // null = the org's default destination
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// CC26: a shareable payment link for ONE order. The plaintext
// token exists ONLY in the creation response (and the buyer's
// URL); the row stores its SHA-256 hash. Links are LIVE-only —
// a link always resolves production credentials, so sandbox
// links are refused at creation. A link becomes "used" when
// its payment reaches verified_paid through the exact same
// IPN/callback verification chain as every other payment
// (wired inside TenantPaymentsService.markVerifiedPaid) —
// initiation alone never marks it used and never pays the
// order. Status: active | used | expired | revoked (expired is
// also computed from expiresAt on read).
model PaymentLink {
  id             String    @id @default(uuid())
  organizationId String
  orderId        String
  tokenHash      String    @unique // sha256 hex of the bearer token
  provider       String // sslcommerz | bkash
  source         String    @default("own") // own | platform
  environment    String    @default("live") // live — pinned; see class doc
  expiresAt      DateTime
  status         String    @default("active") // active | used | expired | revoked
  createdById    String
  usedAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, orderId])
  @@index([organizationId, status])
}

// CC11 (Connect Center Advanced): one Connection Doctor run over
// ONE connection target. A target is described generically
// (targetType + targetId) because the Connect Center aggregates
// rows from many tables, not only Integration: targetType mirrors
// the overview account `source` (integration | social_account |
// ad_account | store | sender_config | org_llm_config |
// tenant_payment_gateway | platform_payment_enablement |
// business_profile). steps is the verbatim per-step record:
// [{ key, label, status: "pass" | "fail" | "not_checkable",
//    message }] — a step reports ONLY what a real provider call
// returned (the provider's own message where available); a kind
// with no real check is "not_checkable", never a guessed pass.
// overall: fail (any real step failed) | pass (every step was
// checkable and passed) | partial (anything else).
// runById is null for CC12 sweep runs.
model ConnectionHealthCheck {
  id             String   @id @default(uuid())
  organizationId String
  targetType     String
  targetId       String
  integrationId  String? // the backing Integration row, when the target has one
  provider       String?
  category       String?
  displayName    String?
  runById        String?
  trigger        String   @default("manual") // manual | sweep
  overall        String // pass | fail | partial
  steps          Json
  createdAt      DateTime @default(now())

  @@index([organizationId, targetType, targetId, createdAt])
  @@index([organizationId, createdAt])
}

// CC12: per-target alert bookkeeping for the connection health
// sweep. `state`/`stateHash` are the last observed FIELD-derived
// state (disconnected | error | sync_failing | webhook_error |
// expiring_7 | expiring_3 | expiring_1 | doctor_fail | ok);
// alerts fire only on state CHANGES, so the same broken state
// never alerts twice. `doctorState` is the last sweep-doctor
// outcome (pass | fail) as its own mini state machine: a doctor
// recovery alert fires only when a later doctor run actually
// passes. snoozedUntil freezes the target: while snoozed the
// sweep neither updates the state nor notifies.
model ConnectionAlertState {
  id             String    @id @default(uuid())
  organizationId String
  targetKey      String // "<targetType>:<targetId>"
  targetType     String
  targetId       String
  provider       String?
  category       String?
  displayName    String?
  state          String    @default("ok")
  stateHash      String    @default("")
  doctorState    String? // pass | fail | null (no sweep doctor run yet)
  snoozedUntil   DateTime?
  lastAlertAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([organizationId, targetKey])
  @@index([organizationId])
}

// CC12: one delivered connection alert — the in-app record the
// Connect Center header/overview badge counts (unread = readAt
// null). Email delivery is counted honestly: emailSentCount is
// the number of OWNER/ADMIN recipients for whom EmailProvider
// returned a real message id; emailError keeps the last send
// failure verbatim. Creating this row never depends on email
// succeeding.
model ConnectionAlert {
  id             String    @id @default(uuid())
  organizationId String
  targetKey      String
  targetType     String
  targetId       String
  provider       String?
  category       String?
  displayName    String?
  kind           String // broke | expiring | recovered
  state          String // the state that triggered the alert
  title          String
  body           String?
  emailSentCount Int       @default(0)
  emailError     String?
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  @@index([organizationId, readAt, createdAt])
  @@index([organizationId, targetKey, createdAt])
}

// CC12: per-org connection-alert preferences. categories null =
// every category alerts. doctorEnabled opts the sweep into also
// running the CC11 doctor for Integration-backed targets at most
// once per doctorIntervalHours (the doctor makes real provider
// calls, so the default is OFF and the cadence conservative).
model ConnectionAlertPreference {
  id                  String   @id @default(uuid())
  organizationId      String   @unique
  emailEnabled        Boolean  @default(true)
  categories          Json?
  doctorEnabled       Boolean  @default(false)
  doctorIntervalHours Int      @default(24)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// CC20: one dismissed Smart Setup Assistant finding for one user.
// The finding itself is recomputed from real rows on every read
// (connections/setup-assistant.service.ts) — this row is the ONLY
// persisted assistant state: which finding key which user of the
// org dismissed. If the underlying facts change, the finding stops
// firing on its own; a dismissal only ever suppresses a finding
// that still fires.
model SetupFindingDismissal {
  id             String   @id @default(uuid())
  organizationId String
  userId         String
  findingKey     String
  createdAt      DateTime @default(now())

  @@unique([organizationId, userId, findingKey])
  @@index([organizationId, userId])
}

// EC12: one WooCommerce wc-auth (1-click connect) attempt.
// A dedicated model — NOT a reuse of SocialOAuthState, which is
// typed for social platforms (platform/purpose/payload) and whose
// lifecycle differs. Binding to the Woo callback: Woo's
// /wc-auth/v1/authorize takes `user_id`, which Woo echoes back
// verbatim in the callback POST as `user_id`; we set user_id =
// this row's id (uuid), so the callback is tied to the attempt by
// id + expiry + not-consumed + storeUrl snapshot match. Woo does
// not round-trip arbitrary state params reliably, so the random
// `state` column is only appended to the return_url (for the
// browser's benefit) and is NEVER relied on for verification.
model WcAuthAttempt {
  id             String    @id @default(uuid())
  organizationId String
  userId         String // staff user who started the flow
  storeId        String
  storeUrl       String // snapshot of Store.url at start
  state          String    @unique // random single-use token (return_url only, see above)
  status         String    @default("pending") // pending | consumed | failed
  failureReason  String?
  expiresAt      DateTime
  consumedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([organizationId])
  @@index([expiresAt])
}

model SyncJob {
  id            String        @id @default(uuid())
  integrationId String
  kind          String // products | orders
  status        SyncJobStatus @default(RUNNING)
  fetched       Int           @default(0)
  created       Int           @default(0)
  updated       Int           @default(0)
  skipped       Int           @default(0)
  error         String?
  startedAt     DateTime      @default(now())
  completedAt   DateTime?
  integration   Integration   @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([integrationId, startedAt])
}

model WebhookEvent {
  id            String      @id @default(uuid())
  integrationId String
  provider      String
  topic         String?
  deliveryId    String? // provider delivery id, used for deduplication
  payload       Json
  signatureValid Boolean    @default(false)
  processedAt   DateTime?
  error         String?
  receivedAt    DateTime    @default(now())
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, deliveryId])
  @@index([integrationId, receivedAt])
}

// EC1: one canonical Product's presence on one Store. The Product
// stays the merchant's master catalog row; the listing carries the
// per-store external id, channel overrides and the sync bookkeeping
// that makes two-way sync (EC3+) auditable instead of assumed.
model StoreListing {
  id                 String    @id @default(uuid())
  organizationId     String
  storeId            String
  productId          String
  externalId         String // product id in the store platform
  // Internal variant id -> the store's variant id, e.g.
  // { "<productVariantId>": "<externalVariantId>" }.
  externalVariantMap Json?
  publishState       String    @default("published") // draft | published | archived (platform wording is normalized at the adapter)
  channelPriceMinor  BigInt? // per-channel price override; null = canonical price
  channelStock       Int? // last known stock on this channel
  lastPushedHash     String? // content hash of what the SaaS last pushed (EC3+)
  lastRemoteHash     String? // content hash of what inbound sync last saw
  lastRemoteUpdatedAt DateTime?
  syncStatus         String    @default("synced") // synced | pending | failed | conflict
  lastSyncError      String?
  // EC3: per-listing sale window + push bookkeeping.
  saleStartsAt       DateTime?
  saleEndsAt         DateTime?
  saleActive         Boolean   @default(false)
  lastPushedAt       DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  store              Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product            Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  conflicts          SyncConflict[]

  @@unique([storeId, productId])
  @@index([organizationId, syncStatus])
  @@index([organizationId, storeId])
  @@index([storeId, externalId])
}

// EC3: maps a local Category/ProductTag (localId) to the id the
// store platform assigned it (externalId), per store, so catalog
// write-back reuses remote taxonomy instead of duplicating it.
model StoreTaxonomyMap {
  id             String       @id @default(uuid())
  organizationId String
  storeId        String
  kind           String // category | tag
  localId        String
  externalId     String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  store          Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, kind, localId])
  @@index([organizationId, storeId])
}

// EC4: a physical / platform location of a store (e.g. a Shopify
// location) that stock can be tracked against.
model StoreLocation {
  id                 String       @id @default(uuid())
  organizationId     String
  storeId            String
  name               String
  externalLocationId String?
  isDefault          Boolean      @default(false)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  store              Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, externalLocationId])
  @@index([organizationId, storeId])
}

// EC4: one component line of a bundle product. The parent product
// is sold as a bundle; stock/fulfilment expand through these rows.
model BundleItem {
  id                 String       @id @default(uuid())
  organizationId     String
  parentProductId    String
  componentProductId String
  componentVariantId String?
  quantity           Int          @default(1)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent             Product      @relation("BundleParent", fields: [parentProductId], references: [id], onDelete: Cascade)
  component          Product      @relation("BundleComponent", fields: [componentProductId], references: [id], onDelete: Cascade)

  @@unique([parentProductId, componentProductId, componentVariantId])
  @@index([organizationId, parentProductId])
}

// EC1: durable outbound work queue. Every future write to a store
// goes through a row here (same transaction as the local write), so
// a slow/dead store can never block or silently lose a change.
// Processing is done by SyncOutboxService via the CommerceAdapter
// registry; an operation an adapter does not implement is recorded
// as failed with the verbatim reason "capability_not_implemented" —
// never as done.
model SyncOutbox {
  id             String    @id @default(uuid())
  organizationId String
  storeId        String
  entityType     String // product | order | customer | discount | webhook | ...
  entityId       String
  operation      String // push_product | push_inventory | register_webhooks | ...
  payload        Json
  payloadHash    String
  idempotencyKey String    @unique
  status         String    @default("pending") // pending | processing | done | failed | dead
  attempts       Int       @default(0)
  nextRetryAt    DateTime?
  lastError      String?
  responseSummary Json? // verbatim-ish summary of the platform response on success/failure
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status, nextRetryAt])
  @@index([organizationId, storeId, status])
}

// EC1: a field whose local and remote values diverged while a local
// change was still unpushed. B1 ships the model + list endpoint
// only; creating/resolving conflicts lands with EC3's write-back.
model SyncConflict {
  id             String    @id @default(uuid())
  organizationId String
  storeId        String
  listingId      String
  field          String
  localValue     Json?
  remoteValue    Json?
  // CP: per-field diff captured at creation:
  // [{ field, localValue, remoteValue }] for the content fields
  // that differ — enables per-field resolution in the queue UI.
  fieldDiffs     Json?
  status         String    @default("open") // open | resolved
  resolution     String? // local_wins | remote_wins | per_field (set by resolution)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  listing        StoreListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([listingId])
}

model Customer {
  id             String       @id @default(uuid())
  organizationId String
  externalId     String? // id in the source store, when available
  source         String       @default("woocommerce")
  firstName      String?
  lastName       String?
  email          String?
  phone          String?
  address        Json?
  // CRM C4: values for the org's CustomFieldDefs (entity
  // "customer"), keyed by def.key. Validated server-side.
  customFields   Json?
  // CX10: opt-out unsubscribe flag
  unsubscribed   Boolean      @default(false)
  // EC16: this customer's own referral code (tenant referral
  // program — another customer presenting it at checkout gets
  // the org-configured discount; the code USED is recorded on
  // the order). Generated lazily, unique per org.
  referralCode   String?
  // EC24d: staff-set wholesale flag — wholesale tier pricing
  // applies only to identified customers carrying this flag.
  isWholesale    Boolean      @default(false)
  // ON7: staff-set credit limit for this customer (minor units);
  // null = no credit limit configured for this customer.
  creditLimitMinor BigInt?
  // AB5 (AX7): B2B customer group (scalar id, like assigneeId —
  // group deletion nulls members in the service). A group may
  // carry ONE price list (PriceList.groupId unique); group list
  // prices are a PRICE SOURCE at checkout line-build time.
  groupId        String?
  // AB5 (AX7): net terms in days (0 = no terms; UI vocabulary
  // 0 | 7 | 14 | 30). At placement the one door stamps
  // Order.creditDueDate = order date + terms when the customer
  // carries terms > 0 — a SNAPSHOT: later term edits never
  // rewrite an existing order's due date.
  creditTermsDays Int         @default(0)
  // GB6 (GC15): CRM record depth — staff-managed tags (Json
  // string array, replaced wholesale on write), a STAFF-ONLY
  // internal note (never serialized on any public/customer
  // payload), a VIP flag, and a record-level block (enforced
  // at the native checkouts via CheckoutGuardService when the
  // order phone matches this customer, ON11-normalized).
  tags           Json?
  notes          String?
  isVip          Boolean      @default(false)
  isBlocked      Boolean      @default(false)
  blockedReason  String?
  // AB1 (AX1): cached loyalty-points balance — maintained ONLY
  // by LoyaltyService.postEntry inside the same DB transaction
  // as the LoyaltyLedger write it mirrors. The ledger is the
  // truth; this column is its read cache. May go NEGATIVE after
  // a refund clawback (documented): a negative balance blocks
  // redemption until earned back.
  loyaltyBalanceCache Int     @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orders         Order[]
  serviceBookings ServiceBooking[]
  loyaltyLedger  LoyaltyLedger[]
  customerTier   CustomerTier?
  storeCreditEntries StoreCreditEntry[]
  storeIdentities CustomerStoreIdentity[]
  subscriptions  CustomerSubscription[]

  // Set when this record was merged into another customer.
  mergedIntoId String?
  @@unique([organizationId, referralCode])
  @@index([organizationId, email])
  @@index([organizationId, phone])
  @@index([organizationId, externalId])
  @@index([organizationId, createdAt(sort: Desc)])
}

/// IN2: the reversible record of one customer merge. The pre-IN2
/// merge (CustomersService.merge) moved orders + conversations to
/// the survivor and marked the source with mergedIntoId, but kept
/// only counts in the audit metadata — a merge could never be
/// undone because nobody knew WHICH rows had moved or which
/// survivor fields were gap-filled from the source. This record
/// stores exactly that: the moved row ids and, per gap-filled
/// field, the survivor's pre-merge value + the value filled in.
/// Unmerge moves back only rows still pointing at the survivor
/// and restores a filled field only when it still holds the
/// filled value (a later human edit is never clobbered).
/// revertedAt/revertedByUserId stamp the unmerge; a reverted
/// record is final (the same merge is never reverted twice).
model CustomerMergeRecord {
  id                     String    @id @default(uuid())
  organizationId         String
  sourceCustomerId       String
  targetCustomerId       String
  movedOrderIds          Json
  movedConversationIds   Json
  filledFields           Json
  createdByUserId        String
  createdAt              DateTime  @default(now())
  revertedAt             DateTime?
  revertedByUserId       String?

  @@index([organizationId, sourceCustomerId])
  @@index([organizationId, targetCustomerId])
}

// ---------- EC25 (the EC17 completion): storefront accounts ----------
// Scalar-id style like the other EC-era tables (LandingPage &
// friends): the account identity IS the org-scoped Customer row
// (matched by phone, exactly as checkout upserts it). Services
// resolve every row org-first; nothing here trusts a bare id.

// EC25: one phone-OTP challenge for the native storefront. Only
// the SHA-256 HASH of the 6-digit code is stored. A challenge dies
// on expiry (5 min), on 5 failed attempts, on consumption, and
// when a newer request for the same (org, phone) supersedes it —
// consumedAt is stamped in every death case.
model ShopOtpChallenge {
  id             String    @id @default(uuid())
  organizationId String
  phone          String
  codeHash       String
  attempts       Int       @default(0)
  expiresAt      DateTime
  consumedAt     DateTime?
  createdAt      DateTime  @default(now())

  @@index([organizationId, phone, createdAt])
}

// EC25: a storefront customer session. The bearer token is shown
// to the client exactly once, at verify time; only its SHA-256
// hash is stored. Org-scoped: a token minted for one shop is
// meaningless at another (organizationId equality is enforced on
// every use).
model ShopSession {
  id             String    @id @default(uuid())
  organizationId String
  customerId     String
  tokenHash      String    @unique
  expiresAt      DateTime
  revokedAt      DateTime?
  lastSeenAt     DateTime  @default(now())
  createdAt      DateTime  @default(now())

  @@index([organizationId, customerId])
  @@index([expiresAt])
}

// EC25: a storefront customer's saved delivery address.
model CustomerAddress {
  id             String   @id @default(uuid())
  organizationId String
  customerId     String
  label          String?
  recipientName  String
  phone          String
  addressLine    String
  district       String
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, customerId])
  @@index([customerId, isDefault])
}

// EC25: a wishlist entry. priceAtAddMinor snapshots the product's
// price when the item was added, so the account page can show an
// honest "price dropped" badge against the CURRENT price.
model WishlistItem {
  id              String   @id @default(uuid())
  organizationId  String
  customerId      String
  productId       String
  priceAtAddMinor BigInt
  createdAt       DateTime @default(now())
  // EC28: price-drop alert bookkeeping. lastNotifiedPriceMinor is
  // the lowest price point the owner has already been alerted at
  // (null = never alerted); a further drop below it alerts again,
  // the same price never re-fires. lastAlertStatus records the
  // last attempt honestly: sent | failed_no_channel (no SMS
  // sender configured / send failed) — never a pretend "sent".
  lastNotifiedPriceMinor BigInt?
  lastAlertStatus        String?
  lastAlertAt            DateTime?

  @@unique([customerId, productId])
  @@index([organizationId, customerId])
}

// EC28: back-in-stock alert subscription, placed from the public
// product page while the item is out of stock. One PENDING row per
// (org, product, variantSku, phone) — re-subscribing is idempotent.
// status: pending | notified | failed_no_channel. A subscription
// fires at most once: on the stock transition 0 → >0 the alert is
// attempted exactly once and the row leaves "pending" forever; a
// new stockout needs a new subscription. phone is stored
// normalized (phoneKeyLoose digits); it is never exposed publicly.
model StockAlertSubscription {
  id             String    @id @default(uuid())
  organizationId String
  productId      String
  variantSku     String?
  phone          String
  customerId     String?
  status         String    @default("pending") // pending | notified | failed_no_channel
  failureReason  String?
  createdAt      DateTime  @default(now())
  notifiedAt     DateTime?

  @@index([organizationId, productId, status])
  @@index([organizationId, phone])
}

// EC28: a product question asked from the public product page.
// Lands as "pending" and is NOT public until staff answer it
// (answering publishes). status: pending | published | hidden.
// phone is optional, staff-only context — it is NEVER serialized
// on any public surface.
model ProductQuestion {
  id             String    @id @default(uuid())
  organizationId String
  productId      String
  customerName   String
  phone          String?
  question       String
  answer         String?
  answeredById   String?
  status         String    @default("pending") // pending | published | hidden
  createdAt      DateTime  @default(now())
  answeredAt     DateTime?

  @@index([organizationId, productId, status])
  @@index([organizationId, status, createdAt])
}

model Order {
  id             String       @id @default(uuid())
  organizationId String
  storeId        String?
  customerId     String?
  externalId     String // order id in the source store
  externalNumber String? // human-facing order number
  source         String       @default("woocommerce")
  status         String // raw platform status, e.g. processing, completed, cancelled, refunded
  paymentMethod  String? // e.g. cod, bacs, sslcommerz
  isCod          Boolean      @default(false)
  // Chat-based COD confirmation: awaiting -> confirmed | declined,
  // driven by the customer's actual reply in the linked conversation.
  codConfirmationStatus String?
  codConfirmationSentAt DateTime?
  codConversationId     String?
  // For orders created from chat: how the store sync went.
  storeSyncStatus String? // synced | failed | local_only
  storeSyncError  String?
  // EC5: when this (chat/manual) order was turned into a store draft
  // order, the platform draft id + the customer-payable invoice URL
  // (Shopify draftOrderCreate; Woo draft = a pending order, so its id
  // lands in externalId and storeDraftId stays null there).
  storeDraftId    String?
  storeInvoiceUrl String?
  // Conversation this order was created from (chat / bot orders), so
  // courier updates can be sent back into the same thread.
  conversationId  String?
  // CX12a: practice order — created from a practice conversation.
  // Excluded from order lists / stats / analytics by default and
  // refused by courier booking; deleted by practice cleanup.
  isPractice      Boolean @default(false)
  // GB3 (GC8): checkout trust stamps — termsConsentedAt /
  // termsRef record the shopper's terms consent when the shop
  // requires it; codAdvanceRequired marks that this COD order
  // crossed the org's advance threshold at placement.
  termsConsentedAt DateTime?
  termsRef         String?
  codAdvanceRequired Boolean @default(false)
  // AB4 (AX5a): the deposit/advance amount (paisa) this order was
  // placed owing BEFORE delivery — computed server-side from the
  // org's deposit config at placement; null = no deposit applied.
  // What has actually been PAID toward it is never stamped here:
  // it derives from approved PaymentVerification rows (a verified
  // gateway deposit writes one, source "gateway_deposit").
  depositDueMinor BigInt?
  // AB4 (AX5b): validated answers to the org's custom checkout
  // fields (map key → string | boolean). Validated against the
  // ACTIVE CheckoutFieldDefs for the placement surface at
  // placement time; null = no fields answered / none defined.
  checkoutFields Json?
  // ON1: staff tags (JSON array of strings, replace semantics via
  // OrdersService.setTags) + assignee (scalar user id, no FK —
  // same style as landingPageId; validated against ACTIVE org
  // membership at assign time).
  tags            Json?
  assigneeId      String?
  // ON4 (Fraud Shield v2): persisted order-level risk assessment,
  // stamped at creation by a failure-isolated hook (and recomputed
  // on staff demand via POST orders/:id/reassess). riskReasons is
  // [{ key, label, points }] — every score explains itself; a null
  // riskBand means "not assessed yet", never "low". This is a
  // SEPARATE, persisted layer on top of the M50 compute-on-read
  // phone-history risk (RiskService) — M50 stays untouched.
  riskScore       Int?
  riskBand        String? // low | medium | high
  riskReasons     Json?
  riskAssessedAt  DateTime?
  // ON4: staff review hold. While true the order is excluded from
  // the ready_to_pack queue and courier booking refuses it unless
  // a staff caller passes the explicit override (audited).
  reviewHold       Boolean   @default(false)
  reviewHoldReason String?
  reviewHeldAt     DateTime?
  // ON4: COD phone-call worklist bookkeeping. codLastCallOutcome
  // vocabulary: confirmed | rejected | unreachable |
  // callback_requested (confirmed/rejected also map onto the
  // existing codConfirmationStatus verdict path — confirmed /
  // declined — so there is ONE confirmation state, not two).
  codCallAttempts   Int       @default(0)
  codLastCallAt     DateTime?
  codLastCallOutcome String?
  // Unified Inbox U3: delivery address captured in chat (bot v2 /
  // chat orders); previously it lived only in an internal note.
  address         String?
  // Sales & Data S2: merchant-only internal note on the order
  // (staff context; never sent to the customer or any platform).
  internalNote   String?
  // EC13: landing-page attribution — set only by the landing
  // order endpoint (source "landing"); null for every other path.
  landingPageId   String?
  landingVariantId String?
  // EC18: customer-chosen delivery slot (DeliverySlot row of the
  // same org) + the chosen calendar day as "YYYY-MM-DD" (Asia/Dhaka
  // shopper day; a plain string keeps per-day capacity counting an
  // exact equality match). Null = no slot chosen.
  deliverySlotId  String?
  deliveryDate    String?
  // EC30: how this order is delivered — "home" (zone charge /
  // weight rule) or "pickup" (customer collects at a PickupPoint;
  // the point's own feeMinor was the delivery charge). Legacy rows
  // default to "home". pickupPointId is the PickupPoint row of the
  // same org when deliveryMethod = "pickup".
  deliveryMethod  String  @default("home") // home | pickup
  pickupPointId   String?
  // EC30: the zone free-shipping threshold (ShippingZone.
  // freeAboveMinor) zeroed this order's delivery charge;
  // freeShippingZoneId records which zone's threshold applied.
  // (A free-shipping COUPON is visible via the promotion/discount
  // stamps instead — this pair is the EC30 zone-threshold stamp.)
  freeShippingApplied Boolean @default(false)
  freeShippingZoneId  String?
  // EC30: the ShippingRateRule that set this order's delivery
  // charge (weight-slab replacement), null when the zone flat
  // charge (or a pickup fee / free shipping) applied.
  shippingRateRuleId  String?
  // Feature 5: Team Performance & Staff Attribution
  agentId        String?      // Staff/Agent who handled, placed, or confirmed the order
  confirmedAt    DateTime?    // When the order was confirmed with customer
  commissionMinor BigInt      @default(0) // Commission earned on delivered order
  currency       String       @default("BDT")
  subtotalMinor  BigInt       @default(0)
  shippingMinor  BigInt       @default(0)
  discountMinor  BigInt       @default(0)
  // EC16: the promotion/referral split of discountMinor (which
  // stays the TOTAL merchandise discount: coupon + promotion +
  // referral, so every existing total/due computation is
  // unchanged). promotionsApplied = [{ promotionId, name, type,
  // amountMinor }] as evaluated at checkout; referralCode = the
  // customer referral code presented at checkout (null = none).
  promotionDiscountMinor BigInt @default(0)
  promotionsApplied      Json?
  referralDiscountMinor  BigInt @default(0)
  referralCode           String?
  // AB1 (AX2): the resolved referrer behind referralCode above,
  // stamped by PromotionsService.stampOrder FROM the evaluation
  // (the evaluator resolves the referrer even when the presented
  // code grants the buyer no discount). Plain scalar, like
  // assigneeId — no FK, so a later customer merge/delete never
  // blocks an order write. LoyaltyService resolves the CURRENT
  // referrer through this id first, falling back to the code.
  referrerCustomerId     String?
  // EC32: affiliate attribution — stamped at checkout ONLY when
  // the org's affiliate program is enabled and the presented code
  // resolved to an ACTIVE AffiliatePartner (and the buyer is not
  // the partner themselves). Deliberately SEPARATE from the EC16
  // customer referralCode above: referral = buyer discount,
  // affiliate = partner commission ledger. affiliateCode keeps
  // the code AS PRESENTED for audit/debugging; the partner link
  // is the source of truth for commission.
  affiliatePartnerId String?
  affiliateCode      String?
  // EC23: fiscal invoice serial INV-<fiscalYear>-<seq>, assigned
  // once at first invoice generation (unique per org);
  // taxBreakdown = per-rate snapshot taken at checkout:
  // [{ rateBps, taxableMinor, taxMinor }] (amounts as strings).
  invoiceNumber   String?
  taxBreakdown    Json?
  // EC24b: digital link reveal bookkeeping (order-level —
  // the reveal button on tracking/success surfaces increments).
  digitalAccessCount    Int       @default(0)
  digitalLastAccessedAt DateTime?
  // EC24d: wholesale lines applied at checkout, snapshot:
  // [{ productId, minQty, priceMinor }] (priceMinor as string).
  wholesaleBreakdown Json?
  // AB5 (AX7): customer-group price-list lines applied at
  // checkout line-build, snapshot: [{ productId, variantId,
  // priceMinor }] (priceMinor as string). Stamped by the pricing
  // surfaces (shop quote / single / landing / POS) exactly like
  // wholesaleBreakdown; null = no group price applied.
  priceListBreakdown Json?
  // AB5 (AX7): net-terms due date snapshot — order effective
  // date (placedAt ?? createdAt) + the customer's creditTermsDays
  // AT PLACEMENT, stamped once by the upsertOrder CREATE branch
  // when terms > 0 and the order total is positive. Null = no
  // terms applied (the khata view then never flags the order
  // overdue on a terms basis; ON7 aging is unaffected).
  creditDueDate   DateTime?
  // AB7 (AX19): order-level attribution stamps — captured by the
  // shop client from first-party tracking storage and presented
  // in the native checkout DTOs; stamped once at placement.
  // Null = untracked (POS / manual / external orders are never
  // stamped). clickIdType vocabulary: fbclid | gclid | ttclid.
  utmSource       String?
  utmMedium       String?
  utmCampaign     String?
  utmContent      String?
  utmTerm         String?
  clickIdType     String?
  clickId         String?
  // AB8 (AX27): first-party device hash presented at native
  // checkout (SHA-256 hex of low-entropy-stable browser signals —
  // a WEAK signal, see fraud-score). Null = not presented (POS /
  // manual / external orders are never stamped).
  deviceHash      String?
  // EC24c: renewal orders created by the subscription sweep
  // link back to their CustomerSubscription.
  subscriptionId  String?
  // EC29: free-gift outcome. giftPromotionId stamps the gift
  // Promotion that fired (applied OR skipped); giftSkipped is true
  // when the gift qualified but could not be added at placement
  // (gift product/variant gone or out of stock) — an order never
  // blocks on a gift.
  giftPromotionId String?
  giftSkipped     Boolean @default(false)
  // ON3 (Order Surgery): split / merge lineage + the coupon code
  // actually applied at checkout. splitFromId = the parent order
  // this order was split out of; mergedIntoId = the survivor
  // order this order was merged into (a merged order is terminal:
  // it can never be revived — see OrdersService.updateOrder).
  // couponCode is stamped ONLY when a coupon truly applied
  // (PromotionsService.stampOrder) or by a surgery re-evaluation,
  // so item edits can re-validate the SAME code instead of
  // silently keeping an unverifiable discount.
  splitFromId     String?
  mergedIntoId    String?
  couponCode      String?
  // GB7 (GC17): what the evaluator actually applied at placement
  // — [{promotionId?, couponCode?, kind, name, discountMinor}]
  // stamped by PromotionsService.stampOrder FROM the evaluation
  // result (never reconstructed later). Null on pre-GB7 orders;
  // the promotions report reads only this column + couponCode.
  appliedDiscounts Json?
  // EC29: gift wrap fee (a FEE like delivery — outside discounts
  // and outside the tax base) + the customer's gift message
  // (printed on the packing slip).
  giftWrapMinor   BigInt  @default(0)
  giftMessage     String?
  taxMinor       BigInt       @default(0)
  totalMinor     BigInt       @default(0)
  refundedMinor  BigInt       @default(0)
  placedAt       DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  store          Store?       @relation(fields: [storeId], references: [id], onDelete: SetNull)
  customer       Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items          OrderItem[]
  installmentPlan InstallmentPlan?
  affiliatePartner AffiliatePartner? @relation(fields: [affiliatePartnerId], references: [id], onDelete: SetNull)
  commissionEntry  CommissionEntry?
  packingScans   PackingScanLog[]
  fulfillments   Fulfillment[]
  returnRequests ReturnRequest[]
  orderComments  OrderComment[]
  orderNotificationLogs OrderNotificationLog[]
  pickWaveOrders PickWaveOrder[]
  deliveryAttempts DeliveryAttempt[]
  voiceCalls     OrderVoiceCall[]
  stockAllocations StockAllocation[]
  liveSessionOrder LiveSessionOrder?

  @@unique([organizationId, source, externalId])
  @@unique([organizationId, invoiceNumber])
  @@index([organizationId, status])
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, customerId])
  @@index([organizationId, placedAt])
  @@index([organizationId, affiliatePartnerId])
  // EC34: POS "today's sales" strip queries org + source +
  // createdAt together.
  @@index([organizationId, source, createdAt])
  @@index([organizationId, landingPageId])
  @@index([organizationId, deliverySlotId, deliveryDate])
  // ON1: assignee queue / "my orders" filtering.
  @@index([organizationId, assigneeId])
  // ON4: fraud-band list filtering + review-hold queue.
  @@index([organizationId, riskBand])
  @@index([organizationId, reviewHold])
  // ON3: split children / merged-away orders by lineage.
  @@index([organizationId, splitFromId])
  @@index([organizationId, mergedIntoId])
  @@index([organizationId, agentId])
}

// ON2: a staff member's saved Orders list configuration (queue +
// list-v2 filters). Private to its owner (userId); filters are
// validated against the list-v2 whitelist at write time.
model OrderSavedView {
  id             String   @id @default(uuid())
  organizationId String
  userId         String
  name           String
  queue          String?
  filters        Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, userId])
}

// ON2: staff-only internal comment thread on an order. NEVER
// exposed on any public/customer surface (storefront tracking
// payloads are built elsewhere and never read this model).
model OrderComment {
  id             String   @id @default(uuid())
  organizationId String
  orderId        String
  authorId       String
  body           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([organizationId, orderId, createdAt])
}

// ON4 (Fraud Shield v2): per-org fraud settings — ONE row per org,
// created lazily with these defaults on first read/write. `enabled`
// gates SCORING only (default true); `autoHoldEnabled` separately
// gates automatic review holds (default FALSE — holds are a staff
// decision until the merchant turns automation on). highValueMinor
// is the "large order" threshold for the high-value-new-customer
// signal; burstCount/burstWindowHours drive the duplicate-burst
// signal. Scalar-id style like the EC-era tables: services resolve
// the row org-first; no Organization relation.
model FraudShieldSetting {
  id               String   @id @default(uuid())
  organizationId   String   @unique
  enabled          Boolean  @default(true)
  autoHoldEnabled  Boolean  @default(false)
  autoHoldBand     String   @default("high") // medium | high
  highValueMinor   BigInt   @default(500000)
  burstCount       Int      @default(3)
  burstWindowHours Int      @default(24)
  // GB3 (GC9): checkout-gate policy + CAPTCHA (Cloudflare
  // Turnstile). openOrderPolicy gates shoppers who already
  // have an open order: off | warn | block (window =
  // openOrderWindowHours). waitingPeriodMinutes is a per-phone
  // cooldown between orders; maxOrdersPerPhonePerDay 0 = off.
  // turnstileSecretEncrypted is SEALED (platform-config seal())
  // and never returned by any API; the site key is public.
  openOrderPolicy        String   @default("off") // off | warn | block
  openOrderWindowHours   Int      @default(72)
  waitingPeriodMinutes   Int      @default(0)
  maxOrdersPerPhonePerDay Int     @default(0)
  turnstileSiteKey       String?
  turnstileSecretEncrypted String?
  captchaEnabled         Boolean  @default(false)
  captchaOnCheckout      Boolean  @default(true)
  captchaOnOtp           Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// GB3 (GC8/GC9): checkout idempotency + fraud-hardening tables.
// Scalar-id style (NO Organization relation), matching
// FraudShieldSetting / BlockedPhone precedent: services resolve
// rows org-first, and a missing table on a partial deployment
// degrades to "no match" instead of breaking checkout. Org
// cleanup for these rows is therefore service-level, not a DB
// cascade — the deliberate trade-off of the scalar style.

// GB3 (GC8): one row per (org, idempotency key) presented at a
// public checkout surface (scope shop | single | landing);
// orderId/responseJson record the first placement so a retry
// replays it instead of duplicating the order.
model IdempotencyRecord {
  id             String   @id @default(uuid())
  organizationId String
  key            String
  scope          String // shop | single | landing
  orderId        String?
  responseJson   Json?
  createdAt      DateTime @default(now())

  @@unique([organizationId, key])
  @@index([organizationId, createdAt])
}

// GB3 (GC9): staff-managed blocked identifiers (phone | email |
// ip). value is the normalized display value; matchKey is the
// comparison key (phone: last-10 digits; email: lowercased;
// ip: the ip string). Enforced at the checkout gate.
model BlockedIdentifier {
  id             String   @id @default(uuid())
  organizationId String
  kind           String // phone | email | ip
  value          String
  matchKey       String
  reason         String?
  createdById    String?
  createdAt      DateTime @default(now())

  @@unique([organizationId, kind, matchKey])
  @@index([organizationId, kind])
}

// AB4 (AX5b): a merchant-defined custom checkout field. Scalar-id
// style (no Organization relation), like the GB3 tables above:
// services resolve rows org-first. key is a merchant-chosen slug
// unique per org; appliesTo scopes the field to one checkout
// surface (shop | single | landing) or "all". Checkout DTOs
// accept answers for the ACTIVE defs of their surface only; the
// validated answers land on Order.checkoutFields.
model CheckoutFieldDef {
  id             String   @id @default(uuid())
  organizationId String
  key            String
  label          String
  type           String // text | textarea | select | checkbox
  options        Json? // string[] for type "select"
  required       Boolean  @default(false)
  appliesTo      String   @default("all") // shop | single | landing | all
  sortOrder      Int      @default(0)
  active         Boolean  @default(true)
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, key])
  @@index([organizationId, appliesTo, active])
}

// ---------- AB5 (AX7): B2B customer groups, price lists, quotes ----------

// AB5 (AX7): a named B2B customer group. Customers join via
// Customer.groupId (scalar; group deletion nulls members in the
// service). A group carries at most ONE price list.
model CustomerGroup {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  priceList      PriceList?

  @@unique([organizationId, name])
  @@index([organizationId])
}

// AB5 (AX7): the group's explicit price list — MATERIALIZED
// prices only (a bulk %-off helper writes explicit rows; nothing
// is computed at read time). Consulted at checkout line-build:
// a matching row REPLACES the line's catalog/variant unit price
// (an explicit list price also beats wholesale-tier math — a
// negotiated price is more specific than a quantity tier).
model PriceList {
  id             String   @id @default(uuid())
  organizationId String
  // AB5: a list is bound to exactly ONE owner — a CustomerGroup
  // (groupId) OR, since NF7 (FB3), a membership TierDefinition
  // (tierId). Both are unique; groupId became nullable for NF7
  // so a tier-bound list needs no fake group. The service layer
  // refuses a list with neither / both set.
  groupId        String?  @unique
  tierId         String?  @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  group          CustomerGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  tier           TierDefinition? @relation(fields: [tierId], references: [id], onDelete: Cascade)
  items          PriceListItem[]

  @@index([organizationId])
}

model PriceListItem {
  id          String    @id @default(uuid())
  priceListId String
  productId   String
  // Null = the product-level price (applies to every variant);
  // a variant-specific row beats the product-level row.
  variantId   String?
  priceMinor  BigInt
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  priceList   PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)

  @@unique([priceListId, productId, variantId])
  @@index([priceListId])
  @@index([productId])
}

// AB5 (AX7): a staff-issued price QUOTE — an OFFER document, not
// an order. Lines are SNAPSHOTS (name + unit price as offered);
// totals on the quote are Σ lines + deliveryChargeMinor, with NO
// tax/promotion evaluation. Conversion (staff-confirmed, on an
// accepted quote) creates a REAL order through the manual-order
// path carrying the snapshot prices — the conversion preview
// shows the resulting order totals computed by that path BEFORE
// staff confirm, so any difference is visible, never silent.
// The public page is reached only via the unguessable token
// (SHA-256 hash stored, like ShopOtpChallenge/GiftCard codes).
model Quote {
  id             String    @id @default(uuid())
  organizationId String
  number         String // QT-<seq>, org-scoped (QuoteCounter)
  customerId     String?
  walkinName     String?
  walkinPhone    String?
  status         String    @default("draft") // draft | sent | accepted | declined | expired | converted | cancelled
  expiresAt      DateTime?
  lines          Json // [{ productId, variantId?, name, variantName?, sku?, qty, unitPriceMinor (string) }]
  deliveryChargeMinor BigInt @default(0)
  note           String?
  convertedOrderId String?
  publicTokenHash String?  @unique
  // Honesty of the LAST send attempt: sms | email | none
  // (recorded, never claimed beyond what the helper returned).
  sentVia        String?
  sentAt         DateTime?
  respondedAt    DateTime?
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([organizationId, number])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, customerId])
}

// AB5 (AX7): org-scoped quote number sequence — mirrors
// InvoiceCounter: the unique row IS the lock, incremented
// atomically inside a transaction.
model QuoteCounter {
  id             String @id @default(uuid())
  organizationId String @unique
  lastSeq        Int    @default(0)
}

// ---------- AB5 (AX9): license-key pools ----------

// AB5 (AX9): one license key in a product's pool. The full key
// exists ONLY as a SHA-256 hash (dedupe) + an AES-256-GCM sealed
// copy (platform-config seal, like GiftCard codes) — staff
// surfaces show keyLast4 only; the full key is revealed solely
// to the entitled buyer on the order-bound digital surface.
// Assignment is exactly-once per (assignedItemId, unitIndex) —
// the unique pair is the claim, mirroring GiftCard issuance.
model LicenseKey {
  id             String    @id @default(uuid())
  organizationId String
  productId      String
  keyHash        String
  keySealed      String
  keyLast4       String
  status         String    @default("available") // available | assigned | revoked
  assignedOrderId String?
  assignedItemId String?
  unitIndex      Int?
  assignedAt     DateTime?
  revokedAt      DateTime?
  importBatch    String?
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([organizationId, productId, keyHash])
  @@unique([assignedItemId, unitIndex])
  @@index([organizationId, productId, status])
  @@index([organizationId, assignedOrderId])
}

// AB4 (AX6b): the server-side ledger of ONE offline POS sale's
// sync journey. The client outbox is the transport; this row is
// the record staff act on. (organizationId, idempotencyKey) is
// unique — the same key the POS sale itself replays under
// (IdempotencyRecord, scope "pos"), so a retried sync can never
// create a second order. payload keeps the original sale body so
// a staff re-post needs nothing from the client. varianceMinor =
// serverTotalMinor − localTotalMinor, recorded even when 0 — a
// priced difference never hides.
model PosOfflineSync {
  id              String    @id @default(uuid())
  organizationId  String
  idempotencyKey  String
  cashierId       String?
  localReceiptNo  String?
  localTotalMinor BigInt?
  payload         Json
  status          String    @default("pending") // pending | synced | conflict | rejected | discarded
  reason          String?
  serverOrderId   String?
  serverTotalMinor BigInt?
  varianceMinor   BigInt?
  discardNote     String?
  attempts        Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  syncedAt        DateTime?

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, status, createdAt])
}

// GB3 (GC9): trusted identifiers — a trusted PHONE bypasses the
// blocked/open-order/waiting/daily gate checks (never CAPTCHA).
// Same shape as BlockedIdentifier.
model TrustedIdentifier {
  id             String   @id @default(uuid())
  organizationId String
  kind           String // phone | email | ip
  value          String
  matchKey       String
  reason         String?
  createdById    String?
  createdAt      DateTime @default(now())

  @@unique([organizationId, kind, matchKey])
  @@index([organizationId, kind])
}

// GB3 (GC9): one row per checkout-gate refusal (staff-visible
// attempt log). identifierSummary is ALWAYS a masked summary —
// never a raw phone/email.
model FraudAttemptLog {
  id                String   @id @default(uuid())
  organizationId    String
  channel           String // shop | single | landing | otp
  kind              String // blocked_identifier | open_order_policy | waiting_period | daily_limit | captcha | fraud_rule
  identifierSummary String
  ruleId            String?
  createdAt         DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([organizationId, kind])
}

// GB3 (GC9): a merchant's basic fraud rule. conditions is a
// validated Json object (known keys only — see
// FraudRulesService): minTotalMinor (digit string), isCod,
// districtIn, phoneOpenOrdersGte, minRiskScore. action:
// hold | tag | block_checkout (tag requires tagValue).
model FraudRule {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  enabled        Boolean  @default(true)
  conditions     Json
  action         String // hold | tag | block_checkout
  tagValue       String?
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
}

// GB3 (GC9): one row per fraud-rule firing (checkout blocks
// carry orderId null — the order was never placed).
model FraudRuleHit {
  id             String   @id @default(uuid())
  organizationId String
  ruleId         String
  orderId        String?
  action         String
  createdAt      DateTime @default(now())

  @@index([organizationId, ruleId])
  @@index([organizationId, orderId])
}

// ON5 (Transactional Notification Engine): per-org notification
// settings — ONE row per org, created lazily. `config` is the
// full per-event JSON shape defined in
// apps/api/src/order-notifications/order-notifications.ts
// ({ [event]: { enabled, channels, templates } }); services merge
// it over DEFAULT_CONFIG on read, so a partial stored config is
// always safe. Scalar-id style like FraudShieldSetting: no
// Organization relation.
model OrderNotificationSetting {
  id             String   @id @default(uuid())
  organizationId String   @unique
  config         Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ON5: one row per notification attempt / skip decision for an
// order+event. status vocabulary: sent | skipped_setting_off |
// skipped_no_channel | covered_existing | failed_error |
// failed_no_channel. The (organizationId, orderId, event, status)
// index backs the dedupe check ("already sent for this event").
// Order relation mirrors OrderComment; organizationId stays a
// scalar (org resolved in services, like OrderComment).
model OrderNotificationLog {
  id                String   @id @default(uuid())
  organizationId    String
  orderId           String
  event             String
  channel           String
  status            String
  providerMessageId String?
  error             String?
  createdAt         DateTime @default(now())
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([organizationId, orderId])
  @@index([organizationId, orderId, event, status])
}


// ON8 (Orders Automation Studio): a merchant's no-code
// if/then rule over ORDER operations. This is a DEDICATED
// engine — the WorkflowsService step vocabulary is
// lead/conversation-scoped (add_tag validates target ∈
// {lead, conversation}, assign is assign_conversation) and
// it has no order-hold / order-assign / order-tag steps and
// no parcel-stuck / due-overdue time triggers, so the full
// ON8 vocabulary cannot be expressed there without forking
// shared step semantics. This engine owns ORDER-operation
// rules ONLY; generic workflow notifications stay with
// WorkflowsService. Scalar-id style like FraudShieldSetting:
// services resolve rows org-first; no Organization relation.
//   trigger vocabulary: order_created | status_changed |
//     parcel_stuck_hours | due_overdue_days
//   triggerConfig Json?: { toStatus } for status_changed,
//     { hours } for parcel_stuck_hours, { days } for
//     due_overdue_days, null for order_created.
//   conditions Json?: the ON8 condition object (ALL must
//     pass; absent = pass) — see order-automation.ts.
//   actions Json: ordered array of action objects, each
//     executed in isolation. HARD BOUNDARY: no action may
//     alter order totals, payment state or status (hold /
//     assign / tags are operational, not money/status).
//   presetKey: the ON8 preset this rule was installed from
//     (null for hand-built rules); uniqueness per org is
//     enforced in OrderAutomationService.installPreset with
//     a lookup (Prisma cannot express a partial unique).
model OrderAutomationRule {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  enabled        Boolean  @default(false)
  trigger        String
  triggerConfig  Json?
  conditions     Json?
  actions        Json
  presetKey      String?
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  logs           OrderAutomationLog[]

  @@index([organizationId, enabled, trigger])
}

// ON8: one row per (rule, order, triggerKey) firing — the
// @@unique is the exactly-once guard: the engine RESERVES
// this row before running any action, so a duplicate event
// delivery hits the unique constraint and skips silently,
// while a genuine re-entry (a status transition at a
// different time, a different stuck shipment/status, a
// different due-days bucket) carries a different triggerKey
// and may fire again. actionsResult is the per-action
// [{ type, ok, detail? }] outcome list, filled in after the
// actions run. Rule relation mirrors OrderNotificationLog's
// Order relation; organizationId/orderId stay scalars.
model OrderAutomationLog {
  id            String              @id @default(uuid())
  organizationId String
  ruleId        String
  orderId       String
  triggerKey    String
  actionsResult Json
  createdAt     DateTime            @default(now())
  rule          OrderAutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([ruleId, orderId, triggerKey])
  @@index([organizationId, ruleId, createdAt])
  @@index([organizationId, orderId, createdAt])
}

// ON10 (Print & Document Center): one row per bulk print job
// (invoices / labels / packing slips / delivery challans over
// 1–100 orders). The PDF itself is streamed to the caller and
// NOT stored — this row is the job's honest record: which
// orders were requested (orderIds Json, string[]), which ones
// could not be printed (failedOrderIds Json, string[] — e.g. a
// label for an order with no courier shipment), and whether
// generation succeeded at all (status done | failed + the
// Bengali error). Scalar organizationId like OrderAutomationRule.
model PrintJob {
  id             String   @id @default(uuid())
  organizationId String
  type           String // invoices | labels | packing_slips | challans
  orderIds       Json
  orderCount     Int
  failedOrderIds Json?
  status         String // done | failed
  error          String?
  createdById    String?
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
}

// ON10: per-org print template customization — ONE row per org,
// lazy-upserted from the Print Center (no row = the pre-ON10
// default documents). Applied to invoices / challans / packing
// slips generated through print jobs; the legacy direct courier
// PDF endpoints keep the default behaviour. logoUrl is stored
// + validated (http(s)) but the dependency-free PDF toolkit
// cannot embed raster images, so it does not render yet —
// footerText / termsText / invoiceNote are the rendered fields.
model PrintTemplateSetting {
  id             String   @id @default(uuid())
  organizationId String   @unique
  logoUrl        String?
  footerText     String?
  termsText      String?
  invoiceNote    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ON6 (Fulfillment Excellence): per-org fulfilment SLA
// thresholds — ONE row per org, created lazily (no row = the
// in-code defaults 24h / 24h / 5 days). The two pack stages are
// hours; the stuck-parcel threshold is days.
model FulfillmentSetting {
  id                  String       @id @default(uuid())
  organizationId      String       @unique
  confirmToPackHours  Int          @default(24)
  packToHandoverHours Int          @default(24)
  stuckDays           Int          @default(5)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// ON6: a batch of orders staff pick together. status:
// open | closed. Orders join through PickWaveOrder rows.
model PickWave {
  id             String          @id @default(uuid())
  organizationId String
  status         String          @default("open") // open | closed
  note           String?
  createdById    String
  createdAt      DateTime        @default(now())
  closedAt       DateTime?
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orders         PickWaveOrder[]

  @@index([organizationId, status, createdAt])
}

// ON6: one order inside one pick wave. pickedAt/pickedById are
// stamped when the order's remaining items have been packed
// through the wave (or were already fully covered).
model PickWaveOrder {
  id         String    @id @default(uuid())
  waveId     String
  orderId    String
  pickedAt   DateTime?
  pickedById String?
  createdAt  DateTime  @default(now())
  wave       PickWave  @relation(fields: [waveId], references: [id], onDelete: Cascade)
  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([waveId, orderId])
  @@index([waveId])
  @@index([orderId])
}

// ON6: one recorded delivery attempt against a shipment.
// outcome: customer_unavailable | refused | address_issue |
// rescheduled | other. rescheduleDate is a "YYYY-MM-DD" string
// (required when outcome = rescheduled), matching the codebase's
// other calendar-day strings.
model DeliveryAttempt {
  id             String          @id @default(uuid())
  organizationId String
  shipmentId     String
  orderId        String
  attemptedAt    DateTime        @default(now())
  outcome        String
  note           String?
  rescheduleDate String?
  recordedById   String
  createdAt      DateTime        @default(now())
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  shipment       CourierShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([organizationId, orderId])
  @@index([organizationId, shipmentId])
}

// ON4: org phone blocklist. `phone` is the canonical form produced
// by ON11 normalizeBdPhone (+8801XXXXXXXXX); `phoneKey` is the
// last-10-digits comparison key (same convention as risk-score's
// phoneKey) so a number stored in any local format still matches.
// Enforcement: the three native checkouts refuse; external-store
// orders are created, assessed and force-held instead of dropped;
// staff manual/chat creation warns and holds (never silently
// blocks staff).
model BlockedPhone {
  id             String   @id @default(uuid())
  organizationId String
  phone          String
  phoneKey       String
  reason         String?
  createdById    String?
  createdAt      DateTime @default(now())

  @@unique([organizationId, phoneKey])
  @@index([organizationId, phoneKey])
}

model OrderItem {
  id          String  @id @default(uuid())
  orderId     String
  productId   String? // linked internal product when a reliable match exists
  externalProductId String?
  externalVariationId String?
  name        String
  sku         String?
  quantity    Int
  priceMinor  BigInt  @default(0)
  totalMinor  BigInt  @default(0)
  // EC24a: this line was placed as a pre-order (no stock was
  // decremented for it at placement).
  isPreorder  Boolean @default(false)
  // EC29: free-gift line (price 0; refund value 0 — an RMA may
  // take the item back physically, never for money).
  isGift      Boolean @default(false)
  // EC29: this line is a component of a fixed-price Bundle set;
  // priceMinor/totalMinor are the ALLOCATED amounts stamped at
  // placement (allocated totals sum exactly to the bundle price).
  bundleId    String?
  bundleName  String?
  // AB5 (AX9): PER-ITEM digital access bookkeeping. The reveal
  // mints signed download tokens per item; each validated
  // download increments THIS counter and the item's own product
  // digitalAccessLimit is enforced against it. The order-level
  // Order.digitalAccessCount stays as the legacy read (still
  // incremented by the reveal, as before AB5).
  digitalAccessCount    Int       @default(0)
  digitalLastAccessedAt DateTime?
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([productId])
}

// ---------- Milestone 4: Tracking & attribution ----------
// First-party, consent-aware tracking. Identifiers are pseudonymous:
// anonymousId is a random browser id, never a name/email by itself.

// EC9: a fulfilment of (part of) an order. items is a JSON list of
// { orderItemId, quantity, packed? } — partial fulfilment is the
// norm, remaining quantities are computed on read from the order's
// items minus all non-cancelled fulfilments. courierShipmentId links
// the CourierShipment booked for this parcel when one exists.
model Fulfillment {
  id                String       @id @default(uuid())
  organizationId    String
  orderId           String
  status            String       @default("pending") // pending | packed | handed_over | in_transit | delivered | returned | cancelled
  courierShipmentId String?
  courierProvider   String?
  trackingCode      String?
  items             Json
  createdById       String?
  // EC9: set once the create_fulfillment store push for this
  // fulfilment has been enqueued, so re-saving never double-pushes.
  storePushEnqueuedAt DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  order             Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([organizationId, orderId])
  @@index([organizationId, status, createdAt])
}

// EC9: a customer return request (RMA). The public page is reached
// only via the unguessable token minted when staff share the link.
// resolution "store_credit_note" is a RECORD ONLY — no money
// instrument exists or is created (tenant money features stay
// postponed). restockAppliedAt is the exactly-once marker for the
// S1 inventory restore on completion.
model ReturnRequest {
  id                String       @id @default(uuid())
  organizationId    String
  orderId           String
  customerId        String?
  // EC28: who opened this request — "staff" (EC9 link flow) or
  // "customer" (self-service from the public tracking page).
  source            String       @default("staff")
  // EC28: the customer's ask on a self-service request:
  // return | exchange. Null on staff link-flow rows (the ask is
  // the submitted reason/items there; resolution stays staff's).
  requestType       String?
  status            String       @default("requested") // requested | approved | rejected | return_shipped | received | completed
  reason            String?
  items             Json? // [{ orderItemId, quantity, condition? }]
  resolution        String? // refund | exchange | store_credit_note
  refundAmountMinor BigInt?
  restockDecision   String       @default("pending") // pending | restock | discard
  staffNote         String?
  token             String       @unique
  returnShipmentId  String? // CourierShipment booked for the return parcel
  exchangeOrderId   String? // manual order created on exchange completion
  restockAppliedAt  DateTime?
  // CP: Shopify partial-restock attempt outcome for this return:
  // { attempted, succeeded, qty, reason? } — written failure-
  // isolated AFTER the local restock; the local flow never
  // depends on it.
  shopifyRestock    Json?
  notificationStatus String? // sent_inbox | sent_email | not_sent_no_channel | failed
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  order             Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([organizationId, orderId])
  @@index([organizationId, status, createdAt])
}

// EC23: per-org tax configuration. A separate model (not
// BusinessProfile) because tax identity (TIN/BIN) and the
// fiscal invoice sequence are accounting concerns, edited by
// different staff than storefront branding. Rates are basis
// points (Int): BD VAT includes fractional rates (7.5%).
model TaxSetting {
  id               String   @id @default(uuid())
  organizationId   String   @unique
  legalName        String?
  tin              String?
  binVatNo         String?
  // Default VAT rate in basis points (1500 = 15.00%).
  // Null = tax OFF — checkouts behave exactly as pre-EC23.
  defaultVatBps    Int?
  // BD retail norm: shelf prices already contain VAT, so the
  // order's taxMinor is the VAT portion inside the total.
  // false = VAT is added on top of the total at checkout.
  pricesIncludeVat Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// EC23: fiscal invoice sequence per org per BD fiscal year
// (Jul–Jun, "2026-27"). Incremented atomically inside the
// invoice-issuing transaction; the (organizationId, fiscalYear)
// unique row IS the lock.
model InvoiceCounter {
  id             String @id @default(uuid())
  organizationId String
  fiscalYear     String
  lastSeq        Int    @default(0)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, fiscalYear])
}

// EC24c: a customer's standing subscription to a product.
// Renewal orders are COD/manual (no gateway auto-charge).
// unitPriceMinor + discountPercent are SNAPSHOTS taken at
// creation — later product price edits never change them.
model CustomerSubscription {
  id                 String   @id @default(uuid())
  organizationId     String
  customerId         String
  productId          String
  variantSku         String?
  qty                Int      @default(1)
  unitPriceMinor     BigInt
  discountPercent    Int?
  status             String   @default("active") // active | paused | cancelled
  nextRunAt          DateTime
  lastOrderId        String?
  createdFromOrderId String?
  // Consecutive sweep failures; at 5 the sweep sets
  // status = "paused" (+ audit) so a broken subscription
  // stops retrying forever.
  failureCount       Int      @default(0)
  // OU12: the customer's recorded consent to FUTURE tokenized
  // auto-charge — server timestamp + how the consent was given +
  // an optional staff note. CONSENT ONLY: no shop tokenized
  // charge path exists in this codebase (the tenant gateway
  // client has no bKash agreement / mode-0001 charge method; the
  // one integrated tokenized charge, PaymentsService.
  // chargeAutoRenew, is bound to PLATFORM billing with the
  // platform's own credentials — see
  // docs/one-umbrella-ou12-section.md). Charging is therefore
  // NOT active: renewals stay COD/manual exactly as before, and
  // every surface labels consent as "auto-charge ready —
  // চার্জিং এখনো চালু নয়". All three fields are null together
  // when no consent is on record.
  autoChargeConsentAt     DateTime?
  autoChargeConsentMethod String?
  autoChargeConsentNote   String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer           Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([organizationId, status, nextRunAt])
  @@index([organizationId, customerId])
}

model Visitor {
  id             String           @id @default(uuid())
  organizationId String
  anonymousId    String
  email          String?
  phone          String?
  firstSeenAt    DateTime         @default(now())
  lastSeenAt     DateTime         @default(now())
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sessions       TrackingSession[]
  events         TrackingEvent[]
  touchpoints    Touchpoint[]

  @@unique([organizationId, anonymousId])
  @@index([organizationId, lastSeenAt])
}

model TrackingSession {
  id            String       @id @default(uuid())
  organizationId String
  visitorId     String
  sessionKey    String // id generated by tracker.js for this visit session
  landingPage   String?
  referrer      String?
  utmSource     String?
  utmMedium     String?
  utmCampaign   String?
  utmContent    String?
  utmTerm       String?
  fbclid        String?
  gclid         String?
  ttclid        String?
  startedAt     DateTime     @default(now())
  lastActivityAt DateTime    @default(now())
  visitor       Visitor      @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  touchpoint    Touchpoint?

  @@unique([organizationId, sessionKey])
  @@index([visitorId])
}

model Touchpoint {
  id             String          @id @default(uuid())
  organizationId String
  visitorId      String
  sessionId      String?         @unique
  source         String          @default("direct") // utm_source or platform, "direct" when none
  medium         String?
  campaign       String?
  content        String?
  term           String?
  clickIdType    String? // fbclid | gclid | ttclid
  clickId        String?
  landingPage    String?
  referrer       String?
  isDirect       Boolean         @default(true)
  occurredAt     DateTime        @default(now())
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  visitor        Visitor         @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  session        TrackingSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  credits        AttributionCredit[]

  @@index([organizationId, visitorId, occurredAt])
  @@index([organizationId, source, campaign])
}

model TrackingEvent {
  id              String       @id @default(uuid())
  organizationId  String
  storeId         String?
  visitorId       String?
  sessionKey      String?
  clientEventId   String // idempotency key generated by tracker.js per event
  type            String // page_view | product_view | add_to_cart | checkout_started | lead | purchase | refund | custom
  url             String?
  referrer        String?
  properties      Json?
  orderExternalId String?
  orderId         String?
  valueMinor      BigInt?
  currency        String?
  occurredAt      DateTime
  receivedAt      DateTime     @default(now())
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  visitor         Visitor?     @relation(fields: [visitorId], references: [id], onDelete: SetNull)

  @@unique([organizationId, clientEventId])
  @@index([organizationId, type, occurredAt])
  @@index([organizationId, orderExternalId])
}

enum AttributionModel {
  FIRST_TOUCH
  LAST_TOUCH
  LAST_NON_DIRECT
  LINEAR
}

model AttributionCredit {
  id            String           @id @default(uuid())
  organizationId String
  orderId       String
  model         AttributionModel
  touchpointId  String? // null = unattributed credit row
  revenueMinor  BigInt // allocated revenue for this touchpoint under this model
  createdAt     DateTime         @default(now())
  touchpoint    Touchpoint?      @relation(fields: [touchpointId], references: [id], onDelete: SetNull)

  @@index([organizationId, model])
  @@index([orderId, model])
  @@index([touchpointId])
}

// ---------- Milestone 5: Advertising analytics & profit ----------

model AdAccount {
  id             String       @id @default(uuid())
  organizationId String
  integrationId  String?
  platform       String // meta | google | tiktok | manual
  sourceType     String       @default("api") // api | csv | manual
  externalId     String? // e.g. act_123456789 for Meta
  name           String
  currency       String       @default("BDT")
  status         String       @default("ACTIVE")
  // AD3: the platform's own account status, captured at connect and
  // via refresh-status. platformStatusRaw is the platform's verbatim
  // value (Meta numeric code as string, Google/TikTok status string);
  // platformStatusBucket is the normalized active|disabled|restricted|
  // unknown. Both stay null when the platform reports no status —
  // never guessed. timezone is the account's platform-reported
  // timezone (informational in v1).
  platformStatusRaw       String?
  platformStatusBucket    String?
  timezone                String?
  platformStatusCheckedAt DateTime?
  // AD4: per-account spend watchdog — ALERTING ONLY (no platform kill
  // switch is held at account level, and v1 builds no enforcement).
  // dailyCapMinor is an alert threshold in the account's own currency
  // minor units; anomalyPct alerts when today's spend reaches the
  // trailing complete-day average × (1 + pct/100); null = off.
  spendWatchEnabled Boolean  @default(false)
  dailyCapMinor     BigInt?
  anomalyPct        Int?
  // AD5: per-account sync switch. When true, every platform-data
  // sync path for this account (manual insights/breakdown/status
  // sync + the scheduled insights jobs) refuses/skips — publishing
  // is a different concern and is NOT affected by this flag.
  syncDisabled      Boolean  @default(false)
  // AD6: tenant-chosen display label (free text; trimmed and capped
  // at 60 chars service-side). NULL/empty = show the platform name.
  label             String?
  // CC17: free-text group name (brand/branch) — same display
  // grouping as Integration/SocialAccount (see Integration.label).
  groupName         String?
  // CC15: Meta's own account-completeness report for this ad
  // account (payment-method-on-file BOOLEAN — never card data) —
  // same verbatim-snapshot discipline as
  // Integration.providerHealth; when Meta gives no answer the
  // field stays absent (unknown), never false-by-default.
  providerHealth    Json?
  providerHealthAt  DateTime?
  providerHealthError String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaigns      AdCampaign[]
  metrics        DailyAdMetric[]

  @@unique([organizationId, platform, externalId])
  @@index([organizationId, platform])
}

model AdCampaign {
  id          String       @id @default(uuid())
  organizationId String
  adAccountId String
  externalId  String
  name        String
  objective   String?
  status      String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  adAccount   AdAccount    @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
  metrics     DailyAdMetric[]

  @@unique([adAccountId, externalId])
  @@index([organizationId])
}

// One row per account + campaign + day + source.
// campaignExternalId is "" (never null) for account-level/manual rows so the
// unique constraint can deduplicate them in Postgres.
model DailyAdMetric {
  id                   String      @id @default(uuid())
  organizationId       String
  adAccountId          String
  adCampaignId         String?
  platform             String
  source               String // api | csv | manual
  campaignExternalId   String      @default("")
  // Ad-level rows (Phase G): empty for campaign-level rows.
  adSetExternalId      String      @default("")
  adSetName            String?
  adExternalId         String      @default("")
  adName               String?
  reach                Int         @default(0)
  videoViews           Int         @default(0)
  campaignName         String?
  date                 DateTime // UTC midnight of the reporting day
  currency             String      @default("BDT")
  spendMinor           BigInt      @default(0)
  impressions          Int         @default(0)
  clicks               Int         @default(0)
  // Platform-reported conversions. Kept strictly separate from the SaaS's
  // own tracked conversions (attribution credits); they will not match.
  platformConversions  Int         @default(0)
  platformConversionValueMinor BigInt @default(0)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  adAccount            AdAccount   @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
  adCampaign           AdCampaign? @relation(fields: [adCampaignId], references: [id], onDelete: SetNull)

  @@unique([organizationId, adAccountId, campaignExternalId, adSetExternalId, adExternalId, date, source])
  @@index([organizationId, date])
  @@index([organizationId, platform, date])
}

model DailyMetricAggregate {
  id              String       @id @default(uuid())
  organizationId  String
  date            DateTime // UTC midnight
  orders          Int          @default(0)
  revenueMinor    BigInt       @default(0) // revenue-bearing orders (excl. cancelled/refunded/failed)
  refundedMinor   BigInt       @default(0)
  cogsMinor       BigInt       @default(0) // estimated from known product costs
  cogsKnownOrders Int          @default(0) // orders where every item had a known cost
  adSpendMinor    BigInt       @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, date])
  @@index([organizationId, date])
}

// ---------- Milestone 6: AI intelligence ----------

model AIConversation {
  id             String      @id @default(uuid())
  organizationId String
  userId         String
  title          String?
  // AP7: specialist persona for this conversation (general |
  // ads_analyst | inbox_coach | finance_analyst). Scopes the tool
  // modules the assistant may use; enforced server-side.
  persona        String      @default("general")
  // Milestone 45: pinned conversations sort first in the assistant.
  pinnedAt       DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messages       AIMessage[]

  @@index([organizationId, userId, updatedAt])
}

model AIMessage {
  id             String         @id @default(uuid())
  conversationId String
  role           String // user | assistant
  content        String
  // Tool calls that produced this assistant message, for transparency.
  toolCalls      Json?
  // AP2: a file/image the user attached to THIS message. The text is
  // the server-extracted content (documents) or the vision model's
  // description (images), capped at 12,000 chars, so the bubble can
  // show exactly what the assistant was given — citations stay
  // honest after a reload. Null for ordinary messages.
  attachmentName String?
  attachmentKind String? // file | image
  attachmentText String?
  createdAt      DateTime       @default(now())
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// GV3 (Global Assistant v2, G4): a user's saved chat prompts for the
// "/" picker. Per-user by design (org-shared prompts would need a
// sharing policy — deferred). Scalar org/user ids like
// AgentNotification; every query is scoped to both.
model AiSavedPrompt {
  id             String   @id @default(uuid())
  organizationId String
  userId         String
  title          String
  body           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, userId, updatedAt])
}

// Every AI tool execution is logged here (who, which org, what tool,
// sanitized args, status). This is the audit trail for AI actions.
model AIAction {
  id             String       @id @default(uuid())
  organizationId String
  userId         String?
  conversationId String?
  toolName       String
  args           Json?
  status         String // success | error | denied
  error          String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

// Milestone 47: write actions proposed by the AI assistant. A proposal
// NEVER executes on creation — a human must approve it, and execution
// goes through the existing confirmed service paths. The full
// lifecycle (proposed/approved/rejected/executed/failed) is stored so
// a platform failure is recorded as failure, never as success.
model AIActionProposal {
  id               String    @id @default(uuid())
  organizationId   String
  userId           String? // proposer (null when the proposer is the AI itself — see proposedBy)
  conversationId   String?
  recommendationId String?
  type             String // pause_campaign | pause_ad_set | create_broadcast_draft | <catalog actionId> (SA-B10)
  title            String
  preview          String // exact human-readable statement of what approval will do
  payload          Json // server-validated arguments (ids / draft fields)
  status           String    @default("proposed") // proposed | approved | executing | rejected | executed | failed
  // SA-B10 (W1 Action Engine): catalog-driven proposals carry the
  // catalog action id + surface, who proposed (ai | staff), the
  // autonomy level snapshotted at proposal time, the origin
  // reference (conversation/comment ids), and the verifier's
  // read-back outcome. All null on legacy Milestone-47 rows.
  actionId         String?
  surface          String? // inbox | comment
  proposedBy       String? // ai | staff
  autonomyLevel    Int? // 0 | 1 | 2 snapshot (absent setting = level 1)
  sourceRef        Json?
  verification     Json?
  decidedById      String?
  decidedAt        DateTime?
  executedAt       DateTime?
  result           Json?
  error            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([organizationId, actionId, status])
}

// SA-B10 (Smart AI Phase 2, W1): per-org autonomy level for ONE
// catalog action (plan decision D5). Absence of a row means the
// default level 1 (propose-only: a human approves before anything
// executes). Level 0 = the action is off (propose() refuses);
// level 2 = low-risk catalog actions may auto-execute (everything
// else still waits for approval). Level 3 (supervised auto) is
// deliberately NOT storable through the settings API — it needs a
// separate owner decision, so setAutonomy rejects it outright.
model AiAutonomySetting {
  id             String     @id @default(uuid())
  organizationId String
  actionId       String // catalog action id (ai/actions/action-catalog.ts)
  level          Int        @default(1) // 0 | 1 | 2
  updatedById    String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, actionId])
  @@index([organizationId])
}

model AIReport {
  id             String       @id @default(uuid())
  organizationId String
  type           String // daily | weekly | monthly
  periodStart    DateTime
  periodEnd      DateTime
  title          String
  content        String // rendered report text (markdown)
  structured     Json? // sections, evidence, metrics snapshot used
  provider       String // openai | anthropic | gemini | dev-template
  model          String?
  version        Int          @default(1)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recommendations AIRecommendation[]

  @@unique([organizationId, type, periodStart, periodEnd])
  @@index([organizationId, createdAt])
}

model AIRecommendation {
  id             String   @id @default(uuid())
  organizationId String
  reportId       String?
  title          String
  detail         String?
  priority       String   @default("medium") // low | medium | high
  status         String   @default("open") // open | done | dismissed
  evidence       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  report         AIReport? @relation(fields: [reportId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
}

model AIUsageRecord {
  id             String       @id @default(uuid())
  organizationId String
  userId         String?
  feature        String // chat | report
  provider       String
  model          String?
  inputTokens    Int          @default(0)
  outputTokens   Int          @default(0)
  estimated      Boolean      @default(false) // true when token counts are estimates (dev adapter)
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

// Milestone 48: per-org proactive assistant switches. Absence of a row
// means the defaults (briefing on, anomaly alerts on).
model AIProactiveSetting {
  id                   String     @id @default(uuid())
  organizationId       String     @unique
  briefingEnabled      Boolean    @default(true)
  anomalyAlertsEnabled Boolean    @default(true)
  // CX12b (12e completion): also email the daily briefing to
  // OWNER/ADMIN members. Default OFF; the in-app notification
  // remains the primary path and email is only a copy.
  dailyReportEmailEnabled Boolean @default(false)
  // AP6: also send the daily briefing to a Telegram chat through
  // the org's connected Telegram bot integration. Default OFF;
  // needs telegramBriefChatId (the owner's chat id) + a connected
  // telegram integration, else the copy is honestly skipped.
  telegramBriefEnabled Boolean    @default(false)
  telegramBriefChatId  String?
  // AP7: autonomy level (0 = approve everything, default;
  // 2 = auto-execute internal-only proposal types) and the
  // per-tenant assistant display name (white-label identity).
  autonomyLevel        Int        @default(0)
  assistantName        String?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// ---------- Milestone 7: unified inbox + leads/CRM ----------

// AP7: org-scoped Assistant API keys. Only the SHA-256 hash is
// stored; the plaintext key is shown exactly once at creation.
model AssistantApiKey {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  keyPrefix      String
  keyHash        String    @unique
  createdById    String
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

model ChannelConversation {
  id             String   @id @default(uuid())
  organizationId String
  integrationId  String?
  channel        String // whatsapp | messenger
  // Who the customer is on the platform: WhatsApp wa_id (phone) or
  // Messenger PSID. Unique per (organization, channel).
  externalContactId String
  contactName    String?
  contactPhone   String?
  customerId     String?
  leadId         String?
  status         String   @default("open") // open | pending | closed
  assignedUserId String?
  teamId         String?
  // Unified Inbox U3: autopilot paused for this conversation after
  // an escalation (human ask, complaint, dispute, high value...).
  // A human reply resumes it.
  autoReplyPaused Boolean @default(false)
  // CX3: wait-before-answering (debounce). When an AI reply is
  // deferred, autoReplyDueAt is when the sweep may fire it and
  // autoReplyBatchSince marks the start of the message batch the
  // reply must cover. Both null = no pending deferred reply.
  autoReplyDueAt DateTime?
  autoReplyBatchSince DateTime?
  // CX4: handover queue — the escalation reason and when the
  // handover started (waiting clock), written by escalateAutopilot
  // alongside autoReplyPaused. Null on pre-CX4 / never-escalated
  // rows; the queue UI falls back to updatedAt for those.
  handoverReason String?
  handoverAt     DateTime?
  // CX4: timed assignment — assignedAt is when the current
  // assignment started (the sweep's "replied since assignment"
  // reference), assignedUntil the timer deadline and
  // assignmentKind "timed" | "normal" (null when unassigned).
  assignedUntil  DateTime?
  assignmentKind String?
  assignedAt     DateTime?
  // CX5: snooze — the conversation is parked until this time.
  snoozedUntil   DateTime?
  // IN4: SLA escalation chain markers — when each chain step
  // fired for this conversation's (single) first-response wait.
  // Null = not fired. The sla_sweep only ever considers rows
  // with firstResponseAt NULL, so a marker, once set, is never
  // re-armed — the chain fires at most once per step per
  // conversation, never a notification storm.
  slaWarnedAt          DateTime?
  slaLeadAlertedAt     DateTime?
  slaAutoReassignedAt  DateTime?
  // CX12a: practice conversation — synthetic thread created by
  // Practice Mode. No real channel identity (integrationId stays
  // null, externalContactId is a practice-* token); every outbound
  // send on it is stored locally as a practice message and NEVER
  // handed to a channel sender.
  isPractice      Boolean @default(false)
  // Unified Inbox U4: email lane — the thread's subject line.
  subject         String?
  // Unified Inbox U5: sales pipeline stage (new | talking |
  // ordered | delivered | repeat) — advanced by real events
  // (first reply, chat order) and movable by agents; "delivered"
  // is also derived at read time from the linked order/shipment.
  pipelineStage   String   @default("new")
  // Unified Inbox U5: outcome recorded when the thread closes
  // (sale | no_sale_price | no_sale_stock | no_sale_undecided |
  // support_resolved | spam | other) — feeds analytics.
  outcome         String?
  outcomeReason   String?
  tags           String[] @default([])
  // Last time the CUSTOMER messaged us. Drives the WhatsApp 24h
  // customer-service window (window = lastCustomerMessageAt + 24h).
  lastCustomerMessageAt DateTime?
  priority       String   @default("normal") // normal | high (complaint/angry)
  sentimentFlag  String?  // negative | null
  // Rule-based spam suspicion (repeated identical messages, promo-link
  // first contact). Flagged for a human - never auto-deleted.
  spamFlag       Boolean  @default(false)
  spamReason     String?
  // IN10a: agent-applied customer block. OUR system-level block only
  // (the platform is never asked to block anyone): while blockedAt is
  // set, inbound messages are still stored and land in the spam queue,
  // but the order bot / autopilot / auto-transcription never run for
  // this conversation (no AI spend), and the row is labelled blocked
  // in the UI. Manual agent replies still work. Null = not blocked.
  blockedAt       DateTime?
  blockedByUserId String?
  blockReason     String?
  // CSAT: rating question sent when a conversation is closed; the
  // customer's 1-5 reply is recorded here.
  csatSentAt     DateTime?
  csatRating     Int?
  csatRatedAt    DateTime?
  // Latest thread summary (LLM when configured, otherwise a clearly
  // labeled data digest) with its provider for honesty.
  summaryText    String?
  summaryProvider String?
  summaryAt      DateTime?
  // SLA clocks: first outbound reply time, and when it was resolved.
  firstResponseAt DateTime?
  resolvedAt      DateTime?
  unreadCount    Int      @default(0)
  lastMessageAt  DateTime?
  lastMessagePreview String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  notes          ConversationNote[]
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messages       ChannelMessage[]
  drafts         MessageDraft[]

  @@unique([organizationId, channel, externalContactId])
  @@index([organizationId, status, lastMessageAt])
  ctwaSourceId         String? // originating ad id when the chat came from a Click-to-WhatsApp ad
}

model ChannelMessage {
  id             String   @id @default(uuid())
  conversationId String
  direction      String // in | out
  // Platform message id (WhatsApp wamid / Messenger mid). Unique so
  // webhook retries are idempotent.
  externalId     String?
  type           String   @default("text") // text | image | audio | video | document | template | other
  content        String?
  mediaUrl       String?
  // WhatsApp media id (Messenger attachments carry a direct mediaUrl).
  // Bytes are fetched through the API media proxy, never exposed raw.
  mediaId        String?
  // Unified Inbox U6: bytes persisted to the media pipeline
  // (S3-compatible or local store) at capture time, because
  // platform media ids/urls expire. Served via signed URL or the
  // authenticated proxy.
  mediaStorageKey   String?
  mediaContentType  String?
  mediaSizeBytes    Int?
  // Rule-based intent classification at ingest (price | stock | delivery
  // | order_status | payment | complaint | greeting | other) with a
  // 0-100 confidence. A heuristic label, shown to agents as an estimate.
  intent           String?
  intentConfidence Int?
  // Voice-note transcription (provider recorded; never fabricated -
  // stays null when no speech provider is configured).
  transcription    String?
  transcriptionProvider String?
  // CX12c: auto-transcription attempt state for inbound voice
  // notes. null = never attempted / not an audio message;
  // "pending" = an attempt is in flight (stamped before the
  // provider call); "done" = transcription stored above;
  // "failed" = provider/media failure; "unavailable" = no speech
  // provider configured for this deployment. "failed" and
  // "unavailable" are terminal for the auto path — a re-dispatch
  // never retries them (the agent's manual transcribe action is
  // the retry path).
  transcriptionStatus String?
  // True when this outbound message was sent by the grounded auto-reply
  // engine (still only "sent" with a platform message id).
  autoReply        Boolean @default(false)
  // JSON evidence the auto-reply was grounded in (product id + price,
  // policy id, order id + status) - auditable, never invented data.
  autoReplyEvidence String?
  // in: received. out: queued -> sent -> delivered -> read, or failed.
  status         String   @default("received")
  error          String?
  sentByUserId   String?
  sentByAiDraft  Boolean  @default(false)
  // CX11ac: reply attribution — true when this outbound message was
  // sent with AI assistance (ghost text / tone rewrite), and the
  // QuickReply it came from, when it came from one.
  sentWithAiAssist Boolean @default(false)
  quickReplyId   String?
  platformTimestamp DateTime?
  // IN6a: platform-CONFIRMED delivery lifecycle, separate from the
  // internal `status` flow. deliveryStatus is set ONLY from a real
  // webhook status (WhatsApp statuses / Messenger deliveries) or a
  // real visitor read (webchat listMessages) — never guessed at
  // send time. Monotonic: sent < delivered < read; failed is
  // terminal-side. deliveredAt/readAt stamp the confirming event.
  deliveryStatus String? // sent | delivered | read | failed
  deliveredAt    DateTime?
  readAt         DateTime?
  // IN6b: the message this one quotes — always a row in the SAME
  // conversation (validated at send/ingest; never cross-thread).
  replyToMessageId String?
  // IN6c: reactions as [{emoji, actor: "customer"|"page", at}]
  // (JSON). Customer entries come only from real Meta reaction
  // webhooks; "page" entries only after Meta confirms our send.
  reactions      Json?
  // IN6d: pin state (DB-only feature, every channel). pinnedBy is
  // the acting user's id; both clear together on unpin.
  pinnedAt       DateTime?
  pinnedBy       String?
  createdAt      DateTime @default(now())
  conversation   ChannelConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, externalId])
  @@index([conversationId, createdAt])
  referral             Json? // CTWA ad referral (source id/type/url) when Meta sends it
}

// AI-suggested replies. A draft is NEVER sent by the AI itself: a human
// approves (optionally after editing) and only then does it go out
// through the normal send path, which records the API confirmation.
model MessageDraft {
  id             String   @id @default(uuid())
  organizationId String
  conversationId String
  content        String
  status         String   @default("suggested") // suggested | sent | dismissed
  provider       String // openai | anthropic | gemini | dev-template
  // CX11ac: true when the agent edited this draft before sending it.
  sentEdited     Boolean  @default(false)
  createdByUserId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  conversation   ChannelConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([organizationId, conversationId, status])
}

/// IN1: an agent's saved inbox filter combination (personal or
/// team-shared). `filters` is a validated JSON object holding ONLY
/// the whitelisted list-filter keys (see InboxService.
/// sanitizeSavedViewFilters) — never arbitrary client payloads.
/// Visibility: the creator always sees their own views; shared
/// views are visible to the whole org. Only the creator may edit
/// or delete a view.
model InboxSavedView {
  id             String   @id @default(uuid())
  organizationId String
  userId         String
  name           String
  filters        Json
  shared         Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, userId])
  @@index([organizationId, shared])
}

/// IN3: a named, ordered macro — a sequence of inbox actions
/// (reply via a quick reply / assign / tag / pipeline stage /
/// close / snooze) an agent runs on one conversation in one click.
/// `steps` is a STRICTLY validated JSON array (see InboxService.
/// sanitizeMacroSteps): unlike saved-view filters, an invalid step
/// is a client error at write time, never silently dropped —
/// a macro must do exactly what its definition shows, no less.
/// Visibility mirrors saved views: the creator always sees their
/// own macros; shared macros are visible to the whole org. Only
/// the creator may edit or delete a macro.
model InboxMacro {
  id             String   @id @default(uuid())
  organizationId String
  userId         String
  name           String
  steps          Json
  shared         Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, userId])
  @@index([organizationId, shared])
}

model Lead {
  id             String   @id @default(uuid())
  organizationId String
  customerId     String?
  name           String
  phone          String?
  email          String?
  source         String   @default("manual") // manual | whatsapp | messenger | woocommerce | website | facebook_lead_ads
  externalId     String? // platform-side id (e.g. Meta leadgen id) for idempotent sync
  // CA20 (CB5): the LeadForm record this lead arrived
  // through, stamped by the inbox leadgen ingest ONLY
  // when Meta's form_id resolves to one of the org's
  // modelled LeadForms. Null = the lead cannot be
  // attributed to a form (every pre-CA20 lead, and any
  // lead from a form the org never modelled) — per-form
  // quality reports count these as unattributed coverage,
  // never guess a form from the notes text.
  leadFormId     String?
  mergedIntoId String? // set when this lead was merged into another
  stage          String   @default("new") // new | contacted | qualified | proposal | won | lost
  tags           String[] @default([])
  valueMinor     BigInt?
  currency       String   @default("BDT")
  ownerUserId    String?
  notes          String?
  nextFollowUpAt DateTime?
  lastContactedAt DateTime?
  // CRM C4: values for the org's CustomFieldDefs (entity "lead"),
  // keyed by def.key. Validated server-side; never per-field columns.
  customFields   Json?
  // CX10: opt-out unsubscribe flag
  unsubscribed   Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  activities     LeadActivity[]

  @@index([organizationId, stage])
  @@index([organizationId, phone])
  @@index([organizationId, leadFormId])
}

model LeadActivity {
  id        String   @id @default(uuid())
  leadId    String
  userId    String?
  type      String // note | stage_change | created | converted | message
  content   String
  createdAt DateTime @default(now())
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
}

// CRM C4: per-org custom field definitions for leads and customers.
// Values live ONLY in Lead.customFields / Customer.customFields
// (JSON keyed by `key`); this table holds the definitions. A def's
// key is immutable after create (stored values reference it), and
// archiving (archivedAt) hides the field from validation/UI/exports
// without deleting anyone's stored values.
model CustomFieldDef {
  id             String    @id @default(uuid())
  organizationId String
  entity         String // lead | customer
  key            String // slug, unique per org+entity, immutable
  label          String
  type           String // text | number | date | select
  options        Json? // string[] for type=select, else null
  required       Boolean   @default(false)
  sortOrder      Int       @default(0)
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, entity, key])
  @@index([organizationId, entity])
}

// CRM C5 (Leads & CRM Package): the org's lead auto-assignment
// setting — at most one row per org, InboxSetting-style (no row =
// defaults). leadAssignStrategy: off | round_robin |
// least_open_leads. rrCursorUserId is the round-robin cursor —
// the member who received the most recent AUTO-assignment; it
// advances only on an actual auto-assignment, never when a
// caller supplies an explicit owner.
model CrmSetting {
  id                 String   @id @default(uuid())
  organizationId     String   @unique
  leadAssignStrategy String   @default("off")
  rrCursorUserId     String?
  // CX10: per-stage default follow-up intervals in HOURS, keyed by
  // Lead stage ({ "new": 24, "contacted": 72, ... }). Null (the
  // pre-CX10 state of every org) = no automatic follow-up stamping
  // at all — LeadsService behaviour is then exactly as before.
  // Validated at the settings write path (stages = LEAD_STAGES,
  // hours integers 1..8760); a stage absent from the map has no
  // default. See crm/lead-followups.ts (followUpDefaultFor).
  followUpDefaultsByStage Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// ---------- Milestone 8: competitor intelligence (public data only) ----------

model Competitor {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  facebookPageId String?
  facebookPageUrl String?
  websiteUrl     String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ads            CompetitorAd[]
  priceObservations CompetitorPriceObservation[]

  @@index([organizationId])
}

model CompetitorAd {
  id             String   @id @default(uuid())
  competitorId   String
  // Ad Library archive id. Unique per competitor so re-syncs update rows.
  externalAdId   String
  pageId         String?
  pageName       String?
  startedAt      DateTime?
  stoppedAt      DateTime?
  isActive       Boolean  @default(false)
  platforms      String[] // publisher_platforms from the Ad Library
  creativeText   String?
  linkUrl        String?
  snapshotUrl    String?
  firstSeenAt    DateTime @default(now())
  lastSeenAt     DateTime @default(now())
  raw            Json?
  competitor     Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  @@unique([competitorId, externalAdId])
  @@index([competitorId, startedAt])
}

model CompetitorPriceObservation {
  id             String   @id @default(uuid())
  competitorId   String
  productName    String
  priceMinor     BigInt
  currency       String   @default("BDT")
  // Evidence is mandatory: every observation carries where it was seen.
  sourceUrl      String
  sourceType     String // website_scan | manual | ad_library
  observedAt     DateTime @default(now())
  competitor     Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  @@index([competitorId, observedAt])
}

// An insight may only exist with evidence. The service enforces this:
// insights without at least one valid evidence reference are dropped.
model CompetitorInsight {
  id             String   @id @default(uuid())
  organizationId String
  competitorId   String?
  kind           String // pricing | creative | positioning | activity
  title          String
  detail         String?
  evidence       Json // [{ ref, label, url? }]
  provider       String
  createdAt      DateTime @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

// ---------- Milestone 9: campaign builder + publishing ----------
// Workflow: draft -> pending_approval -> approved -> publishing ->
// published | publish_failed; rejected returns to editable.
// NOTHING reaches Meta before "approved". Published objects are created
// PAUSED; activation is a separate, explicit human action.

model CampaignPlan {
  id             String   @id @default(uuid())
  organizationId String
  adAccountId    String // our AdAccount record (must be a Meta API account)
  name           String
  objective      String // OUTCOME_SALES | OUTCOME_TRAFFIC | OUTCOME_LEADS | OUTCOME_ENGAGEMENT | OUTCOME_AWARENESS
  status         String   @default("draft")
  isTemplate     Boolean  @default(false)
  externalCampaignId String?
  metaStatus     String? // PAUSED | ACTIVE as last confirmed by the API
  createdById    String
  approvedById   String?
  approvedAt     DateTime?
  // Campaign Builder Next CN11: two-step approval chain.
  // When the org's CampaignApprovalSetting.twoStepApproval
  // is on, the FIRST approver is recorded here and the plan
  // stays pending_approval until a DIFFERENT approver
  // completes the approval (approvedById = the second).
  firstApproverId String?
  firstApprovedAt DateTime?
  rejectionReason String?
  publishedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  adSets         CampaignAdSet[]
  publishLogs    CampaignPublishLog[]

  @@index([organizationId, status])
  metaEffectiveStatus  String? // ACTIVE | PAUSED | DISAPPROVED | WITH_ISSUES ... as Meta reports it
  lastStatusSyncAt     DateTime?
  abGroupId            String?
  abVariant            String?
  abMetric             String?
  advantagePlus Boolean @default(false)
  // Campaign Builder Advanced CA23 (CB6): Meta's OWN
  // read-back of this campaign's Advantage+ state
  // (GET /{campaign}?fields=advantage_state_info after
  // publish). advantageState is Meta's verdict verbatim
  // (ADVANTAGE_PLUS_SALES | ADVANTAGE_PLUS_APP |
  // ADVANTAGE_PLUS_LEADS | DISABLED); null = never read
  // back. The local advantagePlus flag is only the
  // merchant's INTENT — the UI must show this read-back,
  // never the flag, as the confirmed state. The full
  // advantage_state_info object is kept verbatim.
  advantageState String?
  advantageStateInfo Json?
  advantageStateCheckedAt DateTime?
  // Campaign Builder CB2: optional plan-level daily
  // budget cap (minor units). Submit + publish refuse
  // when the ad sets' daily budgets sum above it.
  dailyBudgetCapMinor BigInt?
  // Campaign Builder CB4: the full definition frozen
  // at submit-for-approval. Publish re-compares it —
  // what was approved is what gets published.
  submissionSnapshot Json?
  // Campaign Builder CB5: scheduled launch. Only an
  // APPROVED plan may carry this; the launch scan
  // publishes it (PAUSED, as always) at this time.
  publishAt DateTime?
  // Campaign Builder Advanced CA12 (CB3): plan-level
  // scheduled pause/resume window on a PUBLISHED plan,
  // executed by the per-org plan_schedule_sweep automation
  // job through the same setMetaStatus paths a manual
  // pause uses. The *ExecutedAt stamps are the exactly-once
  // markers: the sweep claims a due window by stamping it
  // (updateMany on the unstamped row) before acting, so
  // re-runs are no-ops. Clearing the window clears the
  // stamps with it.
  pauseAt DateTime?
  resumeAt DateTime?
  pauseExecutedAt DateTime?
  resumeExecutedAt DateTime?
  // Campaign Builder Advanced CA17 (CB4): the plan-level
  // UTM template — a JSON object over the keys source /
  // medium / campaign / content / term whose values may
  // carry the tokens {platform} {campaign} {adset} {ad}.
  // Null = the built-in default scheme (per-platform
  // source, medium "cpc", campaign = plan-name slug,
  // content = ad-set slug, term = ad slug). Applied by
  // every publish path (Meta url_tags + tagged link,
  // Google finalUrlSuffix, TikTok landing URL params);
  // a link's existing utm_* params are the owner's and
  // are never overwritten.
  utmTemplate Json?
  // Campaign Builder Next CN2: TRUE campaign budget for
  // every plan. budgetMode "abo" = budgets live on the ad
  // sets (the pre-CN2 behaviour); "cbo" = the campaign
  // budgets below go on the Meta campaign and ad sets
  // carry none. Advantage+ implies CBO at publish (as it
  // did before, via the first ad set's daily budget when
  // no explicit campaign budget is set).
  budgetMode                   String  @default("abo")
  campaignDailyBudgetMinor     BigInt?
  campaignLifetimeBudgetMinor  BigInt?
  // Campaign Builder Frontier CN16 (NB7): set ONLY on a
  // plan a recurring series generated — the series row id
  // and the occurrence date the instance belongs to. The
  // template plan and hand-made clones keep both null.
  seriesId             String?
  seriesInstanceDate   DateTime?
}

// Campaign Builder Advanced CA18 (CB5): a pacing alert
// raised by the per-org pacing_alert_sweep job when a live
// plan's REAL DailyAdMetric rows cross a stated threshold
// (projected exhaustion before the plan end date, or burn
// pace implying overspend vs expected-to-date). One ACTIVE
// row per (plan, kind): the sweep dedupes on status, a
// condition that stops firing CLEARS its row, and a
// persistent condition re-notifies at most once per
// cooldown (lastNotifiedAt). detail carries the exact
// numbers behind the alert — an alert never exists without
// its arithmetic.
model PlanPacingAlert {
  id             String    @id @default(uuid())
  organizationId String
  planId         String
  kind           String // early_exhaustion | overspend_pace
  status         String    @default("active") // active | cleared
  message        String
  detail         Json
  raisedAt       DateTime  @default(now())
  clearedAt      DateTime?
  lastNotifiedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([organizationId, planId, status])
  @@index([organizationId, status])
}

// Campaign Builder Advanced CA19 (CB5): a geo holdout
// DEFINITION on a plan. Spike verdict (official Meta
// docs, 2026-10-17): an Ad Study cannot split by
// geography — SPLIT_TEST cells are { name,
// treatment_percentage, campaigns }, a randomized
// AUDIENCE split; no region field exists on the study
// contract CN15 uses. So this row is a definition only:
// it changes NO delivery by itself (the merchant excludes
// the holdout regions in targeting); the measurement
// view compares stored region breakdown rows between
// the two region sets over the window and is labelled
// OBSERVATIONAL — never an experiment, never a lift %.
// At most one ACTIVE definition per plan (service rule).
model PlanGeoHoldout {
  id             String   @id @default(uuid())
  organizationId String
  planId         String
  testRegions    Json // [{ name }] — region names as stored in DailyAdBreakdown keys
  holdoutRegions Json // [{ name }]
  startsAt       DateTime
  endsAt         DateTime
  status         String   @default("active") // active | ended
  note           String?
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, planId, status])
}

// Campaign Builder Advanced CA22 (CB5): a builder inbox
// signal — a competitor observation the merchant wants
// to respond to. Sources: manual entry by the merchant,
// or a one-click import of a REAL stored competitor row
// (CompetitorInsight / CompetitorPriceObservation /
// long-running CompetitorAd) — the import composes OUR
// summary text from stored fields; competitor creative
// text and assets are never copied (the CN18 leak-proof
// rule). The AUTOMATED competitor feed into this inbox
// is NOT BUILT — competitor monitoring stays in its
// planned Smart AI sequence (C1–C2, owner decision
// 2026-10-17); imports are merchant-triggered, from rows
// that already exist. status: new -> drafted (a
// suggestPlan DRAFT was created — never published) |
// dismissed.
model BuilderInboxSignal {
  id             String   @id @default(uuid())
  organizationId String
  source         String // manual | competitor_insight | competitor_price | competitor_ad
  sourceRefId    String? // the stored competitor row this was imported from
  competitorId   String?
  text           String
  productId      String?
  status         String   @default("new") // new | drafted | dismissed
  draftPlanId    String?
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, status, createdAt])
  @@index([organizationId, source, sourceRefId])
}

// Campaign Builder CB4: discussion on a plan
// (approval conversation, change requests, notes).
model CampaignPlanComment {
  id             String   @id @default(uuid())
  organizationId String
  planId         String
  authorId       String
  body           String
  createdAt      DateTime @default(now())

  @@index([planId, createdAt])
}

// Campaign Builder Next CN11: an immutable snapshot of a
// plan's definition (the same definitionOf shape frozen at
// submit). kind "submit" rows are written by
// submitForApproval alongside submissionSnapshot; kind
// "manual" rows are explicit snapshots. A version can be
// diffed against the live definition and restored into a
// NEW draft plan — restoring never edits the source plan.
// Campaign Builder Advanced CA26 (CB6): blueprint
// definitions as DATA. Platform rows have organizationId
// null — owned by the platform team (admin CRUD), read-only
// for orgs. An org may clone a platform blueprint into its
// own editable copy (organizationId set). The migration
// seeds the five platform rows with the EXACT definitions
// that used to be code constants (a spec compares the
// migration's seed JSON against the code seed source).
// Campaign Builder Advanced CA27 (CB6): per-ad version
// history. updateAd snapshots the BEFORE image of an
// ad's content fields whenever an edit actually changes
// them; restore writes an old snapshot back AND records
// the pre-restore state as a new version first — history
// is append-only, never rewritten. External ids are NOT
// part of the snapshot: restoring content never touches
// the ad's Meta binding.
model CampaignAdVersion {
  id             String   @id @default(uuid())
  adId           String
  organizationId String
  version        Int
  snapshot       Json
  source         String   @default("edit") // edit | restore
  createdById    String?
  createdAt      DateTime @default(now())

  @@index([adId])
  @@index([organizationId])
}

model CampaignBlueprint {
  id             String   @id @default(uuid())
  key            String
  name           String
  objective      String
  advantagePlus  Boolean  @default(false)
  description    String
  adSet          Json
  ad             Json
  organizationId String?
  version        Int      @default(1)
  category       String?
  tags           String[] @default([])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([key])
  @@index([organizationId])
}

model CampaignPlanVersion {
  id             String   @id @default(uuid())
  organizationId String
  planId         String
  kind           String // submit | manual
  definition     Json
  createdById    String
  createdAt      DateTime @default(now())

  @@index([planId, createdAt])
}

// Campaign Builder Next CN11: per-org approval governance.
// Absent row = the default (twoStepApproval false, the
// pre-CN11 single-approval behaviour).
model CampaignApprovalSetting {
  id              String   @id @default(uuid())
  organizationId  String   @unique
  twoStepApproval Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Campaign Builder Next CN11: a user's saved Campaign Hub
// filter state (opaque Json — the hub owns its shape).
// Views are personal: list/delete are scoped to the owner.
model CampaignSavedView {
  id             String   @id @default(uuid())
  organizationId String
  userId         String
  name           String
  filters        Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, userId])
}

// Campaign Builder Next CN4 (NB2): a Meta Lead Ads Instant
// Form, modelled locally first. status becomes "created"
// ONLY when Meta's POST /{pageId}/leadgen_forms returned a
// form id (stored in externalFormId); a Meta refusal is kept
// verbatim in error with status "failed" — never hidden.
// fieldMapping maps a question key to a CRM lead target:
// "name" | "email" | "phone" | "notes" | "custom:<fieldKey>"
// (a CustomFieldDef with entity "lead"); the Inbox leadgen
// ingest applies it when a lead arrives for externalFormId.
model LeadForm {
  id               String   @id @default(uuid())
  organizationId   String
  pageId           String // Meta Page id that owns the form
  name             String
  locale           String   @default("EN_US")
  introHeadline    String?
  introDescription String?
  questions        Json // [{ key, type, label?, options?: [{ key, value }] }]
  privacyPolicyUrl String
  privacyLinkText  String?
  thankYouTitle    String?
  thankYouBody     String?
  thankYouButtonText String?
  followUpActionUrl String?
  higherIntent     Boolean  @default(false)
  fieldMapping     Json?
  externalFormId   String?
  status           String   @default("local") // local | created | failed
  error            String?
  createdById       String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, externalFormId])
}

model CampaignAdSet {
  id             String   @id @default(uuid())
  planId         String
  name           String
  externalAdSetId String?
  dailyBudgetMinor BigInt?
  lifetimeBudgetMinor BigInt?
  billingEvent   String   @default("IMPRESSIONS")
  optimizationGoal String // LINK_CLICKS | OFFSITE_CONVERSIONS | LEAD_GENERATION | REACH
  pageId         String?
  pixelId        String?
  // Campaign Builder Next CN3 (NB2): the chosen conversion
  // event for pixel optimization (Meta custom_event_type,
  // e.g. PURCHASE | ADD_TO_CART | LEAD). Null = the legacy
  // default (PURCHASE for OFFSITE_CONVERSIONS/VALUE).
  conversionEvent String?
  // CN3: REAL catalog ads — local CatalogRecord / ProductSet
  // record ids; publish resolves the set's Meta externalSetId
  // and sends it as promoted_object.product_set_id. Both or
  // neither (validated in the service).
  catalogRecordId String?
  productSetId    String?
  // CN4 (NB2): the LeadForm record attached to a lead ad set.
  leadFormId      String?
  // Campaign Builder Advanced CA23 (CB6): app promotion
  // (plan objective OUTCOME_APP_PROMOTION). Publish sends
  // promoted_object { application_id, object_store_url }
  // from these two fields (Meta's app-ads contract). Both
  // are the merchant's own app identifiers — typed by the
  // merchant, never derived or guessed.
  appId           String?
  appStoreUrl     String?
  // Frontier CN13 (NB6): Click-to-WhatsApp destination.
  // destinationType "WHATSAPP" = a REAL CTWA ad set (Meta
  // destination_type WHATSAPP; promoted_object { page_id,
  // whatsapp_phone_number? }). The number is bound to one of
  // the org's CONNECTED WhatsApp Integrations — never a
  // free-typed number: whatsappIntegrationId is that
  // Integration row, whatsappPhoneNumberId its
  // phone_number_id (the integration's externalAccountId),
  // whatsappPhoneNumber the display digits when Meta
  // read-back resolved them at save time (null = publish
  // omits Meta's OPTIONAL whatsapp_phone_number field and
  // Meta uses the Page-linked number; readiness warns).
  destinationType       String?
  whatsappIntegrationId String?
  whatsappPhoneNumberId String?
  whatsappPhoneNumber   String?
  targeting      Json // { countries: string[], ageMin?, ageMax?, genders?: number[] }
  startTime      DateTime?
  endTime        DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  plan           CampaignPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  ads            CampaignAd[]

  @@index([planId])
  effectiveStatus String?
  daypart              Json?
  daypartTz            String?
  daypartState         String?
  // Campaign Builder Next CN2: per-ad-set bidding.
  // bidStrategy: lowest_cost | bid_cap | cost_cap |
  // roas_goal (null = lowest_cost, Meta's default).
  // Amounts are minor units; roasAverageFloor is Meta's
  // raw integer (ROAS x 10000, e.g. 20000 = 2.0).
  bidStrategy       String?
  bidAmountMinor    BigInt?
  costGoalMinor     BigInt?
  roasAverageFloor  Int?
  // Campaign Builder Frontier CN16 (NB7): the full-funnel
  // wizard tags each generated ad set with its layer
  // (prospecting | retargeting | retention). funnelIncomplete
  // carries the reason when the layer's inputs were missing
  // (e.g. no buyer contacts for a retention audience) — the
  // ad set still exists, readiness reports it as an error,
  // and nothing was fabricated to fill the gap.
  funnelLayer       String?
  funnelIncomplete  String?
}

model CampaignAd {
  id             String   @id @default(uuid())
  adSetId        String
  name           String
  externalAdId   String?
  productId      String?
  primaryText    String
  headline       String?
  description    String?
  linkUrl        String
  callToAction   String   @default("SHOP_NOW")
  // Phase H formats: link | video | carousel
  format         String   @default("link")
  imageAssetId   String?
  videoAssetId   String?
  carouselCards  Json? // [{ title, description?, linkUrl, imageUrl?, imageAssetId? }]
  imageUrl       String?
  // Campaign Builder Next CN5: creative v2. textOptions =
  // { primaryTexts[], headlines[], descriptions[] } — index 0
  // ALWAYS mirrors the legacy primaryText/headline/description
  // columns (the service syncs them), so every pre-CN5 flow
  // (publish fallback, A/B, creative health, previews) reads
  // the first option byte-compatibly. placementAssets =
  // { feed?: MediaRef, vertical?: MediaRef } with MediaRef =
  // { imageAssetId?, videoAssetId?, imageUrl? } (Stories/Reels
  // share the vertical group). creativeEnhancements =
  // { <metaFeatureKey>: boolean } — only explicitly-set
  // Advantage creative features are stored/sent.
  textOptions    Json?
  placementAssets Json?
  creativeEnhancements Json?
  // Frontier CN13 (NB6): this ad's CTWA welcome experience
  // (Meta page_welcome_message on the creative):
  // { greetingText?, prefillMessage?, iceBreakers?: string[] }.
  // Sent ONLY when the parent ad set is a WHATSAPP
  // destination set; ignored (and flagged in readiness)
  // everywhere else.
  whatsappWelcome Json?
  createdByAi    Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  adSet          CampaignAdSet @relation(fields: [adSetId], references: [id], onDelete: Cascade)

  @@index([adSetId])
  effectiveStatus String?
  issuesInfo      Json?
}

// Every external API call attempted during publish/activate, with its
// outcome. This is the evidence behind any "published" claim.
model CampaignPublishLog {
  id             String   @id @default(uuid())
  planId         String
  actorId        String?
  step           String // campaign | adset | ad | activate | pause
  entityRef      String? // local ad set / ad id the step belongs to
  externalId     String?
  status         String // success | error
  error          String?
  createdAt      DateTime @default(now())
  plan           CampaignPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, createdAt])
}

// Campaign Builder Frontier CN15 (NB7): a Meta Experiments
// (Ad Study) link between two variant plans of one abGroup.
// The spike CONFIRMED the documented path (POST
// /{business_id}/ad_studies, type SPLIT_TEST, cells with
// treatment_percentage + campaigns, objectives of type
// CONVERSIONS) — see docs/campaign-builder-nb7-acceptance.md.
// createResponse / lastReadback store Meta's payloads
// VERBATIM; the platform never computes significance or a
// winner of its own. A row exists ONLY when Meta confirmed
// the study id — a refused create leaves no row.
model CampaignExperiment {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  groupId        String // the abGroupId both variant plans share
  planAId        String
  planBId        String
  splitA         Int // treatment_percentage for plan A's cell (10..90); B gets 100 - splitA
  metricEvent    String // the CN3 conversion event the study objective measures (e.g. PURCHASE)
  startTime      DateTime
  endTime        DateTime
  metaBusinessId String?
  metaStudyId    String?
  createResponse Json?
  lastReadback   Json?
  lastReadbackAt DateTime?
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, groupId])
  @@index([organizationId, planAId])
}

// Campaign Builder Frontier CN16 (NB7): a recurring series
// over one template plan. The sweep materializes the NEXT
// occurrence as a DRAFT clone (full-field copy) leadDays
// before its date — exactly ONE pending instance at a time
// (pendingPlanId), occurrence dates computed FROM the
// anchor (weekly/monthly) or the explicit dates list, so
// the chain never drifts. Instances go through the full
// approval flow; a series never publishes anything itself.
model CampaignPlanSeries {
  id              String   @id @default(uuid())
  organizationId  String
  sourcePlanId    String // the template plan each instance clones
  name            String
  cadence         String // weekly | monthly | dates
  interval        Int      @default(1)
  anchorDate      DateTime? // occurrence 0 (weekly/monthly)
  dates           Json? // ISO date strings (cadence = dates)
  leadDays        Int      @default(3)
  nextIndex       Int      @default(0)
  pendingPlanId   String? // the one generated instance still sitting in draft
  status          String   @default("active") // active | paused | ended
  lastGeneratedAt DateTime?
  createdById     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId, status])
  @@index([organizationId, sourcePlanId])
}

// ---------- Milestone 10: scheduling + automation ----------

// Milestone 57: jobs that exhausted their worker retries land
// here (dead-letter queue) for operator inspection + replay.
model DeadLetterJob {
  id             String    @id @default(uuid())
  organizationId String?
  scheduledJobId String?
  jobType        String?
  error          String
  attempts       Int       @default(0)
  createdAt      DateTime  @default(now())
  replayedAt     DateTime?

  @@index([createdAt])
}

model ScheduledJob {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  // woo_products | woo_orders | shopify_products | shopify_orders |
  // meta_insights | google_insights | tiktok_insights |
  // daily_report | competitor_ads | competitor_scan
  type           String
  targetId       String // integrationId | adAccountId | competitorId, per type
  intervalMinutes Int
  enabled        Boolean  @default(true)
  lastRunAt      DateTime?
  nextRunAt      DateTime
  lastStatus     String? // success | error
  lastError      String?
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, enabled, nextRunAt])
}

model AutomationRule {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  campaignPlanId String? // null = all published plans of the org
  metric         String // platform_cpa | platform_roas | spend_no_conversions
  comparator     String // gt | lt
  threshold      String // numeric, in account currency units for CPA / ratio for ROAS
  windowDays     Int      @default(3)
  action         String // pause_campaign | alert | activate_campaign | scale_budget
  actionConfig   Json? // scale_budget: { percent, minDailyMinor?, maxDailyMinor?, cooldownHours? }
  // Campaign Builder Advanced CA10 (CB3): execute = the
  // pre-CA10 behaviour (the engine acts at once); suggest =
  // a triggered action lands in the RuleSuggestion approval
  // queue and NOTHING executes until a human approves. The
  // DB default stays "execute" so every pre-CA10 rule keeps
  // its behaviour untouched; createRule defaults NEW rules
  // to "suggest" at the service layer.
  mode           String   @default("execute") // execute | suggest
  enabled        Boolean  @default(true)
  lastEvaluatedAt DateTime?
  lastTriggeredAt DateTime?
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, enabled])
}

model AutomationRun {
  id             String   @id @default(uuid())
  organizationId String
  kind           String // schedule | rule | suggestion
  refId          String // scheduledJobId | automationRuleId | ruleSuggestionId
  status         String // success | error | triggered | skipped
  detail         String?
  evidence       Json?
  createdAt      DateTime @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

// Campaign Builder Advanced CA10 (CB3): one pending decision
// created when a SUGGEST-mode AutomationRule triggers. The
// engine evaluates exactly as in execute mode, but instead of
// acting it stores the action it WOULD take (actionPayload)
// with the evidence that fired the rule (reason + facts).
// A human approves (the stored action executes through the
// SAME CampaignsService paths execute mode uses, exactly
// once — the pending -> approved claim is the guard) or
// rejects. Pending suggestions older than the service TTL
// are lazily marked expired on read. No row here ever
// executes anything by itself.
model RuleSuggestion {
  id              String   @id @default(uuid())
  organizationId  String
  ruleId          String
  campaignPlanId  String
  action          String // pause_campaign | activate_campaign | scale_budget | pause_ad
  actionPayload   Json? // scale_budget: { percent, minDailyMinor?, maxDailyMinor? }; pause_ad: { adExternalIds }
  reason          String // the rule evaluation detail text, verbatim
  facts           Json? // { metric, value, threshold, comparator, windowDays }
  status          String   @default("pending") // pending | approved | rejected | expired
  decidedById     String?
  decidedAt       DateTime?
  rejectReason    String?
  executedAt      DateTime?
  executionResult Json? // { ok, executed? , skipped?, changes?, error? } — the verbatim outcome of the approve-time attempt
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status, createdAt])
  @@index([ruleId, campaignPlanId, status])
}

// ---------- Milestone 11: messaging + workflows ----------

model MessageTemplate {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  channel        String // email | sms
  subject        String? // email only
  body           String // supports {{variable}} placeholders
  // MS5: optional HTML part (email channel only — the service
  // rejects htmlBody on sms with an honest 400). Sent to the
  // provider exactly as authored (no server-side rewriting);
  // null (every pre-MS5 row) = text-only sends, as before.
  htmlBody       String?
  // MX7: the block-builder source for email templates built with
  // the drag/reorder builder ([{type, ...}] — validated and
  // rendered by messaging/email-blocks.ts). Rendering writes the
  // SAME body/htmlBody above, so the send path is unchanged;
  // null (every pre-MX7 template and every hand-authored one) =
  // no blocks, body/htmlBody are the source, byte-identical to
  // before. `version` starts at 1 and increments on every
  // content edit; each version's snapshot lives in
  // MessageTemplateVersion.
  blocks         Json?
  version        Int      @default(1)
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, channel])
}

// MX7: one snapshot row per template version (v1 at create, a new
// row on every content edit and on restore — restore creates a
// NEW version copying the target snapshot, history is never
// rewritten). Prior versions are viewable/restorable from the
// Messaging page.
model MessageTemplateVersion {
  id             String   @id @default(uuid())
  organizationId String
  templateId     String
  version        Int
  name           String
  channel        String
  subject        String?
  body           String
  htmlBody       String?
  blocks         Json?
  createdById    String
  createdAt      DateTime @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([templateId, version])
  @@index([organizationId, templateId])
}

// MX7: saved/reusable content blocks (the content library) — one
// validated email block ({type, ...} in `data`) the org can
// insert into any builder template. Per-org, like templates.
model MessagingContentBlock {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  kind           String // text | image | button | product | coupon | divider
  data           Json
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, kind])
}

model Broadcast {
  id              String   @id @default(uuid())
  organizationId  String
  name            String
  channel         String // email | sms | whatsapp | push (MX12) | telegram (MX13) | onsite (MX14)
  templateId      String?
  // MX7: the MessageTemplate.version this broadcast's content was
  // taken from, stamped at broadcast creation (the moment the
  // template content — re-rendered from blocks when the template
  // has them — is copied onto this row). Deliveries reach it via
  // broadcastId. Null when not built from a template and on every
  // pre-MX7 row.
  templateVersion Int?
  // WhatsApp broadcasts send a registered Meta template instead.
  whatsappTemplateId String?
  templateParams     Json?
  // MS6: rich send-time template parameters for WhatsApp
  // broadcasts — { headerMediaUrl?, headerTextParams?,
  // buttonParams?: [{ index, subType: "url"|"quick_reply", text?,
  // payload? }] }. Mapped per recipient by createWhatsAppSender
  // (with {name}/{key} substitution from the snapshot vars) into
  // MetaMessagingClient's rich params. Null (every pre-MS6 row)
  // = legacy body-params-only sends, byte-identical to before.
  templateComponents Json?
  subject         String?
  body            String
  // MS5: optional HTML part for email broadcasts (same rule as
  // MessageTemplate.htmlBody: email only, authored as-is). For
  // A/B broadcasts it is stored on variant A only; variant B's
  // htmlBody stays null.
  htmlBody        String?
  // MX12: web-push click-through URL (channel "push" only) —
  // the shop-relative path the shop service worker opens on
  // notification click (its payload carries title/body/url
  // only). Null (every non-push row) = the notification opens
  // the shop root. Stored on the broadcast because the push
  // payload is composed at send time from this row, exactly
  // like subject/body.
  pushUrl         String?
  // MX13: optional inline URL buttons of a telegram broadcast
  // (channel "telegram" only) — a validated Json array of
  // { label, url } pairs (https URLs only), sent as the Bot
  // API's reply_markup.inline_keyboard (one button per row).
  // Null (every non-telegram row and telegram broadcasts
  // without buttons) = the message carries text only.
  telegramButtons Json?
  // MX14: on-site click-through URL (channel "onsite" only) —
  // the shop-relative path the customer is taken to when they
  // open this notification in their shop account notification
  // center (same shop-relative rule as MX12's pushUrl, via
  // validateOnsiteUrl). Null (every non-onsite row and onsite
  // broadcasts without a link) = opening the notification only
  // marks it read. Stored on the broadcast because the
  // notification row is composed at send time from this row,
  // exactly like subject/body.
  onsiteUrl       String?
  audienceType    String // customers | leads_stage | segment | custom | saved | csv
  audienceStage   String? // when audienceType = leads_stage
  audienceSegment String?
  // MS3: when audienceType = custom, the inline audience-builder
  // definition ({ entity, match, conditions } — validated by
  // messaging/audience-rules.ts). When saved, audienceSavedId points
  // at the SavedAudience whose definition is used (a deleted saved
  // audience fails preview/send honestly, never silently widens).
  // When csv, audienceCsv holds the raw pasted address list as an
  // array of strings (parsed + validated at create; unmatched and
  // invalid entries are counted at resolve time, never dropped
  // silently).
  audienceDefinition Json?
  audienceSavedId    String?
  // MX10: optional topic tag. When set, the resolver excludes
  // recipients whose preference-center topics for this channel
  // do not include it (a null topics list = no restriction).
  // Null (every pre-MX10 row) = untopiced, unchanged behaviour.
  topic              String?
  audienceCsv        Json?
  // A/B test: two broadcasts share an abGroupId, one per variant.
  abVariant      String? // A | B
  abGroupId      String?
  // CX10: broadcast exclusions and opt-out
  excludePastDays Int?
  excludeOptOut   Boolean  @default(true)
  // "daily"|"weekly", interval: int >= 1, weekdays?: int[]
  // (0-6, Asia/Dhaka calendar days), endsAt?: ISO string }.
  // The value lives on the ONE pending instance of the chain:
  // when an instance finalizes, the engine creates the next
  // instance (status "scheduled") holding the recurrence and
  // clears it here. recurrenceGroupId ties the whole chain
  // together (A/B variants share one group, like abGroupId).
  // Null (every pre-MS8 row) = one-off broadcast, unchanged.
  recurrence        Json?
  recurrenceGroupId String?
  status          String   @default("draft") // draft | scheduled | sending | paused | sent | partial | failed | cancelled
  // MS10: archive marker for sent-family broadcasts that must
  // keep their history (delete is draft/cancelled only). An
  // archived broadcast is hidden from the default list and
  // refuses send/schedule until unarchived. Null = not archived
  // (every pre-MS10 row).
  archivedAt      DateTime?
  // CX10: when true, sendBroadcast drops every audience member who
  // already has a CONFIRMED (status "sent") MessageDelivery from
  // ANY earlier broadcast of this org (any channel). Failed
  // deliveries never exclude. Default false = pre-CX10 behaviour.
  excludePreviousRecipients Boolean @default(false)
  // MS1: when set (and status is "scheduled"), the broadcast_send_sweep
  // automation job prepares + sends the broadcast once this time is
  // due. Null (every pre-MS1 row) = no schedule.
  scheduledAt       DateTime?
  // MS1: the resolved recipient set, materialized by
  // prepareBroadcast so a send can pause/resume/retry across
  // requests and a crashed "sending" row can be recovered by the
  // sweep. Entries: { type, id, name, email, phone, status:
  // "pending"|"sent"|"failed"|"skipped", attempts, error?,
  // providerMessageId?, address? }. Null = never prepared.
  // Bounded by the per-send plan cap (max 5000 recipients).
  // MX1: NEW broadcasts materialize into BroadcastRecipient rows
  // instead and leave this NULL — the column remains the store
  // for pre-MX1 broadcasts only (legacy path, read exactly as
  // before; nothing may assume it is non-null on a new row).
  recipientSnapshot Json?
  // SA-B20 (G2): per-broadcast personalisation config
  // ({ enabled: true, tier2AiHook?: boolean }), validated by
  // messaging/broadcast-personalization.service.ts. Persists on
  // the row so a later prepare (schedule / sweep) applies
  // exactly the config the staff previewed. Null = off (every
  // pre-G2 row), legacy behaviour byte-identical.
  personalization Json?
  totalRecipients Int      @default(0)
  sentCount       Int      @default(0)
  failedCount     Int      @default(0)
  // MX1: skipped recipients of a recipient-table broadcast,
  // DERIVED from BroadcastRecipient rows by the engine (the
  // snapshot path keeps deriving skipped from the snapshot and
  // never writes this column — pre-MX1 rows read the default 0
  // exactly as the old counter fallback did).
  skippedCount    Int      @default(0)
  // MX2: smart channel routing / fallback cascade config —
  // { enabled, channels: [...org order...], smartRouting,
  // ordering: "org"|"cheapest", smsBody?, emailSubject?,
  // emailBody?, whatsappTemplateId? } validated by
  // messaging/cascade.ts (parseCascadeConfig). Null (every
  // pre-MX2 row) = single-channel broadcast, behaviour
  // byte-identical to before.
  cascadeConfig   Json?
  // MX2: per-run cascade facts that are NOT derivable from
  // delivery rows — { breakerEvents: [{gatewayKey, failures,
  // at}], skippedChannels: [{channel, reason}], ratesMissing:
  // [channel...] }. Written by processBroadcast when a cascade
  // run produced any; the report merges it with the delivery-
  // derived channel breakdown. Null = nothing to report.
  cascadeReport   Json?
  // MX8: per-recipient dynamic personalization config —
  // { uniqueCoupon?: {kind, value, expiryDays, prefix},
  //   recommendations?: {enabled, limit, heading?, fallbackText?},
  //   segmentBlocks?: [{savedAudienceId? | definition?, body,
  //   htmlBody?}] } validated by messaging/personalization.ts
  // (parsePersonalizationConfig). Null (every pre-MX8 row) =
  // no dynamic personalization, behaviour byte-identical.
  personalizationConfig Json?
  // MX11: holdout group — the org-set percentage (1–50) of the
  // resolved audience deterministically held out of this send
  // for comparison (a bucket of the SAME hash the A/B split
  // reads — see messaging/engagement.ts). Null (every pre-MX11
  // row) = no holdout. holdoutCount is stamped at prepare time
  // with the number actually held out; the held-out recipients
  // are never written as recipient rows / snapshot entries, so
  // a resumed send can never re-roll them.
  holdoutPercent  Int?
  holdoutCount    Int?
  // MX15: approval state (meaningful only when the org's
  // MessagingSetting.approvalEnabled is on). Null (every
  // pre-MX15 row, and every broadcast created while approval
  // is OFF or by an approver) = not_required. Otherwise:
  // "pending" (status is "pending_approval"), "approved"
  // (approvedById/approvedAt/approvalNote carry the decision),
  // or "rejected" (back to draft; still blocked from sending
  // until re-submitted and approved).
  approvalStatus  String?
  approvalNote    String?
  approvedById    String?
  approvedAt      DateTime?
  // MX16: A/B auto-winner (owner decision D3 — default OFF).
  // abAutoWinnerEnabled: null (every pre-MX16 row) = inherit
  // the org switch (MessagingSetting.abAutoWinnerEnabled);
  // true/false = this broadcast pair's explicit override — an
  // explicit false on EITHER variant disables the pair, and
  // the toggle endpoint may flip it mid-flight (it takes
  // effect at the next chunk re-read). abWinnerVariant /
  // abWinnerAt / abWinnerDetail record the ONE decision (the
  // two-proportion z-test inputs + result — see
  // messaging/analytics.ts); null = no decision taken.
  abAutoWinnerEnabled Boolean?
  abWinnerVariant     String? // A | B
  abWinnerAt          DateTime?
  abWinnerDetail      Json?
  // MX15: per-broadcast estimated-cost cap (minor units) —
  // overrides the org default (MessagingSetting
  // .broadcastCostCapMinor) for THIS broadcast. Null = the org
  // default applies (or no cap).
  budgetCapMinor  Int?
  createdById     String
  sentAt          DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveries      MessageDelivery[]
  recipients      BroadcastRecipient[]

  @@index([organizationId, createdAt])
  // MS8: chain lookups by recurrence group.
  @@index([organizationId, recurrenceGroupId])
}

// MX1: one materialized recipient of ONE broadcast — the scale
// path that replaces the MS1 Json recipientSnapshot for NEW
// broadcasts. prepareBroadcast writes these rows in chunks from
// the shared resolver (never one giant Json); processBroadcast
// reads pending rows in chunks, persists per-chunk progress
// counters DERIVED from these rows, and resumes exactly where
// it stopped: a row whose status is no longer "pending" is
// never sent to again. `recipientId` mirrors SnapshotEntry.id
// exactly (entity id for customer/lead; the normalized address
// for csv, whose MessageDelivery rows still record null — see
// recordDelivery). `dedupeKey` is `${recipientType}:${recipientId}`
// (the A/B split key precedent); the unique constraint on
// (broadcastId, dedupeKey) makes a duplicate write impossible
// even when audience sources overlap. `address` is the channel
// address actually used, stamped at send time like the snapshot
// entry's address. `vars` holds the MS5 per-recipient
// personalization vars built at prepare time. Pre-MX1 broadcasts
// have NO rows here and keep the snapshot path byte-for-byte.
model BroadcastRecipient {
  id                String   @id @default(uuid())
  organizationId    String
  broadcastId       String
  recipientType     String // customer | lead | csv | test
  recipientId       String // SnapshotEntry.id semantics (see above)
  dedupeKey         String
  name              String
  email             String?
  phone             String?
  address           String?
  vars              Json?
  // MX12: for channel "push" rows, the WebPushSubscription this
  // row sends to (one row per subscription — a customer with
  // two subscribed devices is two rows). The endpoint itself is
  // stamped into `address` at prepare time: for push the
  // endpoint IS the channel address (the preference-store
  // identity), not merely a send artifact. Null on every
  // non-push row.
  pushSubscriptionId String?
  // MX13: for channel "telegram" rows, the Telegram chat id
  // this row sends to (one row per chat id). The chat id is
  // also stamped into `address` at prepare time: for telegram
  // the chat id IS the channel address (the preference-store
  // identity used by every resolver stage). Null on every
  // non-telegram row.
  telegramChatId     String?
  // MX8: the per-recipient personalization state computed at
  // send time — { couponCode?, couponDiscountId?,
  // couponError?, recommendationSignal?,
  // recommendationProductIds?, segmentBlocksMatched? }. Written
  // BEFORE the provider call and re-read on every later attempt,
  // so a resume/retry NEVER issues a second unique coupon for
  // this recipient (the issued code is reused verbatim) and the
  // dynamic content is stable across attempts. Null = not yet
  // personalized (or the broadcast has no MX8 config). The
  // legacy snapshot path carries the same shape inside the
  // snapshot entry itself (SnapshotEntry.personalization).
  personalization   Json?
  status            String   @default("pending") // pending | sent | failed | skipped
  attempts          Int      @default(0)
  error             String?
  providerMessageId String?
  sortIndex         Int
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  broadcast         Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)

  @@unique([broadcastId, dedupeKey])
  @@index([broadcastId, status, sortIndex])
  @@index([broadcastId, sortIndex])
  @@index([organizationId, broadcastId])
}

// MS3: a named, reusable audience definition for the Messaging
// audience builder. (Named MessagingSavedAudience because
// `SavedAudience` already exists — the Ads campaign builder's
// targeting presets.) `definition` is the Json shape validated by
// messaging/audience-rules.ts ({ entity: "customers"|"leads",
// match: "all"|"any", conditions: [...] }, max 20 conditions).
// Broadcasts reference a saved audience by id only; the definition
// is read at resolve time, so editing a saved audience changes
// future previews/sends of DRAFT broadcasts — a sent broadcast is
// unaffected because its recipients were materialized into the
// MS1 snapshot at prepare time.
model MessagingSavedAudience {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  definition     Json
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model MessageDelivery {
  id                String   @id @default(uuid())
  organizationId    String
  broadcastId       String?
  workflowRunId     String?
  channel           String // email | sms | whatsapp | push (MX12) | telegram (MX13) | onsite (MX14: address = customer id)
  recipientType     String // customer | lead
  recipientId       String?
  address           String // email address or phone number actually used
  status            String // sent | failed | skipped (MS2: recipient opted out; provider never called)
  providerMessageId String? // proof of acceptance by the provider; null = not sent
  error             String?
  // MS7: post-send lifecycle, SEPARATE from the send-outcome
  // `status` above (which the MS1 final-status math reads and
  // which must not change meaning). deliveryStatus: null (no
  // post-send signal yet) | delivered | read | failed. Written
  // ONLY by real signals: WhatsApp status webhooks (monotonic —
  // delivered/read are never erased by a later failed) and the
  // signed email open pixel (openedAt). Email has no delivered
  // signal over SMTP and platform SMS has no documented DLR
  // query API (see docs/messaging-b4-acceptance.md), so those
  // channels honestly stay null.
  deliveryStatus    String?
  // MX2: cascade attempt linking — every attempt of one
  // recipient's cascade chain shares cascadeGroupId (the
  // BroadcastRecipient row id on the recipient-table path)
  // and carries its 0-based attemptIndex + recipientRowId.
  // Null on every pre-MX2 / non-cascade delivery.
  cascadeGroupId    String?
  recipientRowId    String?
  attemptIndex      Int?
  // MX4: the workflow step position that produced this
  // delivery, in the engine's coupon format ("3" top-level,
  // "3.then.0" / "3.else.1" inside a branch arm). Set ONLY by
  // workflow send_email / send_sms steps; null on broadcast
  // deliveries, coupon-step sends and every pre-MX4 row. The
  // journey builder's per-step stats group by this value.
  stepRef           String?
  deliveredAt       DateTime?
  readAt            DateTime?
  openedAt          DateTime?
  createdAt         DateTime @default(now())
  broadcast         Broadcast? @relation(fields: [broadcastId], references: [id], onDelete: SetNull)

  @@index([organizationId, broadcastId])
  @@index([organizationId, createdAt])
  // MS7: WhatsApp webhook statuses match broadcast deliveries by
  // the Meta message id stored in providerMessageId.
  @@index([organizationId, providerMessageId])
  // MX2: chain reads for the cascade report.
  @@index([broadcastId, recipientRowId])
}

// MX14: one on-site notification in ONE shop customer's
// notification center (the storefront account area). Scalar-id
// style like the EC25 shop tables (ShopSession & friends): the
// account identity IS the org-scoped Customer row, and every
// read/write resolves org-first + customer-scoped — a customer
// only ever sees their own rows. Created ONLY by the messaging
// broadcast engine's onsite send (the create IS the delivery —
// there is no external provider): the row's existence in the
// center is the delivered signal, and `readAt` is stamped by
// the REAL customer action of opening it in the account area,
// which also stamps the linked MessageDelivery's readAt /
// deliveryStatus ("read") so the broadcast report funnel reads
// the same truth. `deliveryId` is unique (one notification per
// delivery) and (broadcastId, customerId) is unique (one
// notification per customer per broadcast) — together they make
// a resumed broadcast send incapable of duplicating a
// notification (the send path checks for the existing row
// first and reuses it). `title` is the broadcast's subject
// (the onsite title), `body` the rendered body, `url` the
// broadcast's shop-relative onsiteUrl (null = opening only
// marks read). broadcastId is nullable for the same reason
// MessageDelivery's is (a future non-broadcast writer); every
// MX14 row carries one.
model OnsiteNotification {
  id             String    @id @default(uuid())
  organizationId String
  customerId     String
  broadcastId    String?
  deliveryId     String?   @unique
  title          String
  body           String
  url            String?
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  @@unique([broadcastId, customerId])
  @@index([organizationId, customerId, createdAt])
  @@index([organizationId, broadcastId])
}

// MS5: one row per REAL click on a tracked broadcast link. Rows
// are created ONLY by the public redirect endpoint after the
// signed token verifies (a tampered token records nothing and
// does not redirect). `url` is the final destination the visitor
// was sent to (UTM parameters already applied at send time).
// MS7 will aggregate these; MS5 only records them.
model MessageLinkClick {
  id             String   @id @default(uuid())
  organizationId String
  // MX4: nullable — a click belongs to a broadcast OR (in a
  // future tracking extension) to a workflow run, never both.
  // Today only broadcast clicks are ever written: the MS5 spec
  // pins "workflow sends are NEVER rewritten", so workflow
  // sends carry no tracked links and workflowRunId stays null
  // (see docs/messaging-mx4-acceptance.md).
  broadcastId    String?
  workflowRunId  String?
  // "customer:<id>" | "lead:<id>" | "csv:<address>" | "test:<address>"
  recipientKey   String
  url            String
  createdAt      DateTime @default(now())

  @@index([organizationId, broadcastId])
  @@index([organizationId, workflowRunId])
  @@index([organizationId, createdAt])
}

// MS2: per-(org, channel, address) messaging consent record. The
// address is stored NORMALIZED (email trimmed + lowercased; phone in
// normalizeBdPhone form when possible, else digits only) so the
// send paths and the preference store always compare the same
// string. One row per address: a START/unsubscribe flips the SAME
// row's status, keeping the latest source. Enforced by the shared
// broadcast resolver (suppression + WhatsApp opt-in) and by
// sendToRecipient (suppression only — broadcasts AND workflows).
model MessagePreference {
  id             String   @id @default(uuid())
  organizationId String
  channel        String // email | sms | whatsapp | push (MX12: address = subscription endpoint, trimmed as-is) | telegram (MX13: address = chat id, trimmed as-is) | onsite (MX14: address = customer id, trimmed as-is)
  address        String // normalized (see above)
  recipientType  String? // customer | lead, when known
  recipientId    String?
  status         String // opted_out | opted_in | pending (MX10: double opt-in, not yet confirmed — receives NO marketing sends)
  source         String // unsubscribe_link | inbound_keyword | manual | import | preference_center | signup_form | double_optin | keyword_optin
  note           String?
  // MX10: preference-center choices for THIS (channel, address).
  // topics: the topics this contact wants on this channel (null =
  // no topic restriction — every topic). A broadcast carrying a
  // topic the contact did not choose is excluded at resolve time.
  topics         Json?
  // MX10: the contact's own per-day frequency preference (null =
  // org cap only). Enforced in the resolver's frequency stage as
  // min(org cap, this) — and on its own when the org cap is off.
  maxPerDay      Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, channel, address])
  @@index([organizationId, status])
}

// MX10: ONE row per consent/preference CHANGE, written wherever
// preferences change (preference center, unsubscribe link,
// STOP/START, manual/import, signup, double-opt-in confirm) by
// MessagingService.setPreference + the center's topic/frequency
// writes. This history BEGINS at MX10: pre-MX10 changes were
// never recorded anywhere (the MessagePreference row flips in
// place and keeps only the latest status/source) and are NOT
// backfilled — an export honestly starts at the first MX10-era
// change. actor: "public" (token page) | "inbound" (keyword) |
// "user:<id>" (dashboard) | "import" | "system".
model MessageConsentEvent {
  id            String   @id @default(uuid())
  organizationId String
  channel       String // email | sms | whatsapp
  address       String // normalized, preference-store form
  recipientType String?
  recipientId   String?
  fromStatus    String? // null = no prior row
  toStatus      String // opted_out | opted_in | pending | preferences_updated
  source        String
  actor         String
  note          String?
  createdAt     DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([organizationId, address])
}

// MX10: a messaging-native opt-in form. NOT a LeadForm: LeadForm
// is the Meta lead-ads form builder (pageId/questions/external
// Meta id, attached to CampaignAdSets; submissions arrive via
// Meta sync). This form is the org's OWN embeddable web signup
// (public /join page + popup config + QR + WhatsApp keyword);
// submissions land as real Lead rows (source "messaging_form",
// tag "optin:<slug>") plus MessagePreference rows — pickable in
// the existing audience builder via the source/tag conditions.
model MessagingOptInForm {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  slug           String // url-safe, unique per org
  headline       String?
  description    String?
  // Channels the subscriber consents to: subset of
  // email|sms|whatsapp. The form collects an email when "email"
  // is present and a phone when sms/whatsapp is present.
  channels       Json
  topic          String? // the topic signups subscribe to (preference-center vocabulary)
  doubleOptIn    Boolean  @default(true)
  successMessage String?
  // Popup presentation config for the embed snippet:
  // { enabled, delaySeconds?, headline? } — config only; the
  // public join page renders the form, the embed script (org's
  // site) decides when to show it.
  popup          Json?
  // WhatsApp opt-in / double-opt-in confirm keyword (stored
  // normalized uppercase). An inbound WhatsApp message equal to
  // it confirms a pending signup or records a fresh opt-in —
  // handled inside the MS2/MX6 inbound keyword path, never by a
  // campaign rule.
  keyword        String?
  enabled        Boolean  @default(true)
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, slug])
  @@index([organizationId, enabled])
}

// MX10: a persisted CSV contact-import hygiene report. The
// preview step writes the report (status "previewed") BEFORE any
// contact is created; commit imports only the clean rows and
// flips status to "committed". `report` holds the per-row
// outcome list [{ row, address?, status: clean|excluded,
// reason? }] so every excluded row keeps its reason and the
// report can be downloaded later — it is never recomputed.
model MessagingCsvImport {
  id             String   @id @default(uuid())
  organizationId String
  createdById    String
  channel        String // email | sms | whatsapp — the channel the imported consent applies to
  mapping        Json // { name?, email?, phone? } column names from the file header
  totalRows      Int
  cleanCount     Int
  duplicateCount Int
  invalidCount   Int
  roleCount      Int
  report         Json
  status         String   @default("previewed") // previewed | committed
  committedAt    DateTime?
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
}

// MS4: per-organization sender configuration (one row per org,
// MessagingSetting pattern). A missing row — every pre-MS4 org —
// means "no tenant senders": all sends fall back to the platform
// SMTP / platform SSL Wireless exactly as before. Secrets
// (smtpPassEncrypted, smsApiKeyEncrypted) are AES-256-GCM sealed
// (platform-config seal/unseal) and NEVER returned by any API;
// the safe view reports only configured booleans + non-secret
// fields. The rate columns are the ORG's own entered per-unit
// prices (minor units / poisha) used ONLY for preview estimates —
// null means "rate not set" and no estimate is shown.
model MessagingSenderConfig {
  id             String   @id @default(uuid())
  organizationId String   @unique
  // Tenant SMTP (verified by a real handshake before saving).
  smtpHost         String?
  smtpPort         Int?
  smtpUser         String?
  smtpPassEncrypted String?
  fromAddress      String?
  fromName         String?
  // Optional: the DKIM selector to check for the From domain in
  // the domain-health view. Without it DKIM is "not_checked".
  dkimSelector     String?
  // Tenant SMS gateway: sslwireless | bulksmsbd | alphasms.
  smsGateway         String?
  smsApiKeyEncrypted String?
  smsSenderId        String?
  smsApiUrl          String? // optional base-URL override
  // MX2: failover priority of THIS (primary) SMS config among
  // the org's SMS gateways — lower sends first. Default 0;
  // MessagingSmsGatewayConfig rows carry their own priority
  // and interleave with this one by the same ordering.
  smsPriority          Int      @default(0)
  // Org-entered rates for preview estimates (minor units).
  smsCostPerPartMinor          Int?
  whatsappCostPerMessageMinor  Int?
  // MX9: OPTIONAL org-entered per-category WhatsApp rates (minor
  // units). Meta charges per conversation/message category, so an
  // org MAY split its single flat WhatsApp rate by the template's
  // real Meta category. A category rate, when set, wins over the
  // flat rate for templates of that category in estimates; when
  // neither is set there is NO estimate — a price is never
  // derived from Meta or invented.
  whatsappMarketingCostPerMessageMinor      Int?
  whatsappUtilityCostPerMessageMinor        Int?
  whatsappAuthenticationCostPerMessageMinor Int?
  emailCostPerMessageMinor     Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// MX2: ADDITIONAL per-organization SMS gateway configs — the
// failover set beyond the primary MessagingSenderConfig SMS
// fields. Before MX2 an org had exactly ONE tenant SMS config
// (MessagingSenderConfig.organizationId is @unique); these rows
// are how a SECOND (third, ...) gateway honestly exists: same
// sealed-secret discipline (AES-256-GCM, never returned by any
// API), each with its own failover `priority` (lower sends
// first; the primary config's smsPriority interleaves by the
// same rule). isEnabled=false rows are kept but never sent
// through. Platform SMS remains the fallback only when NO
// tenant gateway is configured at all (pre-MX2 semantics).
model MessagingSmsGatewayConfig {
  id             String   @id @default(uuid())
  organizationId String
  smsGateway         String // sslwireless | bulksmsbd | alphasms
  smsApiKeyEncrypted String
  smsSenderId        String
  smsApiUrl          String?
  priority           Int      @default(10)
  isEnabled          Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, priority])
}

// MS2: per-organization messaging consent settings (one row per
// org, CrmSetting pattern). A missing row reads as the defaults
// below — frequencyCapPerDay 1, whatsappOptInRequired false —
// which is also the pre-MS2 state of every org.
model MessagingSetting {
  id                      String   @id @default(uuid())
  organizationId          String   @unique
  // Broadcast sends per recipient per rolling 24h (confirmed
  // deliveries only). 0 = off. Broadcasts only — workflow /
  // transactional sends are never frequency-capped.
  frequencyCapPerDay      Int      @default(1)
  // When true, WhatsApp broadcasts reach ONLY recipients with an
  // opted_in MessagePreference for (org, whatsapp, phone).
  whatsappOptInRequired   Boolean  @default(false)
  // MS5: link tracking for BROADCAST sends (email + sms). True
  // (the default) = links gain UTM parameters and are wrapped in
  // the signed /public/messaging/redirect/:token redirect (clicks
  // recorded as MessageLinkClick). False = links are sent exactly
  // as authored on every channel — no UTM, no wrap. Workflow sends
  // are never rewritten either way.
  linkTrackingEnabled     Boolean  @default(true)
  // MX3: marketing-stream controls. The sweep caps are NULLABLE:
  // null = the platform default (a total budget of 20 broadcasts
  // per sweep run — up to 10 due + 10 stale, as before — and 200
  // entries per broadcast per run: the pre-MX3 behaviour). Quiet hours
  // defer MARKETING broadcast sends only; transactional sends
  // (OrderNotification, Shop OTP) never pass through the
  // broadcast engine and are never deferred. The window is
  // evaluated in the ORGANIZATION's timezone
  // (Organization.timezone) — there is deliberately no second
  // timezone field here.
  marketingMaxBroadcastsPerSweep Int?
  marketingMaxEntriesPerSweep    Int?
  // MX9: WhatsApp template quality guard. When TRUE, a NEW
  // broadcast send is refused for a template whose REAL
  // Meta-synced state is low — qualityRating "RED" (Meta's own
  // quality_score.score, stored by the MS6 sync) or status
  // "REJECTED". A template with no synced quality data (rating
  // null) is NEVER blocked by this guard: absence of data is not
  // low quality. Default FALSE = pre-MX9 behaviour.
  whatsappQualityGuardEnabled Boolean @default(false)
  // MX11: rule-based predictive-segment thresholds (see
  // messaging/engagement.ts). churnRiskSilentDays — days since
  // last engagement before a previously-engaged contact counts
  // as churn risk; likelyToBuyMinScore — engagement-score floor
  // for likely-to-buy; highLtvMinSpentMinor — absolute total
  // spent floor (minor units) for high-LTV; unengagedSuppressDays
  // / unengagedMinSends — the unengaged suppression SUGGESTION
  // rule (suggestions only; nothing is ever auto-suppressed).
  churnRiskSilentDays     Int      @default(60)
  likelyToBuyMinScore     Int      @default(60)
  highLtvMinSpentMinor    Int      @default(500000)
  unengagedSuppressDays   Int      @default(90)
  unengagedMinSends       Int      @default(3)
  quietHoursEnabled       Boolean  @default(false)
  quietHoursStart         String?
  quietHoursEnd           String?
  // MX15: send-approval workflow (owner decision D2). When TRUE,
  // a broadcast created by a user who is NOT an approver
  // (approver = an ACTIVE OWNER/ADMIN member) enters status
  // "pending_approval" and cannot be sent/scheduled/prepared
  // until a DIFFERENT OWNER/ADMIN approves it (four-eyes: the
  // creator can never approve their own). Default FALSE =
  // pre-MX15 behaviour, byte-identical. The UI copy recommends
  // ON for AGENCY plans but never forces it.
  approvalEnabled         Boolean  @default(false)
  // MX15: budget governance — SPEND caps in minor units,
  // computed ONLY from org-entered rates × real/planned sends.
  // There is NO messaging balance/credit figure for an org
  // (the CC10 WalletAccount is platform-payment money, never a
  // messaging balance — see docs/messaging-mx15-acceptance.md),
  // so these are spend caps, labelled spend-based everywhere.
  // Null = no cap. broadcastCostCapMinor caps ONE broadcast's
  // estimated cost; monthlySpendCapMinor caps the calendar
  // month's estimated spend across broadcasts.
  broadcastCostCapMinor   Int?
  monthlySpendCapMinor    Int?
  // MX16: A/B auto-winner org switch (owner decision D3 —
  // default OFF). When ON, an A/B pair whose per-broadcast
  // override does not disable it may auto-decide a winner on
  // the recipient-table send path under the stated rule
  // (messaging/analytics.ts: two-proportion z-test, min 100
  // sent per variant, |z| >= 1.96). Default FALSE = pre-MX16
  // behaviour: the report's winner stays a suggestion only.
  abAutoWinnerEnabled     Boolean  @default(false)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

// MX6: two-way / interactive campaigns — org-authored rules that
// match an inbound WhatsApp reply in the Unified Inbox. kind
// "keyword": one exact whole-message keyword (normalized exactly
// like the MS2 STOP/START hook — trim, Latin case-insensitive);
// the reserved STOP/START sets can NEVER be claimed here (the
// service refuses them — opt-out/opt-in bookkeeping is exclusive
// and supreme). kind "poll": pollOptions is
// [{ key, label, keywords: string[] }] — an inbound message
// matching one option's keyword records a vote (a
// MessagingKeywordHit with pollOptionKey); polls apply no tags
// and send no auto-reply in v1.
// Actions for keyword rules: ONE tag string (`tag`) applied to
// the entities named in applyTagTo ("customer" | "lead" |
// "conversation" — customer falls back to the linked lead when
// the conversation has no customer), plus an optional org-authored
// plain-text autoReplyText sent back through the REAL inbox
// conversation send path (registered port — Messaging never
// imports Inbox). channel is "whatsapp" only in v1: it is the
// only channel with an inbound path into messaging (no SMS
// inbound exists anywhere; email replies are not hooked;
// Messenger PSIDs match no preference/send keying — dead data).
// MX15: the org's internal seed/test recipient list — staff
// addresses (per channel) that one-click test sends go to
// through the EXISTING MS5 test-send path. A seed row is NOT a
// contact, lead or preference: it creates no audience membership
// and no consent record; a test send to it records a normal
// "test" MessageDelivery exactly like a typed-address test send.
model MessagingSeedRecipient {
  id             String   @id @default(uuid())
  organizationId String
  channel        String // email | sms | whatsapp | telegram
  address        String // normalized (normalizePrefAddress form)
  label          String?
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, channel, address])
  @@index([organizationId, channel])
}

model MessagingKeywordRule {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  kind           String // keyword | poll
  keyword        String? // null for poll rules
  channel        String   @default("whatsapp")
  tag            String?
  applyTagTo     Json? // string[] subset of customer|lead|conversation
  autoReplyText  String?
  pollOptions    Json? // [{ key, label, keywords: string[] }] — poll rules only
  enabled        Boolean  @default(true)
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, enabled])
}

// MX6: ONE row per inbound message that matched a keyword rule
// or a poll option — non-matching chatter writes NO row. actions
// is the per-action outcome list [{ action, status, reason?,
// entity?, providerMessageId? }] with status applied | skipped |
// failed — a skipped/failed action is recorded with its real
// reason, never dressed up as applied. The AI classification
// fields are a SUGGESTION workflow only: suggestedLabel +
// classifyStatus "suggested" after an LLM classify call (through
// the MS9 guard path); a human confirm stores confirmedLabel —
// and for "opt-out" the label is stored ONLY: confirming an
// opt-out suggestion NEVER writes a MessagePreference and never
// suppresses anyone (suppression happens only through the real
// STOP path, which is instant and already supreme).
model MessagingKeywordHit {
  id             String   @id @default(uuid())
  organizationId String
  ruleId         String
  conversationId String
  customerId     String?
  leadId         String?
  matchedText    String
  matchedKeyword String
  pollOptionKey  String?
  actions        Json?
  suggestedLabel String?
  classifyStatus String? // suggested | confirmed | dismissed
  confirmedLabel String?
  createdAt      DateTime @default(now())

  @@index([organizationId, ruleId, createdAt])
  @@index([organizationId, conversationId])
}

model Workflow {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  trigger        String // order_created | lead_created | lead_stage_changed
  conditions     Json? // [{field, op, value}] - all must pass
  steps          Json // [{type: send_email|send_sms|add_lead_activity, templateId?, text?}]
  enabled        Boolean  @default(true)
  // Workflows W6 governance: minimum minutes between
  // automated runs for the SAME entity (0 = off), and a
  // per-day automated run cap (null = off). Manual and
  // retry runs are deliberate and never governed.
  cooldownMinutes Int     @default(0)
  dailyRunCap     Int?
  // MX4: journey metadata for workflows owned by the
  // Messaging journey builder: { origin: "messaging",
  // exitOnPurchase?: boolean, layout?: unknown }. Null on
  // every other workflow — the engine's resume-time journey
  // fact refresh and exit-on-purchase check run ONLY when
  // this is non-null, so non-journey workflows behave
  // byte-identically to before.
  journey        Json?
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  runs           WorkflowRun[]

  @@index([organizationId, trigger, enabled])
}

model WorkflowRun {
  id             String   @id @default(uuid())
  organizationId String
  workflowId     String
  trigger        String
  context        Json
  status         String // completed | skipped | failed | waiting
  stepsLog       Json? // [{step, status, detail}]
  // Wait steps: a run pauses with status "waiting" and resumes when
  // resumeAt passes, continuing at nextStepIndex with its stored context.
  resumeAt       DateTime?
  nextStepIndex  Int      @default(0)
  // Workflows W1: the steps as they were when the run
  // started — editing the workflow never rewrites a
  // run already in flight.
  stepsSnapshot  Json?
  error          String?
  createdAt      DateTime @default(now())
  workflow       Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

// Internal note on a conversation. NEVER sent to the customer; there is
// deliberately no code path from this model to any messaging client.
model ConversationNote {
  id             String   @id @default(uuid())
  organizationId String
  conversationId String
  authorUserId   String
  content        String
  createdAt      DateTime @default(now())
  conversation   ChannelConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([organizationId])
}

// Org-level quick reply library for the inbox. Content may contain
// {{firstName}}, {{contactName}} and {{phone}} placeholders, rendered
// with the conversation's real contact data before insertion.
model QuickReply {
  id             String   @id @default(uuid())
  organizationId String
  title          String
  content        String
  // CX11ac: how many times this quick reply has been used to send.
  timesUsed      Int      @default(0)
  createdByUserId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
}

// Registry of WhatsApp message templates that exist (approved) in the
// business's Meta account. name + language must match Meta exactly;
// sending surfaces Meta's own error if the template is not approved.
model WhatsAppTemplate {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  language       String   @default("bn")
  category       String?  // UTILITY | MARKETING | AUTHENTICATION (as in Meta)
  bodyText       String?  // preview text for agents; Meta owns the real body
  // MS6: Meta-side state, populated by the template sync / submit
  // flow (InboxService). All NULL on legacy local-only rows — a
  // null status means "never verified with Meta", never approved.
  metaTemplateId String?  // Meta's message_template id, as returned
  status         String?  // Meta's status as returned (APPROVED | PENDING | REJECTED | PAUSED | DISABLED | …), or NOT_ON_META after a complete sync that did not return it
  qualityRating  String?  // quality_score.score as returned (GREEN | YELLOW | RED | UNKNOWN)
  components     Json?    // Meta's components array, as returned by sync or as authored at submit
  lastSyncedAt   DateTime? // last time sync/submit touched this row from Meta data
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, name, language])
  @@index([organizationId])
}

// Per-organization inbox intelligence settings (one row per org).
model InboxSetting {
  id                     String   @id @default(uuid())
  organizationId         String   @unique
  // Auto-reply master mode: off | draft | auto. perIntent may override
  // per intent: { "price": "auto", "complaint": "off", ... }.
  autoReplyMode          String   @default("off")
  confidenceThreshold    Int      @default(70)
  perIntent              Json?
  // Smart assignment for new conversations: off | round_robin | least_busy
  smartAssign            String   @default("off")
  lastAssignedUserId     String?
  // Order-taking bot: collects product/qty/name/phone/address in chat
  // and creates the order through the chat-order pipeline.
  botEnabled             Boolean  @default(false)
  // Delivery charge (minor units) the bot quotes + applies. Null =
  // the bot does not quote a charge; the team confirms it later.
  botDeliveryChargeMinor Int?
  slaFirstResponseMinutes Int     @default(60)
  // Unified Inbox U2: minutes before an away agent's open
  // conversation is reassigned; team that receives escalations.
  reassignAfterMinutes   Int?
  // Unified Inbox U6: days after which CLOSED conversations are
  // deleted by the inbox_retention job. Null = keep forever.
  retentionDays          Int?
  escalationTeamId       String?
  // Unified Inbox U3: per-channel auto-reply modes
  // { "whatsapp": "auto", ... } and the high-value escalation
  // threshold (minor units) for autopilot.
  perChannelModes          Json?
  escalationThresholdMinor Int?
  // CX3: seconds the autopilot waits before composing a reply
  // (0 = immediate, the pre-CX3 behaviour). aiReplyDelayByChannel
  // optionally overrides per channel: { "whatsapp": 45, ... }.
  aiReplyDelaySeconds    Int      @default(0)
  aiReplyDelayByChannel Json?
  // CX12d: channel-wise AI schedule — { "whatsapp": { enabled,
  // windows: [{ days: [0..6], start: "HH:mm", end: "HH:mm" }] } }
  // in the organization's timezone. Null = no schedule anywhere.
  aiScheduleByChannel   Json?
  // CX12b: post-delivery review requests — opt-in (this messages
  // customers, so default OFF) + the delay after delivery before
  // the review_request_sweep sends the ask.
  reviewRequestEnabled   Boolean  @default(false)
  reviewRequestDelayHours Int     @default(24)
  // CX7: "To Chase" — gentle follow-up nudges to customers whose
  // order-bot session stalled before completion. Opt-in (this
  // messages customers, so default OFF). First nudge after
  // chaseFirstDelayMinutes of session quiet, then every
  // chaseIntervalMinutes, at most chaseMaxAttempts times. Quiet
  // hours (org timezone) suppress sends when respected.
  chaseEnabled           Boolean  @default(false)
  chaseFirstDelayMinutes Int      @default(60)
  chaseIntervalMinutes   Int      @default(240)
  chaseMaxAttempts       Int      @default(3)
  chaseQuietHoursRespect Boolean  @default(true)
  chaseQuietStartHour    Int      @default(22)
  chaseQuietEndHour      Int      @default(8)
  // Owner CX7 variant fields (his series): kept alongside ours —
  // his chase service reads these names.
  maxChaseAttempts       Int      @default(2)
  chaseMessage           String?
  // IN4: layered SLA + active escalation chain. slaByChannel
  // optionally overrides the first-response minutes per channel:
  // { "whatsapp": 30, ... } (validated at the settings write
  // path; a channel absent from the map uses the org default).
  // slaVipMinutes optionally overrides BOTH for VIP conversations
  // (latest order >= escalationThresholdMinor); null = VIP uses
  // the channel/default layer like everyone else. The chain
  // (inbox_sla_sweep job): at 75% of the effective limit the
  // assignee is warned (always on — it is only a notification to
  // the person already responsible); slaEscalateAfterMinutes
  // after a breach the team lead is alerted when
  // slaLeadAlertEnabled (default ON, it only notifies), and the
  // conversation is auto-reassigned to the least-busy eligible
  // agent only when slaAutoReassignEnabled (default OFF — moving
  // work between people is opt-in, like every customer-affecting
  // automation in this schema).
  slaByChannel           Json?
  slaVipMinutes          Int?
  slaEscalateAfterMinutes Int     @default(30)
  slaLeadAlertEnabled    Boolean  @default(true)
  slaAutoReassignEnabled Boolean  @default(false)
  // CC27 (Connect Center Next): the member who last saved these
  // settings — the autopilot's CONFIGURING actor. Recorded on
  // every updateSettings save (null on rows that predate CC27 or
  // were never saved through the API). The CC27 deny gate for
  // AI/system sends reads it when a conversation has no assignee;
  // a null actor means "not recorded" and the gate honestly does
  // not apply (see docs/connect-center-b12-acceptance.md).
  updatedById            String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

// CX7: one chase chain per bot session (sessionId UNIQUE is the
// dedupe guard — a session can never grow two chains). Created
// lazily by the order_chase_sweep the first time the session is
// considered. stoppedReason is terminal (completed | stop_word |
// human_took_over | max_attempts | session_ended); lastEvent is a
// non-terminal trail (e.g. customer_replied). attempts counts
// CONFIRMED sends only — a failed send stamps lastFailedAt and
// does not consume an attempt.
model OrderChase {
  id             String    @id @default(uuid())
  organizationId String
  sessionId      String    @unique
  conversationId String
  attempts       Int       @default(0)
  lastChasedAt   DateTime?
  lastFailedAt   DateTime?
  stoppedReason  String?
  lastEvent      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([organizationId, stoppedReason])
}

// One active order-taking bot session per conversation.
model BotSession {
  id             String   @id @default(uuid())
  organizationId String
  conversationId String   @unique
  // ask_product | ask_quantity | ask_name | ask_phone | ask_address | confirm
  state          String
  data           Json? // collected answers (productId, quantity, name, phone, address)
  status         String   @default("active") // active | completed | handed_off | expired
  // CX7: To Chase tracking
  chaseCount     Int      @default(0)
  lastChasedAt   DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, status])
}

// A parcel booked with a courier for one of our orders. Status is
// always the courier's own reported status, refreshed via their API.
model CourierShipment {
  id                 String   @id @default(uuid())
  organizationId     String
  orderId            String
  // CC29 (Connect Center Next): the courier ACCOUNT (Integration
  // row) this shipment was booked under — with multi-account
  // keying, status sync must use THIS account's credentials, not
  // whichever account is the provider default today. Null on
  // pre-CC29 shipments: sync falls back to the provider's
  // resolved default account.
  integrationId      String?
  provider           String // steadfast (Pathao/RedX slot into the same shape)
  consignmentId      String?
  trackingCode       String?
  invoice            String
  status             String   @default("in_review")
  codAmountMinor     BigInt   @default(0)
  // EC26: the COD cash the courier actually remitted for this
  // shipment, recorded ONLY from a reconciliation import (or a
  // staff accept_sheet resolution) — a delivered status alone
  // never sets these. codCollectionSource = the
  // ReconciliationImport id that recorded the collection.
  codCollectedMinor  BigInt?
  codCollectedAt     DateTime?
  codCollectionSource String?
  recipientName      String
  recipientPhone     String
  recipientAddress   String
  lastNotifiedStatus String?
  lastCheckedAt      DateTime?
  // CX6: public live-tracking token (ReportShare pattern — minted
  // lazily on first customer update/share, unique when present).
  trackingToken      String?  @unique
  // EC22: the CourierRule that auto-selected this shipment's
  // courier at booking time (null = staff chose explicitly, or no
  // rule matched). Recorded so the choice stays explainable.
  courierRuleId      String?
  // ON6: stuck-parcel escalation stamps — escalatedAt /
  // escalatedForStatus together mean "staff have been escalated
  // for THIS status"; a later status change re-arms the sweep.
  escalatedAt        DateTime?
  escalatedForStatus String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  deliveryAttempts   DeliveryAttempt[]
  // GB5 (GC14): the delivery charge the provider itself returned
  // at BOOKING time (Pathao's delivery_fee today). Null whenever
  // the provider returned no charge — never estimated, never
  // backfilled from quotes or settlement sheets (the EC26 sheet
  // charge stays the stronger actual in ON7 profit, which falls
  // back to this only when no sheet line exists).
  chargeMinor        BigInt?
  events             CourierShipmentEvent[]

  @@index([organizationId, orderId])
  @@index([organizationId, status])
  @@index([organizationId, integrationId])
}

// GB5 (GC14): the shipment's own event history — status
// transitions, provider errors and staff notes/manual updates,
// recorded from GC14 onward (NO backfill: a shipment booked
// before GC14 has no events, and UIs say so). rawStatus keeps
// the provider's verbatim status string next to the mapped
// internal one, so an unmapped provider status is preserved,
// never silently dropped. Written failure-isolated by
// CourierService: a failed event write never breaks booking,
// sync or a manual update.
model CourierShipmentEvent {
  id             String   @id @default(uuid())
  organizationId String
  shipmentId     String
  // status | error | note
  kind           String
  // Internal-vocabulary status (kind = status rows only).
  status         String?
  // The provider's verbatim status string, when the event came
  // from a provider (booking / api_sync).
  rawStatus      String?
  // api_sync | manual | booking | system
  source         String
  // Staff user id for source = manual rows; null otherwise.
  actorId        String?
  // Error message snippet (kind = error) or staff note text.
  message        String?
  createdAt      DateTime @default(now())
  shipment       CourierShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([organizationId, shipmentId, createdAt])
  @@index([shipmentId, kind, createdAt])
}

// EC26: one courier COD settlement-sheet import. The merchant's
// own sheet is the only source — no courier API is claimed. The
// counts are the sum of its lines' outcomes (spec-asserted), and
// fileHash makes re-importing the same file for the same
// org+courier an explicit, refused-by-default act.
model ReconciliationImport {
  id                  String   @id @default(uuid())
  organizationId      String
  // NF10: nullable since FB4 — a bank/mobile-banking statement
  // import (kind = "bank_statement") has no courier account.
  // Courier COD imports (kind = "courier_cod", the EC26 default)
  // always set it, exactly as before.
  courierIntegrationId String?
  // NF10: courier_cod | bank_statement. Existing rows default to
  // courier_cod — the EC26 machinery is EXTENDED, never forked.
  kind                String   @default("courier_cod")
  // NF10: free-text label of the statement's account (e.g.
  // "bKash 017…", "City Bank …1234") for bank_statement imports.
  accountLabel        String?
  fileName            String?
  fileHash            String
  rowCount            Int      @default(0)
  matchedCount        Int      @default(0)
  mismatchCount       Int      @default(0)
  notFoundCount       Int      @default(0)
  duplicateCount      Int      @default(0)
  status              String   @default("processed") // processed | failed
  createdBy           String?
  // GB8 (GC20): stamped when the settlement-mismatch alert has
  // fired for this import — exactly once per import batch.
  mismatchAlertedAt   DateTime?
  createdAt           DateTime @default(now())

  @@index([organizationId, courierIntegrationId, createdAt])
  @@index([organizationId, fileHash])
}

// EC26: one row of an imported settlement sheet, preserved
// verbatim (raw values kept) whatever its outcome. expectedMinor
// snapshots the shipment's booked COD amount (codAmountMinor) at
// import time, so a line stays explainable even if the order is
// edited later.
model ReconciliationLine {
  id               String   @id @default(uuid())
  importId         String
  organizationId   String
  rowNumber        Int
  rawTrackingId    String?
  rawOrderRef      String?
  sheetAmountMinor BigInt?
  sheetChargeMinor BigInt?
  sheetStatus      String?
  matchedOrderId   String?
  matchedShipmentId String?
  expectedMinor    BigInt?
  // matched | amount_mismatch | not_found | duplicate |
  // already_collected | row_error
  // NF10 bank_statement rows use outcome = "statement".
  outcome          String
  note             String?
  reviewedAt       DateTime?
  reviewedBy       String?
  // NF10 (bank_statement rows only; null on courier rows):
  // the statement line's own date / description / direction
  // (credit = money in, debit = money out). The absolute amount
  // rides sheetAmountMinor (the sheet's amount column, as EC26).
  statementDate    DateTime?
  description      String?
  direction        String? // credit | debit
  // NF10 matching state for statement lines:
  // unmatched | suggested | matched | rejected. A suggestion is
  // computed at import (amount + date window) but NOTHING ever
  // auto-confirms: only a staff confirm sets "matched".
  matchState       String   @default("unmatched")
  // NF10: the suggested (or, once confirmed, the confirmed)
  // counterpart — suggestedRefType: journal_entry |
  // payment_verification; suggestedRefId: that row's id.
  suggestedRefType String?
  suggestedRefId   String?
  createdAt        DateTime @default(now())

  @@index([importId, outcome])
  @@index([organizationId, matchedShipmentId])
  @@index([organizationId, matchState])
}

// EC26: saved CSV column mapping per (org, courier account) —
// header-name based, so a repeat import of the same courier's
// sheet is one click. mapping Json:
// { trackingColumn, amountColumn, chargeColumn?, orderRefColumn?,
//   statusColumn? } — values are the sheet's own header names.
model ReconciliationProfile {
  id                   String   @id @default(uuid())
  organizationId       String
  courierIntegrationId String
  mapping              Json
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([organizationId, courierIntegrationId])
}

// EC33: org-level inventory intelligence settings. leadTimeDays
// feeds the velocity reorder mode (suggestedQty =
// ceil(dailyVelocity × leadTimeDays) − currentStock).
model InventorySetting {
  id             String   @id @default(uuid())
  organizationId String   @unique
  leadTimeDays   Int      @default(14)
  // GB2 (GC7): when true, the native online checkouts accept
  // orders beyond available stock (placement decrements into
  // negative exactly as the S1 ledger does today). Default
  // false = checkout refuses beyond AVAILABLE stock.
  allowBackorder Boolean  @default(false)
  // GB2 (GC7): minutes a native shop cart's items stay reserved
  // (StockReservation) after the cart's last item mutation.
  // 0 = reservations OFF (the default; availability then equals
  // on-hand everywhere, exactly as before GB2).
  reserveMinutes Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// GB2 (GC7): stock reserved by a native shop cart (StoreCart).
// sessionRef = the StoreCart id. A reservation counts against
// availability only while state = "active" AND expiresAt > now
// (lazy expiry — reads never count an expired row, whether or
// not its state was ever flipped). Cart conversion stamps
// "consumed"; cart edits reconcile the set (changed/removed
// lines are "released"). productId/variantId are plain ids like
// StockMovement's (no FK): a reservation must never block a
// product delete, and an orphan row can never match a live
// product's availability query (ids are uuids, never reused).
model StockReservation {
  id             String       @id @default(uuid())
  organizationId String
  sessionRef     String
  productId      String
  variantId      String?
  // AB3 (AX4): the bin this reservation holds against, resolved
  // at reserve time (plain id like productId — no FK). Null on
  // pre-AB3 rows; those keep counting org-globally as today.
  binId          String?
  quantity       Int
  state          String       @default("active") // active | consumed | released
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, sessionRef, state])
  @@index([organizationId, productId, variantId, state, expiresAt])
}

// CX12b: post-delivery review request + the collected review.
// ONE row per order (orderId unique — the double-delivery guard).
// Created at delivery with status "pending_send"; the
// review_request_sweep sends the ask when the org's delay has
// passed and stamps "requested"; a captured rating/comment stamps
// "received". A row is NEVER marked sent without a confirmed send
// — channel-less orders stay visibly pending_send. "declined" is
// part of the status vocabulary but no v1 flow produces it (there
// is no decline parsing; an ignored ask simply stays "requested").
// reviewToken is the public review-page credential (CX6 pattern).
model OrderReview {
  id             String    @id @default(uuid())
  organizationId String
  orderId        String    @unique
  customerId     String?
  conversationId String?
  rating         Int?
  comment        String?
  source         String?
  status         String    @default("pending_send")
  reviewToken    String    @unique
  deliveredAt    DateTime
  requestedAt    DateTime?
  receivedAt     DateTime?
  // EC15: staff moderation + reply for the public reviews engine.
  // isVisible=false hides the review from every public surface;
  // pending_send/requested rows are never public regardless.
  replyText      String?
  repliedAt      DateTime?
  isVisible      Boolean   @default(true)
  // NF8 (FB3): customer-uploaded review media — a Json array of
  // { key, kind, contentType, sizeBytes } pointing at PRIVATE
  // bucket objects (StoredFile surface "review"). Keys only,
  // never URLs: a signed URL is minted at read time and ONLY for
  // a review that is public under EC15's rules (received +
  // isVisible) or on the staff moderation surface.
  media          Json?
  // NF8: the staff "share as social draft" claim — the SocialPost
  // id created from this review through SocialService.createPost.
  // Non-null = the draft exists; repeating the action reuses it
  // instead of creating a duplicate (exactly-once per review).
  socialDraftPostId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([organizationId, status])
  @@index([organizationId, conversationId])
}

// NDR (Non-Delivery Report) incident for parcels where a delivery attempt failed,
// was rescheduled, or customer was unreachable. Intercepts returns early.
model CourierNdrIncident {
  id               String    @id @default(uuid())
  organizationId   String
  shipmentId       String
  orderId          String
  provider         String    // steadfast | pathao | redx
  trackingCode     String
  reason           String    @default("customer_unreachable") // customer_unreachable | address_issue | customer_rescheduled | delivery_delayed | other
  status           String    @default("OPEN") // OPEN | CUSTOMER_CONTACTED | RESCHEDULED | RESOLVED | RETURNED
  customerFeedback String?   // CONFIRMED_TOMORROW | CHANGE_ADDRESS | CANCEL_ORDER | NOT_REACHABLE
  rescheduleDate   DateTime?
  notes            String?
  lastContactedAt  DateTime?
  actionTaken      String?
  resolvedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([organizationId, status])
  @@index([organizationId, shipmentId])
  @@index([organizationId, orderId])
}

// COD Reconciliation & Disbursement Tracking (Steadfast / Pathao / RedX)
// Matches merchant bank disbursements against courier delivery records,
// catches underpayments, overcharged courier fees, and missing COD money.
model CourierDisbursementBatch {
  id                  String                    @id @default(uuid())
  organizationId      String
  provider            String                    // steadfast | pathao | redx | generic
  referenceNo         String                    // Invoice / payout statement reference
  totalOrders         Int                       @default(0)
  totalCollectedMinor BigInt                    @default(0) // COD collected by courier
  totalFeeMinor       BigInt                    @default(0) // Delivery fees deducted
  netDisbursedMinor   BigInt                    @default(0) // Net amount credited to merchant
  matchedCount        Int                       @default(0)
  discrepancyCount    Int                       @default(0)
  unmatchedCount      Int                       @default(0)
  status              String                    @default("PROCESSED") // PROCESSED | RECONCILED
  uploadedBy          String?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  items               CourierDisbursementItem[]

  @@index([organizationId, createdAt])
  @@index([organizationId, provider])
}

model CourierDisbursementItem {
  id                    String                   @id @default(uuid())
  batchId               String
  organizationId        String
  trackingCode          String
  orderId               String?
  consignmentId         String?
  systemCodMinor        BigInt                   @default(0)
  courierCollectedMinor BigInt                   @default(0)
  courierFeeMinor       BigInt                   @default(0)
  netPaidMinor          BigInt                   @default(0)
  status                String                   // MATCHED | UNDERPAID | OVERCHARGED_FEE | UNKNOWN_TRACKING
  discrepancyMinor      BigInt                   @default(0)
  disputeStatus         String                   @default("NONE") // NONE | OPEN | CLAIMED | RESOLVED
  notes                 String?
  createdAt             DateTime                 @default(now())
  batch                 CourierDisbursementBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@index([organizationId, trackingCode])
  @@index([organizationId, status])
}


// Result of an AI-vision check on a payment screenshot sent in chat.
// An aid for the agent - it never marks an order paid by itself.
model PaymentVerification {
  id                  String   @id @default(uuid())
  organizationId      String
  // EC19: nullable since B8 — a staff-recorded order advance has
  // no conversation/message behind it. Inbox extractions always
  // set both, exactly as before.
  conversationId      String?
  messageId           String?  @unique
  // EC19: the order this verification pays toward. Set by the
  // staff advance endpoint (and null for legacy inbox rows).
  orderId             String?
  provider            String? // bkash | nagad | rocket | bank | cash | other | unknown
  trxId               String?
  amountMinor         BigInt?
  expectedAmountMinor BigInt?
  // matched | amount_mismatch | duplicate_trxid | no_expected_order | unverifiable
  verdict             String
  // EC19: review state. Inbox extraction rows stay "pending" (the
  // extraction is advisory; the agent decides). Staff-recorded
  // advances are created "approved" with reviewedById = the staff
  // member — the staff member IS the verifier. An order's paid
  // advance is the sum of its APPROVED rows only.
  status              String   @default("pending") // pending | approved | rejected
  // EC19: null = legacy inbox extraction; "manual_advance" =
  // recorded by staff against an order (no gateway involved).
  source              String?
  reviewedById        String?
  note                String?
  flags               Json?
  rawExtraction       Json?
  modelProvider       String
  createdById         String?
  createdAt           DateTime @default(now())

  // EC31: set when this approved row is a collection against one
  // installment item — the row is the SAME approved-verification
  // record the EC19 due math sums, so collecting an installment
  // reduces the order's amountDueMinor by construction.
  installmentItemId   String?

  @@index([organizationId, trxId])
  @@index([organizationId, orderId])
  @@index([organizationId, installmentItemId])
}

// EC31: a manual installment (কিস্তি) plan over one order's
// amount due at creation time. totalMinor is a SNAPSHOT — later
// order changes never rewrite the schedule. Collections are
// approved PaymentVerification rows (installmentItemId set), so
// the EC19 order due math stays the single source of truth.
// status: active | completed | cancelled.
model InstallmentPlan {
  id               String           @id @default(uuid())
  organizationId   String
  orderId          String           @unique
  totalMinor       BigInt
  installmentCount Int
  intervalDays     Int
  startDate        DateTime
  status           String           @default("active") // active | completed | cancelled
  createdById      String?
  note             String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  order            Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items            InstallmentItem[]

  @@index([organizationId, status])
}

model InstallmentItem {
  id       String          @id @default(uuid())
  planId   String
  seq      Int
  dueDate  DateTime
  amountMinor BigInt
  paidMinor   BigInt       @default(0)
  paidAt      DateTime? // set when the item becomes fully paid
  // EC31: reminder bookkeeping — exactly one notification attempt
  // per state (due_soon / overdue). Status vocabulary mirrors the
  // EC28 alert honesty: sent | failed_no_channel | failed. A
  // failed_no_channel attempt still stamps the At field (the
  // attempt happened; it is never retried silently — staff see
  // the status on the plan), matching the brief's exactly-once
  // per item per state.
  dueSoonRemindedAt     DateTime?
  dueSoonRemindStatus   String?
  overdueRemindedAt     DateTime?
  overdueRemindStatus   String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  plan      InstallmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, seq])
  @@index([planId])
}

// EC32: an affiliate partner of the org — a person/business who
// shares ?ref=<code> links to the shop/landings and earns a
// commission on attributed delivered orders. Deliberately NOT a
// Customer and NOT the EC16 referral system: partners are
// staff-managed, commissionPercent is validated 0–50, and the
// code is org-unique + staff-editable. status: active | paused
// (a paused partner's code attributes nothing).
model AffiliatePartner {
  id                String   @id @default(uuid())
  organizationId    String
  name              String
  phone             String
  email             String?
  code              String
  commissionPercent Int
  status            String   @default("active") // active | paused
  note              String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orders            Order[]
  commissionEntries CommissionEntry[]
  payouts           AffiliatePayout[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
}

// EC32: one commission per attributed order (orderId UNIQUE —
// repeated delivered transitions can never duplicate it).
// Created by the failure-isolated order.delivered hook once the
// order reaches the codebase's sold bucket (EC33 definition).
// baseMinor = the order's goods payable at creation time:
// subtotalMinor − discountMinor (ALL discounts incl. promotions
// / coupon / referral; delivery charge and tax are NOT part of
// the base). percentSnapshot freezes the partner's percent at
// creation. status: pending → approved → paid; voided when the
// order is fully refunded or cancelled while pending/approved
// (paid entries are NEVER auto-voided — see the payout report's
// paid_on_refunded_order flag). Partial refunds do not pro-rate
// (v1, documented).
model CommissionEntry {
  id              String   @id @default(uuid())
  organizationId  String
  partnerId       String
  orderId         String   @unique
  baseMinor       BigInt
  percentSnapshot Int
  commissionMinor BigInt
  status          String   @default("pending") // pending | approved | paid | voided
  voidReason      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  partner         AffiliatePartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  order           Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([organizationId, partnerId, status])
  @@index([organizationId, status])
}

// EC32: a payout is a BOOKKEEPING RECORD ONLY — it documents
// money the merchant paid the partner OUTSIDE the system
// (bKash/Nagad/bank/cash by hand). The system never sends money
// and no code may claim it did. Recording a payout flips the
// partner's approved entries to paid in FIFO order (oldest
// first) up to the cumulative coverage — see AffiliatesService.
model AffiliatePayout {
  id             String   @id @default(uuid())
  organizationId String
  partnerId      String
  amountMinor    BigInt
  method         String // bkash | nagad | bank | cash | other
  reference      String?
  note           String?
  createdById    String?
  createdAt      DateTime @default(now())
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  partner        AffiliatePartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([organizationId, partnerId, createdAt])
}

// EC18: a merchant-defined delivery time window shoppers can pick
// at checkout. districtScope is a Json array of district names
// (same vocabulary as BD_DISTRICTS); null/empty = every district.
// capacityPerDay null = unlimited; otherwise checkout refuses once
// the day's non-cancelled orders for the slot reach the capacity.
model DeliverySlot {
  id             String   @id @default(uuid())
  organizationId String
  label          String
  startTime      String // "HH:mm"
  endTime        String // "HH:mm"
  districtScope  Json?
  capacityPerDay Int?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, active])
}

// A website live-chat installation. Each site owns a 'webchat'
// integration row; the widget authenticates with the site key and a
// per-visitor session token (only its hash is stored).
model WidgetSite {
  id             String   @id @default(uuid())
  organizationId String
  integrationId  String?
  name           String
  domain         String?
  widgetKey      String   @unique
  greeting       String?
  color          String?
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
}

model LiveChatSession {
  id              String   @id @default(uuid())
  widgetSiteId    String
  conversationId  String   @unique
  visitorId       String
  visitorTokenHash String
  visitorName     String?
  createdAt       DateTime @default(now())
  lastSeenAt      DateTime @default(now())

  @@index([widgetSiteId, visitorId])
}

// Who is looking at / typing in a conversation right now (collision
// detection). Rows are heartbeats; stale rows are ignored by age.
model AgentPresence {
  id             String   @id @default(uuid())
  organizationId String
  conversationId String
  userId         String
  typing         Boolean  @default(false)
  lastSeenAt     DateTime @default(now())

  @@unique([conversationId, userId])
  @@index([organizationId, conversationId])
}

// Sales & Data S1: one row per stock change, so a product's
// balance is always explainable. Loose-reference like
// AgentNotification: plain organizationId, no relations.
// reason: order_placed | order_cancelled | order_returned |
// manual_adjustment | sync_correction. Negative balanceAfter is
// recorded truthfully (oversell happens with COD commerce).
// AB3 (AX4): binId attributes the delta to one bin (plain id,
// no relation — null for pre-AB3 rows and for movements whose
// flow has no bin attribution); balanceAfter keeps its GLOBAL
// meaning. AB3 adds the reasons transfer_out | transfer_in |
// reallocation_out | reallocation_in, chosen OUTSIDE every
// pre-AB3 reason family (restore / netting / damage / velocity).
model StockMovement {
  id             String   @id @default(uuid())
  organizationId String
  productId      String
  variantId      String?
  binId          String?
  delta          Int
  balanceAfter   Int
  reason         String
  orderId        String?
  actorUserId    String?
  note           String?
  createdAt      DateTime @default(now())

  @@index([organizationId, productId, createdAt])
  @@index([orderId, reason])
}

// Feature 3: Stock-Linked Meta Ad Auto-Pause Guardrail
model InventoryAdGuardLog {
  id               String   @id @default(uuid())
  organizationId   String
  productId        String
  productName      String
  currentStock     Int
  action           String   // AUTO_PAUSED | AUTO_RESUMED | ALERT_SENT
  campaignPlanId   String?
  campaignName     String?
  adId             String?
  adName           String?
  details          String?
  createdAt        DateTime @default(now())

  @@index([organizationId, productId])
  @@index([organizationId, createdAt])
}


// In-app agent notifications: assignments, @mentions, urgent chats.
model AgentNotification {
  id             String    @id @default(uuid())
  organizationId String
  userId         String
  type           String // assigned | mention | urgent
  title          String
  body           String?
  conversationId String?
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  @@index([organizationId, userId, readAt])
}

// GB6 (GC16): per-staff in-app notification preferences. One
// row per (user, organization); mutedCategories is a Json
// array of category keys from common/agent-notify.ts. A muted
// category means AgentNotification rows of that category are
// NOT created for this user. In-app only — no other channel
// is affected. Absence of a row = nothing muted.
model NotificationPreference {
  id               String       @id @default(uuid())
  userId           String
  organizationId   String
  mutedCategories  Json         @default("[]")
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

// GB6 (GC15): a saved CRM segment — criteria Json over the
// customer record (vocabulary: tagsAny[], isVip, isRepeat,
// minSpentMinor, district). Membership is COMPUTED live from
// the criteria (never materialized); the list filter and the
// member counter share one evaluator so they cannot drift.
model CrmSegment {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  criteria       Json
  createdById    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// GB6 (GC16): a per-org custom role — a named subset of the
// REAL permission-area catalog (common/permission-catalog.ts).
// Assigned via Membership.customRoleId. The member's preset
// role remains the baseline for role-list-only endpoints;
// the custom role's areas govern @PermissionArea endpoints.
// presetKey is set when the role was materialized from one
// of the built-in PRESET_ROLE_PROFILES (ORDER_MANAGER,
// INVENTORY_MANAGER, FINANCE) and is immutable afterwards.
model CustomRole {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  areas          Json
  presetKey      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members        Membership[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

// GB6 (GC16): one row per login attempt (success + failure).
// email is stored as attempted (failures for unknown emails
// have userId null). Passwords and tokens are NEVER stored.
model LoginEvent {
  id        String   @id @default(uuid())
  userId    String?
  email     String
  success   Boolean
  // AB8 (AX26): how the login completed — password | google.
  // Existing rows default to "password" (every pre-AB8 login was
  // a password login; TOTP completions keep the ORIGINATING
  // method via the challenge token's `via` claim).
  method    String   @default("password")
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([email, createdAt])
}

// GB6 (GC16): server-side session registry for the stateless
// JWT flow. A row is created at token issuance and its id is
// carried as the token's `sid` claim; JwtAuthGuard rejects a
// token whose session is revoked. Tokens minted before GB6
// carry no sid and stay valid until natural expiry (legacy).
model UserSession {
  id         String    @id @default(uuid())
  userId     String
  ip         String?
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([userId, createdAt])
}

// Daily breakdown aggregates from the Meta insights API (age/gender,
// placement). Keys are the API's own breakdown values.
model DailyAdBreakdown {
  id                   String   @id @default(uuid())
  organizationId       String
  adAccountId          String
  platform             String   @default("meta")
  source               String   @default("api")
  date                 DateTime
  dimension            String // age_gender | placement
  key                  String // "25-34:male" | "facebook:feed"
  campaignExternalId   String   @default("")
  spendMinor           BigInt   @default(0)
  impressions          Int      @default(0)
  clicks               Int      @default(0)
  platformConversions  Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([organizationId, adAccountId, date, dimension, key, campaignExternalId, source])
  @@index([organizationId, dimension, date])
}

// Meta Conversions API configuration per organization. The token is
// optional: when absent, the Meta ads integration token is used.
model ConversionApiSetting {
  id                   String   @id @default(uuid())
  organizationId       String   @unique
  pixelId              String // dataset / pixel id
  accessTokenEncrypted String?
  testEventCode        String?
  // placed | cod_confirmed | delivered
  purchaseTrigger      String   @default("placed")
  enabled              Boolean  @default(true)
  sendLeadEvents       Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

// One row per event we attempted to send to the Conversions API.
// status is "sent" ONLY when Meta answered with events_received >= 1.
model ConversionEventLog {
  id             String   @id @default(uuid())
  organizationId String
  eventName      String // Purchase | Lead | TestEvent
  sourceType     String // order | lead | test
  sourceId       String?
  eventId        String
  status         String // sent | failed
  eventsReceived Int?
  fbtraceId      String?
  error          String?
  payload        Json?
  createdAt      DateTime @default(now())

  @@unique([organizationId, eventId])
  @@index([organizationId, createdAt])
}

// Creative library asset uploaded to (or registered with) a Meta ad
// account. status is "ready" ONLY with a Meta-issued hash / video id;
// video assets pass through "processing" until Meta reports ready.
model CreativeAsset {
  id              String   @id @default(uuid())
  organizationId  String
  adAccountId     String
  kind            String // image | video
  name            String
  sourceUrl       String
  // CA5: pixel dimensions, populated at direct image upload
  // completion (sharp), CA1 AI image generation and CA2 AI
  // video rendering. Null = unknown (legacy assets, direct
  // video uploads) — creative-health reports those dimension
  // checks as not_checked, never as passed.
  width           Int?
  height          Int?
  externalHash    String?
  externalVideoId String?
  status          String   @default("pending") // pending | processing | ready | failed
  error           String?
  createdById     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId, adAccountId])
}

// Custom / lookalike audience on Meta. approximateCount is Meta's own
// reported number (from the API), never estimated locally.
model AudienceRecord {
  id                 String   @id @default(uuid())
  organizationId     String
  adAccountId        String
  name               String
  kind               String // custom | lookalike
  source             String // customers | leads | rfm_segment | meta
  sourceDetail       String? // e.g. the RFM segment name
  externalAudienceId String?
  approximateCount   Int?
  status             String   @default("building") // building | ready | failed
  error              String?
  lastSyncedAt       DateTime?
  createdById        String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([organizationId, adAccountId])
  lastMembershipSyncAt DateTime?
  lastMembershipCount  Int?
}

// Saved targeting preset an organization reuses in the builder.
model SavedAudience {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  targeting      Json
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
}

// CA7 (Campaign Builder Advanced, CB2): per-audience delivery
// rollup, computed by AudiencesService.refreshPerformanceRollups
// from REAL DailyAdMetric rows joined per ad set to the ONE
// audience that ad set unambiguously used. DailyAdMetric has no
// audience dimension, so an ad set with 2+ distinct audiences
// (or an unresolvable one) is EXCLUDED from attribution and
// counted in the coverage note — its spend is never split or
// guessed across audiences. audienceKey is "record:<id>" for a
// Meta AudienceRecord or "saved:<id>" for a SavedAudience
// referenced by an ad set's targeting.savedAudienceId. CPA/CTR
// are derived at read time, never stored. One row per
// (organization, audienceKey); refreshed wholesale per window.
model AudiencePerformanceRollup {
  id               String   @id @default(uuid())
  organizationId   String
  audienceKey      String
  audienceKind     String
  audienceRecordId String?
  savedAudienceId  String?
  name             String
  adAccountId      String?
  spendMinor       BigInt   @default(0)
  impressions      Int      @default(0)
  clicks           Int      @default(0)
  conversions      Int      @default(0)
  windowDays       Int      @default(90)
  adSetsCounted    Int      @default(0)
  computedAt       DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([organizationId, audienceKey])
  @@index([organizationId])
}

// CA8 (Campaign Builder Advanced, CB2): the last membership
// snapshot a full sync actually established on Meta — the
// SHA-256 [emailHash, phoneHash] pairs (the same one-way
// hashes that were uploaded; raw contacts are never stored).
// Kept in its OWN table, never on AudienceRecord, so audience
// list/read paths can never leak pair data. refreshMembership
// diffs the current segment against this snapshot to upload
// additions and DELETE departures; a missing row means no
// baseline exists yet (first full sync uploads all, deletes
// none).
model AudienceMembershipSnapshot {
  id               String   @id @default(uuid())
  organizationId   String
  audienceRecordId String   @unique
  pairs            Json
  memberCount      Int      @default(0)
  syncedAt         DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([organizationId])
}

// Meta Commerce catalog the organization pushes products to.
model CatalogRecord {
  id               String   @id @default(uuid())
  organizationId   String
  name             String
  externalCatalogId String
  businessId       String?
  status           String   @default("connected")
  lastSyncAt       DateTime?
  lastSyncSummary  Json?
  // AB5 (AX10): change-driven sync opt-in. Default FALSE — the
  // manual push stays the behaviour until the merchant turns
  // this on per catalog. Product writes enqueue CatalogSyncRecord
  // rows ONLY for catalogs with autoSync on.
  autoSync         Boolean  @default(false)
  // AB5 (AX10): the Facebook Page / Instagram account the
  // merchant says this catalog is linked to (staff-entered at
  // register/create; displayed verbatim). Null = not recorded —
  // the UI says so instead of inventing a lookup.
  pageId           String?
  pageName         String?
  instagramId      String?
  instagramName    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([organizationId])
}

// AB5 (AX10): one queued change-driven catalog sync action.
// Product writes (create/update/archive/variants) enqueue these
// failure-isolated for every autoSync catalog of the org; the
// catalog_sync_sweep job drains them through the same Meta batch
// endpoint the manual push uses (CREATE/UPDATE/DELETE per
// action). retailerId is snapshotted at enqueue time so a DELETE
// still knows its external id after the product row is gone.
// Pending rows for the same (catalog, product) collapse: the
// latest action wins (a delete supersedes a pending update).
model CatalogSyncRecord {
  id             String    @id @default(uuid())
  organizationId String
  catalogId      String
  productId      String
  retailerId     String?
  action         String // create | update | delete
  status         String    @default("pending") // pending | done | failed
  attempts       Int       @default(0)
  lastError      String?
  processedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([organizationId, catalogId, status, createdAt])
  @@index([organizationId, productId])
}

// A campaign published directly to Google Ads or TikTok (Phase I).
// status becomes "created_paused" ONLY when the platform returned ids
// for the full chain; otherwise "failed" with the step's error.
model PlatformPublication {
  id                 String   @id @default(uuid())
  organizationId     String
  platform           String // google | tiktok
  adAccountId        String
  name               String
  status             String   @default("pending") // pending | created_paused | failed
  externalCampaignId String?
  detail             Json?
  error              String?
  createdById        String
  createdAt          DateTime @default(now())

  @@index([organizationId, platform])
}

// Campaign Builder Next CN9: a CB6 cross-platform draft as a
// manageable object. `fields` is the mapped platform payload
// (the platform's real field set for this flow) as stored on
// OUR side — editable, readiness-checked and re-creatable
// through PublishingService. status: mapped (stored, not yet
// created) | created (platform confirmed a PAUSED draft) |
// blocked (readiness failed; fields ARE the export package) |
// failed (platform call attempted and refused). The external
// draft itself is never edited in place: re-publish creates a
// new PAUSED draft (no update/delete path exists platform-side
// in this codebase) and that is stated wherever it surfaces.
model CrossPlatformDraft {
  id                 String   @id @default(uuid())
  organizationId     String
  planId             String
  platform           String // google | tiktok
  // Frontier NB8 / CN17: the draft's type within its
  // platform. null = the legacy CN9 behaviour (google →
  // Search RSA, tiktok → the stored fields). "pmax" = a
  // Google Performance Max draft (fields carry the PMax
  // asset-group shape the PublishingService skeleton
  // accepts). TikTok objective choice lives in `fields`
  // (objectiveType) — the draft path only.
  kind               String?
  targetAdAccountId  String
  fields             Json
  status             String   @default("mapped")
  unmapped           Json?
  publicationId      String?
  externalCampaignId String?
  lastError          String?
  createdById        String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([organizationId, planId])
}

// Public, read-only, expiring report link for clients (Phase I).
// Shows spend/revenue/orders/platform metrics — never costs or profit.
/// Reports Advanced RP2: a tenant-built report definition.
/// metrics/dimension are validated against the engine's
/// matrix in code (custom-reports.service.ts); rangePreset
/// is one of last_7d | last_30d | this_month | last_month.
model SavedReport {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  metrics        String[]
  dimension      String // day | platform | campaign
  rangePreset    String   @default("last_30d")
  recipients     String[] @default([])
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
}

/// Reports Advanced RP5: a monthly target for one
/// metric (revenue | orders | spend). Progress is
/// computed on read from AnalyticsService.computeRange
/// — never stored, never estimated.
model ReportGoal {
  id             String   @id @default(uuid())
  organizationId String
  month          String // YYYY-MM
  metric         String // revenue | orders | spend
  target         BigInt
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, month, metric])
  @@index([organizationId])
}

model ReportShare {
  id             String   @id @default(uuid())
  organizationId String
  token          String   @unique
  title          String
  // RP6: overview (default, M20 behaviour) | executive
  // (RP6 summary — the public rendering still strips
  // costs and profit for both kinds).
  // Frontier NB8 / CN18: kind "campaign" = a single
  // campaign plan's performance report (CB5 totals +
  // CN7 breakdowns + CN2 pacing, allowlisted fields
  // only); planId names the plan and days is the window.
  kind           String   @default("overview")
  planId         String?
  days           Int      @default(30)
  expiresAt      DateTime
  createdById    String
  createdAt      DateTime @default(now())

  @@index([organizationId])
}

model ProductSet {
  id              String   @id @default(cuid())
  organizationId  String
  catalogRecordId String
  name            String
  category        String?
  maxPriceMinor   BigInt?
  inStockOnly     Boolean  @default(true)
  externalSetId   String?
  status          String   @default("local") // local | created | failed
  error           String?
  createdById     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId])
  @@index([catalogRecordId])
}

model OfflineConversionSetting {
  id               String   @id @default(cuid())
  organizationId   String
  platform         String // google | tiktok | meta (CN14, NB6)
  adAccountId      String
  conversionAction String? // google: conversion action id
  pixelCode        String? // tiktok: Events API pixel code
  datasetId        String? // meta (CN14): dataset (pixel) id receiving the events
  // CN14 (NB6): on a meta row, also send CRM stage outcomes
  // (qualified / won) for Meta lead-ads leads back to the
  // dataset (Meta's Conversion Leads payload). Default off —
  // nothing is sent to Meta about leads until the org opts in.
  leadFeedbackEnabled Boolean @default(false)
  trigger          String   @default("cod_confirmed") // placed | cod_confirmed | delivered
  enabled          Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([organizationId, platform])
  @@index([organizationId])
}

model OfflineConversionLog {
  id              String   @id @default(cuid())
  organizationId  String
  platform        String
  eventId         String
  orderId         String?
  status          String // sent | failed | skipped
  detail          String?
  createdAt       DateTime @default(now())

  @@unique([organizationId, platform, eventId])
  @@index([organizationId, platform])
}

model AdminNote {
  id         String   @id @default(cuid())
  targetType String // user | organization
  targetId   String
  body       String
  authorId   String
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
}

model SystemSetting {
  key        String   @id
  value      Json
  updatedById String?
  updatedAt  DateTime @updatedAt
}

model OrgFeatureFlag {
  id             String  @id @default(cuid())
  organizationId String
  key            String
  enabled        Boolean @default(true)

  @@unique([organizationId, key])
  @@index([organizationId])
}

/// TD11 (Tenant Domain): slug cooldown tombstone. When an
/// organization is PERMANENTLY deleted (AdminService
/// .deleteOrgPermanent — the only hard-delete path; soft-delete
/// status changes never write one), its slug is parked here for
/// 180 days so a new org cannot immediately take over the deleted
/// shop's {slug}.qosprey.com address (old links/customers would
/// land on a stranger's shop). slugAvailability() refuses the
/// name with reason "cooldown" while an unreleased, unexpired
/// row exists. A SUPER admin can release a name early
/// (POST /admin/slug-tombstones/:slug/release, reason mandatory,
/// audited); released/expired rows stay as history and no longer
/// block anything.
model SlugTombstone {
  id             String    @id @default(cuid())
  slug           String    @unique
  deletedOrgName String?
  deletedAt      DateTime  @default(now())
  expiresAt      DateTime
  releasedAt     DateTime?
  releasedById   String?
  createdAt      DateTime  @default(now())

  @@index([expiresAt])
}

model Announcement {
  id        String    @id @default(cuid())
  title     String
  body      String
  audience  String    @default("all")
  startsAt  DateTime?
  endsAt    DateTime?
  active    Boolean   @default(true)
  createdById String
  createdAt DateTime  @default(now())
}

model SaasPayment {
  id             String    @id @default(cuid())
  organizationId String
  amountMinor    BigInt
  currency       String    @default("BDT")
  method         String // bkash | bank | cash | card | other
  reference      String?
  periodStart    DateTime?
  periodEnd      DateTime?
  recordedById   String
  note           String?
  refundedMinor  BigInt    @default(0)
  refundedAt     DateTime?
  refundReason   String?
  createdAt      DateTime  @default(now())

  @@index([organizationId])
}

// Milestone 34 (Phase N1): email-based member invitations. Only the
// SHA-256 hash of the invite token is stored; the raw token exists
// solely in the emailed / copied link. Expiry is computed from
// expiresAt (status stays "pending" until accepted or revoked).
model MemberInvitation {
  id             String    @id @default(cuid())
  organizationId String
  email          String
  role           Role      @default(VIEWER)
  tokenHash      String    @unique
  status         String    @default("pending") // pending | accepted | revoked
  invitedById    String
  expiresAt      DateTime
  acceptedAt     DateTime?
  acceptedUserId String?
  emailSent      Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([organizationId])
  @@index([email])
}

// ORG9 (Organization Next OB3): shareable, role-bound invite links.
// Unlike MemberInvitation (bound to one email), a link can be
// shared openly — so it NEVER creates a membership by itself: it
// only creates an OrgJoinRequest that an OWNER/ADMIN must approve
// (ORG10). Only the SHA-256 hash of the token is stored (the same
// discipline as MemberInvitation); the raw token is returned ONCE
// at creation. maxUses is nullable in storage but null is NEVER
// "unlimited": the service defaults a missing cap to 10 and reads
// a stored null as 10 as well. usedCount counts join REQUESTS the
// link has produced (approvals/rejections do not change it) — the
// cap bounds how many requests one leaked link can generate.
model OrgInviteLink {
  id             String    @id @default(cuid())
  organizationId String
  role           Role      @default(VIEWER)
  tokenHash      String    @unique
  maxUses        Int?
  usedCount      Int       @default(0)
  expiresAt      DateTime
  revokedAt      DateTime?
  createdById    String
  createdAt      DateTime  @default(now())

  @@index([organizationId])
}

// ORG10 (Organization Next OB3): join-request approval queue.
// Created from an OrgInviteLink (inviteLinkId set) by a signed-in
// user requesting to join; an OWNER/ADMIN approves (an ACTIVE
// membership is created at that moment, seat-guarded) or rejects.
// At most one PENDING request per (userId, organizationId) —
// enforced in the service (Prisma has no partial unique index),
// following the MemberInvitation pending-check pattern.
model OrgJoinRequest {
  id             String    @id @default(cuid())
  organizationId String
  userId         String
  inviteLinkId   String?
  message        String?
  status         String    @default("PENDING") // PENDING | APPROVED | REJECTED
  decidedById    String?
  decidedAt      DateTime?
  rejectReason   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([organizationId, status])
  @@index([userId, organizationId])
}

// Milestone 36 (Phase N1): one SSLCommerz checkout attempt for a
// subscription plan. A checkout becomes "success" ONLY through a
// signature-verified IPN whose val_id the gateway's validation
// API confirms for the exact amount — never via the browser
// return. The resulting SaasPayment row is written at activation.
// Billing Package B4: a tenant's consent to recurring
// charges (bKash tokenized agreement). The agreement id is
// stored SEALED (AES-256-GCM, platform-config seal) and is
// never returned by any API — only status is.
model AutoRenewAgreement {
  id               String    @id @default(uuid())
  organizationId   String    @unique
  gateway          String    @default("bkash")
  agreementIdSealed String?
  payerReference   String
  pendingPaymentId String?
  status           String    @default("pending") // pending | active | cancelled | failed
  lastChargeAt     DateTime?
  lastError        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model PlanCheckout {
  id             String    @id @default(cuid())
  organizationId String
  plan           String
  amountMinor    BigInt
  currency       String    @default("BDT")
  tranId         String    @unique
  status         String    @default("initiated") // initiated | success | failed | cancelled
  valId          String?
  gatewayDetail  Json?
  gateway        String    @default("sslcommerz") // sslcommerz | bkash
  creditAppliedMinor BigInt @default(0)
  discountMinor  BigInt    @default(0)
  // Billing Package B2: unused current-plan value credited
  // on an upgrade; part of the money order.
  prorationMinor BigInt    @default(0)
  // Billing Package B3: monthly | yearly.
  cycle          String    @default("monthly")
  couponCode     String?
  createdById    String
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([organizationId])
}

model Coupon {
  id             String    @id @default(cuid())
  code           String    @unique
  kind           String // percent | fixed
  value          Int // percent 1-90 | fixed amount in minor units
  planScope      String? // null = all plans
  expiresAt      DateTime?
  maxRedemptions Int?
  redeemedCount  Int       @default(0)
  active         Boolean   @default(true)
  createdById    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model CouponRedemption {
  id             String   @id @default(cuid())
  couponId       String
  organizationId String
  checkoutId     String?
  amountMinor    BigInt // discount actually given
  createdAt      DateTime @default(now())

  @@index([couponId])
  @@index([organizationId])
}

model SupportTicket {
  id             String    @id @default(cuid())
  organizationId String
  createdById    String
  subject        String
  category       String    @default("general") // general | billing | technical | campaigns | integration
  status         String    @default("open") // open | pending | resolved | closed
  priority       String    @default("normal") // normal | high | urgent
  firstRespondedAt DateTime?
  assignedToId   String?
  diagnostics    Json?     // { url, userAgent, plan, errorSnippet }
  tags           String[]  @default([])
  slaDueAt       DateTime?
  firstRepliedAt DateTime?
  resolvedAt     DateTime?
  csatRating     Int?      // 1 to 5
  csatFeedback   String?
  lastMessageAt  DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  messages       SupportTicketMessage[]

  @@index([organizationId, status])
  @@index([status, lastMessageAt])
}

model SupportTicketMessage {
  id          String        @id @default(cuid())
  ticketId    String
  authorId    String
  authorKind  String        // tenant | admin | system | ai
  isInternal  Boolean       @default(false)
  body        String
  attachments Json?         // [{ name, url, size, mimeType }]
  createdAt   DateTime      @default(now())

  ticket      SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

model SupportCannedResponse {
  id        String   @id @default(cuid())
  shortcut  String   @unique // e.g. "/billing", "/meta-api"
  title     String
  body      String
  category  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// GB9 (GC23): outgoing merchant webhooks. A subscription points
/// at an https URL and names a subset of the platform's real
/// event vocabulary (mapped in the webhooks service). The
/// signing secret is stored SEALED (platform-config seal()) and
/// is shown to the merchant exactly once at creation/rotation.
model WebhookSubscription {
  id             String   @id @default(uuid())
  organizationId String
  url            String
  events         Json // string[] of public event names
  secretSealed   String
  active         Boolean  @default(true)
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveries   WebhookDelivery[]

  @@index([organizationId, active])
}

/// GB9 (GC23): one delivery attempt chain for one event to one
/// subscription. status: pending | delivered | failed. Retries
/// follow 1m → 5m → 30m → 2h then failed (5 attempts max),
/// driven by the webhook_delivery_sweep job. The payload is
/// PII-minimal by construction (ids + summary fields only).
model WebhookDelivery {
  id             String    @id @default(uuid())
  subscriptionId String
  organizationId String
  event          String
  payload        Json
  status         String    @default("pending") // pending | delivered | failed
  attempts       Int       @default(0)
  responseCode   Int?
  error          String?
  nextRetryAt    DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  subscription WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([status, nextRetryAt])
  @@index([subscriptionId, createdAt])
  @@index([organizationId, createdAt])
}

/// GB9 (GC22): per-org daily counter for the public API
/// surface (public/shop + public/landing + tracking). The day
/// is the Asia/Dhaka calendar day (yyyy-mm-dd). Incremented
/// failure-isolated by the public-API interceptor; the plan's
/// apiDailyLimit (when set) is enforced against it.
model ApiUsageDaily {
  id             String @id @default(uuid())
  organizationId String
  day            String
  count          Int    @default(0)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, day])
  @@index([organizationId, day])
}

/// AB8 (AX21): merchant developer API keys — org-scoped
/// programmatic access to the versioned /v1/merchant surface
/// (products/orders/customers). Generalizes the AssistantApiKey
/// plumbing: only the SHA-256 hash of the token is stored; the
/// plaintext (`qk_live_…`) is returned exactly once at creation.
/// scopes is a validated subset of products:read |
/// products:write | orders:read | customers:read. Org scoping is
/// derived from the KEY, never from a client-supplied org id.
model MerchantApiKey {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  keyPrefix      String // first 8 chars of the token, for display
  keyHash        String    @unique
  scopes         Json
  status         String    @default("active") // active | revoked
  lastUsedAt     DateTime?
  createdById    String
  createdAt      DateTime  @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

/// AB8 (AX25): a self-serve org data export. The bundle file
/// lives in the platform media/file store under `fileRef`; the
/// row is the authorization + lifecycle record (a download is
/// served only to staff of the owning org, and only while
/// status = ready and not past expiresAt). kind: manual |
/// backup (scheduled weekly backups share the pipeline).
model DataExport {
  id             String    @id @default(uuid())
  organizationId String
  requestedById  String?
  kind           String    @default("manual") // manual | backup
  status         String    @default("pending") // pending | ready | failed | expired
  fileRef        String?
  sizeBytes      Int?
  error          String?
  expiresAt      DateTime?
  // OU12: the last backup VERIFICATION (restore-readiness
  // check) run against this export's stored file — when it ran
  // + the full result JSON ({ ok, problems, counts,
  // truncatedTables, nonRestorableSections }). Verification is
  // READ-ONLY: the export bundle does not round-trip (no
  // restore exists — credentials are never exported, media is
  // metadata-only, ids are the source org's), so this records
  // that the file is intact/readable, never that a restore
  // happened. See docs/one-umbrella-ou12-section.md.
  backupVerifiedAt   DateTime?
  backupVerification Json?
  createdAt      DateTime  @default(now())
  completedAt    DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([organizationId, kind, status, createdAt])
}

/// AB8 (AX25): scheduled weekly backup preference — one row per
/// org. lastBackupAt stamps the last SUCCESSFUL backup export
/// (the sweep runs when enabled and the stamp is ≥ 7 days old
/// or absent). Retention (newest 4 ready backups) is enforced
/// by the sweep, not by this row.
// ORG16 (Organization Next OB5) — org bundle import/restore job.
// Mirrors DataExport's shape (string status vocabulary, error
// recorded on the row, org cascade). One row per import attempt
// into THIS org: created before the restore transaction runs,
// completed/failed after it settles — the transaction itself is
// all-or-nothing, so a `failed` row always means the target org
// was left untouched. `report` is the validation/restore report
// (per-table rows, skipped tables with reasons, stripped and
// nulled field counts) exactly as the owner saw it.
model DataImport {
  id             String    @id @default(uuid())
  organizationId String
  requestedById  String?
  status         String    @default("running") // running | completed | failed
  fileName       String?
  sourceOrgName  String?
  report         Json?
  error          String?
  createdAt      DateTime  @default(now())
  completedAt    DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

model OrgBackupPreference {
  id             String    @id @default(uuid())
  organizationId String    @unique
  enabled        Boolean   @default(false)
  lastBackupAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

/// AB8 (AX26): Google SSO login state. kind "state" rows guard
/// the OAuth round-trip (10 min, single-use); kind "handoff"
/// rows carry the VERIFIED identity from the API callback to
/// the web login completion call (5 min, single-use, bound to
/// the resolved user). tokenHash is always a SHA-256 hash —
/// raw tokens travel only in redirect URLs / request bodies.
model SsoLoginState {
  id        String    @id @default(uuid())
  kind      String // state | handoff
  tokenHash String    @unique
  userId    String?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, kind])
  @@index([expiresAt])
}

/// Admin Polish AP2: server-side registry for view-as
/// sessions. startViewAs creates a row; TenantGuard
/// requires it to exist, be unrevoked and unexpired —
/// so a session can be killed before its token's 30
/// minutes are up.
model ViewAsSession {
  id             String    @id @default(cuid())
  adminId        String
  adminEmail     String
  targetUserId   String
  organizationId String
  mode           String // read | write
  reason         String
  expiresAt      DateTime
  revokedAt      DateTime?
  revokedById    String?
  createdAt      DateTime  @default(now())

  @@index([adminId, revokedAt])
  @@index([organizationId])
}

model AdminApiKey {
  id          String    @id @default(cuid())
  name        String
  keyPrefix   String // first chars, shown in the console
  keyHash     String    @unique // SHA-256 of the full key; the key itself is never stored
  // AP3: scope grants (area:read|write|* or "*").
  // Empty = legacy key with full access (pre-AP3).
  scopes      String[]  @default([])
  createdById String
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([createdById])
}

// Milestone 41 (Admin A5): growth ops — referrals, feedback, campaigns, changelog.

model Referral {
  id             String    @id @default(cuid())
  // Referral Advanced R4: null for campaign referrals
  // (a campaign has no human referrer).
  referrerUserId String?
  referredUserId String    @unique
  code           String
  status         String    @default("pending") // pending | rewarded | clawed_back
  rewardMinor    BigInt?
  rewardedOrgId  String?
  createdAt      DateTime  @default(now())
  rewardedAt     DateTime?
  // Referral Advanced R1: what actually qualified the reward.
  refereeBonusMinor BigInt?
  firstPaymentMinor BigInt?
  // Referral Advanced R4: user | campaign source.
  sourceKind     String    @default("user")
  // Campaign terms locked at signup (mode/reward/percent/
  // bonus/minimum), so later edits never rewrite a deal.
  termsSnapshot  Json?

  @@index([referrerUserId])
}

// Referral Advanced R4: operator-created campaign /
// influencer codes. A signup with a campaign code records
// a campaign referral; on the first payment the JOINING
// org receives the campaign's credit (reward + welcome
// fields both go to the new org — there is no referrer).
model ReferralCampaign {
  id                    String    @id @default(uuid())
  code                  String    @unique
  label                 String
  mode                  String?
  rewardMinor           BigInt?
  percentOfFirstPayment Int?
  refereeBonusMinor     BigInt?
  minFirstPaymentMinor  BigInt?
  maxUses               Int?
  usedCount             Int       @default(0)
  expiresAt             DateTime?
  active                Boolean   @default(true)
  createdById           String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

// Referral Advanced R4: one row per (referrer, threshold)
// — the unique constraint is the exactly-once guarantee.
model ReferralMilestoneAward {
  id             String   @id @default(uuid())
  referrerUserId String
  threshold      Int
  bonusMinor     BigInt
  orgId          String
  createdAt      DateTime @default(now())

  @@unique([referrerUserId, threshold])
}

// Referral Advanced R1/R2: every billing-credit movement for
// an organization, so a balance is always explainable.
// Organization.creditMinor stays the checkout's source of
// truth; this ledger is the history + expiry layer.
model CreditLedger {
  id             String    @id @default(uuid())
  organizationId String
  deltaMinor     BigInt
  reason         String    // referral_reward | referral_welcome | milestone_bonus | checkout_credit_spend | referral_clawback | credit_expired | admin_adjustment
  referralId     String?
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())

  @@index([organizationId, createdAt])
}

model Feedback {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  score          Int
  comment        String?
  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@index([createdAt])
}

model PlatformCampaign {
  id          String   @id @default(cuid())
  subject     String
  body        String
  audience    String
  recipients  Int
  sent        Int
  failed      Int
  createdById String
  createdAt   DateTime @default(now())
}

model ChangelogEntry {
  id          String    @id @default(cuid())
  version     String?
  title       String
  body        String
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Unified Inbox U2: agent teams, memberships with capacity, agent state.

model InboxTeam {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  // Channels this team handles; empty = all channels.
  channels       String[] @default([])
  // Milestone 71 (Team T3): the team's lead — may manage this
  // team's roster and sees this team's scoped analytics.
  leadUserId     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
}

model InboxTeamMember {
  id        String   @id @default(uuid())
  teamId    String
  userId    String
  // Max simultaneously-open assigned conversations for this member.
  capacity  Int      @default(20)
  createdAt DateTime @default(now())

  @@unique([teamId, userId])
  @@index([teamId])
}

model AgentState {
  id             String    @id @default(uuid())
  organizationId String
  userId         String
  status         String    @default("online") // online | busy | away
  lastAssignedAt DateTime?
  // Milestone 69 (Team W1): last org-level heartbeat from the
  // tenant web app — the "is this person at work" signal.
  lastActiveAt   DateTime?
  // Milestone 73 (Team T4): the agent's chat signature,
  // appended to their own human replies when enabled.
  signature         String?
  signatureEnabled  Boolean @default(false)
  updatedAt      DateTime  @updatedAt

  @@unique([organizationId, userId])
  @@index([organizationId])
}

// Milestone 68 (Team T2): an agent's weekly working-hours
// schedule. windows is a JSON object keyed by weekday
// ("mon".."sun") with a list of ["HH:MM","HH:MM"] windows in
// the schedule's timezone; a window whose end <= start spans
// midnight. No row = no schedule = always available.
model AgentSchedule {
  id             String   @id @default(uuid())
  organizationId String
  userId         String
  timezone       String   @default("Asia/Dhaka")
  windows        Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, userId])
  @@index([organizationId])
}

// ---------- Social Media Post Scheduler SP1: foundation ----------
// Organic (non-ad) social posting. SocialAccount is deliberately
// SEPARATE from the inbox Meta connection: posting needs different
// Meta permissions (pages_manage_posts / instagram_content_publish)
// than messaging, so it gets its own Integration (provider
// "meta_social") whose sealed credential is the PAGE access token
// (see social.service.ts). platform/status are plain Strings,
// matching the AdAccount convention in this schema.

model SocialAccount {
  id             String       @id @default(uuid())
  organizationId String
  integrationId  String?
  platform       String // meta_page | instagram | tiktok | youtube
  externalId     String // Meta Page id, or Instagram business account id
  name           String
  username       String?
  pictureUrl     String?
  status         String       @default("connected") // connected | disconnected
  lastError      String?
  // CC4: which app this account was connected through —
  // "platform" (operator's app; default, incl. every pre-CC4 row)
  // or "own" (the tenant's TenantAppConfig app). Token refresh for
  // TikTok resolves credentials from the matching source.
  appSource      String       @default("platform")
  // SU10 (added in the SU9 migration, Batch 5's shared one): when
  // the account health check last ran; null = never checked.
  healthCheckedAt DateTime?
  // CC15: Meta's own asset-completeness report for this Page
  // (linked Instagram / Pixel / Catalog, exactly as Graph
  // answers) — same verbatim-snapshot discipline as
  // Integration.providerHealth; absent answer = field absent.
  providerHealth    Json?
  providerHealthAt  DateTime?
  providerHealthError String?
  // CC17: tenant-chosen display label (AD6 semantics) + free-text
  // group name — see Integration.label/groupName.
  label             String?
  groupName         String?
  createdById    String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  posts          SocialPost[]
  liveSessions   LiveSession[]
  postingSlots   SocialPostingSlot[]
  autoDraftConfigs SocialAutoDraftConfig[]
  followerSnapshots SocialAccountFollowerSnapshot[]

  @@unique([organizationId, platform, externalId])
  @@index([organizationId])
}

// SU7: one follower-count snapshot per account per day (org tz
// "YYYY-MM-DD"), taken ONLY from what Graph actually returns
// (Page fan_count / IG followers_count). A day the platform did
// not answer stays ABSENT — growth charts show a gap, never an
// invented number.
model SocialAccountFollowerSnapshot {
  id              String        @id @default(uuid())
  organizationId  String
  socialAccountId String
  day             String        @db.VarChar(10)
  followers       Int
  createdAt       DateTime      @default(now())
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  socialAccount   SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@unique([socialAccountId, day])
  @@index([organizationId])
}

// SU1: a post group binds per-platform variants of one piece of
// content; each variant stays its own SocialPost row.
model SocialPostGroup {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  createdById    String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  posts          SocialPost[]
  shareLinks     SocialPostShareLink[]

  @@index([organizationId])
}

// SU2: per-account posting slot (weekday + local "HH:MM" time in
// the organization's timezone) used by Add-to-Queue.
model SocialPostingSlot {
  id              String        @id @default(uuid())
  organizationId  String
  socialAccountId String
  weekday         Int
  time            String
  enabled         Boolean       @default(true)
  createdById     String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  socialAccount   SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@index([organizationId, socialAccountId])
}

model SocialPost {
  id              String        @id @default(uuid())
  organizationId  String
  socialAccountId String
  caption         String
  linkUrl         String?
  // [{ assetId, kind }] referencing MediaAsset rows of the same org.
  mediaRefs       Json          @default("[]")
  status          String        @default("draft") // draft | scheduled | publishing | published | failed | cancelled | sent_to_creator
  scheduledAt     DateTime?
  publishedAt     DateTime?
  platformPostId  String?
  platformUrl     String?
  // SP8/SP9: an honest platform-state note recorded WITH a
  // successful hand-off — e.g. TikTok inbox mode ("video Creator-
  // এর inbox-এ পাঠানো হয়েছে, app-এ গিয়ে post সম্পূর্ণ করুন") or
  // YouTube's unverified-app lock ("Private হিসেবে আপলোড হয়েছে").
  // Null for plain Meta publishes, where published means published.
  publishNote     String?
  error           String?
  // SP5: publish attempts used so far (reset when a failed post is
  // re-scheduled; the publish worker caps at MAX_PUBLISH_ATTEMPTS).
  attempts        Int           @default(0)
  // SP7: published-post insights, stored EXACTLY as the platform
  // returns them: { platform, reactions?, comments?, shares?,
  // likeCount?, commentsCount?, impressions?, reach?, saved?,
  // plays? } — a metric the platform does not return stays ABSENT
  // from the object (never 0, never estimated).
  insights         Json?
  insightsFetchedAt DateTime?
  // SP7: approval flow — only meaningful while the org setting
  // Organization.socialRequireApproval is on. null = the post has
  // no approval state (the setting is off, or the post predates
  // it). Values: pending | approved | rejected.
  approvalStatus   String?
  submittedById    String?
  reviewedById     String?
  reviewNote       String?
  // SU1: post group (per-platform variants) + first comment.
  postGroupId      String?
  firstCommentText String?
  firstCommentStatus String?
  firstCommentError String?
  firstCommentId   String?
  // SU2: recurring series + evergreen recycle config.
  seriesId         String?
  recurrenceFrequency String?
  recurrenceInterval Int?
  isEvergreen      Boolean       @default(false)
  evergreenMinGapDays Int?
  evergreenMaxCycles Int?
  evergreenCyclesUsed Int        @default(0)
  evergreenLastRecycledAt DateTime?
  // SU5: commerce auto-draft provenance (null for human posts).
  // autoDraftRef is the per-kind idempotency key (product id,
  // promotion id, "<productId>:bist:<day>", "milestone:<total>"
  // or "review:<reviewId>").
  autoDraftKind   String?
  autoDraftRef    String?
  // SN10: caption test pairing — two posts (same account + media,
  // different captions) share one captionTestId; the comparison in
  // Analytics reads the pair. Null = not part of a caption test.
  captionTestId   String?
  // SU8: YouTube-specific metadata (title override / tags /
  // category / Shorts marker), a cover/thumbnail asset, and the
  // FB Page photo-story flag. All optional; null/false = the
  // pre-SU8 behaviour exactly.
  youtubeTitle     String?
  youtubeTags      Json?
  youtubeCategoryId String?
  youtubeIsShort   Boolean       @default(false)
  // SN1: the channel playlist this video joins after a successful
  // upload (playlistItems.insert). Null = no playlist step, the
  // pre-SN1 behaviour exactly. A failed insert never unpublishes
  // the video — the verbatim reason joins the publish note (the
  // SU8 cover semantics).
  youtubePlaylistId String?
  coverAssetId     String?
  isStory          Boolean       @default(false)
  // SU6: unguessable tracked-link token (public redirect route);
  // null until the post is scheduled / published with a link.
  linkToken       String?       @unique
  linkClicks      SocialLinkClick[]
  // SU9: team member this draft is assigned to (a plain user id,
  // like createdById — membership is validated in the service at
  // assign time); null = unassigned.
  assignedUserId  String?
  notes           SocialPostNote[]
  videoProjects   VideoProject[]
  versions        SocialPostVersion[]
  shareLinks      SocialPostShareLink[]
  clientReviews   SocialPostClientReview[]
  createdById     String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  socialAccount   SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  socialPostGroup SocialPostGroup? @relation(fields: [postGroupId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([socialAccountId])
  @@index([organizationId, seriesId])
  @@index([organizationId, captionTestId])
}

// SN8: one row per syndication item the sweep has already turned
// into a draft (or definitively accounted for), so an RSS item or
// a YouTube upload is never drafted twice. The sweep only writes
// a row AFTER its draft exists — items skipped by the daily cap
// stay unseen and are retried on a later run.
model SocialSyndicationSeen {
  id             String       @id @default(uuid())
  organizationId String
  source         String // rss | youtube
  externalId     String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, source, externalId])
  @@index([organizationId, source])
}

// SU9: an internal team note on a post. Notes are collaboration
// only — they NEVER travel to any platform or publish path.
model SocialPostNote {
  id             String       @id @default(uuid())
  organizationId String
  socialPostId   String
  authorId       String
  body           String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  socialPost     SocialPost   @relation(fields: [socialPostId], references: [id], onDelete: Cascade)

  @@index([organizationId, socialPostId])
}

// SU9: one content version of a post. snapshot is exactly
// { caption, linkUrl, mediaRefs, firstCommentText } — the post
// row's values at the moment the version was recorded (create,
// a content-changing edit, or a restore). versionNo is unique
// per post and only ever grows.
model SocialPostVersion {
  id             String       @id @default(uuid())
  organizationId String
  socialPostId   String
  versionNo      Int
  snapshot       Json
  changedById    String
  kind           String // create | edit | restore
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  socialPost     SocialPost   @relation(fields: [socialPostId], references: [id], onDelete: Cascade)

  @@unique([socialPostId, versionNo])
  @@index([organizationId, socialPostId])
}

// SN2: a client-approval share link — an unguessable token (the
// SP1 public-media-token discipline: randomBytes base64url,
// shown once at creation) that lets an agency client preview ONE
// post (postId) or ONE variant group (groupId) without a login
// and record an approve / request-changes decision. Exactly one
// of postId / groupId is set. Expiry + revoke are honoured by the
// public review path; a revoked or expired link answers 404.
model SocialPostShareLink {
  id             String       @id @default(uuid())
  organizationId String
  postId         String?
  groupId        String?
  token          String       @unique
  expiresAt      DateTime
  revokedAt      DateTime?
  createdById    String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  post           SocialPost?  @relation(fields: [postId], references: [id], onDelete: Cascade)
  group          SocialPostGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  reviews        SocialPostClientReview[]

  @@index([organizationId])
  @@index([postId])
  @@index([groupId])
}

// SN2: one client decision recorded through a share link. The
// reviewer's name is what the client typed on the public page
// (no account exists for them); decision is "approved" or
// "changes_requested" (String, the SocialPost approvalStatus
// convention). Reviews are append-only history — the latest one
// is the client's current word on the post.
model SocialPostClientReview {
  id             String       @id @default(uuid())
  organizationId String
  postId         String
  shareLinkId    String
  reviewerName   String
  decision       String // approved | changes_requested
  comment        String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  post           SocialPost   @relation(fields: [postId], references: [id], onDelete: Cascade)
  shareLink      SocialPostShareLink @relation(fields: [shareLinkId], references: [id], onDelete: Cascade)

  @@index([organizationId, postId])
  @@index([shareLinkId])
}

// SU5: per-org commerce auto-draft settings — one row per org.
// Absence of a row means every trigger is OFF (all toggles
// default false); drafts are created only for enabled kinds,
// capped per Dhaka day, and never published automatically.
model SocialAutoDraftConfig {
  id             String       @id @default(uuid())
  organizationId String       @unique
  newProductEnabled Boolean   @default(false)
  saleEnabled    Boolean       @default(false)
  backInStockEnabled Boolean  @default(false)
  reviewMilestoneEnabled Boolean @default(false)
  // SN8: syndication sources feed the SAME engine (same cap,
  // same target account) — drafts only, dedupe via
  // SocialSyndicationSeen. Both default OFF.
  rssEnabled     Boolean      @default(false)
  rssFeedUrl     String?
  youtubeEnabled Boolean      @default(false)
  maxDraftsPerDay Int          @default(3)
  // Preferred target account; null = the org's first connected
  // meta_page account. SetNull if the account row is deleted.
  socialAccountId String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  socialAccount  SocialAccount? @relation(fields: [socialAccountId], references: [id], onDelete: SetNull)

  @@index([organizationId])
}

// SU6: one recorded human click on a post's tracked link (bot /
// link-preview fetches are never recorded — see SocialLinkService).
model SocialLinkClick {
  id             String     @id @default(uuid())
  organizationId String
  socialPostId   String
  clickedAt      DateTime   @default(now())
  userAgent      String?    @db.VarChar(300)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  socialPost     SocialPost @relation(fields: [socialPostId], references: [id], onDelete: Cascade)

  @@index([socialPostId, clickedAt])
  @@index([organizationId])
}

// SP8/SP9: OAuth handshake state for operator-app platforms
// (TikTok / YouTube), where the tenant authorizes on the
// platform's own site instead of pasting a token. The row id IS
// the unguessable `state` value (32 random bytes, base64url);
// the callback validates it strictly: org + user + platform
// binding, 10-minute expiry, single use (consumedAt). purpose
// "channel_pick" is SP9's second step: after Google returns MORE
// THAN ONE channel, payload holds the SEALED token bundle
// (encryptJson — tokens never sit in this table in plaintext)
// plus the channel list, while the tenant picks one.
model SocialOAuthState {
  id             String    @id
  organizationId String
  userId         String
  platform       String // tiktok | youtube
  purpose        String    @default("connect") // connect | channel_pick
  payload        Json?
  expiresAt      DateTime
  consumedAt     DateTime?
  createdAt      DateTime  @default(now())

  @@index([organizationId])
  @@index([expiresAt])
}

// SP1 audit finding: MediaStore (inbox/media-store.ts) is byte
// storage only — it has no asset registry. Inbox media is bound to
// ChannelMessage rows and CreativeAsset is bound to an ad account,
// so neither can represent a tenant's post media. This small
// registry is that missing layer: one row per uploaded asset, with
// an opt-in unguessable publicToken (Instagram publishing requires
// a public media URL; tenant media stays private until the tenant
// explicitly creates a public link).
model MediaAsset {
  id             String       @id @default(uuid())
  organizationId String
  kind           String // image | video
  name           String
  contentType    String
  sizeBytes      Int
  storageKey     String
  publicToken    String?      @unique
  // SP4: how this asset came to exist — upload | ai_generated | template.
  // PP3 adds: imported (a product image fetched from its external URL).
  origin         String       @default("upload")
  // SP4: the (product-enriched) prompt for ai_generated assets; null otherwise.
  prompt         String?
  // PP1: for a mechanically derived asset (e.g. the PNG rasterized
  // from an SVG poster), the id of the source MediaAsset. The
  // publish path caches by (organizationId, derivedFromId,
  // contentType) so each SVG is rasterized at most once per org.
  derivedFromId  String?
  // PP3: for an "imported" asset, the external URL the bytes were
  // fetched from (the product's imageUrl). Dedupe key per
  // organization: importing the same URL again returns the existing
  // asset instead of fetching it a second time. Null otherwise.
  sourceUrl      String?
  // SN5: for a stock-imported asset, the photographer's credit
  // line (e.g. "Photo by Jane Doe on Pexels") — shown on the
  // library tile and copied onto derived assets so the credit is
  // never silently dropped. Null for non-stock assets.
  attribution    String?
  // SU3: library organization — an optional folder (deleting the
  // folder leaves the asset folderless, never deletes it) + free
  // tags for filtering.
  folderId       String?
  folder         MediaFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  tags           Json         @default("[]")
  createdById    String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  videoProjects  VideoProject[]

  @@index([organizationId])
  @@index([organizationId, folderId])
}

// SU3: a named folder inside one organization's Media Library.
model MediaFolder {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  createdById    String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  mediaAssets    MediaAsset[]

  @@index([organizationId])
}

// SU4: one month's AI-generated content plan (draft schedule of
// post ideas). items is a JSON array of
// { day, pillar, productId, productName, caption, mediaIdea,
//   materializedPostId? } — materializing an item creates a real
// draft SocialPost through SocialService and stamps its id here.
model SocialContentPlan {
  id             String       @id @default(uuid())
  organizationId String
  month          String
  pillars        Json         @default("[]")
  items          Json         @default("[]")
  status         String       @default("generated")
  createdById    String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, month])
}

// SP3: tenant-saved hashtag sets for social captions. No generic
// tenant key-value store exists, so sets get this one small model;
// tags is a JSON array of strings (without the leading "#").
model SocialHashtagSet {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  tags           Json     @default("[]")
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
}

// SN5: the tenant's OWN stock-media (Pexels) API key — one per
// organization, stored EXACTLY like OrgLlmConfig (CC8): the key
// itself lives only inside the sealed JSON ({ apiKey }, AES-GCM
// via integrations/crypto). Saved ONLY after a real Pexels call
// verified it (status "verified"); the plaintext key is never
// returned by any API — status endpoints expose configured +
// last-4 only.
model OrgStockConfig {
  id              String       @id @default(uuid())
  organizationId  String       @unique
  provider        String       @default("pexels") // pexels
  encryptedData   String // sealed JSON: { apiKey }
  status          String       @default("configured") // verified | configured
  lastVerifiedAt  DateTime?
  lastError       String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// SN9: one AI performance-coach digest per organization per
// week (weekStart = the week's Monday "YYYY-MM-DD" in the org
// timezone). payload is the deterministic compute result PLUS
// the final summary text — every number in it came from the
// org's own SU7 analytics; the job is idempotent on
// (organizationId, weekStart), so a week can never produce two
// digests or two notification rounds.
model SocialCoachDigest {
  id              String       @id @default(uuid())
  organizationId  String
  weekStart       String       @db.VarChar(10)
  payload         Json
  narrationSource String // llm | deterministic
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, weekStart])
  @@index([organizationId])
}
// ==========================================
// Omnichannel Social Comment Management & AI
// ==========================================

model SocialComment {
  id                String   @id @default(uuid())
  organizationId    String
  platform          String   // "facebook" | "instagram" | "tiktok" | "youtube"
  externalPostId    String   // Page post id or video id
  externalCommentId String   // Platform unique comment id
  postTitle         String?
  postMediaUrl      String?
  authorName        String
  authorAvatarUrl   String?
  authorSocialId    String?
  commentText       String
  sentiment         String   @default("NEUTRAL") // POSITIVE | NEUTRAL | NEGATIVE | SPAM
  intent            String   @default("GENERAL") // PRICE_QUERY | DELIVERY_QUERY | COMPLAINT | GENERAL | PRODUCT_INFO
  status            String   @default("PENDING") // PENDING | AUTO_REPLIED | MANUALLY_REPLIED | HIDDEN | ESCALATED | DELETED (IN8: DELETED only after Graph confirms)
  replyText         String?
  repliedAt         DateTime?
  isPrivateDmSent   Boolean  @default(false)
  privateDmText     String?
  confidenceScore   Float    @default(0.95)
  metadata          Json?
  // CX3: when the (already-existing) replyDelaySeconds setting
  // defers this comment's AI reply, aiReplyDueAt is when the
  // comment sweep may fire it. aiReplyBatchOf is set on comments
  // whose reply was covered by a later same-author/same-post
  // comment's batched reply (value = that comment's
  // externalCommentId).
  aiReplyDueAt      DateTime?
  aiReplyBatchOf    String?
  // IN8b: comment-queue assignment — the team member responsible
  // for this comment (plain user id, SocialComment style: no
  // relation). Null = unassigned. SLA/snooze are NOT applied to
  // comments: they are conversation clocks with no comment-side
  // sweep, so no such fields exist here (see in8-acceptance).
  assignedUserId    String?
  // IN8c: the inbox conversation created/linked when a Graph
  // private reply to this comment was CONFIRMED sent. Null until
  // then — a failed private reply never sets it.
  dmConversationId  String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([organizationId, externalCommentId])
  @@index([organizationId, platform, status])
  @@index([organizationId, externalPostId])
}

model SocialReplySetting {
  id                 String   @id @default(uuid())
  organizationId     String   @unique
  aiAutoReplyEnabled Boolean  @default(true)
  sendPrivateDm      Boolean  @default(true)
  autoHideSpam       Boolean  @default(true)
  replyDelaySeconds  Int      @default(25)
  tonePreference     String   @default("FRIENDLY_SALES") // FRIENDLY_SALES | PROFESSIONAL | HELPFUL_SUPPORT
  bannedKeywords     String[] @default([])
  salesOrderUrl      String?
  freeDeliveryThresholdMinor BigInt?
  nightOwlEnabled    Boolean  @default(true)
  nightOwlMessage    String?
  urgentAlertTelegramEnabled Boolean @default(false)
  telegramChatId     String?
  telegramBotToken   String?
  // CC27 (Connect Center Next): the member who last saved these
  // settings — the comment autopilot's CONFIGURING actor. Null on
  // default-created rows (getSettings mints defaults with no
  // human actor) and on rows predating CC27: in both cases no
  // actor is recorded and the CC27 deny gate for AI comment
  // replies honestly does not apply.
  updatedById        String?
  cannedSnippets     Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([organizationId])
}

// ==========================================
// CX2: AI Instructions Desk — versioned publish
// history + the questions the autopilot could
// not answer. Plain organizationId, no relation
// (SocialComment/SocialReplySetting style).
// ==========================================

model AiInstructionVersion {
  id             String   @id @default(uuid())
  organizationId String
  version        Int
  instructions   String
  replyLanguage  String?
  note           String?
  publishedById  String
  createdAt      DateTime @default(now())

  @@unique([organizationId, version])
  @@index([organizationId, version])
}

model AiUnansweredQuestion {
  id                 String    @id @default(uuid())
  organizationId     String
  conversationId     String?
  channel            String
  questionText       String
  normalizedQuestion String
  reason             String // no_answer | knowledge_gap | low_confidence
  status             String    @default("open") // open | resolved | ignored
  count              Int       @default(1)
  lastSeenAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([organizationId, status, createdAt])
  @@index([organizationId, normalizedQuestion])
}

// ==========================================
// CX8: Packing Scanner — Vision label & item
// verification before dispatch to prevent packing mistakes.
// ==========================================

model PackingScanLog {
  id              String            @id @default(uuid())
  organizationId  String
  orderId         String
  scannedById     String
  status          String            @default("in_progress") // in_progress | verified | mismatch | overridden
  matchedItems    Int               @default(0)
  totalItems      Int               @default(0)
  notes           String?
  scannedAt       DateTime          @default(now())
  completedAt     DateTime?
  order           Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items           PackingScanItem[]

  @@index([organizationId, orderId])
  @@index([organizationId, scannedAt])
}

model PackingScanItem {
  id              String          @id @default(uuid())
  packingScanId   String
  orderItemId     String?
  sku             String?
  expectedQty     Int
  scannedQty      Int             @default(0)
  status          String          @default("pending") // pending | matched | mismatch
  packingScan     PackingScanLog  @relation(fields: [packingScanId], references: [id], onDelete: Cascade)

  @@index([packingScanId])
}

// ==========================================
// CX12a: Setup Guide & Practice Mode (Interactive Simulation)
// Allows merchants to test bot replies without touching real customers.
// ==========================================

model PracticeScenario {
  id              String            @id @default(uuid())
  title           String
  description     String
  channel         String            @default("whatsapp") // whatsapp | messenger | webchat
  sampleMessages  Json              // array of { role: "customer"|"agent"|"system", text: string }
  difficulty      String            @default("beginner") // beginner | intermediate | advanced
  createdAt       DateTime          @default(now())
  sessions        PracticeSession[]
}

model PracticeSession {
  id              String            @id @default(uuid())
  organizationId  String
  userId          String
  scenarioId      String?
  channel         String            @default("whatsapp")
  status          String            @default("active") // active | completed | abandoned
  score           Int?
  feedback        String?
  transcript      Json              // array of simulated messages & bot responses
  startedAt       DateTime          @default(now())
  completedAt     DateTime?
  scenario        PracticeScenario? @relation(fields: [scenarioId], references: [id], onDelete: SetNull)

  @@index([organizationId, userId])
  @@index([organizationId, status])
}

// EC6: one row per (store, platform customer id) a local Customer is
// known by. A Customer has ONE legacy externalId/source pair (used by
// order sync matching); identities are the multi-store truth — the
// same person can be customer 123 in the Woo store and gid …/456 in
// the Shopify store while remaining a single Customer row.
model CustomerStoreIdentity {
  id             String   @id @default(uuid())
  organizationId String
  customerId     String
  storeId        String
  externalId     String // the customer id in that store's platform
  emailSnapshot  String?
  phoneSnapshot  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  store          Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, externalId])
  @@index([organizationId, customerId])
  @@index([organizationId, storeId])
}

// EC7: a tenant's OWN store discount code — NOT the SaaS-plan
// `Coupon` model (that one is global to the platform's billing).
// Codes are unique per organization. Money is integer minor units.
model StoreDiscount {
  id             String    @id @default(uuid())
  organizationId String
  code           String
  kind           String // percent | fixed | free_shipping
  value          Int // percent 1-90 | fixed amount in minor units | 0 for free_shipping
  minOrderMinor  BigInt?
  scopeType      String    @default("all") // all | products | categories
  scopeIds       Json? // local product ids or category ids, per scopeType
  startsAt       DateTime?
  endsAt         DateTime?
  usageLimit     Int?
  usedCount      Int       @default(0)
  active         Boolean   @default(true)
  origin         String    @default("manual") // manual | woocommerce | shopify | abandoned_recovery (GB7)
  // GB7 (GC17): customer-condition vocabulary. firstOrderOnly is
  // valid only when the resolved customer has NO prior orders;
  // repeatCustomerOnly only when they have >= 1 (identity = the
  // resolved Customer record; the count is computed once per
  // checkout by the caller and passed into the evaluator —
  // see PromotionsService.evaluateCheckout).
  firstOrderOnly     Boolean @default(false)
  repeatCustomerOnly Boolean @default(false)
  // NF14 (FB5): app-only offer — a DISPLAY rule only. When true,
  // the public storefront surfaces this offer only inside the
  // shop's installed app (standalone display mode). The flag is
  // never read by discount evaluation: the code still redeems
  // normally everywhere if shared (see nf14 acceptance doc).
  appOnly            Boolean @default(false)
  // GB7 (GC17): per-customer cap, counted from PLACED orders
  // carrying this code's GB3 couponCode stamp for the same
  // customer (stamp-based counting — pre-stamp history is
  // uncountable per-customer; see the acceptance doc).
  perCustomerLimit   Int?
  // GB7 (GC17): refuse when the merchandise subtotal is ABOVE
  // this (mirrors minOrderMinor's semantics in reverse).
  maxOrderMinor      BigInt?
  // GB7 (GC17): a cart containing ANY of these product/category
  // ids refuses the coupon outright (v1: no line-level partial
  // application). Ids validated against the org catalog at save.
  excludedProductIds  Json?
  excludedCategoryIds Json?
  // GB7 (GC17): provenance link for system-issued coupons (the
  // abandoned checkout / native cart id for origin
  // "abandoned_recovery"; null for merchant-created coupons).
  sourceRef           String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  syncs          StoreDiscountSync[]

  @@unique([organizationId, code])
  @@index([organizationId, active])
}

// EC7: per-store push/pull state of a StoreDiscount (mirrors the
// StoreListing pattern: syncStatus + verbatim lastError).
model StoreDiscountSync {
  id             String   @id @default(uuid())
  organizationId String
  discountId     String
  storeId        String
  externalId     String? // coupon id (Woo) or discount node gid (Shopify)
  syncStatus     String   @default("pending") // pending | synced | failed
  lastError      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  discount       StoreDiscount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  store          Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([discountId, storeId])
  @@index([organizationId, storeId])
}

// EC10: an abandoned checkout observed on a CONNECTED store
// (today: Shopify checkouts webhooks / REST backfill). The S4
// tracker-derived carts stay computed-on-read; these rows are the
// platform-reported counterpart. `status` is the stored lifecycle;
// "recovered" is computed on read against real orders (see the
// commerce abandoned service) rather than guessed here.
model AbandonedStoreCheckout {
  id                 String   @id @default(uuid())
  organizationId     String
  storeId            String
  externalCheckoutId String
  email              String?
  phone              String?
  items              Json? // [{ name, quantity, priceMinor }]
  totalMinor         BigInt   @default(0)
  currency           String   @default("BDT")
  checkoutUrl        String?
  status             String   @default("open") // open | recovered | expired
  abandonedAt        DateTime
  recoveredOrderId   String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  store              Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, externalCheckoutId])
  @@index([organizationId, abandonedAt])
  @@index([organizationId, status])
}

// EC8 (Native Storefront v2): per-org storefront configuration.
// Absence of a row (or shopEnabled = false) means the public shop
// does not exist for the org — the public API answers 404.
model StorefrontSetting {
  id                 String       @id @default(uuid())
  organizationId     String       @unique
  shopEnabled        Boolean      @default(false)
  shopName           String?
  announcementText   String?
  // EC19: how the featured section is filled — the merchant's own
  // picks (featuredProductIds) or the real top sellers of the last
  // 30 days computed from order items.
  featuredMode       String       @default("merchant_picks") // merchant_picks | top_sellers
  // EC19: storefront surface language (shop pages only; the
  // dashboard stays Bengali). bn | en.
  locale             String       @default("bn")
  // EC18: branded public order-tracking page (/track/<slug>) on/off.
  trackingPageEnabled Boolean     @default(true)
  // EC18: merchant-written trust copy shown at checkout / shop
  // footer / tracking page. Null/empty = the block is hidden,
  // never placeholder text.
  returnPolicyText   String?
  deliveryPromiseText String?
  supportPhone       String?
  // GB1 (GC1/GC4): storefront theme + favicon + direct contact
  // channels shown on the shop. themeId is one of
  // classic | bold | minimal (validated in the service/DTO).
  themeId            String       @default("classic")
  // GB3 (GC8): when requireTermsConsent is on, checkout refuses
  // without a recorded terms consent (Order.termsConsentedAt /
  // termsRef); termsUrl links the merchant's terms page.
  requireTermsConsent Boolean     @default(false)
  termsUrl           String?
  faviconUrl         String?
  whatsappNumber     String?
  messengerUrl       String?
  // EC16: tenant referral-as-discount config. Percent null =
  // the referral discount is OFF (a presented code is recorded
  // on the order but grants nothing). Min subtotal (minor units)
  // is judged on the post-promotion merchandise subtotal.
  referralDiscountPercent Int?
  referralMinSubtotalMinor BigInt?
  // GB7 (GC18): the MERCHANT's own tracking ids — never platform
  // ids. Format-validated at save (G-… / GTM-… / AW-… / label /
  // verification token); null = unset = the shop renders NOTHING
  // for that tag.
  ga4MeasurementId          String?
  gtmContainerId            String?
  googleAdsId               String?
  googleAdsConversionLabel  String?
  searchConsoleVerification String?
  metaPixelId               String?
  tikTokPixelId             String?
  clarityId                 String?
  // EC32: affiliate program config. Enabled=false = presented
  // codes are ignored entirely (no stamp, no commission).
  // affiliateDefaultPercent pre-fills new partners (a partner's
  // own commissionPercent is what snapshots onto entries).
  // affiliateAttributionDays = how long a stored ?ref code stays
  // attributable in the shopper's browser (web-side window).
  affiliateEnabled         Boolean @default(false)
  affiliateDefaultPercent  Int?
  affiliateAttributionDays Int     @default(30)
  // EC29: gift wrap option on the shop + single checkouts. The
  // fee is merchant-set; null = no wrap price configured (wrap
  // cannot be charged even when the flag is on).
  giftWrapEnabled    Boolean @default(false)
  giftWrapFeeMinor   BigInt?
  showFeatured       Boolean      @default(true)
  showCategories     Boolean      @default(true)
  showSearch         Boolean      @default(true)
  // OU8: section customizer — additional show/hide toggles +
  // merchant-chosen home section order (Json array of section
  // keys: hero|categories|brands|bundles|flash|featured|recently;
  // "products" is the shop itself and is never hideable/reorderable
  // away — it always renders last among ordered sections).
  showHero           Boolean      @default(true)
  showBrands         Boolean      @default(true)
  showBundles        Boolean      @default(true)
  showFlashSale      Boolean      @default(true)
  showRecentlyViewed Boolean      @default(true)
  sectionOrder       Json?
  metaDescription    String?
  featuredProductIds Json? // ordered product ids, org-scoped (validated on write)
  // Custom-domain ownership proof: the merchant publishes this token
  // as a TXT record at _qosprey-verify.<domain>; domainVerifiedAt is
  // set only after a real DNS lookup returns the exact token.
  domainVerifyToken  String?
  domainVerifiedAt   DateTime?
  // OU2: Cloudflare for SaaS (per-merchant HTTPS) provisioning
  // state for the verified custom domain. Written ONLY by the
  // storefront CfS hook / refresh (real adapter outcomes) — never
  // by the merchant directly. httpsStatus is one of
  // not_configured | pending | active | failed (null = HTTPS
  // provisioning never attempted for the current domain);
  // customHostnameId is the provider's custom-hostname record id;
  // httpsStatusDetail carries the provider's own words / our
  // honest not-configured explanation; httpsUpdatedAt stamps the
  // last write. A domain change or a fresh verify token resets
  // all four — the old domain's certificate state must never
  // carry over.
  customHostnameId   String?
  httpsStatus        String?
  httpsStatusDetail  String?
  httpsUpdatedAt     DateTime?
  // AB8 (AX23): merchant's own custom CSS/JS for the SHOP only.
  // Rendered by the shop layout (CSS in a <style data-custom> tag;
  // JS only when customJsEnabled AND the request host passes the
  // host rule derived from the cookie audit — see the AB8
  // acceptance). Values are validated at save (length caps +
  // closing-tag breakouts rejected); changes are audited with
  // LENGTHS ONLY — code values never enter audit bodies.
  customCss          String?
  customJs           String?
  customJsEnabled    Boolean      @default(false)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

/// GB7 (GC17): per-org abandoned-cart recovery coupon template.
/// When enabled, a staff recovery send issues a REAL StoreDiscount
/// row (origin "abandoned_recovery", sourceRef = the checkout /
/// native cart id, perCustomerLimit 1, endsAt = now + expiryHours)
/// and the generated code is composed into the recovery message.
/// Default OFF — with it off, recovery sends are byte-identical
/// to the pre-GB7 behaviour. kind mirrors StoreDiscount kinds
/// (percent | fixed; free_shipping is not offered in v1).
model AbandonedCouponSetting {
  id             String       @id @default(uuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  enabled        Boolean      @default(false)
  kind           String       @default("percent")
  value          Int          @default(0)
  expiryHours    Int          @default(72)
  minOrderMinor  BigInt?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

// AB1 (AX1): per-org loyalty-points program configuration.
// Ships DISABLED — when off, no earn, no redemption, no sweep
// effect (every pre-AB1 behaviour is byte-identical). Points are
// integers; their taka value exists ONLY at redemption time via
// redeemValueMinorPerPoint (paisa per point).
model LoyaltySetting {
  id             String       @id @default(uuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  enabled        Boolean      @default(false)
  // Points earned per 1000 minor (৳10) of an order's earn basis
  // (totalMinor − shippingMinor − giftWrapMinor, floored per
  // 1000-minor step BEFORE the multiply).
  earnPointsPer1000Minor Int    @default(1)
  // Paisa one point is worth when redeemed at checkout.
  redeemValueMinorPerPoint Int  @default(100)
  // Minimum points a single redemption must reach (0 = no min).
  minRedeemPoints        Int    @default(0)
  // Optional cap: redemption may cover at most this % of the
  // merchandise payable after all other discount lines.
  maxRedeemSharePct      Int?
  // Optional expiry for earn / referral_reward lots (days from
  // the lot's creation). Null = points never expire.
  pointsExpiryDays       Int?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

// AB1 (AX2): what the REFERRER earns when a referred order
// becomes sold (today the referrer earns nothing — the buyer
// discount is EC16's, configured on StorefrontSetting). Ships
// DISABLED. rewardType "points" posts into the loyalty ledger
// (and therefore requires LoyaltySetting.enabled); "coupon"
// issues a real single-use-per-customer StoreDiscount.
model ReferralRewardSetting {
  id             String       @id @default(uuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  enabled        Boolean      @default(false)
  rewardType     String       @default("points") // points | coupon
  rewardPoints   Int?
  couponPercent  Int? // 1..90 when rewardType = coupon
  // The referred order's earn basis must reach this (null = any).
  rewardMinOrderMinor BigInt?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

// AB1 (AX1): THE loyalty truth. One row per points movement,
// written ONLY by LoyaltyService (inside a DB transaction that
// also maintains Customer.loyaltyBalanceCache). Positive lots
// (earn / referral_reward / positive adjust) carry
// remainingPoints for FIFO consumption + expiry; expiresAt is
// set on earn / referral_reward lots when the org configures
// pointsExpiryDays. Exactly-once for earn / referral_reward is
// a partial unique index on (orderId) per reason, created by
// raw SQL in the AB1 migration (Prisma cannot express partial
// indexes) — the service checks first, the index is the
// backstop.
model LoyaltyLedger {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId     String
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  deltaPoints    Int // signed
  reason         String // earn | redeem | expire | adjust | referral_reward
  orderId        String? // plain scalar (orders outlive merges; no FK by design)
  balanceAfter   Int
  expiresAt      DateTime?
  remainingPoints Int?
  createdById    String? // staff actor for reason = adjust
  note           String?
  createdAt      DateTime     @default(now())

  @@index([organizationId, customerId, createdAt])
  @@index([organizationId, orderId])
}

// AB2 (AX3): per-org gift-card program configuration. Selling is
// switched by the Product.isGiftCard flag; this row carries the
// redemption kill-switch (default ON — redemption works out of
// the box) and the default card expiry.
model GiftCardSetting {
  id             String       @id @default(uuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Kill-switch for REDEMPTION only (existing cards keep their
  // balances; selling is controlled per product).
  redemptionEnabled Boolean   @default(true)
  // Days from issuance after which an unspent balance expires
  // (the gift_card_expiry_sweep releases it as breakage). Null =
  // issued cards never expire.
  defaultExpiryDays Int?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

// AB2 (AX3): a PURCHASE INTENT for gift-card value, recorded at
// placement — one row per gift-card ORDER LINE (orderItemId is
// the exactly-once claim). amountMinor is the line's unit price
// (= the face value of EACH card); quantity N mints N cards.
// The reconciler issues the cards only when the order reaches
// the sold set — an unpaid/abandoned order never mints value.
model GiftCardIssuance {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orderId        String // plain scalar, like LoyaltyLedger.orderId
  orderItemId    String       @unique
  amountMinor    BigInt
  quantity       Int          @default(1)
  recipientName  String?
  recipientEmail String?
  recipientPhone String?
  recipientMessage String?
  // Set when every unit of this intent has been issued.
  issuedAt       DateTime?
  // Honest delivery evidence for the recipient send:
  // "email" | "sms" | "none" (buyer reveal is a separate surface).
  sentVia        String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, orderId])
}

// AB2 (AX3): a stored-value gift card — a BEARER instrument.
// The full code is NEVER stored in plaintext and never logged:
// codeHash (SHA-256 of the canonical code) is the lookup key;
// codeSealed (AES-256-GCM via integrations/crypto encryptJson)
// is the only recoverable copy, unsealed solely on the entitled
// buyer's delivery surface. Staff surfaces see prefix + last4
// only. balanceCache is maintained ONLY by GiftCardService
// inside the same transaction as the GiftCardLedger write.
// status: active | depleted | expired | void.
model GiftCard {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  codeHash       String
  codeSealed     String
  codePrefix     String       @default("QG")
  codeLast4      String
  initialAmountMinor BigInt
  balanceCache   BigInt
  currency       String       @default("BDT")
  status         String       @default("active")
  // Who bought it (when the purchase order resolved a customer)
  // and who it was addressed to (free-text recipient fields from
  // the purchase intent; a recipient is NOT an account holder).
  buyerCustomerId String?
  recipientName  String?
  recipientEmail String?
  recipientPhone String?
  recipientMessage String?
  // Provenance: the purchase order + line this card was minted
  // from (null on staff manual issues). (issuedOrderItemId,
  // unitIndex) is UNIQUE — the exactly-once issuance claim:
  // quantity N on one line mints unitIndex 0..N-1, never twice.
  issuedOrderId  String?
  issuedOrderItemId String?
  unitIndex      Int          @default(0)
  source         String       @default("purchase") // purchase | manual
  expiresAt      DateTime?
  createdById    String? // staff actor for manual issues / corrections
  note           String? // mandatory on manual issue / void / adjust
  ledger         GiftCardLedger[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([issuedOrderItemId, unitIndex])
  @@index([organizationId, codeHash])
  @@index([organizationId, status])
  @@index([organizationId, issuedOrderId])
  @@index([organizationId, codeLast4])
}

// AB2 (AX3): THE gift-card truth. One row per balance movement,
// written ONLY by GiftCardService.postEntry (inside a DB
// transaction that also maintains GiftCard.balanceCache and the
// card's status). kind: issue | redeem | restore | adjust |
// void | expire. deltaMinor is the SIGNED balance movement.
// Exactly-once for issue (per card) and redeem (per card+order)
// is a partial unique index created by raw SQL in the AB2
// migration — the service checks first, the index backstops.
model GiftCardLedger {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  giftCardId     String
  giftCard       GiftCard     @relation(fields: [giftCardId], references: [id], onDelete: Cascade)
  kind           String
  deltaMinor     BigInt // signed
  balanceAfter   BigInt
  orderId        String? // redeem / restore: the spending order; issue: the purchase order
  createdById    String? // staff actor for manual issue / void / adjust
  note           String?
  createdAt      DateTime     @default(now())

  @@index([organizationId, giftCardId, createdAt])
  @@index([organizationId, orderId])
  @@index([organizationId, kind, createdAt])
}

// GB1 (GC2): a merchant content page for the shop (about /
// contact / policy pages + custom pages). blocks is a validated
// Json block list (fixed block types only — see
// storefront/shop-pages.ts; NO raw HTML anywhere). System pages
// are seeded lazily per org (isSystem) and cannot be deleted.
model ShopPage {
  id             String       @id @default(uuid())
  organizationId String
  slug           String
  title          String
  blocks         Json
  published      Boolean      @default(false)
  showInFooter   Boolean      @default(false)
  showInMenu     Boolean      @default(false)
  sortOrder      Int          @default(0)
  isSystem       Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, slug])
  @@index([organizationId, published])
}

// AB6 (AX12): a shop blog post. Content is the GC1 ShopPage
// block vocabulary (structured blocks ONLY — no raw HTML
// anywhere), validated by storefront/shop-pages.ts
// validateShopPageBlocks. status: draft | published; a draft is
// never publicly visible (public reads filter published only and
// a draft slug 404s). publishedAt stamps the latest transition
// into published.
model BlogPost {
  id             String       @id @default(uuid())
  organizationId String
  slug           String
  title          String
  excerpt        String?
  coverImageUrl  String?
  blocks         Json
  tags           Json         @default("[]")
  status         String       @default("draft") // draft | published
  publishedAt    DateTime?
  seoTitle       String?
  seoDescription String?
  authorName     String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, slug])
  @@index([organizationId, status])
}

// AB6 (AX11): a merchant-authored search synonym. `term` is the
// normalized (trimmed, lowercased) lookup term; `expansions` is a
// JSON string array of alternative phrases OR-expanded into the
// FTS query when the term matches the whole normalized query or
// one of its whitespace tokens (rule: storefront/search-fts.ts).
model SearchSynonym {
  id             String       @id @default(uuid())
  organizationId String
  term           String
  expansions     Json         @default("[]")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, term])
  @@index([organizationId])
}

// AB6 (AX11): one row per public shop search (the shopHome q
// path). Written failure-isolated — a logging failure never
// breaks a search. resultsCount is the TRUE outcome (after the
// substring fallback when FTS found nothing); viaFallback marks
// rows the legacy substring scan answered (internal analytics
// honesty, never exposed on the public payload).
model SearchQueryLog {
  id             String       @id @default(uuid())
  organizationId String
  term           String
  resultsCount   Int
  viaFallback    Boolean      @default(false)
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

// GB1 (GC3): the shop's single promotional popup config (one
// row per org, lazy-upserted). Impressions/clicks are real
// counters incremented only by the public popup-event route.
model StorePopup {
  id             String       @id @default(uuid())
  organizationId String       @unique
  enabled        Boolean      @default(false)
  title          String?
  body           String?
  imageUrl       String?
  ctaText        String?
  ctaUrl         String?
  trigger        String       @default("delay_seconds") // delay_seconds | scroll_percent | exit_intent
  delaySeconds   Int          @default(5)
  scrollPercent  Int          @default(50)
  frequencyDays  Int          @default(7)
  startsAt       DateTime?
  endsAt         DateTime?
  showOn         String       @default("home") // home | all
  impressions    Int          @default(0)
  clicks         Int          @default(0)
  // OU8: lead-capture mode. mode "promo" (default) = the original
  // GC3 behaviour byte-for-byte. mode "lead" renders a real form
  // (name + chosen contact fields) whose submissions create REAL
  // Lead rows (source "website") via the public popup-lead route;
  // captures counts only those real Lead creations.
  mode           String       @default("promo") // promo | lead
  captureName    Boolean      @default(true)
  capturePhone   Boolean      @default(true)
  captureEmail   Boolean      @default(false)
  successMessage String?
  captures       Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// GB1 (GC2): a contact-form message submitted from the shop.
// deliveredVia records the honest delivery evidence:
// agent_notification and/or email, or stored_only when neither
// channel delivered.
model ShopContactMessage {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  phone          String
  message        String
  deliveredVia   String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

// EC13: a single-product landing page bound to one canonical
// product. sections is a validated Json block list (fixed block
// types only — see the landings section validator). Pixel/CAPI
// comes from the org's BusinessProfile via the existing checkout
// injection; a landing never carries its own pixel settings.
model LandingPage {
  id              String   @id @default(uuid())
  organizationId  String
  productId       String
  slug            String   @unique
  title           String
  status          String   @default("draft") // draft | published | archived
  sections        Json?
  upsellProductId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId, status])
  @@index([organizationId, productId])
}

// EC13: an A/B variant of a landing. The control variant carries
// the baseline presentation; assignment is a stable hash of the
// visitor token over the weights (see the landings service).
model LandingVariant {
  id            String   @id @default(uuid())
  landingId     String
  name          String
  isControl     Boolean  @default(false)
  weight        Int      @default(100)
  headline      String?
  heroImageUrl  String?
  ctaText       String?
  showCompareAt Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([landingId])
}

// EC13: funnel beacons (no PII) — views and checkout starts per
// landing/variant; orders and revenue come from Order rows with
// landingPageId set.
model LandingEvent {
  id        String   @id @default(uuid())
  landingId String
  variantId String?
  kind      String // view | checkout_started
  createdAt DateTime @default(now())

  @@index([landingId, kind, createdAt])
}

// EC15: a review pulled from a connected store (WooCommerce
// today). productId is resolved through StoreListing by the
// store's external product id; rows whose product cannot be
// resolved are never created (the sync counts them as skipped).
model ExternalReview {
  id              String    @id @default(uuid())
  organizationId  String
  storeId         String
  productId       String
  externalId      String
  authorName      String?
  rating          Int
  text            String?
  imageUrls       Json?
  status          String    @default("visible") // visible | hidden
  createdAtRemote DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([storeId, externalId])
  @@index([organizationId, productId])
  @@index([organizationId, status])
}

// EC16: a cart-level promotion (separate from EC7 StoreDiscount
// coupons). config is a per-type validated Json document (see
// commerce/promotions.ts). Evaluation order = priority DESC.
// Promotions are evaluated live at checkout against the items'
// effective (sale-aware) prices; nothing is precomputed on the
// product rows.
model Promotion {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  type           String // bogo | tiered | flash
  config         Json
  startsAt       DateTime?
  endsAt         DateTime?
  active         Boolean   @default(true)
  priority       Int       @default(0)
  createdBy      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, active, priority])
}

// EC14: a product feed exposed at a secret token URL for
// scheduled fetch by Meta Commerce / Google Merchant Center
// (XML) or as a generic CSV. The token IS the credential
// (rotate = old URL dies). Generation is per-request from the
// org's real products; lastGeneratedAt records the last fetch.
model ProductFeed {
  id                    String    @id @default(uuid())
  organizationId        String
  channel               String // meta | google | tiktok
  format                String // xml | csv
  token                 String    @unique
  includeOutOfStock     Boolean   @default(false)
  defaultGoogleCategory String?
  active                Boolean   @default(true)
  lastGeneratedAt       DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, active])
}

// EC8: native shipping zones. Match priority is by KIND tier first
// (district_list > inside_dhaka/outside_dhaka > all), then position.
// chargeMinor / freeAboveMinor are integer minor units (poisha).
model ShippingZone {
  id              String       @id @default(uuid())
  organizationId  String
  name            String
  kind            String // inside_dhaka | outside_dhaka | district_list | all
  districts       Json? // string[] of BD_DISTRICTS names (district_list only)
  chargeMinor     BigInt
  deliveryDays    Int?
  freeAboveMinor  BigInt?
  active          Boolean      @default(true)
  position        Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, active, position])
}

// EC30: weight-slab delivery charge rules. A rule REPLACES the
// matched zone's flat charge when zone (null = every zone) and
// weight window both match. Weight windows are judged ONLY when
// the cart weight is fully known (every line's product carries
// weightGrams) — a weight is never invented to make a rule match.
model ShippingRateRule {
  id             String       @id @default(uuid())
  organizationId String
  shippingZoneId String? // null = applies to every zone
  minWeightGrams Int? // inclusive lower bound; null = no lower bound
  maxWeightGrams Int? // inclusive upper bound; null = no upper bound
  chargeMinor    BigInt
  priority       Int          @default(0)
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, active, priority])
}

// EC30: a merchant outlet / agent point a shopper can choose as
// the delivery destination instead of home delivery. The address
// is the merchant's PUBLIC outlet info (shown on the tracking
// page); feeMinor is the point's own pickup fee (usually 0).
model PickupPoint {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  address        String
  district       String
  phone          String?
  feeMinor       BigInt       @default(0)
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, active])
}

// EC8: guest server-side cart for the native storefront. The token
// is the guest credential (sent via the x-cart-token header); it is
// stored as issued, matching the brief. status: open | converted.
model StoreCart {
  id             String         @id @default(uuid())
  organizationId String
  token          String         @unique
  email          String?
  phone          String?
  status         String         @default("open")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items          StoreCartItem[]

  @@index([organizationId, status, updatedAt])
}

model StoreCartItem {
  id          String          @id @default(uuid())
  cartId      String
  productId   String
  variantId   String?
  quantity    Int
  // EC8 bump: when true AND the product carries bump data, the bump
  // amount is added once for this line at quote/checkout (mirrors
  // the single-product checkout's [Special Add-On] order line).
  includeBump Boolean         @default(false)
  // AB2 (AX3): gift-card purchase intent on the line — the chosen
  // face value (minor units; the line's unit price at quote) and
  // the optional recipient { name?, email?, phone?, message? }.
  // Both stay null on ordinary lines. At placement the shop
  // checkout hands them to GiftCardService, which records a
  // GiftCardIssuance per order line.
  giftCardAmountMinor BigInt?
  giftCardRecipient   Json?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  cart        StoreCart       @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product     Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  // NOTE: SQL unique treats NULL variantId rows as distinct, so the
  // application layer merges null-variant lines explicitly.
  @@unique([cartId, productId, variantId])
  @@index([cartId])
  @@index([productId])
}

// ---------- EC29: fixed-price bundles & cart bundle lines ----------

// EC29: a fixed-price bundle SET sold on the native shop — NOT
// the EC4 BundleItem composition (that one is stock-only
// decomposition of a single parent product). items is validated
// Json: [{ productId, variantSku?, qty }] (2–10 entries, org
// products, active). At checkout the set expands into component
// OrderItems whose allocated totals sum EXACTLY to
// bundlePriceMinor × bundleQty (see commerce/ec29-bundles.ts).
model Bundle {
  id               String   @id @default(uuid())
  organizationId   String
  name             String
  description      String?
  imageUrl         String?
  items            Json
  bundlePriceMinor BigInt
  active           Boolean  @default(true)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  // AB5 (AX8): mix-and-match slots (pick N from a category or a
  // product set). A bundle may carry fixed items, slots, or both.
  slots            BundleSlot[]

  @@index([organizationId, active, sortOrder])
}

// AB5 (AX8): one choice slot of a mix-and-match bundle. The
// merchant prices the BOX (Bundle.bundlePriceMinor) — picks never
// change the bundle price; each pick contributes ONE component
// unit to the EC29 allocation (weighted by its regular price,
// exactly like a fixed item). sourceType "category" resolves its
// pool from sourceRef { categoryId }; "products" from sourceRef
// { productIds: string[] }. Picks are validated at cart write and
// re-validated at quote/placement.
model BundleSlot {
  id             String   @id @default(uuid())
  organizationId String
  bundleId       String
  label          String
  chooseQty      Int      @default(1)
  sourceType     String // category | products
  sourceRef      Json
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  bundle         Bundle   @relation(fields: [bundleId], references: [id], onDelete: Cascade)

  @@index([organizationId, bundleId, sortOrder])
  @@index([bundleId])
}

// EC29: a bundle line on a guest shop cart — kept apart from
// StoreCartItem, whose productId is non-nullable and priced per
// product; a bundle line is priced per SET by the Bundle row.
model StoreCartBundle {
  id        String   @id @default(uuid())
  cartId    String
  bundleId  String
  quantity  Int
  // AB5 (AX8): the buyer's slot picks for THIS cart line:
  // [{ slotId, productId, variantSku? }] — validated server-side
  // at cart write AND re-validated at quote/placement (a pick
  // that went inactive refuses). Null = no picks (fixed-only
  // bundle, the pre-AB5 shape).
  picks     Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, bundleId])
  @@index([cartId])
}

// ---------- EC20: Purchasing & suppliers ----------
// A supplier the org buys stock from. Contact record only — no
// money ever moves through this model.
model Supplier {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  phone          String?
  email          String?
  address        String?
  note           String?
  active         Boolean  @default(true)
  // NF12 (FB4): supplier-maintained lead time, editable by the
  // supplier themselves through the NF12 portal (and by staff).
  leadTimeDays   Int?
  leadTimeNote   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseOrders PurchaseOrder[]
  portalLinks    SupplierPortalLink[]

  @@index([organizationId, active])
}

// NF12 (FB4): the supplier portal link — NF9 RiderShareLink /
// OrgInviteLink discipline verbatim: the raw token is
// randomBytes(32) base64url, returned ONCE at issue/rotation;
// at rest only its SHA-256 hex hash exists. One link per
// supplier (rotation overwrites the hash — the old token dies
// immediately). The token is bound to ONE supplier in ONE org:
// everything the portal can read or write is scoped by the
// link's (organizationId, supplierId) pair, never by any id a
// caller supplies.
model SupplierPortalLink {
  id             String    @id @default(uuid())
  organizationId String
  supplierId     String    @unique
  tokenHash      String    @unique
  expiresAt      DateTime
  revokedAt      DateTime?
  lastSeenAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier       Supplier     @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([organizationId, supplierId])
}

// EC20: one purchase order to one supplier. Status vocabulary:
// draft | ordered | partially_received | received | cancelled.
// Receiving writes stock through the S1 InventoryService ONLY
// (reason "purchase_receive") and appends a ProductCost history
// row (weighted-average) — this model never writes stock itself.
model PurchaseOrder {
  id             String    @id @default(uuid())
  organizationId String
  supplierId     String
  status         String    @default("draft")
  expectedDate   DateTime?
  note           String?
  // NF12 (FB4): supplier-portal stamps. The PO status vocabulary
  // has NO supplier-side transitions of its own (see
  // purchasing.service MANUAL_TRANSITIONS): portal "confirm"
  // rides the existing draft→ordered transition and stamps
  // supplierConfirmedAt; portal "mark shipped" stamps
  // supplierShippedAt (+ optional note) WITHOUT changing status
  // — "received" remains reachable only through the buyer's own
  // receive flow. Mapping documented in
  // docs/nf12-supplier-dropship-acceptance.md.
  supplierConfirmedAt DateTime?
  supplierShippedAt   DateTime?
  supplierShipNote    String?
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier       Supplier          @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  items          PurchaseOrderItem[]

  @@index([organizationId, status, createdAt])
  @@index([organizationId, supplierId])
}

model PurchaseOrderItem {
  id              String @id @default(uuid())
  purchaseOrderId String
  productId       String
  // Variant identity mirrors StockMovement: the ProductVariant id
  // as a plain column (resolved from the SKU at write time); `sku`
  // is the display snapshot so the row stays readable if the
  // variant is later renamed/deleted.
  variantId       String?
  sku             String?
  qtyOrdered      Int
  qtyReceived     Int    @default(0)
  unitCostMinor   BigInt
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product         Product       @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
  @@index([productId])
}

// ---------- NF12 (FB4): Dropship agreements, offers, listings,
// order links and the commission ledger ----------
// Cross-org data minimisation is the design centre: until an
// agreement is ACCEPTED nothing crosses the boundary at all (no
// product reads, no listing creation — enforced in the service
// and spec-proven). After acceptance the ONLY things that cross
// are (a) the source org's dropship-eligible offers (product
// name + floor price + real stock count) towards the seller, and
// (b) fulfilment-necessary order data (items, quantities,
// delivery name/phone/address) towards the supplier, priced at
// the WHOLESALE (floor) value — the seller's retail price and
// margin NEVER appear on the supplier-side order. The ledger
// below is the one place both totals meet, and it is a RECORD
// only: no payout is executed anywhere in NF12 (OU11 legal
// gate), no wallet balance is mutated.

model DropshipAgreement {
  id             String    @id @default(uuid())
  // orgA = the SUPPLIER / source org; orgB = the SELLER org.
  supplierOrgId  String
  sellerOrgId    String
  // Which side sent the invite (always one of the two orgs).
  invitedByOrgId String
  // pending | accepted | declined | revoked
  status         String    @default("pending")
  createdById    String?
  respondedById  String?
  respondedAt    DateTime?
  revokedByOrgId String?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  supplierOrg    Organization @relation("DropshipSupplierOrg", fields: [supplierOrgId], references: [id], onDelete: Cascade)
  sellerOrg      Organization @relation("DropshipSellerOrg", fields: [sellerOrgId], references: [id], onDelete: Cascade)
  offers         DropshipOffer[]
  listings       DropshipListing[]
  orderLinks     DropshipOrderLink[]
  ledgerEntries  DropshipLedgerEntry[]

  @@unique([supplierOrgId, sellerOrgId])
  @@index([sellerOrgId, status])
  @@index([supplierOrgId, status])
}

// NF12: per (agreement, source product) eligibility + floor.
// A product is dropship-eligible for a seller org ONLY through
// a row here on an ACCEPTED agreement; floorPriceMinor is the
// wholesale unit value the supplier order is priced at and the
// minimum the seller may charge retail.
model DropshipOffer {
  id             String   @id @default(uuid())
  agreementId    String
  // The SOURCE org (denormalised from the agreement for scoped
  // reads; always == agreement.supplierOrgId).
  organizationId String
  productId      String
  floorPriceMinor BigInt
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  agreement      DropshipAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product        Product           @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([agreementId, productId])
  @@index([organizationId, active])
}

// NF12: a listing in the SELLER org. sellerProductId is a REAL
// Product row in the seller org (created at listing time,
// source = "dropship", stockQuantity = null — partner stock is
// NEVER merged into the seller's own stock; it is read live
// from the source product and labelled "পার্টনার স্টক").
// priceMinor is the seller's retail unit price, enforced
// server-side >= the offer's floorPriceMinor.
model DropshipListing {
  id              String   @id @default(uuid())
  sellerOrgId     String
  agreementId     String
  offerId         String
  sourceProductId String
  sellerProductId String   @unique
  priceMinor      BigInt
  active          Boolean  @default(true)
  createdById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  agreement       DropshipAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  sellerOrg       Organization      @relation(fields: [sellerOrgId], references: [id], onDelete: Cascade)

  @@unique([agreementId, sourceProductId])
  @@index([sellerOrgId, active])
}

// NF12: the exactly-once link between a seller order and its
// supplier-org fulfilment order. Unique per (sellerOrderId,
// agreementId) — the exactly-once unit (one supplier order per
// seller order PER agreement; a replay finds this row and
// creates nothing). supplierStatus is a READ-MODEL mirror of
// the supplier order's status, refreshed on read + on sync;
// the seller order keeps its own independent lifecycle.
// itemsSnapshot = [{ listingId, sourceProductId, qty,
// retailUnitMinor, wholesaleUnitMinor }] — the sole record of
// both prices; the supplier ORDER itself carries wholesale
// only. retail/wholesale/margin totals on the ledger derive
// from these REAL line values.
model DropshipOrderLink {
  id              String    @id @default(uuid())
  sellerOrgId     String
  supplierOrgId   String
  agreementId     String
  sellerOrderId   String
  supplierOrderId String?
  supplierStatus  String?
  itemsSnapshot   Json?
  cancelNote      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  agreement       DropshipAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  sellerOrg       Organization      @relation(fields: [sellerOrderId], references: [id], onDelete: Cascade)
  ledgerEntry     DropshipLedgerEntry?

  @@unique([sellerOrderId, agreementId])
  @@index([sellerOrgId, createdAt])
  @@index([supplierOrgId, createdAt])
}

// NF12: commission/margin LEDGER — records only. One entry per
// completed dropship order (dropshipOrderLinkId unique =
// exactly-once). marginMinor = retailTotalMinor −
// wholesaleTotalMinor, computed from the REAL order totals at
// completion. NO payout execution, NO wallet mutation —
// payouts remain behind the OU11 legal gate.
model DropshipLedgerEntry {
  id                  String   @id @default(uuid())
  agreementId         String
  dropshipOrderLinkId String   @unique
  sellerOrgId         String
  supplierOrgId       String
  retailTotalMinor    BigInt
  wholesaleTotalMinor BigInt
  marginMinor         BigInt
  createdAt           DateTime @default(now())
  agreement           DropshipAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  orderLink           DropshipOrderLink   @relation(fields: [dropshipOrderLinkId], references: [id], onDelete: Cascade)
  sellerOrg           Organization      @relation(fields: [sellerOrgId], references: [id], onDelete: Cascade)

  @@index([sellerOrgId, createdAt])
  @@index([supplierOrgId, createdAt])
}

// ---------- EC21: Warehouse & stock ops ----------
// A physical warehouse of the org. NOTE: stock balances stay
// org-global on Product/ProductVariant (the S1 model) — a
// warehouse owns BIN LOCATIONS and stock-count sessions, it does
// NOT split balances per warehouse in v1.
// AB3 (AX4) supersedes the v1 note for balances: StockBalance
// (below) splits the global counter per bin (Σ bins == global),
// and Warehouse gains priority + serviceDistricts for the
// allocation ordering (district match → priority ASC →
// isDefault → createdAt; design §4.2).
model Warehouse {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  address        String?
  isDefault      Boolean  @default(false)
  active         Boolean  @default(true)
  // AB3 (AX4): allocation order — a LOWER priority number is
  // served first. serviceDistricts is a Json array of BD
  // district names (the ON11 / BD_DISTRICTS vocabulary) this
  // warehouse serves first; null = no district preference.
  priority       Int      @default(0)
  serviceDistricts Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bins           BinLocation[]
  assignments    ProductBinAssignment[]
  countSessions  StockCountSession[]
  stockAllocations StockAllocation[]

  @@index([organizationId, active])
}

model BinLocation {
  id             String   @id @default(uuid())
  organizationId String
  warehouseId    String
  code           String // e.g. "A-03-12"
  note           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  warehouse      Warehouse            @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  assignments    ProductBinAssignment[]
  stockBalances  StockBalance[]
  stockAllocations StockAllocation[]
  stockTransfersFrom StockTransfer[] @relation("StockTransferFromBin")
  stockTransfersTo   StockTransfer[] @relation("StockTransferToBin")

  @@unique([warehouseId, code])
  @@index([organizationId, warehouseId])
}

// EC21: the ONE primary bin of a product (or variant) inside one
// warehouse. SQL unique treats NULL variantId rows as distinct —
// the service enforces one product-level row per warehouse.
model ProductBinAssignment {
  id             String   @id @default(uuid())
  organizationId String
  warehouseId    String
  binLocationId  String
  productId      String
  variantId      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  warehouse      Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  binLocation    BinLocation  @relation(fields: [binLocationId], references: [id], onDelete: Cascade)
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, productId, variantId])
  @@index([organizationId, binLocationId])
  @@index([organizationId, productId])
}

// EC21: a stock-count session. Lines snapshot systemQty at
// creation; closing applies ONLY counted lines through the S1
// InventoryService (reason "stock_count"); uncounted lines are
// reported skipped, never zeroed. Closed sessions are immutable.
model StockCountSession {
  id             String    @id @default(uuid())
  organizationId String
  warehouseId    String
  binLocationId  String? // optional scope: only this bin's lines
  status         String    @default("open") // open | closed
  createdById    String?
  closedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  warehouse      Warehouse        @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  lines          StockCountLine[]

  @@index([organizationId, status, createdAt])
}

model StockCountLine {
  id         String  @id @default(uuid())
  sessionId  String
  productId  String
  variantId  String?
  systemQty  Int
  countedQty Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  session    StockCountSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  product    Product           @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([sessionId, productId, variantId])
  @@index([sessionId])
}

// ---------- AB3 (AX4): Multi-warehouse stock ----------
// The per-location layer over the S1 org-global counters. The
// consistency invariant (design §3): for every TRACKED row,
// Σ StockBalance.onHand over all bins == the global counter
// (Product.stockQuantity, or ProductVariant.stockQuantity for a
// variant row). Untracked rows (counter null) never have balance
// rows, and a variant row never falls back to the product row
// (or vice versa) — the S1 no-fallback rule, per bin.

// AB3 (AX4): the per-bin stock truth. One row per (product or
// variant, bin): onHand is this bin's share of the global
// counter, maintained by InventoryService inside the SAME
// transaction as the global write. reserved is a maintained
// counter — the Σ of this bin's active, unexpired
// StockReservation rows — recomputed at every reservation
// mutation; it is NOT part of the onHand invariant. variantId
// is a plain scalar like StockMovement's (null = the
// product-level row). Uniqueness per (organizationId,
// productId, variantId, binId) is enforced by TWO PARTIAL
// unique indexes in the AB3 migration SQL (one WHERE variantId
// IS NOT NULL, one WHERE variantId IS NULL), because SQL
// treats NULLs as distinct in a plain unique index — the AB1
// partial-index precedent. Prisma declares NO @@unique here on
// purpose (a plain one would be wrong); the service always
// goes find-then-write inside a transaction.
model StockBalance {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productId      String
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId      String?
  binId          String
  bin            BinLocation  @relation(fields: [binId], references: [id], onDelete: Cascade)
  onHand         Int
  reserved       Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, productId, variantId])
  @@index([binId])
}

// AB3 (AX4): the CURRENT claim state of an order's deduction —
// which bins its already-deducted units are attributed to.
// Written at placement alongside the balance + movement writes
// (one deduction moment, design §5.1); settled when the order
// is restored; MOVED (never duplicated) by ON3 split/merge
// surgery and by staff re-allocation. Bundle-component
// allocations carry orderItemId = null (components are not
// order items). status: active | settled. productId /
// variantId / orderItemId are plain scalars like
// StockMovement's ids (no FK): a claim must survive catalog
// edits exactly as its movements do.
model StockAllocation {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orderId        String
  order          Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItemId    String?
  productId      String
  variantId      String?
  binId          String
  bin            BinLocation  @relation(fields: [binId], references: [id], onDelete: Cascade)
  warehouseId    String
  warehouse      Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  qty            Int
  status         String       @default("active") // active | settled
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([orderId])
  @@index([organizationId, productId])
}

// AB3 (AX4): a warehouse-to-warehouse transfer of stock
// between two bins. Lifecycle: draft (no stock moves) →
// in_transit (dispatch decremented the fromBin balance with a
// "transfer_out" movement) → received | received_with_variance
// (receive incremented the toBin balance with "transfer_in";
// a short receive closes with variance) | cancelled (from
// draft, or from in_transit before any receive — quantities
// return to the fromBin). Transfers NEVER touch the global
// Product counter: while in_transit, Σ balances + Σ
// in-transit line qty == the global counter (design §6).
model StockTransfer {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fromBinId      String
  fromBin        BinLocation  @relation("StockTransferFromBin", fields: [fromBinId], references: [id], onDelete: Cascade)
  toBinId        String
  toBin          BinLocation  @relation("StockTransferToBin", fields: [toBinId], references: [id], onDelete: Cascade)
  status         String       @default("draft") // draft | in_transit | received | received_with_variance | cancelled
  createdById    String?
  dispatchedAt   DateTime?
  receivedAt     DateTime?
  note           String?
  lines          StockTransferLine[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, status])
  @@index([fromBinId])
  @@index([toBinId])
}

// AB3 (AX4): one product line of a StockTransfer. In-transit
// quantities live ONLY on these lines — in neither bin's
// balance — between dispatch and receive. qtyReceived is null
// until a receive posts it (partial receives allowed,
// qtyReceived ≤ qtySent). The variance (qtySent − qtyReceived)
// is recorded here and stays visible forever: those units are
// GONE (lost in transit), never silently returned to a bin.
// productId / variantId are plain scalars, like the transfer's
// other stock references.
model StockTransferLine {
  id          String        @id @default(uuid())
  transferId  String
  transfer    StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  productId   String
  variantId   String?
  qtySent     Int
  qtyReceived Int?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([transferId])
}

// ---------- EC22: Delivery ops ----------
// A merchant rule that auto-selects the courier account when a
// shipment is booked WITHOUT an explicit provider choice.
// conditions is validated Json: { districts?: string[],
// minWeightGrams?, maxWeightGrams?, minOrderMinor? (string),
// maxOrderMinor? (string), paymentType?: "cod"|"prepaid"|"any" }.
// courierAccountId is the courier Integration row (provider
// steadfast|pathao|redx); provider is its snapshot for display.
model CourierRule {
  id               String   @id @default(uuid())
  organizationId   String
  name             String
  conditions       Json
  courierAccountId String
  provider         String
  priority         Int      @default(0)
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, active, priority])
}

// EC22: the org's own delivery rider (staff-operated records
// only — no rider login/app in v1).
model Rider {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  phone          String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignments    DeliveryAssignment[]
  shareLink      RiderShareLink?
  locationLatest RiderLocationLatest?
  locationPings  RiderLocationPing[]

  @@index([organizationId, active])
}

// NF9 (FB4): per-rider live-GPS share link. The RAW token is
// shown ONCE to staff at issue/rotation time and is NEVER
// stored — only its SHA-256 hex hash lives here (the exact
// pattern OrgInviteLink / payment links use). One link row per
// rider: rotation overwrites the hash (the old token dies at
// once), revocation stamps revokedAt + sharingEnabled=false.
// sharingEnabled is the rider's own ON/OFF switch, flipped from
// the public /rider/[token] page; staff revocation is separate
// and terminal until staff issue/rotate a fresh link.
// expiresAt is set at issue time (30 days) — an expired link
// resolves to nothing, exactly like a revoked one.
model RiderShareLink {
  id             String    @id @default(uuid())
  organizationId String
  riderId        String    @unique
  tokenHash      String    @unique
  sharingEnabled Boolean   @default(true)
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rider          Rider        @relation(fields: [riderId], references: [id], onDelete: Cascade)

  @@index([organizationId, riderId])
}

// NF9 (FB4): ONE trail row per accepted geolocation ping,
// bound to the active DeliveryAssignment the ping was posted
// under. Retention is bounded in the service: at most
// NF9_TRAIL_CAP_PER_ASSIGNMENT (200) rows are kept per
// assignment — on insert the oldest rows beyond the cap are
// pruned. The rider's CURRENT position never reads this trail;
// it reads RiderLocationLatest (the upserted latest fix).
model RiderLocationPing {
  id                   String   @id @default(uuid())
  organizationId       String
  riderId              String
  deliveryAssignmentId String
  lat                  Float
  lng                  Float
  accuracy             Float?
  recordedAt           DateTime
  createdAt            DateTime @default(now())
  organization         Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rider                Rider              @relation(fields: [riderId], references: [id], onDelete: Cascade)
  deliveryAssignment   DeliveryAssignment @relation(fields: [deliveryAssignmentId], references: [id], onDelete: Cascade)

  @@index([organizationId, riderId, recordedAt])
  @@index([organizationId, deliveryAssignmentId, recordedAt])
}

// NF9 (FB4): the rider's latest accepted fix — exactly ONE row
// per rider, UPSERTED on every accepted ping (no history here;
// history is the capped RiderLocationPing trail). Fleet view
// and customer tracking read ONLY this row, and a fix older
// than NF9_STALE_THRESHOLD_MS (5 minutes) is labelled stale,
// never presented as live.
model RiderLocationLatest {
  id                   String   @id @default(uuid())
  organizationId       String
  riderId              String   @unique
  deliveryAssignmentId String
  lat                  Float
  lng                  Float
  accuracy             Float?
  recordedAt           DateTime
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  organization         Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rider                Rider              @relation(fields: [riderId], references: [id], onDelete: Cascade)
  deliveryAssignment   DeliveryAssignment @relation(fields: [deliveryAssignmentId], references: [id], onDelete: Restrict)

  @@index([organizationId, riderId])
}

// EC22: one order handed to one rider. Status vocabulary:
// assigned | picked_up | delivered | returned. At most ONE
// non-terminal (assigned|picked_up) assignment per order —
// enforced in the service (a plain unique cannot express it).
// Marking delivered drives the order to "completed" through
// OrdersService.updateOrder (the same transition path staff
// use); returned does not touch the order status in v1.
model DeliveryAssignment {
  id             String    @id @default(uuid())
  organizationId String
  orderId        String
  riderId        String
  assignedById   String?
  status         String    @default("assigned")
  note           String?
  assignedAt     DateTime  @default(now())
  pickedUpAt     DateTime?
  deliveredAt    DateTime?
  returnedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rider          Rider        @relation(fields: [riderId], references: [id], onDelete: Restrict)
  locationPings  RiderLocationPing[]
  locationLatests RiderLocationLatest[]

  @@index([organizationId, riderId, status])
  @@index([organizationId, orderId])
  @@index([organizationId, assignedAt])
}

// Automated COD Order Confirmation AI Voice Calling Engine (Bangla IVR)
model VoiceCallSetting {
  id                       String       @id @default(uuid())
  organizationId           String       @unique
  enabled                  Boolean      @default(false)
  autoCallNewCod           Boolean      @default(false)
  delayMinutes             Int          @default(2)
  provider                 String       @default("mock") // twilio | mock
  twilioAccountSid         String?
  twilioAuthToken          String?
  twilioCallerId           String?
  promptIntro              String?
  maxAttempts              Int          @default(3)
  retryIntervalMinutes     Int          @default(15)
  // NF3 (FB2): AI Voice Agent conversation upgrade.
  conversationAgentEnabled Boolean      @default(false)
  conversationMode         String       @default("simulation") // simulation | twilio_relay
  relayWebsocketUrl        String?
  conversationLanguage     String       @default("bn-BD")
  sttProvider              String       @default("google")
  ttsProvider              String       @default("amazon")
  ttsVoice                 String       @default("Polly.Nabanita")
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt
  organization             Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// RM3 (Cloudflare R2 Media Program): the central file registry —
// ONE row for every object the platform stores, whichever surface
// put it there (product, social, inbox, branding, creative, review,
// digital, document). Older surfaces keep their own rows untouched
// (MediaAsset, ChannelMessage.mediaStorageKey, Organization.logoUrl);
// this table is the single source for storage accounting, lifecycle
// (quarantine -> active -> trashed) and orphan/inventory sweeps.
// Backfill of the older surfaces is RM10's job, not this model's.
//
// sizeBytes is BigInt on purpose: MediaAsset's Int caps a file at
// ~2 GB, but the multipart path (RM2) exists precisely for objects
// that can exceed that; a registry that overflows at 2 GB would
// silently break for the largest files it is meant to track.
// `key` is globally unique (keys embed the organization id by the
// storage layer's naming convention), which makes re-registering
// the same object an idempotent upsert instead of a duplicate row.
model StoredFile {
  id             String   @id @default(uuid())
  organizationId String
  bucket         String // R2 bucket name, or "local" in local-disk mode
  key            String   @unique
  visibility     String // public | private
  surface        String // product | social | inbox | branding | creative | review | digital | document | other
  contentType    String
  sizeBytes      BigInt
  width          Int?
  height         Int?
  sha256         String?
  status         String   @default("active") // quarantine | active | trashed
  createdById    String?
  // The originating row on the owning surface, when there is one
  // (e.g. "mediaAsset:<id>", "productImage:<id>"); null for objects
  // registered without a surface row.
  sourceRef      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, surface])
}

// GB8 (GC20): one staff-recorded business expense. category is a
// FIXED vocabulary (rent | salary | marketing | packaging |
// delivery | utilities | inventory_purchase | other) enforced by
// the service DTO, Bengali labels live in the UI. amountMinor is
// BigInt minor units (paisa). spentAt is stored as the Dhaka-
// midnight instant of the merchant's chosen date. receiptUrl is
// an optional validated http(s) URL — the file itself is never
// hosted here.
model Expense {
  id             String   @id @default(uuid())
  organizationId String
  category       String
  amountMinor    BigInt
  spentAt        DateTime
  note           String?
  paymentMethod  String? // cash | bank | bkash | other
  receiptUrl     String?
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, spentAt])
  @@index([organizationId, category, spentAt])
}

// OU7 (One-Umbrella, accounting-lite): persisted DERIVED bookkeeping.
// Journal entries are generated by the posting rules in
// apps/api/src/finance/ou7-accounting.service.ts from real source
// records (sold orders, verified payments, approved manual advances,
// matched courier-settlement lines, gateway fees, completed refunds,
// expenses) — never hand-maintained except entries explicitly marked
// isManual (OWNER/ADMIN, audit-logged, balance enforced server-side).
// idempotencyKey is unique per org: one source record posts at most
// once. Account NAMES reuse the GC20.5 GL-export mapping verbatim
// ("Sales", "Gateway Clearing", "Expense: <category>", ...); the GL
// export itself is unchanged and stays the accountant's generic file.
model FinanceAccount {
  id             String   @id @default(uuid())
  organizationId String
  code           String // e.g. "1020" — stable, see DEFAULT_ACCOUNTS in ou7-accounting.service.ts
  name           String // GL-export account name, e.g. "Gateway Clearing"
  type           String // asset | liability | equity | income | expense | contra_income
  normalSide     String // debit | credit
  isSystem       Boolean  @default(true)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId, active])
}

// UNION RENAME (int10 final union, 2026-10-17): OU7's journal models were
// renamed JournalEntry/JournalLine -> Ou7JournalEntry/Ou7JournalLine
// because NF10 (FB4) independently shipped models with the identical
// names AND identical table names (different shape: ChartAccount-based).
// Zero-loss stitch: OU7 keeps its own tables/posting rules; NF10 keeps
// the JournalEntry/JournalLine names. The OU7 migration SQL was renamed
// to match (that migration had never run on any real DB).
model Ou7JournalEntry {
  id             String   @id @default(uuid())
  organizationId String
  entryDate      DateTime // Dhaka-midnight instant of the entry's date key
  sourceType     String // sale | payment_gateway | payment_manual | courier_settlement | gateway_fee | refund | expense | manual
  sourceId       String? // null only for manual entries
  idempotencyKey String // "ou7:<sourceType>:<sourceId>" | "manual:<uuid>"
  memo           String?
  isManual       Boolean  @default(false)
  createdById    String?
  createdAt      DateTime @default(now())
  lines          Ou7JournalLine[]

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, entryDate])
  @@index([organizationId, sourceType])
}

model Ou7JournalLine {
  id             String          @id @default(uuid())
  organizationId String
  entryId        String
  accountCode    String // FinanceAccount.code within the same org
  debitMinor     BigInt          @default(0)
  creditMinor    BigInt          @default(0)
  createdAt      DateTime        @default(now())
  entry          Ou7JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([organizationId, entryId])
  @@index([organizationId, accountCode])
}

// OU7 bank statement reconciliation: imported statement lines.
// status starts "unmatched" ALWAYS — a match is only ever set by a
// human confirming a suggestion (never auto-confirmed). amountMinor
// is signed: positive = money in, negative = money out (paisa).
model BankStatementLine {
  id               String    @id @default(uuid())
  organizationId   String
  importId         String // one CSV import batch
  statementDate    DateTime // Dhaka-midnight instant of the statement date
  description      String
  amountMinor      BigInt // signed
  reference        String?
  status           String    @default("unmatched") // unmatched | matched
  matchedSourceType String? // tenant_payment_transaction | courier_settlement | payment_verification | expense
  matchedSourceId  String?
  confirmedById    String?
  confirmedAt      DateTime?
  createdAt        DateTime  @default(now())

  @@index([organizationId, status])
  @@index([organizationId, statementDate])
  @@index([organizationId, importId])
}

// GB8 (GC19): one scheduled-report configuration. reportType is
// one of discounts | refunds | payment_sales | category_sales |
// shipping_cost | profit — plus messaging_summary (MX16: the
// scheduled messaging summary, generated by the
// ScheduledReportsService from messaging records). cadence
// daily | weekly; format csv | xlsx. recipients is a JSON array
// of validated email strings.
// lastRunAt is stamped INSIDE a run before delivery is attempted
// (exactly-once per period stance: a crash mid-run loses that
// period's send rather than duplicating it).
model ScheduledReport {
  id             String   @id @default(uuid())
  organizationId String
  reportType     String
  cadence        String // daily | weekly
  format         String   @default("csv") // csv | xlsx
  recipients     Json // string[] of email addresses
  enabled        Boolean  @default(true)
  lastRunAt      DateTime?
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  runs           ScheduledReportRun[]

  @@index([organizationId, enabled])
}

model OrderVoiceCall {
  id                  String       @id @default(uuid())
  organizationId      String
  orderId             String
  phone               String
  provider            String       @default("mock") // twilio | mock | simulation | twilio_relay
  callSid             String?      @unique
  direction           String       @default("outbound") // outbound | inbound
  status              String       @default("initiated") // initiated | ringing | in_progress | completed | busy | failed | no_answer
  durationSeconds     Int          @default(0)
  digitsPressed       String?
  outcome             String       @default("pending") // pending | confirmed | rejected | unreachable | failed
  speechPrompt        String?
  recordingUrl        String?
  errorMessage        String?
  metadata            Json?
  // NF3 (FB2): conversation outcome / follow-up.
  conversationOutcome String? // confirmed | cancelled | address_changed | delivery_time_changed | human_handoff | unreachable | failed
  conversationSummary String?
  followUpStatus      String       @default("none") // none | pending | done
  followUpChannel     String? // whatsapp_manual when pending
  actionAppliedAt     DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  order               Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  conversationTurns   VoiceConversationTurn[]

  @@index([organizationId, createdAt])
  @@index([organizationId, orderId])
  @@index([orderId, status])
}

// NF3 (FB2): one persisted turn of an AI voice conversation.
model VoiceConversationTurn {
  id             String         @id @default(uuid())
  organizationId String
  callId         String
  seq            Int
  role           String // agent | customer | system
  text           String
  intent         String?
  confidence     Float?
  createdAt      DateTime       @default(now())
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  call           OrderVoiceCall @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@unique([callId, seq])
  @@index([organizationId, callId, seq])
}

// GB8 (GC19): one delivery attempt of a ScheduledReport. status
// vocabulary: sent | failed_no_provider | failed_error. A run
// counts as sent ONLY when at least one recipient's EmailProvider
// send returned a message id. testRun marks "এখনই পাঠান" sends
// (they never stamp the config's lastRunAt). detail carries the
// per-recipient results + the attachment filename.
model ScheduledReportRun {
  id                String   @id @default(uuid())
  scheduledReportId String
  organizationId    String
  periodLabel       String
  status            String // sent | failed_no_provider | failed_error
  testRun           Boolean  @default(false)
  detail            Json?
  createdAt         DateTime @default(now())
  scheduledReport   ScheduledReport @relation(fields: [scheduledReportId], references: [id], onDelete: Cascade)

  @@index([scheduledReportId, createdAt])
  @@index([organizationId, createdAt])
}

// AB7 (AX15): AI review insight for one product — generated ONLY
// on a staff trigger through the org's configured LLM, cached on
// this row. summaryText is AI-generated text and is labelled as
// such on every surface. sentimentJson = { positive, neutral,
// negative, total } aggregate counts from the generation pass
// (per-review sentiment is never stamped back). themesJson =
// up to 5 short theme strings. reviewCountAtGeneration lets the
// panel show how many reviews arrived since (staleness badge at
// >= 10). modelLabel = the LLM model identifier when known.
model ProductReviewInsight {
  id                      String       @id @default(uuid())
  organizationId          String
  productId               String
  summaryText             String
  sentimentJson           Json
  themesJson              Json
  reviewCountAtGeneration Int
  generatedAt             DateTime
  generatedById           String?
  modelLabel              String?
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
  organization            Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, productId])
  @@index([organizationId])
}

// AB7 (AX16): per-org web-push configuration. The VAPID keypair
// is generated ONCE when the merchant enables push; the private
// key is stored SEALED (common/platform-config seal) and never
// leaves the server. enabled defaults FALSE — no prompt, no
// sends until the merchant turns it on.
model ShopPushSetting {
  id                   String       @id @default(uuid())
  organizationId       String       @unique
  vapidPublicKey       String?
  vapidPrivateKeySealed String?
  enabled              Boolean      @default(false)
  promptDelaySec       Int          @default(20)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// AB7 (AX16): one browser push subscription captured on the
// shop. endpoint is the push-service URL (unique per org);
// p256dh/auth are the subscription's own encryption keys (not
// secrets of the platform — they are required to send TO this
// browser). status: active | gone (404/410 from the push
// service marks gone; gone rows are never retried).
model WebPushSubscription {
  id             String       @id @default(uuid())
  organizationId String
  endpoint       String
  p256dh         String
  auth           String
  customerId     String?
  userAgent      String?
  isTestDevice   Boolean      @default(false)
  status         String       @default("active") // active | gone
  createdAt      DateTime     @default(now())
  lastSeenAt     DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveries     WebPushDelivery[]

  @@unique([organizationId, endpoint])
  @@index([organizationId, status])
}

// AB7 (AX16): one dashboard-composed push broadcast. Fan-out is
// chunked: the send request attempts up to a bounded batch
// inline; the remainder stays queued (queuedCount) for the
// web_push_sweep job to drain. Counts are honest send outcomes
// from the push service — no open/read tracking exists.
model WebPushCampaign {
  id             String       @id @default(uuid())
  organizationId String
  title          String
  body           String
  url            String?
  createdById    String?
  status         String       @default("queued") // queued | sending | done
  queuedCount    Int          @default(0)
  sentCount      Int          @default(0)
  failedCount    Int          @default(0)
  goneCount      Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveries     WebPushDelivery[]

  @@index([organizationId, status])
  @@index([organizationId, createdAt])
}

// AB7 (AX16): one delivery attempt of a campaign to one
// subscription. status: sent | failed | gone. statusCode is the
// push service's HTTP response when one came back.
model WebPushDelivery {
  id             String   @id @default(uuid())
  campaignId     String
  subscriptionId String
  status         String // sent | failed | gone
  statusCode     Int?
  error          String?
  createdAt      DateTime @default(now())
  campaign       WebPushCampaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  subscription   WebPushSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([campaignId, subscriptionId])
  @@index([campaignId, status])
}

// AB7 (AX17): social-proof popup configuration. The feed itself
// is REAL recent orders only (never fabricated), anonymized to
// first name + district + product + hours-ago bucket; amounts
// are never shown.
model SocialProofSetting {
  id             String       @id @default(uuid())
  organizationId String       @unique
  enabled        Boolean      @default(false)
  lookbackHours  Int          @default(24)
  intervalSec    Int          @default(25)
  displaySec     Int          @default(6)
  maxPerSession  Int          @default(5)
  minTotalMinor  BigInt?
  impressions    Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// NF1 (FB1): Facebook Live Commerce — one live selling session.
// source: meta | manual. A meta session carries the merchant's
// connected SocialAccount + the Page live-video id the merchant
// started on Facebook (broadcast creation via the Live Video API
// is evidenced in docs/nf1-meta-live-spike.md but NOT called in
// v1 — the id is staff-supplied). A manual session has neither
// and runs on staff-imported comments only. status:
// scheduled | live | ended. No columns were added to Order —
// attribution lives in LiveSessionOrder below.
model LiveSession {
  id                 String       @id @default(uuid())
  organizationId     String
  socialAccountId    String?
  externalLiveVideoId String?
  title              String
  status             String       @default("scheduled") // scheduled | live | ended
  source             String       @default("manual") // meta | manual
  startedAt          DateTime?
  endedAt            DateTime?
  createdById        String
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  socialAccount      SocialAccount? @relation(fields: [socialAccountId], references: [id], onDelete: SetNull)
  products           LiveSessionProduct[]
  comments           LiveComment[]
  sessionOrders      LiveSessionOrder[]

  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@index([socialAccountId])
}

// NF1: a product pinned to a live session, in staff-chosen
// display order. isNowShowing marks the ONE product currently
// being presented — the service enforces exactly one per
// session (clearing the others in the same write); the schema
// cannot express that partial-unique rule, so it lives in
// LiveCommerceService.setNowShowing + its spec.
model LiveSessionProduct {
  id           String      @id @default(uuid())
  liveSessionId String
  productId    String
  displayOrder Int         @default(0)
  isNowShowing Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  liveSession  LiveSession @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)
  product      Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([liveSessionId, productId])
  @@index([liveSessionId, displayOrder])
  @@index([productId])
}

// NF1: one comment seen during a live session. source: meta
// (polled from the Live Video comments edge — shape evidenced in
// docs/nf1-meta-live-spike.md) | manual (staff import). Null
// handling for the composite unique: Postgres treats NULLs as
// distinct, so manual rows (externalCommentId null) never
// collide with each other, while a meta comment's
// (liveSessionId, externalCommentId) pair can only ever be
// stored once — the provider upsert relies on exactly that.
model LiveComment {
  id                  String      @id @default(uuid())
  liveSessionId       String
  organizationId      String
  externalCommentId   String?
  commenterExternalId String?
  commenterName       String
  message             String
  commentedAt         DateTime    @default(now())
  source              String      @default("manual") // meta | manual
  createdAt           DateTime    @default(now())
  liveSession         LiveSession @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)
  sessionOrders       LiveSessionOrder[]

  @@unique([liveSessionId, externalCommentId])
  @@index([organizationId, liveSessionId, commentedAt])
  @@index([liveSessionId, commentedAt])
}

// NF1: the attribution link between a live session and an order
// created from it. orderId is unique — an order is attributed to
// at most one session. liveCommentId is the comment the order
// came from (null when staff attributes an order without a
// specific comment); comment→order exactly-once is enforced in
// the service by looking up an existing link for the comment
// before creating. Recap revenue sums ONLY orders linked here.
model LiveSessionOrder {
  id            String      @id @default(uuid())
  liveSessionId String
  orderId       String      @unique
  liveCommentId String?
  organizationId String
  createdAt     DateTime    @default(now())
  liveSession   LiveSession @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)
  order         Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  liveComment   LiveComment? @relation(fields: [liveCommentId], references: [id], onDelete: SetNull)

  @@index([organizationId, liveSessionId])
  @@index([liveSessionId])
  @@index([liveCommentId])
}

// NF2 (FB1): one short-video project for one product of one org,
// rendered locally by the ffmpeg template provider (see
// docs/nf2-video-provider-spike.md — NO external AI video
// provider is selected; v1 is template rendering, never labelled
// AI-generated). template is a free string validated in the
// service (v1: "showcase" | "offer"); language bn | en;
// status queued | rendering | ready | failed. mediaAssetId is
// the rendered output MediaAsset (kind "video", origin
// "video_studio") — set ONLY on a successful render; a failed
// render records errorLabel (the real, merchant-readable reason)
// and creates NO asset. socialPostId is set once, when the ready
// video is turned into a SocialPost through SocialService
// .createPost; publishing again returns that same post.
model VideoProject {
  id             String      @id @default(uuid())
  organizationId String
  productId      String
  template       String      @default("showcase")
  language       String      @default("bn") // bn | en
  offerText      String?
  status         String      @default("queued") // queued | rendering | ready | failed
  mediaAssetId   String?
  errorLabel     String?
  socialPostId   String?
  createdById    String
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  mediaAsset     MediaAsset?  @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)
  socialPost     SocialPost?  @relation(fields: [socialPostId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@index([productId])
  @@index([mediaAssetId])
  @@index([socialPostId])
}

// NF4 (FB2): Service & Appointment business type — a service a
// customer books with a staff member for a concrete time slot
// (salon, clinic, consultancy, repair…). priceMinor is the full
// service price (paisa); a booking's deposit slice comes from
// the org BusinessProfile deposit config via fraud/deposit.ts
// depositFor(kind "manual") — see ServiceBooking.
model ServiceOffering {
  id              String       @id @default(uuid())
  organizationId  String
  name            String
  description     String?
  durationMinutes Int
  priceMinor      BigInt
  bufferMinutes   Int          @default(0)
  active          Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bookings        ServiceBooking[]

  @@index([organizationId, active])
}

// NF4: a bookable staff member. Staff are EXISTING org members —
// membershipId links the Membership row (no new user table); one
// ServiceStaff row per membership per org.
model ServiceStaff {
  id             String       @id @default(uuid())
  organizationId String
  membershipId   String
  displayName    String?
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership     Membership   @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  availabilities StaffAvailability[]
  bookings       ServiceBooking[]

  @@unique([organizationId, membershipId])
  @@index([organizationId, active])
  @@index([membershipId])
}

// NF4: one weekly working window for one staff member. weekday
// uses the JS convention 0 = Sunday … 6 = Saturday; startMinute /
// endMinute are minutes from midnight in the ORGANIZATION's
// timezone. Overlapping windows for the same weekday are refused
// in the service (replace-all write), not by the schema.
model StaffAvailability {
  id             String       @id @default(uuid())
  organizationId String
  serviceStaffId String
  weekday        Int // 0 = Sunday … 6 = Saturday (JS convention)
  startMinute    Int // minutes from midnight, org-local
  endMinute      Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  serviceStaff   ServiceStaff @relation(fields: [serviceStaffId], references: [id], onDelete: Cascade)

  @@index([organizationId, serviceStaffId, weekday])
  @@index([serviceStaffId])
}

// NF4: one appointment. Overlap (same staff, status pending /
// confirmed, intervals intersecting) is enforced in
// BookingService inside a transaction — the schema cannot express
// it, same discipline as DeliveryAssignment's service-enforced
// rules. Deposit honesty: depositRequiredMinor is a QUOTE from
// the org's manual deposit config; depositState is manual-only
// (not_required | unpaid_manual | paid_manual) — a booking NEVER
// creates a PaymentVerification or a gateway transaction.
model ServiceBooking {
  id                   String       @id @default(uuid())
  organizationId       String
  serviceId            String
  staffId              String
  customerId           String?
  guestName            String
  guestPhone           String
  startAt              DateTime
  endAt                DateTime
  status               String       @default("pending") // pending | confirmed | cancelled | completed | no_show
  source               String       @default("storefront") // storefront | dashboard
  depositRequiredMinor BigInt       @default(0)
  depositState         String       @default("not_required") // not_required | unpaid_manual | paid_manual
  reminderSentAt       DateTime?
  reminderStatus       String? // sent | failed_no_channel | failed_error
  note                 String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  organization         Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  service              ServiceOffering @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  staff                ServiceStaff    @relation(fields: [staffId], references: [id], onDelete: Restrict)
  customer             Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([organizationId, staffId, startAt])
  @@index([organizationId, status, startAt])
  @@index([organizationId, customerId])
  @@index([serviceId])
  @@index([staffId])
}

// NF5 (FB3): one translated content string. entityType "product"
// (entityId = product id, field = name | description) or
// "storefront_string" (entityId = "shop", field = the string key,
// e.g. announcementText). HARD RULE: the public storefront serves
// status "approved" rows ONLY — a draft (every AI generation starts
// as one) is never public; a missing/unapproved row falls back to
// the base-language original text. source records provenance:
// "ai" (an LlmFactory draft a human still had to approve) or
// "human" (typed by staff). The locale column is a free string on
// purpose: the mechanism is locale-agnostic (bn + en + hi ship in
// v1; see apps/api/src/translations/translations.ts).
model ContentTranslation {
  id             String       @id @default(uuid())
  organizationId String
  entityType     String
  entityId       String
  field          String
  locale         String
  text           String
  status         String       @default("draft") // draft | approved
  source         String       @default("human") // ai | human
  createdById    String?
  updatedById    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, entityType, entityId, field, locale])
  @@index([organizationId, entityType, locale])
  @@index([organizationId, entityId])
}

// NF5 (FB3): a HUMAN-ENTERED display-currency rate for the public
// shop. ratePerUnit = how many units of the shop's BASE currency
// one unit of `currency` costs (e.g. base BDT, currency USD,
// ratePerUnit "119.50"), stored as a string so no float ever
// touches money-shaped data; conversion happens display-side only
// and every converted price is labelled approximate with checkout
// charged in the base currency. Nothing ever fetches a live FX
// rate. sourceNote is required — the human records where the rate
// came from. Checkout / orders / payments NEVER read this table.
model DisplayCurrencyRate {
  id             String       @id @default(uuid())
  organizationId String
  currency       String
  ratePerUnit    String
  sourceNote     String
  updatedById    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, currency])
  @@index([organizationId])
}

// NF6 (FB3): a gamified promotion campaign — ONE of three
// mechanics (spin_wheel | quiz | group_buy) presented on the
// storefront through the OU8 popup engine's placement/trigger
// vocabulary (trigger / delaySeconds / scrollPercent /
// frequencyDays / showOn / startsAt / endsAt mirror StorePopup
// field-for-field, so the shop renders it with the same trigger
// machinery). `config` is a per-kind validated Json document
// (see gamified-promotions/promo-config.ts). For spin_wheel the
// config carries segment WEIGHTS — server-side only, never sent
// to a public response. For group_buy the campaign window IS
// startsAt..endsAt and endsAt is required.
model PromoCampaign {
  id             String       @id @default(uuid())
  organizationId String
  kind           String // spin_wheel | quiz | group_buy
  name           String
  active         Boolean      @default(true)
  trigger        String       @default("delay_seconds") // delay_seconds | scroll_percent | exit_intent
  delaySeconds   Int          @default(5)
  scrollPercent  Int          @default(50)
  frequencyDays  Int          @default(7)
  showOn         String       @default("home") // home | all
  startsAt       DateTime?
  endsAt         DateTime?
  config         Json
  createdById    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, kind, active])
}

// NF6 (FB3): ONE play of a spin_wheel or quiz campaign by ONE
// phone. The (campaignId, phoneKey) unique IS the
// one-play-per-phone rule — phoneKey is the Fraud Shield /
// BlockedPhone match key (orders/phone-utils bdPhoneMatchKey),
// and blocked phones are refused before a row is ever written.
// outcome: won | lost | completed (quiz). A win/completion with
// a configured prize carries couponId/couponCode of the REAL
// single-use StoreDiscount issued through the existing coupon
// engine (origin "gamified_promo", sourceRef "nf6:play:<id>" —
// the sourceRef pre-check is what makes issuance exactly-once
// on replay). resultKey is the quiz winner mapping key
// (cat:<id> | catname:<name> | tag:<slug>); null otherwise.
model PromoPlay {
  id             String       @id @default(uuid())
  organizationId String
  campaignId     String
  phone          String
  phoneKey       String
  customerName   String?
  outcome        String // won | lost | completed
  segmentIndex   Int?
  segmentLabel   String?
  resultKey      String?
  couponId       String?
  couponCode     String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([campaignId, phoneKey])
  @@index([organizationId, campaignId, createdAt])
}

// NF6 (FB3): ONE group-buy join. A join is a RECORD, not a stock
// hold — StockReservation was considered and rejected (see the
// NF6 acceptance doc): reservations are anonymous checkout-
// session stock holds that expire silently, and holding real
// stock for a group that may never form would block real sales.
// NO payment is ever taken for a join. status: joined (window
// open, threshold unmet) | unlocked (threshold met — a REAL
// single-use product-scoped StoreDiscount was issued through
// the existing coupon engine, sourceRef "nf6:groupbuy:<id>")
// | expired (window closed unmet — nothing charged, nothing
// issued; the status flip + the staff-visible joiner list IS
// the notification record in v1, no send is claimed).
model PromoGroupBuyJoin {
  id             String       @id @default(uuid())
  organizationId String
  campaignId     String
  phone          String
  phoneKey       String
  customerName   String?
  status         String       @default("joined") // joined | unlocked | expired
  couponId       String?
  couponCode     String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([campaignId, phoneKey])
  @@index([organizationId, campaignId, status])
}

// NF7 (FB3): an org-configured membership tier. A customer earns
// the HIGHEST tier whose minSpendMinor their lifetime completed
// spend reaches (see CustomerTier). minSpendMinor is in minor
// units (পয়সা), like every other money field. sortOrder is the
// staff-facing display order; derivation compares thresholds,
// never sortOrder.
model TierDefinition {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  minSpendMinor  BigInt
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerTiers  CustomerTier[]
  priceList      PriceList?

  @@unique([organizationId, name])
  @@index([organizationId, sortOrder])
}

// NF7 (FB3): a customer's CURRENT tier, DERIVED — never staff-
// assigned. lifetimeSpendMinor is the sum of totalMinor over
// the customer's sold orders ONLY (status completed | delivered,
// the codebase's canonical sold statuses — cancelled / pending /
// returned / refunded / failed never count), recomputed by
// MembershipService on order transitions (the loyalty reconciler
// event pattern), on tier-definition changes, and on a staff
// recompute call. tierId is null when the spend reaches no
// tier's threshold. This row is a derived cache of a pure
// function of the orders table — it can always be rebuilt.
model CustomerTier {
  id                 String       @id @default(uuid())
  organizationId     String
  customerId         String       @unique
  tierId             String?
  lifetimeSpendMinor BigInt       @default(0)
  computedAt         DateTime     @default(now())
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer           Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tier               TierDefinition? @relation(fields: [tierId], references: [id], onDelete: SetNull)

  @@index([organizationId, tierId])
  @@index([organizationId, customerId])
}

// NF7 (FB3): THE store-credit truth — one row per credit
// movement, written ONLY by StoreCreditService. The customer's
// balance is ALWAYS derived as Σ deltaMinor over this ledger;
// there is deliberately NO mutable balance column anywhere
// (the loyalty pattern, minus its cache). deltaMinor is signed:
// positive = credit in (grant_manual | refund_credit |
// spend_reversal), negative = spend. balanceAfter is the
// derived balance immediately after this entry, stamped inside
// the writing transaction for audit readability — it is a
// per-entry snapshot, never updated afterwards.
// Exactly-once: (organizationId, sourceRef) is UNIQUE —
// spend uses "nf7:spend:<orderId>", its reversal
// "nf7:spend-reversal:<orderId>", refund-to-credit
// "nf7:refund-credit:<orderId>:<refundKey>" (the refundKey is
// supplied by the caller so a retried refund replays the SAME
// key). Manual grants carry no sourceRef (each is a deliberate,
// audited staff act) and require a note.
model StoreCreditEntry {
  id             String       @id @default(uuid())
  organizationId String
  customerId     String
  deltaMinor     BigInt // signed
  reason         String // grant_manual | refund_credit | spend | spend_reversal
  orderId        String? // plain scalar, like LoyaltyLedger.orderId
  sourceRef      String?
  balanceAfter   BigInt
  createdById    String? // staff actor for grant_manual / refund_credit
  note           String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([organizationId, sourceRef])
  @@index([organizationId, customerId, createdAt])
  @@index([organizationId, orderId])
}

// NF10 (FB4): one chart-of-accounts row. Org-scoped; system
// accounts (isSystem = true, systemKey set) are seeded lazily by
// AccountingService on first use and can be RENAMED but never
// deleted or re-typed (enforced in the service). Custom accounts
// carry no systemKey. code is org-unique and staff-facing
// (e.g. "1000"); type: asset | liability | equity | income |
// expense. All journal money is BigInt minor units.
model ChartAccount {
  id             String   @id @default(uuid())
  organizationId String
  code           String
  name           String
  type           String // asset | liability | equity | income | expense
  isSystem       Boolean  @default(false)
  systemKey      String? // cash | bkash | bank | accounts_receivable | ... (see AccountingService)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  journalLines   JournalLine[]

  @@unique([organizationId, code])
  @@unique([organizationId, systemKey])
  @@index([organizationId, type])
}

// NF10 (FB4): one balanced double-entry journal entry. The
// BALANCE INVARIANT lives in AccountingService.createJournalEntry
// (the ONLY write door): an entry saves only if it has >= 2
// lines, Σdebit == Σcredit and Σ > 0 — an unbalanced entry can
// never be saved. Auto-generated entries carry
// sourceType + sourceId (order | payment | expense |
// courier_charge) and the (organizationId, sourceType, sourceId)
// unique makes generation idempotent per source record; manual
// entries carry sourceType = "manual" and a null sourceId
// (Postgres treats NULLs as distinct, so manual entries never
// collide on the unique).
model JournalEntry {
  id             String   @id @default(uuid())
  organizationId String
  date           DateTime
  memo           String?
  sourceType     String? // order | payment | expense | courier_charge | manual
  sourceId       String?
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lines          JournalLine[]

  @@unique([organizationId, sourceType, sourceId])
  @@index([organizationId, date])
  @@index([organizationId, sourceType])
}

// NF10 (FB4): one leg of a JournalEntry. Exactly one of
// debitMinor / creditMinor is > 0 (service-enforced); both are
// BigInt minor units like the rest of the codebase.
model JournalLine {
  id         String   @id @default(uuid())
  entryId    String
  accountId  String
  debitMinor BigInt   @default(0)
  creditMinor BigInt  @default(0)
  createdAt  DateTime @default(now())
  entry      JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account    ChartAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([entryId])
  @@index([accountId])
}

// ── NF11 (FB4): HR lite ──────────────────────────────────────
// Staff ARE Membership/User rows — there is deliberately NO
// parallel people table. Every HR row hangs off a Membership
// of the org. Money is BigInt minor units. A PayrollRun is a
// RECORD of pay computed from recorded inputs (salary profile,
// APPROVED UNPAID leave, recorded Order.commissionMinor on
// agent-attributed sold orders) — marking a run paid moves NO
// money; it stamps paidBy/paidAt and (via NF10) posts ONE
// journal expense entry.

// NF11: the org's single explicit HR/payroll rule row. The
// rules are STORED (never hard-coded silently): the unpaid-leave
// pro-rata rule and the commission rule are shown verbatim in
// every PayrollRun.ruleSnapshot. v1 values:
// unpaidLeaveRule = "per_calendar_day" — deduction =
// round(base × unpaidDays ÷ daysInMonth); commissionRule =
// "recorded_order_commission" — Σ Order.commissionMinor over
// sold (completed|delivered) orders whose agentId = the
// member's userId in the run month (the Feature-5 attribution
// fields). NO percentage/per-delivery fallback is ever applied.
model HrSetting {
  id              String   @id @default(uuid())
  organizationId  String   @unique
  unpaidLeaveRule String   @default("per_calendar_day")
  commissionRule  String   @default("recorded_order_commission")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// NF11: one salary profile per membership. payoutNote is a
// free-text note (e.g. "bKash personal") — it is NOT a
// credential field and must never carry secrets.
model StaffSalaryProfile {
  id             String    @id @default(uuid())
  organizationId String
  membershipId   String    @unique
  baseSalaryMinor BigInt
  effectiveFrom  DateTime // date the profile takes effect (org-local day)
  payoutNote     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership     Membership   @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// NF11: one attendance record per member per org-local day
// (Organization.timezone date — the codebase's org timezone).
// source = self | staff_correction; a correction ALWAYS writes
// an AuditLog entry and stores correctionNote.
model AttendanceRecord {
  id             String    @id @default(uuid())
  organizationId String
  membershipId   String
  date           String // YYYY-MM-DD, org-timezone calendar day
  checkInAt      DateTime?
  checkOutAt     DateTime?
  source         String    @default("self") // self | staff_correction
  correctionNote String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership     Membership   @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([organizationId, membershipId, date])
  @@index([organizationId, date])
}

// NF11: weekly shift pattern — same shape/validation as NF4's
// StaffAvailability (weekday 0=Sunday…6, minutes from midnight,
// org-local), but keyed to the Membership directly (a roster is
// about the staff member, not a bookable service resource).
model StaffShiftPattern {
  id             String   @id @default(uuid())
  organizationId String
  membershipId   String
  weekday        Int // 0 = Sunday … 6 = Saturday (JS convention)
  startMinute    Int // minutes from midnight, org-local
  endMinute      Int
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership     Membership   @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([organizationId, membershipId, weekday])
  @@index([membershipId])
}

// NF11: leave request. paid = paid | unpaid. Status machine:
// pending → approved | rejected (decided rows never re-decide).
// Only APPROVED + unpaid days feed payroll deductions.
model LeaveRequest {
  id             String    @id @default(uuid())
  organizationId String
  membershipId   String
  fromDate       String // YYYY-MM-DD org-local
  toDate         String // YYYY-MM-DD org-local, >= fromDate
  days           Int // inclusive calendar days in [fromDate, toDate]
  paid           String // paid | unpaid
  reason         String?
  status         String    @default("pending") // pending | approved | rejected
  decidedBy      String?
  decidedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership     Membership   @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([organizationId, membershipId])
}

// NF11: one payroll run per org per (year, month). status:
// draft | paid. A PAID run is immutable. ruleSnapshot stores
// the exact rules + org inputs used, shown verbatim.
model PayrollRun {
  id             String    @id @default(uuid())
  organizationId String
  year           Int
  month          Int // 1-12
  status         String    @default("draft") // draft | paid
  ruleSnapshot   Json
  totalMinor     BigInt    @default(0)
  createdBy      String?
  paidBy         String?
  paidAt         DateTime?
  journalEntryId String? // NF10 JournalEntry posted on mark-paid (null = none / zero total)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lines          PayrollLine[]

  @@unique([organizationId, year, month])
  @@index([organizationId, status])
}

// NF11: one calculated line per member in a run. totalMinor =
// baseMinor − deductionMinor + commissionMinor + Σ adjustments
// (adjustment amounts are signed). The payslip is generated
// FROM this stored line — never recomputed differently.
model PayrollLine {
  id               String  @id @default(uuid())
  runId            String
  organizationId   String
  membershipId     String
  baseMinor        BigInt  @default(0)
  unpaidLeaveDays  Int     @default(0)
  deductionMinor   BigInt  @default(0)
  commissionMinor  BigInt  @default(0)
  adjustments      Json? // [{ label, amountMinor (string, signed), note }]
  totalMinor       BigInt  @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  run              PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  membership       Membership   @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([runId, membershipId])
  @@index([organizationId, membershipId])
}

// NF13 (FB5): Platform Fraud Network — PRIVACY IS THE PRODUCT.
// Opt-in is per-org and OWNER-only (service-enforced). The ONLY
// thing that ever crosses orgs is an HMAC-SHA256 hash of a phone
// number plus aggregate counters — never a raw phone, never a
// name, order detail or message. FraudNetworkPhoneStat is the
// shared aggregate: it carries NO org id and NO raw phone, keyed
// only by phoneHash. FraudNetworkContribution is the org-side
// ledger (hash only too) that makes contribution exactly-once
// per (organizationId, orderId) and lets contributingOrgCount
// count DISTINCT orgs per phone. Past contributions already
// merged into the aggregates cannot be removed — disabling only
// stops future contributions (stated verbatim in the UI).
model FraudNetworkSetting {
  id             String    @id @default(uuid())
  organizationId String    @unique
  enabled        Boolean   @default(false)
  enabledAt      DateTime?
  enabledById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// NF13: shared aggregate per phone hash. NO other fields —
// deliberately no organizationId, no raw phone, no timestamps
// beyond updatedAt.
model FraudNetworkPhoneStat {
  phoneHash             String   @id
  contributingOrgCount  Int      @default(0)
  deliveredCount        Int      @default(0)
  returnedFailedCount   Int      @default(0)
  codRefusalCount       Int      @default(0)
  updatedAt             DateTime @updatedAt
}

// NF13: org-side contribution ledger. Stores the HASH only —
// never a raw phone. outcome is the risk-score classifyOutcome
// vocabulary (delivered | returned | refunded |
// cancelledOrFailed).
model FraudNetworkContribution {
  id             String   @id @default(uuid())
  organizationId String
  orderId        String
  phoneHash      String
  outcome        String
  createdAt      DateTime @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, orderId])
  @@index([organizationId, phoneHash])
}

// NF15 (FB5): Agency / reseller console — commission RECORDS only.
// There is NO agency entity: an "agency" is simply a user with
// memberships in multiple orgs. An entry records that the agency
// org (agencyOrganizationId) earned commission from a client org
// (clientOrganizationId) for a period. Recording an entry moves
// NO money — no wallet is touched and no payout is executed;
// payouts remain behind the OU11 legal gate. amountMinor is
// BIGINT minor units (paisa), serialised as string in payloads.
model AgencyCommissionEntry {
  id                   String   @id @default(uuid())
  agencyOrganizationId String
  clientOrganizationId String
  periodLabel          String
  amountMinor          BigInt
  note                 String?
  recordedById         String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  agencyOrganization   Organization @relation("AgencyCommissionAgency", fields: [agencyOrganizationId], references: [id], onDelete: Cascade)
  clientOrganization   Organization @relation("AgencyCommissionClient", fields: [clientOrganizationId], references: [id], onDelete: Cascade)

  @@index([agencyOrganizationId, createdAt])
  @@index([clientOrganizationId])
}
