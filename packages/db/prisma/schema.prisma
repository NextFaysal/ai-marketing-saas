// Milestone 1 foundation schema.
// Money is always integer minor units or Decimal - never Float.
// Every tenant-owned model carries organizationId and is indexed on it.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  OWNER
  ADMIN
  MARKETING_MANAGER
  ADVERTISER
  SUPPORT_AGENT
  ANALYST
  VIEWER
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum SubscriptionPlan {
  FREE
  STARTER
  GROWTH
  AGENCY
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  referralCode String?  @unique
  name         String
  passwordHash String
  isSuperAdmin Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  memberships  Membership[]
  auditLogs    AuditLog[]
  status              String    @default("ACTIVE") // ACTIVE | SUSPENDED | DELETED
  adminTier           String? // SUPER | SUPPORT | FINANCE (null = not an admin even if flag legacy)
  lastLoginAt         DateTime?
  tokenVersion        Int       @default(0)
  totpSecretEncrypted String?
  totpEnabled         Boolean   @default(false)
}

model Organization {
  id             String          @id @default(uuid())
  name           String
  slug           String          @unique
  country        String          @default("BD")
  creditMinor    BigInt          @default(0)
  attributionWindowDays Int       @default(30)
  timezone       String          @default("Asia/Dhaka")
  currency       String          @default("BDT")
  // Milestone 59 (Agency White-Label v1): per-org branding.
  // All additive + nullable; absence means the platform defaults.
  brandName       String?
  logoUrl         String?
  logoContentType String?
  primaryColor    String?
  customDomain    String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  memberships    Membership[]
  businessProfile BusinessProfile?
  subscriptions  Subscription[]
  usageRecords   UsageRecord[]
  auditLogs      AuditLog[]
  products       Product[]
  policies       BusinessPolicy[]
  importJobs     ImportJob[]
  knowledgeDocs  KnowledgeDocument[]
  stores         Store[]
  integrations   Integration[]
  storeListings  StoreListing[]
  syncOutbox     SyncOutbox[]
  syncConflicts  SyncConflict[]
  categories     Category[]
  productTags    ProductTag[]
  taxonomyMaps   StoreTaxonomyMap[]
  storeLocations StoreLocation[]
  bundleItems    BundleItem[]
  fulfillments   Fulfillment[]
  returnRequests ReturnRequest[]
  customerStoreIdentities CustomerStoreIdentity[]
  storeDiscounts          StoreDiscount[]
  abandonedStoreCheckouts AbandonedStoreCheckout[]
  storefrontSetting StorefrontSetting?
  shippingZones     ShippingZone[]
  storeCarts        StoreCart[]
  customers      Customer[]
  orders         Order[]
  visitors       Visitor[]
  trackingEvents TrackingEvent[]
  touchpoints    Touchpoint[]
  adAccounts     AdAccount[]
  socialAccounts SocialAccount[]
  socialPosts    SocialPost[]
  mediaAssets    MediaAsset[]
  dailyAdMetrics DailyAdMetric[]
  dailyAggregates DailyMetricAggregate[]
  aiConversations AIConversation[]
  aiReports      AIReport[]
  aiActions      AIAction[]
  aiActionProposals AIActionProposal[]
  aiProactiveSetting AIProactiveSetting?
  assistantApiKeys   AssistantApiKey[]
  aiUsageRecords AIUsageRecord[]
  channelConversations ChannelConversation[]
  leads          Lead[]
  customFieldDefs CustomFieldDef[]
  competitors    Competitor[]
  competitorInsights CompetitorInsight[]
  campaignPlans  CampaignPlan[]
  messageTemplates MessageTemplate[]
  broadcasts     Broadcast[]
  messagingSavedAudiences MessagingSavedAudience[]
  workflows      Workflow[]
  scheduledJobs  ScheduledJob[]
  automationRules AutomationRule[]
  automationRuns AutomationRun[]
  status                String @default("ACTIVE") // ACTIVE | SUSPENDED | DELETED
  aiDailyLimitOverride  Int?
  broadcastCapOverride  Int?
  seatLimit             Int?
  // SP7: when true, social posts by non-OWNER/ADMIN members need
  // OWNER/ADMIN approval before they can be scheduled/published.
  socialRequireApproval Boolean @default(false)
  // CX12a: Practice Mode — while true, the org can rehearse the
  // full AI reply + order flow on practice conversations/orders;
  // nothing practice-flagged ever reaches a real customer (the
  // send guard lives at InboxService.deliverText + courier
  // booking). Default false = pre-CX12a behaviour.
  practiceMode          Boolean @default(false)
}

model Membership {
  id             String           @id @default(uuid())
  userId         String
  organizationId String
  role           Role             @default(VIEWER)
  status         MembershipStatus @default(ACTIVE)
  // Milestone 72 (Team W3): per-member custom access on top of
  // the role — { grants: string[], denies: string[] } of
  // permission-area keys (see common/permission-catalog.ts).
  // Null = no overrides. Never applies to the OWNER.
  permissionOverrides Json?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
}

model BusinessProfile {
  id              String       @id @default(uuid())
  organizationId  String       @unique
  description     String?
  industry        String?
  businessModel   String?
  websiteUrl      String?
  goals           String?
  targetCustomers Json?
  brandVoice      String?
  uniqueSellingPoints String?
  monthlyBudgetMinor BigInt?
  budgetCurrency  String       @default("BDT")
  contactEmail    String?
  contactPhone    String?
  // Milestone 75 (Business Command Center): the operational
  // layer the AI quotes daily — address, hours, delivery,
  // payments. Money is integer minor units (BigInt, matching
  // monthlyBudgetMinor). Null = not set; the AI must say it
  // does not know rather than invent a value.
  address         String?
  city            String?
  businessHours   Json?
  deliveryChargeInsideMinor  BigInt?
  deliveryChargeOutsideMinor BigInt?
  freeDeliveryAboveMinor     BigInt?
  deliveryDaysInside  Int?
  deliveryDaysOutside Int?
  codAvailable        Boolean?
  minOrderMinor       BigInt?
  bkashNumber         String?
  nagadNumber         String?
  paymentNote         String?
  advancePaymentPercent Int?
  returnWindowDays    Int?
  // Milestone 77 (Business Command Center): owner-set AI
  // behaviour. Instructions steer style/conduct only — they
  // can never override the verified-facts discipline.
  aiInstructions      String?
  // CX2 (AI Instructions Desk): the persistent DRAFT working copy.
  // Consumers keep reading aiInstructions (the published text) only;
  // the draft reaches customers solely through an explicit publish.
  aiInstructionsDraft String?
  aiReplyLanguage     String?
  // Billing Package B5: who receives invoices/reminders
  // (up to 3 extra emails) + the buyer block on invoices.
  billingEmails       Json?
  billingAddress      String?
  billingBin          String?
  // SaaS Multi-Tenant Merchant Growth Settings
  metaPixelId         String?      // Merchant's Facebook Pixel ID
  metaCapiToken       String?      // Merchant's Conversions API Token
  tikTokPixelId       String?      // Merchant's TikTok Pixel ID
  customDomain        String?      // e.g. "shop.leatherbrand.com"
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Subscription {
  id               String             @id @default(uuid())
  organizationId   String
  plan             SubscriptionPlan   @default(FREE)
  status           SubscriptionStatus @default(TRIALING)
  currentPeriodEnd DateTime?
  // Billing Package B2: a downgrade (or FREE = cancel)
  // scheduled for the period end; the sweep applies it.
  pendingPlan      String?
  pendingPlanAt    DateTime?
  // Billing Package B3: the cycle the current period was
  // bought on — drives renewal price + proration length.
  billingCycle     String             @default("monthly")
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model UsageRecord {
  id             String       @id @default(uuid())
  organizationId String
  metric         String
  quantity       Int          @default(1)
  recordedAt     DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, metric, recordedAt])
}

model AuditLog {
  id             String        @id @default(uuid())
  organizationId String?
  userId         String?
  action         String
  entityType     String
  entityId       String?
  metadata       Json?
  ipAddress      String?
  createdAt      DateTime      @default(now())
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
}

// ---------- Milestone 2: Business data ----------

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ImportJobStatus {
  PENDING
  COMPLETED
  FAILED
}

model Product {
  id             String        @id @default(uuid())
  organizationId String
  name           String
  slug           String?
  description    String?
  category       String?
  sku            String?
  status         ProductStatus @default(ACTIVE)
  // Selling price in integer minor units (e.g. poisha for BDT, cents for USD)
  priceMinor     BigInt
  compareAtMinor BigInt?
  currency       String        @default("BDT")
  stockQuantity  Int?
  // Sales & Data S1: per-product low-stock alert threshold.
  // Null = the platform default (5, see InventoryService).
  lowStockThreshold Int?
  imageUrl       String?
  source         String        @default("manual") // manual | csv | woocommerce | shopify
  externalId     String?
  // SaaS eCommerce Expansion: 1-Click Order Bump & Upsells
  bumpTitle      String?       // e.g. "লেদার কি-রিং ও স্পেশাল পলিশ যোগ করুন"
  bumpPriceMinor BigInt?       // e.g. 19000 (190 BDT)
  bumpImageUrl   String?
  // EC3: physical dimensions, barcode and SEO enrichment for
  // catalog write-back. All additive + nullable; the legacy
  // `category String?` display field above stays untouched —
  // `categoryId`/`categoryRef` is the structured taxonomy link.
  weightGrams    Int?
  lengthCm       Int?
  widthCm        Int?
  heightCm       Int?
  barcode        String?
  seoTitle       String?
  seoDescription String?
  categoryId     String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  categoryRef    Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants       ProductVariant[]
  costs          ProductCost[]
  listings       StoreListing[]
  images         ProductImage[]
  tagAssignments ProductTagAssignment[]
  bundleItems    BundleItem[]  @relation("BundleParent")
  bundleComponentIn BundleItem[] @relation("BundleComponent")
  storeCartItems StoreCartItem[]

  @@unique([organizationId, sku])
  @@index([organizationId, status])
  @@index([organizationId, category])
}

model ProductVariant {
  id            String  @id @default(uuid())
  productId     String
  name          String // e.g. "Red / XL"
  sku           String?
  priceMinor    BigInt?
  stockQuantity Int?
  attributes    Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  product       Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  storeCartItems StoreCartItem[]

  @@unique([productId, sku])
  @@index([productId])
}

model ProductCost {
  id             String   @id @default(uuid())
  productId      String
  variantId      String?
  // Unit cost in integer minor units, same currency as the product price
  costMinor      BigInt
  currency       String   @default("BDT")
  effectiveFrom  DateTime @default(now())
  note           String?
  createdAt      DateTime @default(now())
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, effectiveFrom])
}

// EC3: additional product gallery images. The legacy single
// `Product.imageUrl` stays as the primary/cover image; rows here
// are the ordered extra gallery.
model ProductImage {
  id        String   @id @default(uuid())
  productId String
  url       String
  altText   String?
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
}

// EC3: structured product taxonomy (tree). Replaces free-text
// categorisation for write-back; Product.category stays as the
// legacy display string.
model Category {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  slug           String
  parentId       String?
  description    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent         Category?    @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children       Category[]   @relation("CategoryTree")
  products       Product[]

  @@unique([organizationId, slug])
  @@index([organizationId, parentId])
}

// EC3: org-scoped product tags.
model ProductTag {
  id             String                 @id @default(uuid())
  organizationId String
  name           String
  slug           String
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignments    ProductTagAssignment[]

  @@unique([organizationId, slug])
}

// EC3: join row between Product and ProductTag.
model ProductTagAssignment {
  id        String     @id @default(uuid())
  productId String
  tagId     String
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag       ProductTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([productId, tagId])
  @@index([tagId])
}

model BusinessPolicy {
  id             String       @id @default(uuid())
  organizationId String
  // shipping | delivery | refund | return | cancellation | payment | custom
  type           String
  title          String
  content        String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, type])
}

model KnowledgeDocument {
  id             String       @id @default(uuid())
  organizationId String
  title          String
  content        String
  kind           String       @default("faq") // faq | note | claim | template
  source         String       @default("paste") // paste | file:<original filename> (CX9)
  // Owner CX9 variant: chunked file-ingestion tracking (his series)
  sourceFile     String?
  chunkIndex     Int?
  totalChunks    Int?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, kind])
}

model ImportJob {
  id             String          @id @default(uuid())
  organizationId String
  kind           String          @default("products") // products (orders in a later milestone)
  status         ImportJobStatus @default(PENDING)
  fileName       String?
  totalRows      Int             @default(0)
  successRows    Int             @default(0)
  failedRows     Int             @default(0)
  skippedRows    Int             @default(0)
  errors         Json?
  createdById    String?
  createdAt      DateTime        @default(now())
  completedAt    DateTime?
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

// ---------- Milestone 3: Stores, integrations, ecommerce ----------

enum StorePlatform {
  WOOCOMMERCE
  SHOPIFY
  CUSTOM
}

enum IntegrationStatus {
  CONNECTED
  DISCONNECTED
  ERROR
}

enum SyncJobStatus {
  RUNNING
  COMPLETED
  FAILED
}

model Store {
  id             String        @id @default(uuid())
  organizationId String
  platform       StorePlatform @default(WOOCOMMERCE)
  name           String
  url            String
  currency       String        @default("BDT")
  timezone       String        @default("Asia/Dhaka")
  isActive       Boolean       @default(true)
  trackingKey    String?       @unique // public key used by tracker.js, not a secret
  // EC1: how much control the SaaS has over this store.
  // mirror = inbound only (the pre-EC1 behaviour, default for every
  // existing store) | co-manage = order-side pushes | full-manage =
  // catalog/price/stock pushes too. Changing it is OWNER/ADMIN-only
  // and audit-logged (see CommerceService.updateSyncMode).
  syncMode       String        @default("mirror")
  // EC1: optional per-field source-of-truth overrides, e.g.
  // { "price": "saas", "stock": "saas", "description": "store" }.
  // Null = the sync mode's defaults. Read by EC3 conflict logic.
  fieldOwnership Json?
  // EC5: refund push to the store platform is a money-adjacent
  // capability — DEFAULT OFF (plan §9 owner decision). Only when an
  // OWNER turns this on does recording a refund locally enqueue a
  // platform refund. Default false is part of the safety contract.
  refundPushEnabled Boolean @default(false)
  // EC5: name of the meta_data key the store's shipment/tracking
  // plugin reads (e.g. an AST-style plugin). Null = only the generic
  // tracking_provider/tracking_number meta keys + customer note.
  courierTrackingMetaKey String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  integrations   Integration[]
  orders         Order[]
  listings       StoreListing[]
  locations      StoreLocation[]
  taxonomyMaps   StoreTaxonomyMap[]
  customerIdentities CustomerStoreIdentity[]
  discountSyncs      StoreDiscountSync[]
  abandonedCheckouts AbandonedStoreCheckout[]

  @@index([organizationId])
}

model Integration {
  id             String            @id @default(uuid())
  organizationId String
  storeId        String?
  provider       String // woocommerce | meta | google_ads | tiktok | whatsapp
  status         IntegrationStatus @default(DISCONNECTED)
  externalAccountId String?
  lastSyncAt     DateTime?
  productsCursor DateTime?
  ordersCursor   DateTime?
  lastError      String?
  // EC2: last webhook registration/subscription attempt, recorded
  // verbatim per topic ({ provider, topics: {topic: {status, error?}},
  // updatedAt }). This is a RECORD of an attempt — a topic counts as
  // registered only when its status says so; never inferred.
  webhookStatus  Json?
  // EC2: how this integration authenticated. Null = the pre-EC2
  // legacy token path (Woo keys / Shopify shpat_ token).
  // "client_credentials" = Shopify Dev Dashboard grant (token
  // expires; tokenExpiresAt drives the refresh in ShopifyService).
  authType       String?
  tokenExpiresAt DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  store          Store?            @relation(fields: [storeId], references: [id], onDelete: SetNull)
  credential     IntegrationCredential?
  syncJobs       SyncJob[]
  webhookEvents  WebhookEvent[]

  @@index([organizationId, provider])
  @@index([storeId])
}

// Secrets are stored ONLY as AES-256-GCM ciphertext (see integrations/crypto.ts).
// Plaintext consumer keys/secrets never touch the database or API responses.
model IntegrationCredential {
  id            String      @id @default(uuid())
  integrationId String      @unique
  encryptedData String // JSON payload, encrypted
  keyVersion    Int         @default(1)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
}

// EC12: one WooCommerce wc-auth (1-click connect) attempt.
// A dedicated model — NOT a reuse of SocialOAuthState, which is
// typed for social platforms (platform/purpose/payload) and whose
// lifecycle differs. Binding to the Woo callback: Woo's
// /wc-auth/v1/authorize takes `user_id`, which Woo echoes back
// verbatim in the callback POST as `user_id`; we set user_id =
// this row's id (uuid), so the callback is tied to the attempt by
// id + expiry + not-consumed + storeUrl snapshot match. Woo does
// not round-trip arbitrary state params reliably, so the random
// `state` column is only appended to the return_url (for the
// browser's benefit) and is NEVER relied on for verification.
model WcAuthAttempt {
  id             String    @id @default(uuid())
  organizationId String
  userId         String // staff user who started the flow
  storeId        String
  storeUrl       String // snapshot of Store.url at start
  state          String    @unique // random single-use token (return_url only, see above)
  status         String    @default("pending") // pending | consumed | failed
  failureReason  String?
  expiresAt      DateTime
  consumedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([organizationId])
  @@index([expiresAt])
}

model SyncJob {
  id            String        @id @default(uuid())
  integrationId String
  kind          String // products | orders
  status        SyncJobStatus @default(RUNNING)
  fetched       Int           @default(0)
  created       Int           @default(0)
  updated       Int           @default(0)
  skipped       Int           @default(0)
  error         String?
  startedAt     DateTime      @default(now())
  completedAt   DateTime?
  integration   Integration   @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([integrationId, startedAt])
}

model WebhookEvent {
  id            String      @id @default(uuid())
  integrationId String
  provider      String
  topic         String?
  deliveryId    String? // provider delivery id, used for deduplication
  payload       Json
  signatureValid Boolean    @default(false)
  processedAt   DateTime?
  error         String?
  receivedAt    DateTime    @default(now())
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, deliveryId])
  @@index([integrationId, receivedAt])
}

// EC1: one canonical Product's presence on one Store. The Product
// stays the merchant's master catalog row; the listing carries the
// per-store external id, channel overrides and the sync bookkeeping
// that makes two-way sync (EC3+) auditable instead of assumed.
model StoreListing {
  id                 String    @id @default(uuid())
  organizationId     String
  storeId            String
  productId          String
  externalId         String // product id in the store platform
  // Internal variant id -> the store's variant id, e.g.
  // { "<productVariantId>": "<externalVariantId>" }.
  externalVariantMap Json?
  publishState       String    @default("published") // draft | published | archived (platform wording is normalized at the adapter)
  channelPriceMinor  BigInt? // per-channel price override; null = canonical price
  channelStock       Int? // last known stock on this channel
  lastPushedHash     String? // content hash of what the SaaS last pushed (EC3+)
  lastRemoteHash     String? // content hash of what inbound sync last saw
  lastRemoteUpdatedAt DateTime?
  syncStatus         String    @default("synced") // synced | pending | failed | conflict
  lastSyncError      String?
  // EC3: per-listing sale window + push bookkeeping.
  saleStartsAt       DateTime?
  saleEndsAt         DateTime?
  saleActive         Boolean   @default(false)
  lastPushedAt       DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  store              Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product            Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  conflicts          SyncConflict[]

  @@unique([storeId, productId])
  @@index([organizationId, syncStatus])
  @@index([organizationId, storeId])
  @@index([storeId, externalId])
}

// EC3: maps a local Category/ProductTag (localId) to the id the
// store platform assigned it (externalId), per store, so catalog
// write-back reuses remote taxonomy instead of duplicating it.
model StoreTaxonomyMap {
  id             String       @id @default(uuid())
  organizationId String
  storeId        String
  kind           String // category | tag
  localId        String
  externalId     String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  store          Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, kind, localId])
  @@index([organizationId, storeId])
}

// EC4: a physical / platform location of a store (e.g. a Shopify
// location) that stock can be tracked against.
model StoreLocation {
  id                 String       @id @default(uuid())
  organizationId     String
  storeId            String
  name               String
  externalLocationId String?
  isDefault          Boolean      @default(false)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  store              Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, externalLocationId])
  @@index([organizationId, storeId])
}

// EC4: one component line of a bundle product. The parent product
// is sold as a bundle; stock/fulfilment expand through these rows.
model BundleItem {
  id                 String       @id @default(uuid())
  organizationId     String
  parentProductId    String
  componentProductId String
  componentVariantId String?
  quantity           Int          @default(1)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent             Product      @relation("BundleParent", fields: [parentProductId], references: [id], onDelete: Cascade)
  component          Product      @relation("BundleComponent", fields: [componentProductId], references: [id], onDelete: Cascade)

  @@unique([parentProductId, componentProductId, componentVariantId])
  @@index([organizationId, parentProductId])
}

// EC1: durable outbound work queue. Every future write to a store
// goes through a row here (same transaction as the local write), so
// a slow/dead store can never block or silently lose a change.
// Processing is done by SyncOutboxService via the CommerceAdapter
// registry; an operation an adapter does not implement is recorded
// as failed with the verbatim reason "capability_not_implemented" —
// never as done.
model SyncOutbox {
  id             String    @id @default(uuid())
  organizationId String
  storeId        String
  entityType     String // product | order | customer | discount | webhook | ...
  entityId       String
  operation      String // push_product | push_inventory | register_webhooks | ...
  payload        Json
  payloadHash    String
  idempotencyKey String    @unique
  status         String    @default("pending") // pending | processing | done | failed | dead
  attempts       Int       @default(0)
  nextRetryAt    DateTime?
  lastError      String?
  responseSummary Json? // verbatim-ish summary of the platform response on success/failure
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status, nextRetryAt])
  @@index([organizationId, storeId, status])
}

// EC1: a field whose local and remote values diverged while a local
// change was still unpushed. B1 ships the model + list endpoint
// only; creating/resolving conflicts lands with EC3's write-back.
model SyncConflict {
  id             String    @id @default(uuid())
  organizationId String
  storeId        String
  listingId      String
  field          String
  localValue     Json?
  remoteValue    Json?
  status         String    @default("open") // open | resolved
  resolution     String? // local_wins | remote_wins (set by EC3 resolution)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  listing        StoreListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([listingId])
}

model Customer {
  id             String       @id @default(uuid())
  organizationId String
  externalId     String? // id in the source store, when available
  source         String       @default("woocommerce")
  firstName      String?
  lastName       String?
  email          String?
  phone          String?
  address        Json?
  // CRM C4: values for the org's CustomFieldDefs (entity
  // "customer"), keyed by def.key. Validated server-side.
  customFields   Json?
  // CX10: opt-out unsubscribe flag
  unsubscribed   Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orders         Order[]
  storeIdentities CustomerStoreIdentity[]

  // Set when this record was merged into another customer.
  mergedIntoId String?
  @@index([organizationId, email])
  @@index([organizationId, phone])
  @@index([organizationId, externalId])
}

/// IN2: the reversible record of one customer merge. The pre-IN2
/// merge (CustomersService.merge) moved orders + conversations to
/// the survivor and marked the source with mergedIntoId, but kept
/// only counts in the audit metadata — a merge could never be
/// undone because nobody knew WHICH rows had moved or which
/// survivor fields were gap-filled from the source. This record
/// stores exactly that: the moved row ids and, per gap-filled
/// field, the survivor's pre-merge value + the value filled in.
/// Unmerge moves back only rows still pointing at the survivor
/// and restores a filled field only when it still holds the
/// filled value (a later human edit is never clobbered).
/// revertedAt/revertedByUserId stamp the unmerge; a reverted
/// record is final (the same merge is never reverted twice).
model CustomerMergeRecord {
  id                     String    @id @default(uuid())
  organizationId         String
  sourceCustomerId       String
  targetCustomerId       String
  movedOrderIds          Json
  movedConversationIds   Json
  filledFields           Json
  createdByUserId        String
  createdAt              DateTime  @default(now())
  revertedAt             DateTime?
  revertedByUserId       String?

  @@index([organizationId, sourceCustomerId])
  @@index([organizationId, targetCustomerId])
}

model Order {
  id             String       @id @default(uuid())
  organizationId String
  storeId        String?
  customerId     String?
  externalId     String // order id in the source store
  externalNumber String? // human-facing order number
  source         String       @default("woocommerce")
  status         String // raw platform status, e.g. processing, completed, cancelled, refunded
  paymentMethod  String? // e.g. cod, bacs, sslcommerz
  isCod          Boolean      @default(false)
  // Chat-based COD confirmation: awaiting -> confirmed | declined,
  // driven by the customer's actual reply in the linked conversation.
  codConfirmationStatus String?
  codConfirmationSentAt DateTime?
  codConversationId     String?
  // For orders created from chat: how the store sync went.
  storeSyncStatus String? // synced | failed | local_only
  storeSyncError  String?
  // EC5: when this (chat/manual) order was turned into a store draft
  // order, the platform draft id + the customer-payable invoice URL
  // (Shopify draftOrderCreate; Woo draft = a pending order, so its id
  // lands in externalId and storeDraftId stays null there).
  storeDraftId    String?
  storeInvoiceUrl String?
  // Conversation this order was created from (chat / bot orders), so
  // courier updates can be sent back into the same thread.
  conversationId  String?
  // CX12a: practice order — created from a practice conversation.
  // Excluded from order lists / stats / analytics by default and
  // refused by courier booking; deleted by practice cleanup.
  isPractice      Boolean @default(false)
  // Unified Inbox U3: delivery address captured in chat (bot v2 /
  // chat orders); previously it lived only in an internal note.
  address         String?
  // Sales & Data S2: merchant-only internal note on the order
  // (staff context; never sent to the customer or any platform).
  internalNote   String?
  currency       String       @default("BDT")
  subtotalMinor  BigInt       @default(0)
  shippingMinor  BigInt       @default(0)
  discountMinor  BigInt       @default(0)
  taxMinor       BigInt       @default(0)
  totalMinor     BigInt       @default(0)
  refundedMinor  BigInt       @default(0)
  placedAt       DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  store          Store?       @relation(fields: [storeId], references: [id], onDelete: SetNull)
  customer       Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items          OrderItem[]
  packingScans   PackingScanLog[]
  fulfillments   Fulfillment[]
  returnRequests ReturnRequest[]

  @@unique([organizationId, source, externalId])
  @@index([organizationId, status])
  @@index([organizationId, placedAt])
}

model OrderItem {
  id          String  @id @default(uuid())
  orderId     String
  productId   String? // linked internal product when a reliable match exists
  externalProductId String?
  externalVariationId String?
  name        String
  sku         String?
  quantity    Int
  priceMinor  BigInt  @default(0)
  totalMinor  BigInt  @default(0)
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([productId])
}

// ---------- Milestone 4: Tracking & attribution ----------
// First-party, consent-aware tracking. Identifiers are pseudonymous:
// anonymousId is a random browser id, never a name/email by itself.

// EC9: a fulfilment of (part of) an order. items is a JSON list of
// { orderItemId, quantity, packed? } — partial fulfilment is the
// norm, remaining quantities are computed on read from the order's
// items minus all non-cancelled fulfilments. courierShipmentId links
// the CourierShipment booked for this parcel when one exists.
model Fulfillment {
  id                String       @id @default(uuid())
  organizationId    String
  orderId           String
  status            String       @default("pending") // pending | packed | handed_over | in_transit | delivered | returned | cancelled
  courierShipmentId String?
  courierProvider   String?
  trackingCode      String?
  items             Json
  createdById       String?
  // EC9: set once the create_fulfillment store push for this
  // fulfilment has been enqueued, so re-saving never double-pushes.
  storePushEnqueuedAt DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  order             Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([organizationId, orderId])
  @@index([organizationId, status, createdAt])
}

// EC9: a customer return request (RMA). The public page is reached
// only via the unguessable token minted when staff share the link.
// resolution "store_credit_note" is a RECORD ONLY — no money
// instrument exists or is created (tenant money features stay
// postponed). restockAppliedAt is the exactly-once marker for the
// S1 inventory restore on completion.
model ReturnRequest {
  id                String       @id @default(uuid())
  organizationId    String
  orderId           String
  customerId        String?
  status            String       @default("requested") // requested | approved | rejected | return_shipped | received | completed
  reason            String?
  items             Json? // [{ orderItemId, quantity, condition? }]
  resolution        String? // refund | exchange | store_credit_note
  refundAmountMinor BigInt?
  restockDecision   String       @default("pending") // pending | restock | discard
  staffNote         String?
  token             String       @unique
  returnShipmentId  String? // CourierShipment booked for the return parcel
  exchangeOrderId   String? // manual order created on exchange completion
  restockAppliedAt  DateTime?
  notificationStatus String? // sent_inbox | sent_email | not_sent_no_channel | failed
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  order             Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([organizationId, orderId])
  @@index([organizationId, status, createdAt])
}

model Visitor {
  id             String           @id @default(uuid())
  organizationId String
  anonymousId    String
  email          String?
  phone          String?
  firstSeenAt    DateTime         @default(now())
  lastSeenAt     DateTime         @default(now())
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sessions       TrackingSession[]
  events         TrackingEvent[]
  touchpoints    Touchpoint[]

  @@unique([organizationId, anonymousId])
  @@index([organizationId, lastSeenAt])
}

model TrackingSession {
  id            String       @id @default(uuid())
  organizationId String
  visitorId     String
  sessionKey    String // id generated by tracker.js for this visit session
  landingPage   String?
  referrer      String?
  utmSource     String?
  utmMedium     String?
  utmCampaign   String?
  utmContent    String?
  utmTerm       String?
  fbclid        String?
  gclid         String?
  ttclid        String?
  startedAt     DateTime     @default(now())
  lastActivityAt DateTime    @default(now())
  visitor       Visitor      @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  touchpoint    Touchpoint?

  @@unique([organizationId, sessionKey])
  @@index([visitorId])
}

model Touchpoint {
  id             String          @id @default(uuid())
  organizationId String
  visitorId      String
  sessionId      String?         @unique
  source         String          @default("direct") // utm_source or platform, "direct" when none
  medium         String?
  campaign       String?
  content        String?
  term           String?
  clickIdType    String? // fbclid | gclid | ttclid
  clickId        String?
  landingPage    String?
  referrer       String?
  isDirect       Boolean         @default(true)
  occurredAt     DateTime        @default(now())
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  visitor        Visitor         @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  session        TrackingSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  credits        AttributionCredit[]

  @@index([organizationId, visitorId, occurredAt])
  @@index([organizationId, source, campaign])
}

model TrackingEvent {
  id              String       @id @default(uuid())
  organizationId  String
  storeId         String?
  visitorId       String?
  sessionKey      String?
  clientEventId   String // idempotency key generated by tracker.js per event
  type            String // page_view | product_view | add_to_cart | checkout_started | lead | purchase | refund | custom
  url             String?
  referrer        String?
  properties      Json?
  orderExternalId String?
  orderId         String?
  valueMinor      BigInt?
  currency        String?
  occurredAt      DateTime
  receivedAt      DateTime     @default(now())
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  visitor         Visitor?     @relation(fields: [visitorId], references: [id], onDelete: SetNull)

  @@unique([organizationId, clientEventId])
  @@index([organizationId, type, occurredAt])
  @@index([organizationId, orderExternalId])
}

enum AttributionModel {
  FIRST_TOUCH
  LAST_TOUCH
  LAST_NON_DIRECT
  LINEAR
}

model AttributionCredit {
  id            String           @id @default(uuid())
  organizationId String
  orderId       String
  model         AttributionModel
  touchpointId  String? // null = unattributed credit row
  revenueMinor  BigInt // allocated revenue for this touchpoint under this model
  createdAt     DateTime         @default(now())
  touchpoint    Touchpoint?      @relation(fields: [touchpointId], references: [id], onDelete: SetNull)

  @@index([organizationId, model])
  @@index([orderId, model])
  @@index([touchpointId])
}

// ---------- Milestone 5: Advertising analytics & profit ----------

model AdAccount {
  id             String       @id @default(uuid())
  organizationId String
  integrationId  String?
  platform       String // meta | google | tiktok | manual
  sourceType     String       @default("api") // api | csv | manual
  externalId     String? // e.g. act_123456789 for Meta
  name           String
  currency       String       @default("BDT")
  status         String       @default("ACTIVE")
  // AD3: the platform's own account status, captured at connect and
  // via refresh-status. platformStatusRaw is the platform's verbatim
  // value (Meta numeric code as string, Google/TikTok status string);
  // platformStatusBucket is the normalized active|disabled|restricted|
  // unknown. Both stay null when the platform reports no status —
  // never guessed. timezone is the account's platform-reported
  // timezone (informational in v1).
  platformStatusRaw       String?
  platformStatusBucket    String?
  timezone                String?
  platformStatusCheckedAt DateTime?
  // AD4: per-account spend watchdog — ALERTING ONLY (no platform kill
  // switch is held at account level, and v1 builds no enforcement).
  // dailyCapMinor is an alert threshold in the account's own currency
  // minor units; anomalyPct alerts when today's spend reaches the
  // trailing complete-day average × (1 + pct/100); null = off.
  spendWatchEnabled Boolean  @default(false)
  dailyCapMinor     BigInt?
  anomalyPct        Int?
  // AD5: per-account sync switch. When true, every platform-data
  // sync path for this account (manual insights/breakdown/status
  // sync + the scheduled insights jobs) refuses/skips — publishing
  // is a different concern and is NOT affected by this flag.
  syncDisabled      Boolean  @default(false)
  // AD6: tenant-chosen display label (free text; trimmed and capped
  // at 60 chars service-side). NULL/empty = show the platform name.
  label             String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaigns      AdCampaign[]
  metrics        DailyAdMetric[]

  @@unique([organizationId, platform, externalId])
  @@index([organizationId, platform])
}

model AdCampaign {
  id          String       @id @default(uuid())
  organizationId String
  adAccountId String
  externalId  String
  name        String
  objective   String?
  status      String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  adAccount   AdAccount    @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
  metrics     DailyAdMetric[]

  @@unique([adAccountId, externalId])
  @@index([organizationId])
}

// One row per account + campaign + day + source.
// campaignExternalId is "" (never null) for account-level/manual rows so the
// unique constraint can deduplicate them in Postgres.
model DailyAdMetric {
  id                   String      @id @default(uuid())
  organizationId       String
  adAccountId          String
  adCampaignId         String?
  platform             String
  source               String // api | csv | manual
  campaignExternalId   String      @default("")
  // Ad-level rows (Phase G): empty for campaign-level rows.
  adSetExternalId      String      @default("")
  adSetName            String?
  adExternalId         String      @default("")
  adName               String?
  reach                Int         @default(0)
  videoViews           Int         @default(0)
  campaignName         String?
  date                 DateTime // UTC midnight of the reporting day
  currency             String      @default("BDT")
  spendMinor           BigInt      @default(0)
  impressions          Int         @default(0)
  clicks               Int         @default(0)
  // Platform-reported conversions. Kept strictly separate from the SaaS's
  // own tracked conversions (attribution credits); they will not match.
  platformConversions  Int         @default(0)
  platformConversionValueMinor BigInt @default(0)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  adAccount            AdAccount   @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
  adCampaign           AdCampaign? @relation(fields: [adCampaignId], references: [id], onDelete: SetNull)

  @@unique([organizationId, adAccountId, campaignExternalId, adSetExternalId, adExternalId, date, source])
  @@index([organizationId, date])
  @@index([organizationId, platform, date])
}

model DailyMetricAggregate {
  id              String       @id @default(uuid())
  organizationId  String
  date            DateTime // UTC midnight
  orders          Int          @default(0)
  revenueMinor    BigInt       @default(0) // revenue-bearing orders (excl. cancelled/refunded/failed)
  refundedMinor   BigInt       @default(0)
  cogsMinor       BigInt       @default(0) // estimated from known product costs
  cogsKnownOrders Int          @default(0) // orders where every item had a known cost
  adSpendMinor    BigInt       @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, date])
  @@index([organizationId, date])
}

// ---------- Milestone 6: AI intelligence ----------

model AIConversation {
  id             String      @id @default(uuid())
  organizationId String
  userId         String
  title          String?
  // AP7: specialist persona for this conversation (general |
  // ads_analyst | inbox_coach | finance_analyst). Scopes the tool
  // modules the assistant may use; enforced server-side.
  persona        String      @default("general")
  // Milestone 45: pinned conversations sort first in the assistant.
  pinnedAt       DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messages       AIMessage[]

  @@index([organizationId, userId, updatedAt])
}

model AIMessage {
  id             String         @id @default(uuid())
  conversationId String
  role           String // user | assistant
  content        String
  // Tool calls that produced this assistant message, for transparency.
  toolCalls      Json?
  // AP2: a file/image the user attached to THIS message. The text is
  // the server-extracted content (documents) or the vision model's
  // description (images), capped at 12,000 chars, so the bubble can
  // show exactly what the assistant was given — citations stay
  // honest after a reload. Null for ordinary messages.
  attachmentName String?
  attachmentKind String? // file | image
  attachmentText String?
  createdAt      DateTime       @default(now())
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// GV3 (Global Assistant v2, G4): a user's saved chat prompts for the
// "/" picker. Per-user by design (org-shared prompts would need a
// sharing policy — deferred). Scalar org/user ids like
// AgentNotification; every query is scoped to both.
model AiSavedPrompt {
  id             String   @id @default(uuid())
  organizationId String
  userId         String
  title          String
  body           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, userId, updatedAt])
}

// Every AI tool execution is logged here (who, which org, what tool,
// sanitized args, status). This is the audit trail for AI actions.
model AIAction {
  id             String       @id @default(uuid())
  organizationId String
  userId         String?
  conversationId String?
  toolName       String
  args           Json?
  status         String // success | error | denied
  error          String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

// Milestone 47: write actions proposed by the AI assistant. A proposal
// NEVER executes on creation — a human must approve it, and execution
// goes through the existing confirmed service paths. The full
// lifecycle (proposed/approved/rejected/executed/failed) is stored so
// a platform failure is recorded as failure, never as success.
model AIActionProposal {
  id               String    @id @default(uuid())
  organizationId   String
  userId           String // proposer
  conversationId   String?
  recommendationId String?
  type             String // pause_campaign | pause_ad_set | create_broadcast_draft
  title            String
  preview          String // exact human-readable statement of what approval will do
  payload          Json // server-validated arguments (ids / draft fields)
  status           String    @default("proposed") // proposed | approved | rejected | executed | failed
  decidedById      String?
  decidedAt        DateTime?
  executedAt       DateTime?
  result           Json?
  error            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
}

model AIReport {
  id             String       @id @default(uuid())
  organizationId String
  type           String // daily | weekly | monthly
  periodStart    DateTime
  periodEnd      DateTime
  title          String
  content        String // rendered report text (markdown)
  structured     Json? // sections, evidence, metrics snapshot used
  provider       String // openai | anthropic | gemini | dev-template
  model          String?
  version        Int          @default(1)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recommendations AIRecommendation[]

  @@unique([organizationId, type, periodStart, periodEnd])
  @@index([organizationId, createdAt])
}

model AIRecommendation {
  id             String   @id @default(uuid())
  organizationId String
  reportId       String?
  title          String
  detail         String?
  priority       String   @default("medium") // low | medium | high
  status         String   @default("open") // open | done | dismissed
  evidence       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  report         AIReport? @relation(fields: [reportId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
}

model AIUsageRecord {
  id             String       @id @default(uuid())
  organizationId String
  userId         String?
  feature        String // chat | report
  provider       String
  model          String?
  inputTokens    Int          @default(0)
  outputTokens   Int          @default(0)
  estimated      Boolean      @default(false) // true when token counts are estimates (dev adapter)
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

// Milestone 48: per-org proactive assistant switches. Absence of a row
// means the defaults (briefing on, anomaly alerts on).
model AIProactiveSetting {
  id                   String     @id @default(uuid())
  organizationId       String     @unique
  briefingEnabled      Boolean    @default(true)
  anomalyAlertsEnabled Boolean    @default(true)
  // CX12b (12e completion): also email the daily briefing to
  // OWNER/ADMIN members. Default OFF; the in-app notification
  // remains the primary path and email is only a copy.
  dailyReportEmailEnabled Boolean @default(false)
  // AP6: also send the daily briefing to a Telegram chat through
  // the org's connected Telegram bot integration. Default OFF;
  // needs telegramBriefChatId (the owner's chat id) + a connected
  // telegram integration, else the copy is honestly skipped.
  telegramBriefEnabled Boolean    @default(false)
  telegramBriefChatId  String?
  // AP7: autonomy level (0 = approve everything, default;
  // 2 = auto-execute internal-only proposal types) and the
  // per-tenant assistant display name (white-label identity).
  autonomyLevel        Int        @default(0)
  assistantName        String?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// ---------- Milestone 7: unified inbox + leads/CRM ----------

// AP7: org-scoped Assistant API keys. Only the SHA-256 hash is
// stored; the plaintext key is shown exactly once at creation.
model AssistantApiKey {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  keyPrefix      String
  keyHash        String    @unique
  createdById    String
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

model ChannelConversation {
  id             String   @id @default(uuid())
  organizationId String
  integrationId  String?
  channel        String // whatsapp | messenger
  // Who the customer is on the platform: WhatsApp wa_id (phone) or
  // Messenger PSID. Unique per (organization, channel).
  externalContactId String
  contactName    String?
  contactPhone   String?
  customerId     String?
  leadId         String?
  status         String   @default("open") // open | pending | closed
  assignedUserId String?
  teamId         String?
  // Unified Inbox U3: autopilot paused for this conversation after
  // an escalation (human ask, complaint, dispute, high value...).
  // A human reply resumes it.
  autoReplyPaused Boolean @default(false)
  // CX3: wait-before-answering (debounce). When an AI reply is
  // deferred, autoReplyDueAt is when the sweep may fire it and
  // autoReplyBatchSince marks the start of the message batch the
  // reply must cover. Both null = no pending deferred reply.
  autoReplyDueAt DateTime?
  autoReplyBatchSince DateTime?
  // CX4: handover queue — the escalation reason and when the
  // handover started (waiting clock), written by escalateAutopilot
  // alongside autoReplyPaused. Null on pre-CX4 / never-escalated
  // rows; the queue UI falls back to updatedAt for those.
  handoverReason String?
  handoverAt     DateTime?
  // CX4: timed assignment — assignedAt is when the current
  // assignment started (the sweep's "replied since assignment"
  // reference), assignedUntil the timer deadline and
  // assignmentKind "timed" | "normal" (null when unassigned).
  assignedUntil  DateTime?
  assignmentKind String?
  assignedAt     DateTime?
  // CX5: snooze — the conversation is parked until this time.
  snoozedUntil   DateTime?
  // IN4: SLA escalation chain markers — when each chain step
  // fired for this conversation's (single) first-response wait.
  // Null = not fired. The sla_sweep only ever considers rows
  // with firstResponseAt NULL, so a marker, once set, is never
  // re-armed — the chain fires at most once per step per
  // conversation, never a notification storm.
  slaWarnedAt          DateTime?
  slaLeadAlertedAt     DateTime?
  slaAutoReassignedAt  DateTime?
  // CX12a: practice conversation — synthetic thread created by
  // Practice Mode. No real channel identity (integrationId stays
  // null, externalContactId is a practice-* token); every outbound
  // send on it is stored locally as a practice message and NEVER
  // handed to a channel sender.
  isPractice      Boolean @default(false)
  // Unified Inbox U4: email lane — the thread's subject line.
  subject         String?
  // Unified Inbox U5: sales pipeline stage (new | talking |
  // ordered | delivered | repeat) — advanced by real events
  // (first reply, chat order) and movable by agents; "delivered"
  // is also derived at read time from the linked order/shipment.
  pipelineStage   String   @default("new")
  // Unified Inbox U5: outcome recorded when the thread closes
  // (sale | no_sale_price | no_sale_stock | no_sale_undecided |
  // support_resolved | spam | other) — feeds analytics.
  outcome         String?
  outcomeReason   String?
  tags           String[] @default([])
  // Last time the CUSTOMER messaged us. Drives the WhatsApp 24h
  // customer-service window (window = lastCustomerMessageAt + 24h).
  lastCustomerMessageAt DateTime?
  priority       String   @default("normal") // normal | high (complaint/angry)
  sentimentFlag  String?  // negative | null
  // Rule-based spam suspicion (repeated identical messages, promo-link
  // first contact). Flagged for a human - never auto-deleted.
  spamFlag       Boolean  @default(false)
  spamReason     String?
  // IN10a: agent-applied customer block. OUR system-level block only
  // (the platform is never asked to block anyone): while blockedAt is
  // set, inbound messages are still stored and land in the spam queue,
  // but the order bot / autopilot / auto-transcription never run for
  // this conversation (no AI spend), and the row is labelled blocked
  // in the UI. Manual agent replies still work. Null = not blocked.
  blockedAt       DateTime?
  blockedByUserId String?
  blockReason     String?
  // CSAT: rating question sent when a conversation is closed; the
  // customer's 1-5 reply is recorded here.
  csatSentAt     DateTime?
  csatRating     Int?
  csatRatedAt    DateTime?
  // Latest thread summary (LLM when configured, otherwise a clearly
  // labeled data digest) with its provider for honesty.
  summaryText    String?
  summaryProvider String?
  summaryAt      DateTime?
  // SLA clocks: first outbound reply time, and when it was resolved.
  firstResponseAt DateTime?
  resolvedAt      DateTime?
  unreadCount    Int      @default(0)
  lastMessageAt  DateTime?
  lastMessagePreview String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  notes          ConversationNote[]
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messages       ChannelMessage[]
  drafts         MessageDraft[]

  @@unique([organizationId, channel, externalContactId])
  @@index([organizationId, status, lastMessageAt])
  ctwaSourceId         String? // originating ad id when the chat came from a Click-to-WhatsApp ad
}

model ChannelMessage {
  id             String   @id @default(uuid())
  conversationId String
  direction      String // in | out
  // Platform message id (WhatsApp wamid / Messenger mid). Unique so
  // webhook retries are idempotent.
  externalId     String?
  type           String   @default("text") // text | image | audio | video | document | template | other
  content        String?
  mediaUrl       String?
  // WhatsApp media id (Messenger attachments carry a direct mediaUrl).
  // Bytes are fetched through the API media proxy, never exposed raw.
  mediaId        String?
  // Unified Inbox U6: bytes persisted to the media pipeline
  // (S3-compatible or local store) at capture time, because
  // platform media ids/urls expire. Served via signed URL or the
  // authenticated proxy.
  mediaStorageKey   String?
  mediaContentType  String?
  mediaSizeBytes    Int?
  // Rule-based intent classification at ingest (price | stock | delivery
  // | order_status | payment | complaint | greeting | other) with a
  // 0-100 confidence. A heuristic label, shown to agents as an estimate.
  intent           String?
  intentConfidence Int?
  // Voice-note transcription (provider recorded; never fabricated -
  // stays null when no speech provider is configured).
  transcription    String?
  transcriptionProvider String?
  // CX12c: auto-transcription attempt state for inbound voice
  // notes. null = never attempted / not an audio message;
  // "pending" = an attempt is in flight (stamped before the
  // provider call); "done" = transcription stored above;
  // "failed" = provider/media failure; "unavailable" = no speech
  // provider configured for this deployment. "failed" and
  // "unavailable" are terminal for the auto path — a re-dispatch
  // never retries them (the agent's manual transcribe action is
  // the retry path).
  transcriptionStatus String?
  // True when this outbound message was sent by the grounded auto-reply
  // engine (still only "sent" with a platform message id).
  autoReply        Boolean @default(false)
  // JSON evidence the auto-reply was grounded in (product id + price,
  // policy id, order id + status) - auditable, never invented data.
  autoReplyEvidence String?
  // in: received. out: queued -> sent -> delivered -> read, or failed.
  status         String   @default("received")
  error          String?
  sentByUserId   String?
  sentByAiDraft  Boolean  @default(false)
  // CX11ac: reply attribution — true when this outbound message was
  // sent with AI assistance (ghost text / tone rewrite), and the
  // QuickReply it came from, when it came from one.
  sentWithAiAssist Boolean @default(false)
  quickReplyId   String?
  platformTimestamp DateTime?
  // IN6a: platform-CONFIRMED delivery lifecycle, separate from the
  // internal `status` flow. deliveryStatus is set ONLY from a real
  // webhook status (WhatsApp statuses / Messenger deliveries) or a
  // real visitor read (webchat listMessages) — never guessed at
  // send time. Monotonic: sent < delivered < read; failed is
  // terminal-side. deliveredAt/readAt stamp the confirming event.
  deliveryStatus String? // sent | delivered | read | failed
  deliveredAt    DateTime?
  readAt         DateTime?
  // IN6b: the message this one quotes — always a row in the SAME
  // conversation (validated at send/ingest; never cross-thread).
  replyToMessageId String?
  // IN6c: reactions as [{emoji, actor: "customer"|"page", at}]
  // (JSON). Customer entries come only from real Meta reaction
  // webhooks; "page" entries only after Meta confirms our send.
  reactions      Json?
  // IN6d: pin state (DB-only feature, every channel). pinnedBy is
  // the acting user's id; both clear together on unpin.
  pinnedAt       DateTime?
  pinnedBy       String?
  createdAt      DateTime @default(now())
  conversation   ChannelConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, externalId])
  @@index([conversationId, createdAt])
  referral             Json? // CTWA ad referral (source id/type/url) when Meta sends it
}

// AI-suggested replies. A draft is NEVER sent by the AI itself: a human
// approves (optionally after editing) and only then does it go out
// through the normal send path, which records the API confirmation.
model MessageDraft {
  id             String   @id @default(uuid())
  organizationId String
  conversationId String
  content        String
  status         String   @default("suggested") // suggested | sent | dismissed
  provider       String // openai | anthropic | gemini | dev-template
  // CX11ac: true when the agent edited this draft before sending it.
  sentEdited     Boolean  @default(false)
  createdByUserId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  conversation   ChannelConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([organizationId, conversationId, status])
}

/// IN1: an agent's saved inbox filter combination (personal or
/// team-shared). `filters` is a validated JSON object holding ONLY
/// the whitelisted list-filter keys (see InboxService.
/// sanitizeSavedViewFilters) — never arbitrary client payloads.
/// Visibility: the creator always sees their own views; shared
/// views are visible to the whole org. Only the creator may edit
/// or delete a view.
model InboxSavedView {
  id             String   @id @default(uuid())
  organizationId String
  userId         String
  name           String
  filters        Json
  shared         Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, userId])
  @@index([organizationId, shared])
}

/// IN3: a named, ordered macro — a sequence of inbox actions
/// (reply via a quick reply / assign / tag / pipeline stage /
/// close / snooze) an agent runs on one conversation in one click.
/// `steps` is a STRICTLY validated JSON array (see InboxService.
/// sanitizeMacroSteps): unlike saved-view filters, an invalid step
/// is a client error at write time, never silently dropped —
/// a macro must do exactly what its definition shows, no less.
/// Visibility mirrors saved views: the creator always sees their
/// own macros; shared macros are visible to the whole org. Only
/// the creator may edit or delete a macro.
model InboxMacro {
  id             String   @id @default(uuid())
  organizationId String
  userId         String
  name           String
  steps          Json
  shared         Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, userId])
  @@index([organizationId, shared])
}

model Lead {
  id             String   @id @default(uuid())
  organizationId String
  customerId     String?
  name           String
  phone          String?
  email          String?
  source         String   @default("manual") // manual | whatsapp | messenger | woocommerce | website | facebook_lead_ads
  externalId     String? // platform-side id (e.g. Meta leadgen id) for idempotent sync
  mergedIntoId String? // set when this lead was merged into another
  stage          String   @default("new") // new | contacted | qualified | proposal | won | lost
  tags           String[] @default([])
  valueMinor     BigInt?
  currency       String   @default("BDT")
  ownerUserId    String?
  notes          String?
  nextFollowUpAt DateTime?
  lastContactedAt DateTime?
  // CRM C4: values for the org's CustomFieldDefs (entity "lead"),
  // keyed by def.key. Validated server-side; never per-field columns.
  customFields   Json?
  // CX10: opt-out unsubscribe flag
  unsubscribed   Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  activities     LeadActivity[]

  @@index([organizationId, stage])
  @@index([organizationId, phone])
}

model LeadActivity {
  id        String   @id @default(uuid())
  leadId    String
  userId    String?
  type      String // note | stage_change | created | converted | message
  content   String
  createdAt DateTime @default(now())
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
}

// CRM C4: per-org custom field definitions for leads and customers.
// Values live ONLY in Lead.customFields / Customer.customFields
// (JSON keyed by `key`); this table holds the definitions. A def's
// key is immutable after create (stored values reference it), and
// archiving (archivedAt) hides the field from validation/UI/exports
// without deleting anyone's stored values.
model CustomFieldDef {
  id             String    @id @default(uuid())
  organizationId String
  entity         String // lead | customer
  key            String // slug, unique per org+entity, immutable
  label          String
  type           String // text | number | date | select
  options        Json? // string[] for type=select, else null
  required       Boolean   @default(false)
  sortOrder      Int       @default(0)
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, entity, key])
  @@index([organizationId, entity])
}

// CRM C5 (Leads & CRM Package): the org's lead auto-assignment
// setting — at most one row per org, InboxSetting-style (no row =
// defaults). leadAssignStrategy: off | round_robin |
// least_open_leads. rrCursorUserId is the round-robin cursor —
// the member who received the most recent AUTO-assignment; it
// advances only on an actual auto-assignment, never when a
// caller supplies an explicit owner.
model CrmSetting {
  id                 String   @id @default(uuid())
  organizationId     String   @unique
  leadAssignStrategy String   @default("off")
  rrCursorUserId     String?
  // CX10: per-stage default follow-up intervals in HOURS, keyed by
  // Lead stage ({ "new": 24, "contacted": 72, ... }). Null (the
  // pre-CX10 state of every org) = no automatic follow-up stamping
  // at all — LeadsService behaviour is then exactly as before.
  // Validated at the settings write path (stages = LEAD_STAGES,
  // hours integers 1..8760); a stage absent from the map has no
  // default. See crm/lead-followups.ts (followUpDefaultFor).
  followUpDefaultsByStage Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// ---------- Milestone 8: competitor intelligence (public data only) ----------

model Competitor {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  facebookPageId String?
  facebookPageUrl String?
  websiteUrl     String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ads            CompetitorAd[]
  priceObservations CompetitorPriceObservation[]

  @@index([organizationId])
}

model CompetitorAd {
  id             String   @id @default(uuid())
  competitorId   String
  // Ad Library archive id. Unique per competitor so re-syncs update rows.
  externalAdId   String
  pageId         String?
  pageName       String?
  startedAt      DateTime?
  stoppedAt      DateTime?
  isActive       Boolean  @default(false)
  platforms      String[] // publisher_platforms from the Ad Library
  creativeText   String?
  linkUrl        String?
  snapshotUrl    String?
  firstSeenAt    DateTime @default(now())
  lastSeenAt     DateTime @default(now())
  raw            Json?
  competitor     Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  @@unique([competitorId, externalAdId])
  @@index([competitorId, startedAt])
}

model CompetitorPriceObservation {
  id             String   @id @default(uuid())
  competitorId   String
  productName    String
  priceMinor     BigInt
  currency       String   @default("BDT")
  // Evidence is mandatory: every observation carries where it was seen.
  sourceUrl      String
  sourceType     String // website_scan | manual | ad_library
  observedAt     DateTime @default(now())
  competitor     Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  @@index([competitorId, observedAt])
}

// An insight may only exist with evidence. The service enforces this:
// insights without at least one valid evidence reference are dropped.
model CompetitorInsight {
  id             String   @id @default(uuid())
  organizationId String
  competitorId   String?
  kind           String // pricing | creative | positioning | activity
  title          String
  detail         String?
  evidence       Json // [{ ref, label, url? }]
  provider       String
  createdAt      DateTime @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

// ---------- Milestone 9: campaign builder + publishing ----------
// Workflow: draft -> pending_approval -> approved -> publishing ->
// published | publish_failed; rejected returns to editable.
// NOTHING reaches Meta before "approved". Published objects are created
// PAUSED; activation is a separate, explicit human action.

model CampaignPlan {
  id             String   @id @default(uuid())
  organizationId String
  adAccountId    String // our AdAccount record (must be a Meta API account)
  name           String
  objective      String // OUTCOME_SALES | OUTCOME_TRAFFIC | OUTCOME_LEADS | OUTCOME_ENGAGEMENT | OUTCOME_AWARENESS
  status         String   @default("draft")
  isTemplate     Boolean  @default(false)
  externalCampaignId String?
  metaStatus     String? // PAUSED | ACTIVE as last confirmed by the API
  createdById    String
  approvedById   String?
  approvedAt     DateTime?
  rejectionReason String?
  publishedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  adSets         CampaignAdSet[]
  publishLogs    CampaignPublishLog[]

  @@index([organizationId, status])
  metaEffectiveStatus  String? // ACTIVE | PAUSED | DISAPPROVED | WITH_ISSUES ... as Meta reports it
  lastStatusSyncAt     DateTime?
  abGroupId            String?
  abVariant            String?
  abMetric             String?
  advantagePlus Boolean @default(false)
  // Campaign Builder CB2: optional plan-level daily
  // budget cap (minor units). Submit + publish refuse
  // when the ad sets' daily budgets sum above it.
  dailyBudgetCapMinor BigInt?
  // Campaign Builder CB4: the full definition frozen
  // at submit-for-approval. Publish re-compares it —
  // what was approved is what gets published.
  submissionSnapshot Json?
  // Campaign Builder CB5: scheduled launch. Only an
  // APPROVED plan may carry this; the launch scan
  // publishes it (PAUSED, as always) at this time.
  publishAt DateTime?
}

// Campaign Builder CB4: discussion on a plan
// (approval conversation, change requests, notes).
model CampaignPlanComment {
  id             String   @id @default(uuid())
  organizationId String
  planId         String
  authorId       String
  body           String
  createdAt      DateTime @default(now())

  @@index([planId, createdAt])
}

model CampaignAdSet {
  id             String   @id @default(uuid())
  planId         String
  name           String
  externalAdSetId String?
  dailyBudgetMinor BigInt?
  lifetimeBudgetMinor BigInt?
  billingEvent   String   @default("IMPRESSIONS")
  optimizationGoal String // LINK_CLICKS | OFFSITE_CONVERSIONS | LEAD_GENERATION | REACH
  pageId         String?
  pixelId        String?
  targeting      Json // { countries: string[], ageMin?, ageMax?, genders?: number[] }
  startTime      DateTime?
  endTime        DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  plan           CampaignPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  ads            CampaignAd[]

  @@index([planId])
  effectiveStatus String?
  daypart              Json?
  daypartTz            String?
  daypartState         String?
}

model CampaignAd {
  id             String   @id @default(uuid())
  adSetId        String
  name           String
  externalAdId   String?
  productId      String?
  primaryText    String
  headline       String?
  description    String?
  linkUrl        String
  callToAction   String   @default("SHOP_NOW")
  // Phase H formats: link | video | carousel
  format         String   @default("link")
  imageAssetId   String?
  videoAssetId   String?
  carouselCards  Json? // [{ title, description?, linkUrl, imageUrl?, imageAssetId? }]
  imageUrl       String?
  createdByAi    Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  adSet          CampaignAdSet @relation(fields: [adSetId], references: [id], onDelete: Cascade)

  @@index([adSetId])
  effectiveStatus String?
  issuesInfo      Json?
}

// Every external API call attempted during publish/activate, with its
// outcome. This is the evidence behind any "published" claim.
model CampaignPublishLog {
  id             String   @id @default(uuid())
  planId         String
  actorId        String?
  step           String // campaign | adset | ad | activate | pause
  entityRef      String? // local ad set / ad id the step belongs to
  externalId     String?
  status         String // success | error
  error          String?
  createdAt      DateTime @default(now())
  plan           CampaignPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, createdAt])
}

// ---------- Milestone 10: scheduling + automation ----------

// Milestone 57: jobs that exhausted their worker retries land
// here (dead-letter queue) for operator inspection + replay.
model DeadLetterJob {
  id             String    @id @default(uuid())
  organizationId String?
  scheduledJobId String?
  jobType        String?
  error          String
  attempts       Int       @default(0)
  createdAt      DateTime  @default(now())
  replayedAt     DateTime?

  @@index([createdAt])
}

model ScheduledJob {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  // woo_products | woo_orders | shopify_products | shopify_orders |
  // meta_insights | google_insights | tiktok_insights |
  // daily_report | competitor_ads | competitor_scan
  type           String
  targetId       String // integrationId | adAccountId | competitorId, per type
  intervalMinutes Int
  enabled        Boolean  @default(true)
  lastRunAt      DateTime?
  nextRunAt      DateTime
  lastStatus     String? // success | error
  lastError      String?
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, enabled, nextRunAt])
}

model AutomationRule {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  campaignPlanId String? // null = all published plans of the org
  metric         String // platform_cpa | platform_roas | spend_no_conversions
  comparator     String // gt | lt
  threshold      String // numeric, in account currency units for CPA / ratio for ROAS
  windowDays     Int      @default(3)
  action         String // pause_campaign | alert | activate_campaign | scale_budget
  actionConfig   Json? // scale_budget: { percent, minDailyMinor?, maxDailyMinor?, cooldownHours? }
  enabled        Boolean  @default(true)
  lastEvaluatedAt DateTime?
  lastTriggeredAt DateTime?
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, enabled])
}

model AutomationRun {
  id             String   @id @default(uuid())
  organizationId String
  kind           String // schedule | rule
  refId          String // scheduledJobId | automationRuleId
  status         String // success | error | triggered | skipped
  detail         String?
  evidence       Json?
  createdAt      DateTime @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

// ---------- Milestone 11: messaging + workflows ----------

model MessageTemplate {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  channel        String // email | sms
  subject        String? // email only
  body           String // supports {{variable}} placeholders
  // MS5: optional HTML part (email channel only — the service
  // rejects htmlBody on sms with an honest 400). Sent to the
  // provider exactly as authored (no server-side rewriting);
  // null (every pre-MS5 row) = text-only sends, as before.
  htmlBody       String?
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, channel])
}

model Broadcast {
  id              String   @id @default(uuid())
  organizationId  String
  name            String
  channel         String // email | sms | whatsapp
  templateId      String?
  // WhatsApp broadcasts send a registered Meta template instead.
  whatsappTemplateId String?
  templateParams     Json?
  // MS6: rich send-time template parameters for WhatsApp
  // broadcasts — { headerMediaUrl?, headerTextParams?,
  // buttonParams?: [{ index, subType: "url"|"quick_reply", text?,
  // payload? }] }. Mapped per recipient by createWhatsAppSender
  // (with {name}/{key} substitution from the snapshot vars) into
  // MetaMessagingClient's rich params. Null (every pre-MS6 row)
  // = legacy body-params-only sends, byte-identical to before.
  templateComponents Json?
  subject         String?
  body            String
  // MS5: optional HTML part for email broadcasts (same rule as
  // MessageTemplate.htmlBody: email only, authored as-is). For
  // A/B broadcasts it is stored on variant A only; variant B's
  // htmlBody stays null.
  htmlBody        String?
  audienceType    String // customers | leads_stage | segment | custom | saved | csv
  audienceStage   String? // when audienceType = leads_stage
  audienceSegment String?
  // MS3: when audienceType = custom, the inline audience-builder
  // definition ({ entity, match, conditions } — validated by
  // messaging/audience-rules.ts). When saved, audienceSavedId points
  // at the SavedAudience whose definition is used (a deleted saved
  // audience fails preview/send honestly, never silently widens).
  // When csv, audienceCsv holds the raw pasted address list as an
  // array of strings (parsed + validated at create; unmatched and
  // invalid entries are counted at resolve time, never dropped
  // silently).
  audienceDefinition Json?
  audienceSavedId    String?
  audienceCsv        Json?
  // A/B test: two broadcasts share an abGroupId, one per variant.
  abVariant      String? // A | B
  abGroupId      String?
  // CX10: broadcast exclusions and opt-out
  excludePastDays Int?
  excludeOptOut   Boolean  @default(true)
  // "daily"|"weekly", interval: int >= 1, weekdays?: int[]
  // (0-6, Asia/Dhaka calendar days), endsAt?: ISO string }.
  // The value lives on the ONE pending instance of the chain:
  // when an instance finalizes, the engine creates the next
  // instance (status "scheduled") holding the recurrence and
  // clears it here. recurrenceGroupId ties the whole chain
  // together (A/B variants share one group, like abGroupId).
  // Null (every pre-MS8 row) = one-off broadcast, unchanged.
  recurrence        Json?
  recurrenceGroupId String?
  status          String   @default("draft") // draft | scheduled | sending | paused | sent | partial | failed | cancelled
  // MS10: archive marker for sent-family broadcasts that must
  // keep their history (delete is draft/cancelled only). An
  // archived broadcast is hidden from the default list and
  // refuses send/schedule until unarchived. Null = not archived
  // (every pre-MS10 row).
  archivedAt      DateTime?
  // CX10: when true, sendBroadcast drops every audience member who
  // already has a CONFIRMED (status "sent") MessageDelivery from
  // ANY earlier broadcast of this org (any channel). Failed
  // deliveries never exclude. Default false = pre-CX10 behaviour.
  excludePreviousRecipients Boolean @default(false)
  // MS1: when set (and status is "scheduled"), the broadcast_send_sweep
  // automation job prepares + sends the broadcast once this time is
  // due. Null (every pre-MS1 row) = no schedule.
  scheduledAt       DateTime?
  // MS1: the resolved recipient set, materialized by
  // prepareBroadcast so a send can pause/resume/retry across
  // requests and a crashed "sending" row can be recovered by the
  // sweep. Entries: { type, id, name, email, phone, status:
  // "pending"|"sent"|"failed"|"skipped", attempts, error?,
  // providerMessageId?, address? }. Null = never prepared.
  // Bounded by the per-send plan cap (max 5000 recipients).
  recipientSnapshot Json?
  totalRecipients Int      @default(0)
  sentCount       Int      @default(0)
  failedCount     Int      @default(0)
  createdById     String
  sentAt          DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveries      MessageDelivery[]

  @@index([organizationId, createdAt])
  // MS8: chain lookups by recurrence group.
  @@index([organizationId, recurrenceGroupId])
}

// MS3: a named, reusable audience definition for the Messaging
// audience builder. (Named MessagingSavedAudience because
// `SavedAudience` already exists — the Ads campaign builder's
// targeting presets.) `definition` is the Json shape validated by
// messaging/audience-rules.ts ({ entity: "customers"|"leads",
// match: "all"|"any", conditions: [...] }, max 20 conditions).
// Broadcasts reference a saved audience by id only; the definition
// is read at resolve time, so editing a saved audience changes
// future previews/sends of DRAFT broadcasts — a sent broadcast is
// unaffected because its recipients were materialized into the
// MS1 snapshot at prepare time.
model MessagingSavedAudience {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  definition     Json
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model MessageDelivery {
  id                String   @id @default(uuid())
  organizationId    String
  broadcastId       String?
  workflowRunId     String?
  channel           String // email | sms
  recipientType     String // customer | lead
  recipientId       String?
  address           String // email address or phone number actually used
  status            String // sent | failed | skipped (MS2: recipient opted out; provider never called)
  providerMessageId String? // proof of acceptance by the provider; null = not sent
  error             String?
  // MS7: post-send lifecycle, SEPARATE from the send-outcome
  // `status` above (which the MS1 final-status math reads and
  // which must not change meaning). deliveryStatus: null (no
  // post-send signal yet) | delivered | read | failed. Written
  // ONLY by real signals: WhatsApp status webhooks (monotonic —
  // delivered/read are never erased by a later failed) and the
  // signed email open pixel (openedAt). Email has no delivered
  // signal over SMTP and platform SMS has no documented DLR
  // query API (see docs/messaging-b4-acceptance.md), so those
  // channels honestly stay null.
  deliveryStatus    String?
  deliveredAt       DateTime?
  readAt            DateTime?
  openedAt          DateTime?
  createdAt         DateTime @default(now())
  broadcast         Broadcast? @relation(fields: [broadcastId], references: [id], onDelete: SetNull)

  @@index([organizationId, broadcastId])
  @@index([organizationId, createdAt])
  // MS7: WhatsApp webhook statuses match broadcast deliveries by
  // the Meta message id stored in providerMessageId.
  @@index([organizationId, providerMessageId])
}

// MS5: one row per REAL click on a tracked broadcast link. Rows
// are created ONLY by the public redirect endpoint after the
// signed token verifies (a tampered token records nothing and
// does not redirect). `url` is the final destination the visitor
// was sent to (UTM parameters already applied at send time).
// MS7 will aggregate these; MS5 only records them.
model MessageLinkClick {
  id             String   @id @default(uuid())
  organizationId String
  broadcastId    String
  // "customer:<id>" | "lead:<id>" | "csv:<address>" | "test:<address>"
  recipientKey   String
  url            String
  createdAt      DateTime @default(now())

  @@index([organizationId, broadcastId])
  @@index([organizationId, createdAt])
}

// MS2: per-(org, channel, address) messaging consent record. The
// address is stored NORMALIZED (email trimmed + lowercased; phone in
// normalizeBdPhone form when possible, else digits only) so the
// send paths and the preference store always compare the same
// string. One row per address: a START/unsubscribe flips the SAME
// row's status, keeping the latest source. Enforced by the shared
// broadcast resolver (suppression + WhatsApp opt-in) and by
// sendToRecipient (suppression only — broadcasts AND workflows).
model MessagePreference {
  id             String   @id @default(uuid())
  organizationId String
  channel        String // email | sms | whatsapp
  address        String // normalized (see above)
  recipientType  String? // customer | lead, when known
  recipientId    String?
  status         String // opted_out | opted_in
  source         String // unsubscribe_link | inbound_keyword | manual | import
  note           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, channel, address])
  @@index([organizationId, status])
}

// MS4: per-organization sender configuration (one row per org,
// MessagingSetting pattern). A missing row — every pre-MS4 org —
// means "no tenant senders": all sends fall back to the platform
// SMTP / platform SSL Wireless exactly as before. Secrets
// (smtpPassEncrypted, smsApiKeyEncrypted) are AES-256-GCM sealed
// (platform-config seal/unseal) and NEVER returned by any API;
// the safe view reports only configured booleans + non-secret
// fields. The rate columns are the ORG's own entered per-unit
// prices (minor units / poisha) used ONLY for preview estimates —
// null means "rate not set" and no estimate is shown.
model MessagingSenderConfig {
  id             String   @id @default(uuid())
  organizationId String   @unique
  // Tenant SMTP (verified by a real handshake before saving).
  smtpHost         String?
  smtpPort         Int?
  smtpUser         String?
  smtpPassEncrypted String?
  fromAddress      String?
  fromName         String?
  // Optional: the DKIM selector to check for the From domain in
  // the domain-health view. Without it DKIM is "not_checked".
  dkimSelector     String?
  // Tenant SMS gateway: sslwireless | bulksmsbd | alphasms.
  smsGateway         String?
  smsApiKeyEncrypted String?
  smsSenderId        String?
  smsApiUrl          String? // optional base-URL override
  // Org-entered rates for preview estimates (minor units).
  smsCostPerPartMinor          Int?
  whatsappCostPerMessageMinor  Int?
  emailCostPerMessageMinor     Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// MS2: per-organization messaging consent settings (one row per
// org, CrmSetting pattern). A missing row reads as the defaults
// below — frequencyCapPerDay 1, whatsappOptInRequired false —
// which is also the pre-MS2 state of every org.
model MessagingSetting {
  id                      String   @id @default(uuid())
  organizationId          String   @unique
  // Broadcast sends per recipient per rolling 24h (confirmed
  // deliveries only). 0 = off. Broadcasts only — workflow /
  // transactional sends are never frequency-capped.
  frequencyCapPerDay      Int      @default(1)
  // When true, WhatsApp broadcasts reach ONLY recipients with an
  // opted_in MessagePreference for (org, whatsapp, phone).
  whatsappOptInRequired   Boolean  @default(false)
  // MS5: link tracking for BROADCAST sends (email + sms). True
  // (the default) = links gain UTM parameters and are wrapped in
  // the signed /public/messaging/redirect/:token redirect (clicks
  // recorded as MessageLinkClick). False = links are sent exactly
  // as authored on every channel — no UTM, no wrap. Workflow sends
  // are never rewritten either way.
  linkTrackingEnabled     Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model Workflow {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  trigger        String // order_created | lead_created | lead_stage_changed
  conditions     Json? // [{field, op, value}] - all must pass
  steps          Json // [{type: send_email|send_sms|add_lead_activity, templateId?, text?}]
  enabled        Boolean  @default(true)
  // Workflows W6 governance: minimum minutes between
  // automated runs for the SAME entity (0 = off), and a
  // per-day automated run cap (null = off). Manual and
  // retry runs are deliberate and never governed.
  cooldownMinutes Int     @default(0)
  dailyRunCap     Int?
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  runs           WorkflowRun[]

  @@index([organizationId, trigger, enabled])
}

model WorkflowRun {
  id             String   @id @default(uuid())
  organizationId String
  workflowId     String
  trigger        String
  context        Json
  status         String // completed | skipped | failed | waiting
  stepsLog       Json? // [{step, status, detail}]
  // Wait steps: a run pauses with status "waiting" and resumes when
  // resumeAt passes, continuing at nextStepIndex with its stored context.
  resumeAt       DateTime?
  nextStepIndex  Int      @default(0)
  // Workflows W1: the steps as they were when the run
  // started — editing the workflow never rewrites a
  // run already in flight.
  stepsSnapshot  Json?
  error          String?
  createdAt      DateTime @default(now())
  workflow       Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

// Internal note on a conversation. NEVER sent to the customer; there is
// deliberately no code path from this model to any messaging client.
model ConversationNote {
  id             String   @id @default(uuid())
  organizationId String
  conversationId String
  authorUserId   String
  content        String
  createdAt      DateTime @default(now())
  conversation   ChannelConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([organizationId])
}

// Org-level quick reply library for the inbox. Content may contain
// {{firstName}}, {{contactName}} and {{phone}} placeholders, rendered
// with the conversation's real contact data before insertion.
model QuickReply {
  id             String   @id @default(uuid())
  organizationId String
  title          String
  content        String
  // CX11ac: how many times this quick reply has been used to send.
  timesUsed      Int      @default(0)
  createdByUserId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
}

// Registry of WhatsApp message templates that exist (approved) in the
// business's Meta account. name + language must match Meta exactly;
// sending surfaces Meta's own error if the template is not approved.
model WhatsAppTemplate {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  language       String   @default("bn")
  category       String?  // UTILITY | MARKETING | AUTHENTICATION (as in Meta)
  bodyText       String?  // preview text for agents; Meta owns the real body
  // MS6: Meta-side state, populated by the template sync / submit
  // flow (InboxService). All NULL on legacy local-only rows — a
  // null status means "never verified with Meta", never approved.
  metaTemplateId String?  // Meta's message_template id, as returned
  status         String?  // Meta's status as returned (APPROVED | PENDING | REJECTED | PAUSED | DISABLED | …), or NOT_ON_META after a complete sync that did not return it
  qualityRating  String?  // quality_score.score as returned (GREEN | YELLOW | RED | UNKNOWN)
  components     Json?    // Meta's components array, as returned by sync or as authored at submit
  lastSyncedAt   DateTime? // last time sync/submit touched this row from Meta data
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, name, language])
  @@index([organizationId])
}

// Per-organization inbox intelligence settings (one row per org).
model InboxSetting {
  id                     String   @id @default(uuid())
  organizationId         String   @unique
  // Auto-reply master mode: off | draft | auto. perIntent may override
  // per intent: { "price": "auto", "complaint": "off", ... }.
  autoReplyMode          String   @default("off")
  confidenceThreshold    Int      @default(70)
  perIntent              Json?
  // Smart assignment for new conversations: off | round_robin | least_busy
  smartAssign            String   @default("off")
  lastAssignedUserId     String?
  // Order-taking bot: collects product/qty/name/phone/address in chat
  // and creates the order through the chat-order pipeline.
  botEnabled             Boolean  @default(false)
  // Delivery charge (minor units) the bot quotes + applies. Null =
  // the bot does not quote a charge; the team confirms it later.
  botDeliveryChargeMinor Int?
  slaFirstResponseMinutes Int     @default(60)
  // Unified Inbox U2: minutes before an away agent's open
  // conversation is reassigned; team that receives escalations.
  reassignAfterMinutes   Int?
  // Unified Inbox U6: days after which CLOSED conversations are
  // deleted by the inbox_retention job. Null = keep forever.
  retentionDays          Int?
  escalationTeamId       String?
  // Unified Inbox U3: per-channel auto-reply modes
  // { "whatsapp": "auto", ... } and the high-value escalation
  // threshold (minor units) for autopilot.
  perChannelModes          Json?
  escalationThresholdMinor Int?
  // CX3: seconds the autopilot waits before composing a reply
  // (0 = immediate, the pre-CX3 behaviour). aiReplyDelayByChannel
  // optionally overrides per channel: { "whatsapp": 45, ... }.
  aiReplyDelaySeconds    Int      @default(0)
  aiReplyDelayByChannel Json?
  // CX12d: channel-wise AI schedule — { "whatsapp": { enabled,
  // windows: [{ days: [0..6], start: "HH:mm", end: "HH:mm" }] } }
  // in the organization's timezone. Null = no schedule anywhere.
  aiScheduleByChannel   Json?
  // CX12b: post-delivery review requests — opt-in (this messages
  // customers, so default OFF) + the delay after delivery before
  // the review_request_sweep sends the ask.
  reviewRequestEnabled   Boolean  @default(false)
  reviewRequestDelayHours Int     @default(24)
  // CX7: "To Chase" — gentle follow-up nudges to customers whose
  // order-bot session stalled before completion. Opt-in (this
  // messages customers, so default OFF). First nudge after
  // chaseFirstDelayMinutes of session quiet, then every
  // chaseIntervalMinutes, at most chaseMaxAttempts times. Quiet
  // hours (org timezone) suppress sends when respected.
  chaseEnabled           Boolean  @default(false)
  chaseFirstDelayMinutes Int      @default(60)
  chaseIntervalMinutes   Int      @default(240)
  chaseMaxAttempts       Int      @default(3)
  chaseQuietHoursRespect Boolean  @default(true)
  chaseQuietStartHour    Int      @default(22)
  chaseQuietEndHour      Int      @default(8)
  // Owner CX7 variant fields (his series): kept alongside ours —
  // his chase service reads these names.
  maxChaseAttempts       Int      @default(2)
  chaseMessage           String?
  // IN4: layered SLA + active escalation chain. slaByChannel
  // optionally overrides the first-response minutes per channel:
  // { "whatsapp": 30, ... } (validated at the settings write
  // path; a channel absent from the map uses the org default).
  // slaVipMinutes optionally overrides BOTH for VIP conversations
  // (latest order >= escalationThresholdMinor); null = VIP uses
  // the channel/default layer like everyone else. The chain
  // (inbox_sla_sweep job): at 75% of the effective limit the
  // assignee is warned (always on — it is only a notification to
  // the person already responsible); slaEscalateAfterMinutes
  // after a breach the team lead is alerted when
  // slaLeadAlertEnabled (default ON, it only notifies), and the
  // conversation is auto-reassigned to the least-busy eligible
  // agent only when slaAutoReassignEnabled (default OFF — moving
  // work between people is opt-in, like every customer-affecting
  // automation in this schema).
  slaByChannel           Json?
  slaVipMinutes          Int?
  slaEscalateAfterMinutes Int     @default(30)
  slaLeadAlertEnabled    Boolean  @default(true)
  slaAutoReassignEnabled Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

// CX7: one chase chain per bot session (sessionId UNIQUE is the
// dedupe guard — a session can never grow two chains). Created
// lazily by the order_chase_sweep the first time the session is
// considered. stoppedReason is terminal (completed | stop_word |
// human_took_over | max_attempts | session_ended); lastEvent is a
// non-terminal trail (e.g. customer_replied). attempts counts
// CONFIRMED sends only — a failed send stamps lastFailedAt and
// does not consume an attempt.
model OrderChase {
  id             String    @id @default(uuid())
  organizationId String
  sessionId      String    @unique
  conversationId String
  attempts       Int       @default(0)
  lastChasedAt   DateTime?
  lastFailedAt   DateTime?
  stoppedReason  String?
  lastEvent      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([organizationId, stoppedReason])
}

// One active order-taking bot session per conversation.
model BotSession {
  id             String   @id @default(uuid())
  organizationId String
  conversationId String   @unique
  // ask_product | ask_quantity | ask_name | ask_phone | ask_address | confirm
  state          String
  data           Json? // collected answers (productId, quantity, name, phone, address)
  status         String   @default("active") // active | completed | handed_off | expired
  // CX7: To Chase tracking
  chaseCount     Int      @default(0)
  lastChasedAt   DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, status])
}

// A parcel booked with a courier for one of our orders. Status is
// always the courier's own reported status, refreshed via their API.
model CourierShipment {
  id                 String   @id @default(uuid())
  organizationId     String
  orderId            String
  provider           String // steadfast (Pathao/RedX slot into the same shape)
  consignmentId      String?
  trackingCode       String?
  invoice            String
  status             String   @default("in_review")
  codAmountMinor     BigInt   @default(0)
  recipientName      String
  recipientPhone     String
  recipientAddress   String
  lastNotifiedStatus String?
  lastCheckedAt      DateTime?
  // CX6: public live-tracking token (ReportShare pattern — minted
  // lazily on first customer update/share, unique when present).
  trackingToken      String?  @unique
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([organizationId, orderId])
  @@index([organizationId, status])
}

// CX12b: post-delivery review request + the collected review.
// ONE row per order (orderId unique — the double-delivery guard).
// Created at delivery with status "pending_send"; the
// review_request_sweep sends the ask when the org's delay has
// passed and stamps "requested"; a captured rating/comment stamps
// "received". A row is NEVER marked sent without a confirmed send
// — channel-less orders stay visibly pending_send. "declined" is
// part of the status vocabulary but no v1 flow produces it (there
// is no decline parsing; an ignored ask simply stays "requested").
// reviewToken is the public review-page credential (CX6 pattern).
model OrderReview {
  id             String    @id @default(uuid())
  organizationId String
  orderId        String    @unique
  customerId     String?
  conversationId String?
  rating         Int?
  comment        String?
  source         String?
  status         String    @default("pending_send")
  reviewToken    String    @unique
  deliveredAt    DateTime
  requestedAt    DateTime?
  receivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([organizationId, status])
  @@index([organizationId, conversationId])
}

// Result of an AI-vision check on a payment screenshot sent in chat.
// An aid for the agent - it never marks an order paid by itself.
model PaymentVerification {
  id                  String   @id @default(uuid())
  organizationId      String
  conversationId      String
  messageId           String   @unique
  provider            String? // bkash | nagad | rocket | bank | unknown
  trxId               String?
  amountMinor         BigInt?
  expectedAmountMinor BigInt?
  // matched | amount_mismatch | duplicate_trxid | no_expected_order | unverifiable
  verdict             String
  flags               Json?
  rawExtraction       Json?
  modelProvider       String
  createdById         String?
  createdAt           DateTime @default(now())

  @@index([organizationId, trxId])
}

// A website live-chat installation. Each site owns a 'webchat'
// integration row; the widget authenticates with the site key and a
// per-visitor session token (only its hash is stored).
model WidgetSite {
  id             String   @id @default(uuid())
  organizationId String
  integrationId  String?
  name           String
  domain         String?
  widgetKey      String   @unique
  greeting       String?
  color          String?
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
}

model LiveChatSession {
  id              String   @id @default(uuid())
  widgetSiteId    String
  conversationId  String   @unique
  visitorId       String
  visitorTokenHash String
  visitorName     String?
  createdAt       DateTime @default(now())
  lastSeenAt      DateTime @default(now())

  @@index([widgetSiteId, visitorId])
}

// Who is looking at / typing in a conversation right now (collision
// detection). Rows are heartbeats; stale rows are ignored by age.
model AgentPresence {
  id             String   @id @default(uuid())
  organizationId String
  conversationId String
  userId         String
  typing         Boolean  @default(false)
  lastSeenAt     DateTime @default(now())

  @@unique([conversationId, userId])
  @@index([organizationId, conversationId])
}

// Sales & Data S1: one row per stock change, so a product's
// balance is always explainable. Loose-reference like
// AgentNotification: plain organizationId, no relations.
// reason: order_placed | order_cancelled | order_returned |
// manual_adjustment | sync_correction. Negative balanceAfter is
// recorded truthfully (oversell happens with COD commerce).
model StockMovement {
  id             String   @id @default(uuid())
  organizationId String
  productId      String
  variantId      String?
  delta          Int
  balanceAfter   Int
  reason         String
  orderId        String?
  actorUserId    String?
  note           String?
  createdAt      DateTime @default(now())

  @@index([organizationId, productId, createdAt])
  @@index([orderId, reason])
}

// In-app agent notifications: assignments, @mentions, urgent chats.
model AgentNotification {
  id             String    @id @default(uuid())
  organizationId String
  userId         String
  type           String // assigned | mention | urgent
  title          String
  body           String?
  conversationId String?
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  @@index([organizationId, userId, readAt])
}

// Daily breakdown aggregates from the Meta insights API (age/gender,
// placement). Keys are the API's own breakdown values.
model DailyAdBreakdown {
  id                   String   @id @default(uuid())
  organizationId       String
  adAccountId          String
  platform             String   @default("meta")
  source               String   @default("api")
  date                 DateTime
  dimension            String // age_gender | placement
  key                  String // "25-34:male" | "facebook:feed"
  campaignExternalId   String   @default("")
  spendMinor           BigInt   @default(0)
  impressions          Int      @default(0)
  clicks               Int      @default(0)
  platformConversions  Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([organizationId, adAccountId, date, dimension, key, campaignExternalId, source])
  @@index([organizationId, dimension, date])
}

// Meta Conversions API configuration per organization. The token is
// optional: when absent, the Meta ads integration token is used.
model ConversionApiSetting {
  id                   String   @id @default(uuid())
