# Copy to .env - never commit real secrets
DATABASE_URL="postgresql://marketing:marketing@localhost:5432/marketing_saas?schema=public"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="change-this-in-production-min-32-chars"
JWT_EXPIRES_IN="7d"
API_PORT=4000
WEB_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:4000"
# Media storage (Inbox U6 MediaStore; RM1: Cloudflare R2 in
# production). Any S3-compatible endpoint works. When the bucket or
# keys are empty the API falls back to a local folder (MEDIA_LOCAL_DIR,
# default <cwd>/../.media-store), which is fine for development only.
# For R2: endpoint is https://<account-id>.r2.cloudflarestorage.com
# and region is "auto".
MEDIA_S3_BUCKET=""
MEDIA_S3_ENDPOINT=""
MEDIA_S3_REGION="auto"
MEDIA_S3_ACCESS_KEY_ID=""
MEDIA_S3_SECRET_ACCESS_KEY=""
MEDIA_LOCAL_DIR=""
# RM2: optional dedicated R2 buckets for the StorageService.
# MEDIA_R2_PRIVATE_BUCKET (when set) replaces MEDIA_S3_BUCKET as the
# private/default bucket; MEDIA_R2_PUBLIC_BUCKET takes public-intent
# media. Both empty = the single MEDIA_S3_BUCKET serves everything.
MEDIA_R2_PUBLIC_BUCKET=""
MEDIA_R2_PRIVATE_BUCKET=""
# RB6/RM11: optional backup bucket (lifecycle sweep snapshots +
# fresh private-object copies) and lifecycle retention windows
# (defaults: MEDIA_TRASH_RETENTION_DAYS=30,
# MEDIA_QUARANTINE_RETENTION_HOURS=24).
MEDIA_R2_BACKUP_BUCKET=""
MEDIA_TRASH_RETENTION_DAYS=""
MEDIA_QUARANTINE_RETENTION_HOURS=""
# RM4: public CDN base used to build stored-media URLs. Empty =
# the built-in default https://media.qosprey.com (the public
# bucket's R2 custom domain).
MEDIA_CDN_BASE_URL=""
# AI - provider agnostic, leave empty until Milestone 6
LLM_PROVIDER="" # openai | anthropic | gemini | dev (dev = labeled template adapter, no real LLM)
LLM_MODEL="" # e.g. gpt-4o-mini, claude-3-5-haiku-latest, gemini-1.5-flash
AI_DAILY_MESSAGE_LIMIT="200"
LLM_API_KEY=""
# AES-256-GCM key for integration credentials: 32 bytes, base64 or hex.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=""
# Meta / Google / TikTok / WhatsApp - leave empty until their phases
META_APP_ID=""
META_APP_SECRET=""

# Ad Library API (Milestone 8): optional. Falls back to the connected Meta
# integration token. Some regions require an identity-confirmed Facebook user token.
FACEBOOK_AD_LIBRARY_TOKEN=""

# Google Ads (Milestone 10): API version for the Google Ads adapter.
GOOGLE_ADS_API_VERSION="v17"
# TikTok Ads (Milestone 10): reporting API base version path is fixed at v1.3.
# Scheduler (Milestone 10): set to "true" to disable the in-API job runner
# (useful in tests and multi-instance setups where an external runner is used).
DISABLE_SCHEDULER=""

# Email sending (Milestone 11): SMTP. Local docker-compose Mailpit listens
# on localhost:1025 (UI on 8025) with no auth - perfect for development.
SMTP_HOST=""
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
# SMS sending (Milestone 11): SSL Wireless (Bangladesh) v3 API.
SMS_API_TOKEN=""
SMS_SENDER_ID=""
SMS_API_URL="https://smsplus.sslwireless.com"
# Broadcast safety cap per send (Milestone 11).
BROADCAST_MAX_RECIPIENTS="1000"
