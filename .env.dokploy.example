# Paste these into the Dokploy stack's Environment tab and replace
# every value. Generate the secrets ONCE and never change
# ENCRYPTION_KEY afterwards (it decrypts every stored credential).

# A strong password for the bundled PostgreSQL.
POSTGRES_PASSWORD=change-me-long-random-password

# Session signing secret. Generate: openssl rand -hex 32
JWT_SECRET=change-me

# Exactly 32 bytes, base64. Generate: openssl rand -base64 32
ENCRYPTION_KEY=change-me

# The tenant app's public domain (no https://, no path).
# Point its DNS A record at the Dokploy server first.
APP_DOMAIN=app.yourdomain.com
# Milestone 57: API <-> worker shared secret (job execution plane).
# Generate with: openssl rand -hex 32
INTERNAL_JOB_SECRET=

# RM1: Media storage on Cloudflare R2 (S3-compatible). STRONGLY
# recommended: without these, every uploaded image/media file stays
# on the api container's local disk and can be lost on redeploy.
# In the Cloudflare dashboard create the R2 buckets and a
# bucket-scoped R2 API token (Object Read & Write), then fill in:
#   MEDIA_S3_ENDPOINT=https://<cloudflare-account-id>.r2.cloudflarestorage.com
MEDIA_S3_BUCKET=
MEDIA_S3_ENDPOINT=
MEDIA_S3_REGION=auto
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
# RM2: dedicated public/private buckets (same R2 account + token
# scope permitting). MEDIA_R2_PRIVATE_BUCKET, when set, becomes the
# private/default bucket instead of MEDIA_S3_BUCKET; public-intent
# media (product/social/branding) goes to MEDIA_R2_PUBLIC_BUCKET.
# Leave both empty to keep the single-bucket RB1 setup.
MEDIA_R2_PUBLIC_BUCKET=
MEDIA_R2_PRIVATE_BUCKET=
# RB6/RM11: optional backup bucket for the media lifecycle sweep
# (registry snapshots + fresh private-object copies). Create a
# third bucket (e.g. qosprey-media-backup) and extend the R2 token
# scope to it; leave empty to keep backups off.
MEDIA_R2_BACKUP_BUCKET=
# RB6/RM11: lifecycle retention (defaults: trash 30 days,
# abandoned upload quarantine 24 hours).
MEDIA_TRASH_RETENTION_DAYS=
MEDIA_QUARANTINE_RETENTION_HOURS=
# RM4: public CDN base for stored-media URLs — the public bucket's
# custom domain. Leave empty for the default
# https://media.qosprey.com.
MEDIA_CDN_BASE_URL=

# Attach these in the Dokploy Domains tab (not env, just a note):
#   web   service -> APP_DOMAIN            (port 3000)
#   admin service -> admin.yourdomain.com  (port 3001)
#   api   service -> api.yourdomain.com    (port 4000)
# The API domain is the base for Meta/WooCommerce webhook URLs.
